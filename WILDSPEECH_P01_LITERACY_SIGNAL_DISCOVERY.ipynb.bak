   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/paths.py\n",
    "\"\"\"Project directory layout, stage output mapping and data-folder discovery.\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import os\n",
    "from dataclasses import dataclass, field\n",
    "from pathlib import Path\n",
    "\n",
    "OUTPUT_SECTION_DIRS = [\n",
    "    \"00_environment\", \"01_data_audit\", \"02_target\", \"03_screening\",\n",
    "    \"04_item_intelligence\", \"05_adaptive_testing\", \"06_audio_quality\",\n",
    "    \"07_temporal\", \"08_spectral\", \"09_wavelets\", \"10_phonetic\",\n",
    "    \"11_task_intelligence\", \"12_aggregation\", \"13_student_phenotypes\",\n",
    "    \"14_residual_discovery\", \"15_confound_analysis\", \"16_feature_interactions\",\n",
    "    \"17_literacy_indices\", \"18_baselines\", \"19_failure_phenotypes\",\n",
    "    \"20_feature_registry\", \"21_final_report\",\n",
    "]\n",
    "\n",
    "# Stages without a dedicated directory in the requested tree are given\n",
    "# sub-directories of the closest section so the requested tree stays intact.\n",
    "STAGE_OUTPUT_DIR = {\n",
    "    \"00\": \"00_environment\",\n",
    "    \"01\": \"01_data_audit\",\n",
    "    \"02\": \"02_target\",\n",
    "    \"03\": \"03_screening\",\n",
    "    \"04\": \"04_item_intelligence\",\n",
    "    \"05\": \"05_adaptive_testing\",\n",
    "    \"06\": \"06_audio_quality\",\n",
    "    \"07\": \"07_temporal\",\n",
    "    \"08\": \"08_spectral\",\n",
    "    \"09\": \"09_wavelets\",\n",
    "    \"10\": \"06_audio_quality/prosody_anonymization\",\n",
    "    \"11\": \"10_phonetic\",\n",
    "    \"12\": \"11_task_intelligence\",\n",
    "    \"13\": \"12_aggregation\",\n",
    "    \"14\": \"18_baselines\",\n",
    "    \"15\": \"13_student_phenotypes\",\n",
    "    \"16\": \"14_residual_discovery\",\n",
    "    \"17\": \"15_confound_analysis\",\n",
    "    \"18\": \"16_feature_interactions\",\n",
    "    \"19\": \"17_literacy_indices\",\n",
    "    \"20\": \"18_baselines/ablation\",\n",
    "    \"21\": \"18_baselines/residual_learning\",\n",
    "    \"22\": \"19_failure_phenotypes\",\n",
    "    \"23\": \"12_aggregation/foundation_models\",\n",
    "    \"24\": \"20_feature_registry\",\n",
    "    \"25\": \"20_feature_registry/hypotheses\",\n",
    "    \"26\": \"21_final_report/visual_atlas\",\n",
    "    \"27\": \"21_final_report/submission_validation\",\n",
    "    \"28\": \"21_final_report\",\n",
    "}\n",
    "\n",
    "CACHE_SUBDIRS = [\n",
    "    \"manifests\", \"audio\", \"vad\", \"acoustic\", \"spectral\", \"wavelets\",\n",
    "    \"phonetic\", \"embeddings\", \"item_features\", \"student_features\",\n",
    "]\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class ProjectPaths:\n",
    "    root: Path\n",
    "    local_root: Path\n",
    "    experiment: str\n",
    "    data_source: Path | None = None\n",
    "    cache_dirs: dict = field(default_factory=dict)\n",
    "\n",
    "    @property\n",
    "    def data_raw(self) -> Path:\n",
    "        return self.root / \"data\" / \"raw\"\n",
    "\n",
    "    @property\n",
    "    def extracted_root(self) -> Path:\n",
    "        return self.local_root / \"data\" / \"extracted\"\n",
    "\n",
    "    @property\n",
    "    def extracted_train(self) -> Path:\n",
    "        return self.extracted_root / \"train\"\n",
    "\n",
    "    @property\n",
    "    def extracted_test(self) -> Path:\n",
    "        return self.extracted_root / \"test\"\n",
    "\n",
    "    @property\n",
    "    def configs(self) -> Path:\n",
    "        return self.root / \"configs\"\n",
    "\n",
    "    @property\n",
    "    def notebooks(self) -> Path:\n",
    "        return self.root / \"notebooks\"\n",
    "\n",
    "    @property\n",
    "    def cache(self) -> Path:\n",
    "        return self.root / \"cache\"\n",
    "\n",
    "    @property\n",
    "    def local_cache(self) -> Path:\n",
    "        return self.local_root / \"cache\"\n",
    "\n",
    "    @property\n",
    "    def outputs(self) -> Path:\n",
    "        return self.root / \"outputs\" / self.experiment\n",
    "\n",
    "    @property\n",
    "    def models(self) -> Path:\n",
    "        return self.root / \"models\"\n",
    "\n",
    "    @property\n",
    "    def submissions(self) -> Path:\n",
    "        return self.root / \"submissions\"\n",
    "\n",
    "    @property\n",
    "    def reports(self) -> Path:\n",
    "        return self.root / \"reports\"\n",
    "\n",
    "    @property\n",
    "    def logs(self) -> Path:\n",
    "        return self.outputs / \"00_environment\" / \"logs\"\n",
    "\n",
    "    def stage_dir(self, stage_id: str) -> Path:\n",
    "        path = self.outputs / STAGE_OUTPUT_DIR.get(stage_id, f\"stage_{stage_id}\")\n",
    "        path.mkdir(parents=True, exist_ok=True)\n",
    "        return path\n",
    "\n",
    "    def cache_dir(self, name: str) -> Path:\n",
    "        path = self.cache_dirs.get(name, self.cache / name)\n",
    "        path.mkdir(parents=True, exist_ok=True)\n",
    "        return path\n",
    "\n",
    "\n",
    "def default_roots(cfg: dict, environment: str) -> tuple[Path, Path]:\n",
    "    \"\"\"Return (persistent project root, local fast root).\"\"\"\n",
    "    project = cfg.get(\"project_name\", \"WildSpeech\")\n",
    "    if cfg.get(\"output_root\"):\n",
    "        root = Path(cfg[\"output_root\"]).expanduser()\n",
    "    elif environment == \"COLAB\":\n",
    "        persist = cfg.get(\"persist_root\") or str(Path(cfg.get(\"drive_mount_point\", \"/content/drive\")) / \"MyDrive\" / project)\n",
    "        root = Path(persist)\n",
    "    else:\n",
    "        root = Path.cwd() / project\n",
    "    if cfg.get(\"local_root\"):\n",
    "        local = Path(cfg[\"local_root\"]).expanduser()\n",
    "    elif environment == \"COLAB\":\n",
    "        local = Path(\"/content\") / f\"{project}_local\"\n",
    "    else:\n",
    "        local = root\n",
    "    return root, local\n",
    "\n",
    "\n",
    "def build_project_tree(cfg: dict, environment: str) -> ProjectPaths:\n",
    "    root, local = default_roots(cfg, environment)\n",
    "    paths = ProjectPaths(root=root, local_root=local, experiment=cfg.get(\"experiment_name\", \"P01\"))\n",
    "    for directory in [\n",
    "        paths.data_raw, paths.extracted_train, paths.extracted_test, paths.configs,\n",
    "        paths.notebooks, paths.cache, paths.outputs, paths.models, paths.submissions,\n",
    "        paths.reports, paths.logs, paths.local_cache,\n",
    "    ]:\n",
    "        directory.mkdir(parents=True, exist_ok=True)\n",
    "    for sub in OUTPUT_SECTION_DIRS:\n",
    "        (paths.outputs / sub).mkdir(parents=True, exist_ok=True)\n",
    "    for sub in CACHE_SUBDIRS:\n",
    "        # Heavy intermediate audio caches live on fast local storage; the\n",
    "        # persistent cache keeps manifests and compact feature tables.\n",
    "        base = paths.local_cache if sub in {\"audio\", \"vad\"} else paths.cache\n",
    "        paths.cache_dirs[sub] = base / sub\n",
    "        paths.cache_dirs[sub].mkdir(parents=True, exist_ok=True)\n",
    "    return paths\n",
    "\n",
    "\n",
    "def _walk_limited(root: Path, max_depth: int):\n",
    "    root = Path(root)\n",
    "    if not root.exists():\n",
    "        return\n",
    "    base_depth = len(root.parts)\n",
    "    for current, dirs, files in os.walk(root, followlinks=False):\n",
    "        depth = len(Path(current).parts) - base_depth\n",
    "        if depth >= max_depth:\n",
    "            dirs[:] = []\n",
    "        dirs[:] = [d for d in dirs if not d.startswith(\".\") or d == \".shortcut-targets-by-id\"]\n",
    "        yield Path(current), files\n",
    "\n",
    "\n",
    "def candidate_search_roots(cfg: dict, environment: str) -> list[Path]:\n",
    "    roots: list[Path] = []\n",
    "    if cfg.get(\"data_search_roots\"):\n",
    "        roots.extend(Path(p).expanduser() for p in cfg[\"data_search_roots\"])\n",
    "    if environment == \"COLAB\":\n",
    "        mount = Path(cfg.get(\"drive_mount_point\", \"/content/drive\"))\n",
    "        folder_id = cfg.get(\"drive_folder_id\")\n",
    "        if folder_id:\n",
    "            # Shared-folder shortcuts are exposed under this path by Colab.\n",
    "            roots.append(mount / \".shortcut-targets-by-id\" / folder_id)\n",
    "        roots.extend([mount / \"MyDrive\", mount / \"Shareddrives\", mount / \".shortcut-targets-by-id\"])\n",
    "        roots.append(Path(\"/content\"))\n",
    "    else:\n",
    "        roots.extend([Path.cwd(), Path.cwd() / \"data\", Path.home()])\n",
    "    if cfg.get(\"drive_root\"):\n",
    "        roots.insert(0, Path(cfg[\"drive_root\"]).expanduser())\n",
    "    unique: list[Path] = []\n",
    "    for r in roots:\n",
    "        if r not in unique:\n",
    "            unique.append(r)\n",
    "    return unique\n",
    "\n",
    "\n",
    "def discover_data_root(cfg: dict, environment: str) -> dict:\n",
    "    \"\"\"Recursively search for the directory containing all required files.\n",
    "\n",
    "    Returns a report with the chosen root and all candidates. Never picks one\n",
    "    of several non-identical candidates silently.\n",
    "    \"\"\"\n",
    "    required = list(cfg[\"required_files\"])\n",
    "    report: dict = {\"required_files\": required, \"candidates\": [], \"partial_candidates\": [],\n",
    "                    \"chosen\": None, \"status\": \"NOT_FOUND\", \"message\": \"\"}\n",
    "    if cfg.get(\"data_root\"):\n",
    "        root = Path(cfg[\"data_root\"]).expanduser()\n",
    "        missing = [f for f in required if not (root / f).is_file()]\n",
    "        report[\"candidates\"] = [str(root)]\n",
    "        if missing:\n",
    "            report[\"status\"] = \"MISSING_FILES\"\n",
    "            report[\"missing\"] = missing\n",
    "            report[\"message\"] = f\"Configured data_root {root} lacks: {missing}\"\n",
    "        else:\n",
    "            report[\"status\"] = \"CONFIGURED\"\n",
    "            report[\"chosen\"] = str(root)\n",
    "        return report\n",
    "    seen: set = set()\n",
    "    full: list[Path] = []\n",
    "    for search_root in candidate_search_roots(cfg, environment):\n",
    "        for directory, files in _walk_limited(search_root, int(cfg.get(\"data_search_max_depth\", 7))):\n",
    "            key = str(directory.resolve()) if directory.exists() else str(directory)\n",
    "            if key in seen:\n",
    "                continue\n",
    "            seen.add(key)\n",
    "            present = set(files) & set(required)\n",
    "            if len(present) == len(required):\n",
    "                full.append(directory)\n",
    "            elif len(present) >= max(2, len(required) // 2):\n",
    "                report[\"partial_candidates\"].append({\"path\": str(directory), \"present\": sorted(present)})\n",
    "    report[\"candidates\"] = [str(p) for p in full]\n",
    "    if not full:\n",
    "        report[\"message\"] = (\"No directory containing every required file was found. Set CONFIG['data_root'] \"\n",
    "                             \"explicitly or add the shared folder to your Drive.\")\n",
    "        return report\n",
    "    if len(full) == 1:\n",
    "        report[\"status\"] = \"FOUND\"\n",
    "        report[\"chosen\"] = str(full[0])\n",
    "        return report\n",
    "    signatures = []\n",
    "    for p in full:\n",
    "        signatures.append(tuple((f, (p / f).stat().st_size) for f in required))\n",
    "    report[\"duplicates\"] = [{\"path\": str(p), \"signature\": dict(sig)} for p, sig in zip(full, signatures)]\n",
    "    if len(set(signatures)) == 1:\n",
    "        chosen = sorted(full, key=lambda p: (len(p.parts), str(p)))[0]\n",
    "        report[\"status\"] = \"FOUND_IDENTICAL_DUPLICATES\"\n",
    "        report[\"chosen\"] = str(chosen)\n",
    "        report[\"message\"] = f\"{len(full)} identical copies found; using {chosen}.\"\n",
    "    else:\n",
    "        report[\"status\"] = \"AMBIGUOUS_DUPLICATES\"\n",
    "        report[\"message\"] = (\"Several non-identical candidate data folders were found. Set CONFIG['data_root'] \"\n",
    "                             \"to the intended folder.\")\n",
    "    return report\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-030",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/phonetic_features.py\n",
    "\"\"\"Section 11 - linguistic item complexity and phonetic intelligence.\n",
    "\n",
    "Optional local ASR runs only when ``enable_asr`` and ``enable_phonetic_analysis``\n",
    "are on AND each model entry in ``CONFIG['asr_models']`` is explicitly\n",
    "configured and marked license-verified and competition-eligible by the user.\n",
    "Audio is never sent to remote services. ASR disagreement with the expected\n",
    "text is an uncertain proxy for pronunciation differences, not a verified\n",
    "child error.\n",
    "\n",
    "ASR_MODEL_SPEC (one dict per model)::\n",
    "\n",
    "    {\"alias\": \"whisper_small\", \"type\": \"whisper\" | \"ctc\" | \"ctc_phoneme\",\n",
    "     \"checkpoint\": \"<local path or hub id>\", \"license_verified\": True,\n",
    "     \"eligible_for_competition\": True, \"language\": \"en\", \"batch_size\": 16}\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .linguistic_features import ARPABET_VOWELS, G2P, item_linguistic_table, tokenize_words\n",
    "\n",
    "ASR_MODEL_SPEC = {\"alias\": str, \"type\": str, \"checkpoint\": str, \"license_verified\": bool,\n",
    "                  \"eligible_for_competition\": bool}\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------- alignment\n",
    "def align(ref: list, hyp: list) -> list:\n",
    "    \"\"\"Levenshtein alignment; returns ops (op, ref_token, hyp_token) with op in =,S,D,I.\"\"\"\n",
    "    n, m = len(ref), len(hyp)\n",
    "    D = np.zeros((n + 1, m + 1), dtype=int)\n",
    "    D[:, 0] = np.arange(n + 1)\n",
    "    D[0, :] = np.arange(m + 1)\n",
    "    for i in range(1, n + 1):\n",
    "        for j in range(1, m + 1):\n",
    "            cost = 0 if ref[i - 1] == hyp[j - 1] else 1\n",
    "            D[i, j] = min(D[i - 1, j] + 1, D[i, j - 1] + 1, D[i - 1, j - 1] + cost)\n",
    "    ops, i, j = [], n, m\n",
    "    while i > 0 or j > 0:\n",
    "        if i > 0 and j > 0 and D[i, j] == D[i - 1, j - 1] + (ref[i - 1] != hyp[j - 1]):\n",
    "            ops.append((\"=\" if ref[i - 1] == hyp[j - 1] else \"S\", ref[i - 1], hyp[j - 1]))\n",
    "            i, j = i - 1, j - 1\n",
    "        elif i > 0 and D[i, j] == D[i - 1, j] + 1:\n",
    "            ops.append((\"D\", ref[i - 1], None))\n",
    "            i -= 1\n",
    "        else:\n",
    "            ops.append((\"I\", None, hyp[j - 1]))\n",
    "            j -= 1\n",
    "    return ops[::-1]\n",
    "\n",
    "\n",
    "def lcs_length(a: list, b: list) -> int:\n",
    "    if not a or not b:\n",
    "        return 0\n",
    "    prev = [0] * (len(b) + 1)\n",
    "    for x in a:\n",
    "        cur = [0]\n",
    "        for j, y in enumerate(b):\n",
    "            cur.append(prev[j] + 1 if x == y else max(prev[j + 1], cur[-1]))\n",
    "        prev = cur\n",
    "    return prev[-1]\n",
    "\n",
    "\n",
    "def error_summary(ref: list, hyp: list, prefix: str) -> dict:\n",
    "    ops = align(ref, hyp)\n",
    "    counts = {k: sum(o[0] == k for o in ops) for k in (\"=\", \"S\", \"D\", \"I\")}\n",
    "    n = max(len(ref), 1)\n",
    "    out = {f\"{prefix}_er\": (counts[\"S\"] + counts[\"D\"] + counts[\"I\"]) / n if ref else np.nan,\n",
    "           f\"{prefix}_sub_rate\": counts[\"S\"] / n, f\"{prefix}_del_rate\": counts[\"D\"] / n, f\"{prefix}_ins_rate\": counts[\"I\"] / n,\n",
    "           f\"{prefix}_completeness\": 1 - counts[\"D\"] / n if ref else np.nan,\n",
    "           f\"{prefix}_order_preservation\": lcs_length(ref, hyp) / n if ref else np.nan}\n",
    "    first_err = next((k for k, o in enumerate(ops) if o[0] != \"=\"), None)\n",
    "    out[f\"{prefix}_first_error_pos\"] = first_err / max(len(ops), 1) if first_err is not None else np.nan\n",
    "    return out, ops\n",
    "\n",
    "\n",
    "def self_correction_count(words: list) -> int:\n",
    "    \"\"\"Repeated words or partial-word restarts ('c cat', 'the the').\"\"\"\n",
    "    count = 0\n",
    "    for a, b in zip(words[:-1], words[1:]):\n",
    "        if a == b or (len(a) < len(b) and b.startswith(a)):\n",
    "            count += 1\n",
    "    return count\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------- adapters\n",
    "class ASRAdapter:\n",
    "    def __init__(self, spec: dict, device: str):\n",
    "        self.spec = spec\n",
    "        self.device = device\n",
    "        self.alias = spec.get(\"alias\") or spec[\"type\"]\n",
    "\n",
    "    def transcribe(self, waves: list, sr: int) -> list:\n",
    "        raise NotImplementedError\n",
    "\n",
    "\n",
    "class WhisperAdapter(ASRAdapter):\n",
    "    def __init__(self, spec: dict, device: str, local_only: bool):\n",
    "        super().__init__(spec, device)\n",
    "        import torch\n",
    "        from transformers import WhisperForConditionalGeneration, WhisperProcessor\n",
    "\n",
    "        self.torch = torch\n",
    "        self.processor = WhisperProcessor.from_pretrained(spec[\"checkpoint\"], local_files_only=local_only)\n",
    "        self.model = WhisperForConditionalGeneration.from_pretrained(spec[\"checkpoint\"], local_files_only=local_only).to(device).eval()\n",
    "\n",
    "    def transcribe(self, waves: list, sr: int) -> list:\n",
    "        torch = self.torch\n",
    "        inputs = self.processor(waves, sampling_rate=sr, return_tensors=\"pt\")\n",
    "        feats = inputs.input_features.to(self.device)\n",
    "        with torch.no_grad():\n",
    "            gen = self.model.generate(feats, output_scores=True, return_dict_in_generate=True,\n",
    "                                      language=self.spec.get(\"language\", \"en\"), task=\"transcribe\")\n",
    "        texts = self.processor.batch_decode(gen.sequences, skip_special_tokens=True)\n",
    "        scores = torch.stack(gen.scores, dim=1).float().softmax(-1)  # batch x steps x vocab\n",
    "        tok = gen.sequences[:, -scores.shape[1]:]\n",
    "        conf = scores.gather(-1, tok.unsqueeze(-1)).squeeze(-1)\n",
    "        ent = -(scores * (scores + 1e-12).log()).sum(-1)\n",
    "        special = torch.tensor(self.processor.tokenizer.all_special_ids, device=tok.device)\n",
    "        out = []\n",
    "        for k in range(len(texts)):\n",
    "            mask = ~torch.isin(tok[k], special)\n",
    "            c, e = conf[k][mask].cpu().numpy(), ent[k][mask].cpu().numpy()\n",
    "            out.append({\"text\": texts[k].strip(), \"token_conf_mean\": float(c.mean()) if len(c) else np.nan,\n",
    "                        \"token_conf_min\": float(c.min()) if len(c) else np.nan,\n",
    "                        \"token_entropy_mean\": float(e.mean()) if len(e) else np.nan,\n",
    "                        \"seq_confidence\": float(np.exp(np.log(c + 1e-12).mean())) if len(c) else np.nan})\n",
    "        return out\n",
    "\n",
    "\n",
    "class CTCAdapter(ASRAdapter):\n",
    "    def __init__(self, spec: dict, device: str, local_only: bool):\n",
    "        super().__init__(spec, device)\n",
    "        import torch\n",
    "        from transformers import AutoModelForCTC, AutoProcessor\n",
    "\n",
    "        self.torch = torch\n",
    "        self.processor = AutoProcessor.from_pretrained(spec[\"checkpoint\"], local_files_only=local_only)\n",
    "        self.model = AutoModelForCTC.from_pretrained(spec[\"checkpoint\"], local_files_only=local_only).to(device).eval()\n",
    "        self.blank = getattr(self.processor.tokenizer, \"pad_token_id\", 0) or 0\n",
    "\n",
    "    def transcribe(self, waves: list, sr: int, expected: list | None = None) -> list:\n",
    "        torch = self.torch\n",
    "        inputs = self.processor(waves, sampling_rate=sr, return_tensors=\"pt\", padding=True)\n",
    "        values = inputs.input_values.to(self.device)\n",
    "        attn = inputs.get(\"attention_mask\")\n",
    "        with torch.no_grad():\n",
    "            logits = self.model(values, attention_mask=attn.to(self.device) if attn is not None else None).logits.float()\n",
    "        logp = logits.log_softmax(-1)\n",
    "        ids = logp.argmax(-1)\n",
    "        texts = self.processor.batch_decode(ids)\n",
    "        frame_s = values.shape[1] / sr / logits.shape[1]\n",
    "        out = []\n",
    "        for k in range(len(texts)):\n",
    "            n_frames = logits.shape[1]\n",
    "            if attn is not None:\n",
    "                n_frames = int(np.ceil(attn[k].sum().item() / values.shape[1] * logits.shape[1]))\n",
    "            lp = logp[k, :n_frames]\n",
    "            p = lp.exp()\n",
    "            top = p.max(-1).values\n",
    "            nonblank = ids[k, :n_frames] != self.blank\n",
    "            ent = -(p * lp).sum(-1)\n",
    "            rec = {\"text\": texts[k].strip(),\n",
    "                   \"align_conf_mean\": float(top[nonblank].mean()) if nonblank.any() else np.nan,\n",
    "                   \"align_entropy_mean\": float(ent.mean()),\n",
    "                   \"nonblank_frame_frac\": float(nonblank.float().mean()),\n",
    "                   \"phone_duration_mean_s\": float(nonblank.sum().item() * frame_s / max(len(texts[k].split()), 1))}\n",
    "            rec[\"seq_confidence\"] = rec[\"align_conf_mean\"]\n",
    "            if expected is not None and expected[k]:\n",
    "                target = self.processor.tokenizer(expected[k], return_tensors=\"pt\").input_ids[0]\n",
    "                target = target[target != self.blank]\n",
    "                if len(target) and len(target) <= n_frames:\n",
    "                    loss = torch.nn.functional.ctc_loss(lp.unsqueeze(1).cpu(), target.unsqueeze(0), [n_frames], [len(target)],\n",
    "                                                        blank=self.blank, reduction=\"sum\", zero_infinity=True)\n",
    "                    rec[\"expected_loglik_per_token\"] = float(-loss.item() / len(target))\n",
    "            out.append(rec)\n",
    "        return out\n",
    "\n",
    "\n",
    "def build_adapter(spec: dict, cfg: dict):\n",
    "    if not spec.get(\"license_verified\") or not spec.get(\"eligible_for_competition\"):\n",
    "        raise PermissionError(f\"ASR model {spec.get('alias')} not marked license_verified and eligible_for_competition\")\n",
    "    device = \"cpu\"\n",
    "    try:\n",
    "        import torch\n",
    "\n",
    "        if cfg.get(\"use_gpu\") and torch.cuda.is_available():\n",
    "            device = \"cuda\"\n",
    "    except Exception:\n",
    "        pass\n",
    "    local = bool(cfg.get(\"hf_local_files_only\", True))\n",
    "    if spec[\"type\"] == \"whisper\":\n",
    "        return WhisperAdapter(spec, device, local)\n",
    "    if spec[\"type\"] in {\"ctc\", \"ctc_phoneme\"}:\n",
    "        return CTCAdapter(spec, device, local)\n",
    "    raise ValueError(f\"unknown ASR type {spec['type']}\")\n",
    "\n",
    "\n",
    "def run_asr(ctx, adapter, clips: pd.DataFrame, split: str) -> pd.DataFrame:\n",
    "    \"\"\"Batched local ASR with per-chunk caching and CUDA OOM recovery.\"\"\"\n",
    "    from .audio_processing import decode_audio\n",
    "    from . import audio_manifest as am\n",
    "    from .io_utils import atomic_write_parquet\n",
    "    from .logging_utils import progress, release_memory\n",
    "\n",
    "    cfg = ctx.config\n",
    "    cache = ctx.paths.cache_dir(\"phonetic\") / f\"{split}_{adapter.alias}\"\n",
    "    cache.mkdir(parents=True, exist_ok=True)\n",
    "    done = set()\n",
    "    for p in cache.glob(\"chunk_*.parquet\"):\n",
    "        done |= set(pd.read_parquet(p, columns=[\"clip_id\"])[\"clip_id\"])\n",
    "    todo = clips[~clips[\"clip_id\"].isin(done) & clips[\"audio_member\"].notna()]\n",
    "    archive = ctx.data_root() / (\"train_audio.tar\" if split == \"train\" else \"test_audio.tar\")\n",
    "    extracted = ctx.paths.extracted_train if split == \"train\" else ctx.paths.extracted_test\n",
    "    batch = int(adapter.spec.get(\"batch_size\", cfg[\"audio_batch_size\"]))\n",
    "    chunk_size = max(batch * 8, 64)\n",
    "    sr = 16000\n",
    "    start_idx = len(list(cache.glob(\"chunk_*.parquet\")))\n",
    "    for ci, start in enumerate(progress(range(0, len(todo), chunk_size), desc=f\"ASR {adapter.alias}\")):\n",
    "        chunk = todo.iloc[start:start + chunk_size]\n",
    "        members = chunk[\"audio_member\"].tolist()\n",
    "        use_files = all((extracted / m).exists() for m in members)\n",
    "        blobs = {} if use_files else am.read_member_bytes(archive, members)\n",
    "        waves, ids, expected = [], [], []\n",
    "        for _, r in chunk.iterrows():\n",
    "            src = str(extracted / r[\"audio_member\"]) if use_files else blobs.get(r[\"audio_member\"])\n",
    "            if src is None:\n",
    "                continue\n",
    "            try:\n",
    "                y, _ = decode_audio(src, sr)\n",
    "            except Exception:\n",
    "                continue\n",
    "            waves.append(y[: int(float(cfg[\"embedding_max_seconds\"]) * sr)])\n",
    "            ids.append(r[\"clip_id\"])\n",
    "            expected.append(str(r.get(\"expected_text\", \"\") or \"\"))\n",
    "        rows, k, bs = [], 0, batch\n",
    "        while k < len(waves):\n",
    "            try:\n",
    "                part = waves[k:k + bs]\n",
    "                if isinstance(adapter, CTCAdapter):\n",
    "                    res = adapter.transcribe(part, sr, expected[k:k + bs])\n",
    "                else:\n",
    "                    res = adapter.transcribe(part, sr)\n",
    "                for cid, rec in zip(ids[k:k + bs], res):\n",
    "                    rows.append({\"clip_id\": cid, **rec})\n",
    "                k += bs\n",
    "            except RuntimeError as exc:\n",
    "                if \"out of memory\" in str(exc).lower() and bs > 1:\n",
    "                    release_memory()\n",
    "                    bs = max(1, bs // 2)\n",
    "                    ctx.logger.warning(\"CUDA OOM in ASR; reducing batch to %d\", bs)\n",
    "                    continue\n",
    "                raise\n",
    "        atomic_write_parquet(pd.DataFrame(rows), cache / f\"chunk_{start_idx + ci:05d}.parquet\")\n",
    "    parts = [pd.read_parquet(p) for p in sorted(cache.glob(\"chunk_*.parquet\"))]\n",
    "    return pd.concat(parts, ignore_index=True).drop_duplicates(\"clip_id\", keep=\"last\") if parts else pd.DataFrame(columns=[\"clip_id\"])\n",
    "\n",
    "\n",
    "def compare_expected(asr: pd.DataFrame, clips: pd.DataFrame, g2p: G2P, alias: str, phoneme_output: bool) -> tuple[pd.DataFrame, pd.DataFrame]:\n",
    "    d = asr.merge(clips[[\"clip_id\", \"expected_text\", \"task_family\"]], on=\"clip_id\", how=\"left\")\n",
    "    rows, confusion = [], []\n",
    "    p = f\"ph_{alias}\"\n",
    "    for _, r in d.iterrows():\n",
    "        exp_words = tokenize_words(r.get(\"expected_text\", \"\"))\n",
    "        hyp_text = str(r.get(\"text\", \"\") or \"\")\n",
    "        hyp_words = tokenize_words(hyp_text)\n",
    "        rec = {\"clip_id\": r[\"clip_id\"], f\"{p}_text\": hyp_text}\n",
    "        w, _ = error_summary(exp_words, hyp_words, f\"{p}_word\")\n",
    "        c, _ = error_summary(list(\"\".join(exp_words)), list(\"\".join(hyp_words)), f\"{p}_char\")\n",
    "        exp_ph = [x for wd in exp_words for x in g2p.word(wd)]\n",
    "        hyp_ph = hyp_text.upper().split() if phoneme_output else [x for wd in hyp_words for x in g2p.word(wd)]\n",
    "        ph, ops = error_summary(exp_ph, hyp_ph, f\"{p}_phone\")\n",
    "        rec.update(w)\n",
    "        rec.update(c)\n",
    "        rec.update(ph)\n",
    "        cons = [o for o in ops if o[1] is not None and o[1] not in ARPABET_VOWELS]\n",
    "        vow = [o for o in ops if o[1] is not None and o[1] in ARPABET_VOWELS]\n",
    "        rec[f\"{p}_consonant_accuracy\"] = float(np.mean([o[0] == \"=\" for o in cons])) if cons else np.nan\n",
    "        rec[f\"{p}_vowel_accuracy\"] = float(np.mean([o[0] == \"=\" for o in vow])) if vow else np.nan\n",
    "        rec[f\"{p}_self_corrections\"] = float(self_correction_count(hyp_words))\n",
    "        rec[f\"{p}_hyp_len_ratio\"] = len(hyp_words) / len(exp_words) if exp_words else np.nan\n",
    "        for key in (\"token_conf_mean\", \"token_conf_min\", \"token_entropy_mean\", \"seq_confidence\", \"align_conf_mean\",\n",
    "                    \"align_entropy_mean\", \"nonblank_frame_frac\", \"phone_duration_mean_s\", \"expected_loglik_per_token\"):\n",
    "            if key in r and pd.notna(r[key]):\n",
    "                rec[f\"{p}_{key}\"] = float(r[key])\n",
    "        rows.append(rec)\n",
    "        for o in ops:\n",
    "            if o[0] != \"=\":\n",
    "                confusion.append({\"task_family\": r.get(\"task_family\"), \"op\": o[0], \"expected\": o[1], \"observed\": o[2]})\n",
    "    return pd.DataFrame(rows), pd.DataFrame(confusion)\n",
    "\n",
    "\n",
    "def stage_phonetic_intelligence(ctx) -> dict:\n",
    "    cfg = ctx.config\n",
    "    outputs: list = []\n",
    "    items = ctx.load_df(\"item_master\")\n",
    "    summary: dict = {}\n",
    "    if cfg.get(\"enable_linguistic_features\") or cfg.get(\"enable_phonetic_analysis\"):\n",
    "        table, info = item_linguistic_table(items, cfg)\n",
    "        ctx.save_df(table, \"item_linguistic_features\", also_csv=True)\n",
    "        ctx.save_json(info, \"linguistic_status\")\n",
    "        outputs += [\"item_linguistic_features\", \"linguistic_status\"]\n",
    "        summary[\"linguistic\"] = info\n",
    "        if len(table) and \"l_n_phonemes\" in table.columns:\n",
    "            fig, axes = viz.new_figure(1, 3, (4.5, 3.6))\n",
    "            for ax, c in zip(axes.ravel(), (\"l_n_phonemes\", \"l_n_syllables\", \"l_max_cluster_len\")):\n",
    "                viz.hist_kde(ax, table[c], c, bins=20)\n",
    "            ctx.figure(fig, \"item_linguistic_complexity\", \"Expected-text complexity of items\",\n",
    "                       \"How complex are the items linguistically?\", \"item_linguistic_features\", int(len(table)),\n",
    "                       f\"G2P backend: {info['g2p_backend']}{' (approximate rules)' if info.get('approximate') else ''}.\")\n",
    "    specs = cfg.get(\"asr_models\") or []\n",
    "    if not (cfg.get(\"enable_asr\") and cfg.get(\"enable_phonetic_analysis\")):\n",
    "        ctx.save_json({\"status\": \"SKIPPED_DISABLED\", \"reason\": \"enable_asr and enable_phonetic_analysis must both be True\"}, \"asr_status\")\n",
    "        return {\"outputs\": outputs + [\"asr_status\"], \"summary\": summary}\n",
    "    if not specs:\n",
    "        ctx.save_json({\"status\": \"NOT_CONFIGURED\", \"reason\": \"no entries in CONFIG['asr_models']\"}, \"asr_status\")\n",
    "        return {\"outputs\": outputs + [\"asr_status\"], \"summary\": summary}\n",
    "    g2p = G2P(cfg.get(\"g2p_backend\", \"auto\"))\n",
    "    status = []\n",
    "    for split in [\"train\"] + ([\"test\"] if cfg.get(\"allow_test_inference\") else []):\n",
    "        clips = da.clips(ctx, split)\n",
    "        merged = None\n",
    "        confusions = []\n",
    "        for spec in specs:\n",
    "            try:\n",
    "                adapter = build_adapter(spec, cfg)\n",
    "            except Exception as exc:\n",
    "                status.append({\"alias\": spec.get(\"alias\"), \"split\": split, \"status\": \"UNAVAILABLE\", \"reason\": str(exc)})\n",
    "                continue\n",
    "            asr = run_asr(ctx, adapter, clips, split)\n",
    "            feats, conf = compare_expected(asr, clips, g2p, adapter.alias, spec[\"type\"] == \"ctc_phoneme\")\n",
    "            merged = feats if merged is None else merged.merge(feats, on=\"clip_id\", how=\"outer\")\n",
    "            confusions.append(conf.assign(alias=adapter.alias))\n",
    "            status.append({\"alias\": adapter.alias, \"split\": split, \"status\": \"OK\", \"n\": int(len(feats))})\n",
    "            del adapter\n",
    "        if merged is not None:\n",
    "            name = \"clip_phonetic_features\" if split == \"train\" else \"clip_phonetic_features_test\"\n",
    "            ctx.save_df(merged, name)\n",
    "            outputs.append(name)\n",
    "        if split == \"train\" and confusions:\n",
    "            conf = pd.concat(confusions, ignore_index=True)\n",
    "            ctx.save_df(conf, \"phoneme_confusions\")\n",
    "            outputs.append(\"phoneme_confusions\")\n",
    "            _phonetic_figures(ctx, conf, merged)\n",
    "    ctx.save_json({\"status\": \"COMPLETED\", \"models\": status,\n",
    "                   \"caveat\": \"ASR disagreement is an uncertain proxy, not a verified child error.\"}, \"asr_status\")\n",
    "    outputs.append(\"asr_status\")\n",
    "    summary[\"asr\"] = status\n",
    "    return {\"outputs\": outputs, \"summary\": summary}\n",
    "\n",
    "\n",
    "def _phonetic_figures(ctx, conf: pd.DataFrame, feats: pd.DataFrame) -> None:\n",
    "    subs = conf[conf[\"op\"] == \"S\"]\n",
    "    if len(subs):\n",
    "        top = subs[\"expected\"].value_counts().head(30).index\n",
    "        M = pd.crosstab(subs[\"expected\"], subs[\"observed\"]).reindex(index=top).fillna(0)\n",
    "        M = M.loc[:, M.sum().sort_values(ascending=False).index[:30]]\n",
    "        fig, axes = viz.new_figure(1, 1, (9, 8))\n",
    "        viz.heatmap(axes[0, 0], M, \"Phoneme substitutions (expected rows, recognised columns)\", cmap=\"viridis\", cbar_label=\"count\")\n",
    "        ctx.figure(fig, \"phoneme_confusion\", \"Phoneme confusion matrix\", \"Which expected sounds are recognised differently?\",\n",
    "                   \"phoneme_confusions\", int(len(subs)), \"ASR-based proxy; not verified child errors.\")\n",
    "    fig, axes = viz.new_figure(1, 1)\n",
    "    conf.groupby([\"task_family\", \"op\"]).size().unstack(fill_value=0).plot(kind=\"bar\", stacked=True, ax=axes[0, 0])\n",
    "    viz.finalize_axis(axes[0, 0], \"Error-type distribution by task\", \"task\", \"operations\", int(len(conf)))\n",
    "    ctx.figure(fig, \"phonetic_error_types\", \"Task-specific phonetic error profiles\", \"Which error types dominate per task?\",\n",
    "               \"phoneme_confusions\", int(len(conf)), \"S=substitution, D=deletion, I=insertion (ASR proxy).\")\n",
    "    pos = [c for c in feats.columns if c.endswith(\"_phone_first_error_pos\")]\n",
    "    conf_cols = [c for c in feats.columns if c.endswith((\"_seq_confidence\", \"_align_conf_mean\"))]\n",
    "    if pos or conf_cols:\n",
    "        fig, axes = viz.new_figure(1, 2)\n",
    "        if pos:\n",
    "            viz.hist_kde(axes[0, 0], feats[pos[0]], \"normalised first-error position\")\n",
    "        if conf_cols:\n",
    "            viz.hist_kde(axes[0, 1], feats[conf_cols[0]], conf_cols[0])\n",
    "        ctx.figure(fig, \"phonetic_error_position_confidence\", \"Error positions and recognition confidence\",\n",
    "                   \"Where do deviations occur and how confident is recognition?\", \"clip_phonetic_features\",\n",
    "                   int(len(feats)), \"Confidence values are model-specific and uncalibrated.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-031",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/pipeline.py\n",
    "\"\"\"Stage orchestrator with explicit dependency resolution, caching and manifests.\n",
    "\n",
    "Stage statuses: NOT_STARTED, RUNNING, COMPLETE, SKIPPED_DISABLED,\n",
    "BLOCKED_DEPENDENCY, FAILED, CACHED.\n",
    "\n",
    "A stage is CACHED when ``resume`` is on, ``overwrite_cache`` is off, the\n",
    "previous run completed, every registered output still exists and the input\n",
    "fingerprint (stage version + semantic config hash + fingerprints of every\n",
    "available dependency) is unchanged. Re-running any dependency changes its\n",
    "fingerprint and therefore invalidates all dependants (dependency-aware cache\n",
    "invalidation).\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import datetime as _dt\n",
    "import traceback\n",
    "from dataclasses import dataclass, field\n",
    "from pathlib import Path\n",
    "from typing import Callable\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "from . import (ablation, adaptive_behavior, audio_processing, baseline_models, clustering,\n",
    "               confound_analysis, data_audit, environment, failure_atlas, feature_interactions,\n",
    "               feature_registry, foundation_models, hypothesis_registry, item_intelligence,\n",
    "               literacy_indices, phonetic_features, prosody_features, reporting, residual_discovery,\n",
    "               residual_models, screening_eda, spectral_features, student_aggregation, submission,\n",
    "               target_eda, task_intelligence, temporal_features, visualization, wavelet_features)\n",
    "from .config import PROFILE_DEFAULT_STAGES, build_config, config_hash, save_config, stable_hash\n",
    "from .io_utils import ArtifactMissing, ArtifactStore, atomic_write_csv, atomic_write_json, file_fingerprint, read_json\n",
    "from .logging_utils import StageTimer, get_logger, release_memory\n",
    "from .paths import ProjectPaths, build_project_tree\n",
    "\n",
    "NOT_STARTED = \"NOT_STARTED\"\n",
    "RUNNING = \"RUNNING\"\n",
    "COMPLETE = \"COMPLETE\"\n",
    "SKIPPED_DISABLED = \"SKIPPED_DISABLED\"\n",
    "BLOCKED_DEPENDENCY = \"BLOCKED_DEPENDENCY\"\n",
    "FAILED = \"FAILED\"\n",
    "CACHED = \"CACHED\"\n",
    "AVAILABLE_STATES = {COMPLETE, CACHED}\n",
    "\n",
    "STAGE_REGISTRY: dict = {\n",
    "    \"00\": environment.stage_environment,\n",
    "    \"01\": data_audit.stage_data_audit,\n",
    "    \"02\": target_eda.stage_target_intelligence,\n",
    "    \"03\": screening_eda.stage_screening_intelligence,\n",
    "    \"04\": item_intelligence.stage_item_intelligence,\n",
    "    \"05\": adaptive_behavior.stage_adaptive_testing,\n",
    "    \"06\": audio_processing.stage_acoustic_atlas,\n",
    "    \"07\": temporal_features.stage_temporal_features,\n",
    "    \"08\": spectral_features.stage_spectral_features,\n",
    "    \"09\": wavelet_features.stage_wavelet_features,\n",
    "    \"10\": prosody_features.stage_prosody,\n",
    "    \"11\": phonetic_features.stage_phonetic_intelligence,\n",
    "    \"12\": task_intelligence.stage_task_intelligence,\n",
    "    \"13\": student_aggregation.stage_student_aggregation,\n",
    "    \"14\": baseline_models.stage_validation_and_baseline,\n",
    "    \"15\": clustering.stage_student_phenotypes,\n",
    "    \"16\": residual_discovery.stage_residual_discovery,\n",
    "    \"17\": confound_analysis.stage_confound_analysis,\n",
    "    \"18\": feature_interactions.stage_feature_interactions,\n",
    "    \"19\": literacy_indices.stage_literacy_indices,\n",
    "    \"20\": ablation.stage_predictive_ablation,\n",
    "    \"21\": residual_models.stage_residual_learning,\n",
    "    \"22\": failure_atlas.stage_failure_atlas,\n",
    "    \"23\": foundation_models.stage_foundation_models,\n",
    "    \"24\": feature_registry.stage_feature_registry,\n",
    "    \"25\": hypothesis_registry.stage_hypothesis_registry,\n",
    "    \"26\": visualization.stage_visualization_atlas,\n",
    "    \"27\": submission.stage_submission,\n",
    "    \"28\": reporting.stage_final_report,\n",
    "}\n",
    "\n",
    "\n",
    "def _flag(*keys: str, any_of: bool = False) -> Callable[[dict], tuple[bool, str]]:\n",
    "    def check(cfg: dict) -> tuple[bool, str]:\n",
    "        values = [bool(cfg.get(k)) for k in keys]\n",
    "        ok = any(values) if any_of else all(values)\n",
    "        if ok:\n",
    "            return True, \"\"\n",
    "        off = [k for k, v in zip(keys, values) if not v]\n",
    "        return False, f\"disabled by configuration: {', '.join(off)}\"\n",
    "    return check\n",
    "\n",
    "\n",
    "def _always(cfg: dict) -> tuple[bool, str]:\n",
    "    return True, \"\"\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class StageSpec:\n",
    "    stage_id: str\n",
    "    name: str\n",
    "    func: Callable\n",
    "    requires: list = field(default_factory=list)\n",
    "    optional: list = field(default_factory=list)\n",
    "    enabled: Callable = _always\n",
    "    version: str = \"1.0.0\"\n",
    "    always_run: bool = False\n",
    "\n",
    "\n",
    "ALL_ANALYSIS = [f\"{i:02d}\" for i in range(1, 26)]\n",
    "\n",
    "STAGE_SPECS: dict = {s.stage_id: s for s in [\n",
    "    StageSpec(\"00\", \"environment\", STAGE_REGISTRY[\"00\"], always_run=True),\n",
    "    StageSpec(\"01\", \"data_audit\", STAGE_REGISTRY[\"01\"], [\"00\"]),\n",
    "    StageSpec(\"02\", \"target_intelligence\", STAGE_REGISTRY[\"02\"], [\"01\"], [], _flag(\"enable_tabular_eda\")),\n",
    "    StageSpec(\"03\", \"screening_intelligence\", STAGE_REGISTRY[\"03\"], [\"01\"], [], _flag(\"enable_tabular_eda\")),\n",
    "    StageSpec(\"04\", \"item_intelligence\", STAGE_REGISTRY[\"04\"], [\"01\"], [\"03\"], _flag(\"enable_item_analysis\")),\n",
    "    StageSpec(\"05\", \"adaptive_testing\", STAGE_REGISTRY[\"05\"], [\"01\"], [\"04\", \"06\"], _flag(\"enable_item_analysis\")),\n",
    "    StageSpec(\"06\", \"acoustic_atlas\", STAGE_REGISTRY[\"06\"], [\"01\"], [\"03\", \"04\", \"14\"], _flag(\"enable_acoustic_features\")),\n",
    "    StageSpec(\"07\", \"temporal_features\", STAGE_REGISTRY[\"07\"], [\"06\"], [\"03\", \"04\", \"11\", \"13\", \"14\"], _flag(\"enable_acoustic_features\")),\n",
    "    StageSpec(\"08\", \"spectral_features\", STAGE_REGISTRY[\"08\"], [\"06\"], [\"03\", \"04\", \"11\", \"13\", \"14\"], _flag(\"enable_acoustic_features\")),\n",
    "    StageSpec(\"09\", \"wavelet_features\", STAGE_REGISTRY[\"09\"], [\"06\"], [\"03\", \"04\", \"11\", \"13\", \"14\"], _flag(\"enable_acoustic_features\", \"enable_wavelets\")),\n",
    "    StageSpec(\"10\", \"prosody\", STAGE_REGISTRY[\"10\"], [\"06\"], [\"03\", \"04\", \"11\", \"13\", \"14\"], _flag(\"enable_acoustic_features\")),\n",
    "    StageSpec(\"11\", \"phonetic_intelligence\", STAGE_REGISTRY[\"11\"], [\"01\"], [\"06\"], _flag(\"enable_linguistic_features\", \"enable_phonetic_analysis\", any_of=True)),\n",
    "    StageSpec(\"12\", \"task_intelligence\", STAGE_REGISTRY[\"12\"], [\"13\", \"14\"], [\"11\"]),\n",
    "    StageSpec(\"13\", \"student_aggregation\", STAGE_REGISTRY[\"13\"], [\"01\"], [\"03\", \"04\", \"05\", \"06\", \"11\", \"23\"]),\n",
    "    StageSpec(\"14\", \"validation_and_baseline\", STAGE_REGISTRY[\"14\"], [\"01\", \"03\"], [], _flag(\"enable_baseline_models\")),\n",
    "    StageSpec(\"15\", \"student_phenotypes\", STAGE_REGISTRY[\"15\"], [\"13\"], [\"14\"], _flag(\"enable_student_clustering\")),\n",
    "    StageSpec(\"16\", \"residual_discovery\", STAGE_REGISTRY[\"16\"], [\"13\", \"14\"], [], _flag(\"enable_residual_analysis\")),\n",
    "    StageSpec(\"17\", \"confound_analysis\", STAGE_REGISTRY[\"17\"], [\"13\", \"14\"], [\"10\"], _flag(\"enable_confound_analysis\")),\n",
    "    StageSpec(\"18\", \"feature_interactions\", STAGE_REGISTRY[\"18\"], [\"13\", \"14\"], [\"04\"], _flag(\"enable_feature_interactions\")),\n",
    "    StageSpec(\"19\", \"literacy_indices\", STAGE_REGISTRY[\"19\"], [\"13\", \"14\"], [\"04\"], _flag(\"enable_residual_analysis\")),\n",
    "    StageSpec(\"20\", \"predictive_ablation\", STAGE_REGISTRY[\"20\"], [\"13\", \"14\"], [\"04\", \"15\", \"19\"], _flag(\"enable_baseline_models\")),\n",
    "    StageSpec(\"21\", \"residual_learning\", STAGE_REGISTRY[\"21\"], [\"13\", \"14\"], [], _flag(\"enable_residual_analysis\", \"enable_baseline_models\")),\n",
    "    StageSpec(\"22\", \"failure_atlas\", STAGE_REGISTRY[\"22\"], [\"14\"], [\"13\", \"20\", \"21\"], _flag(\"enable_failure_analysis\")),\n",
    "    StageSpec(\"23\", \"foundation_models\", STAGE_REGISTRY[\"23\"], [\"06\"], [], _flag(\"enable_embeddings\")),\n",
    "    StageSpec(\"24\", \"feature_registry\", STAGE_REGISTRY[\"24\"], [\"13\", \"14\"], [\"10\", \"16\", \"17\", \"20\"]),\n",
    "    StageSpec(\"25\", \"hypothesis_registry\", STAGE_REGISTRY[\"25\"], [\"24\"], [\"12\", \"15\", \"16\", \"17\", \"18\", \"19\", \"20\", \"21\", \"22\", \"23\"]),\n",
    "    StageSpec(\"26\", \"visualization_atlas\", STAGE_REGISTRY[\"26\"], [], [s for s in ALL_ANALYSIS], _flag(\"save_figures\")),\n",
    "    StageSpec(\"27\", \"submission\", STAGE_REGISTRY[\"27\"], [\"14\"], [\"13\", \"20\"], _flag(\"enable_submission\", \"allow_test_inference\")),\n",
    "    StageSpec(\"28\", \"final_report\", STAGE_REGISTRY[\"28\"], [], [f\"{i:02d}\" for i in range(0, 28)]),\n",
    "]}\n",
    "\n",
    "\n",
    "class RunContext:\n",
    "    \"\"\"Everything a stage needs: config, paths, logger, artifact store, figures.\"\"\"\n",
    "\n",
    "    def __init__(self, config: dict, paths: ProjectPaths, logger, store: ArtifactStore, figures):\n",
    "        self.config = config\n",
    "        self.paths = paths\n",
    "        self.logger = logger\n",
    "        self.store = store\n",
    "        self.figures = figures\n",
    "        self.state: dict = {}\n",
    "        self.current_stage: str = \"00\"\n",
    "        self.available_stages: set = set()\n",
    "\n",
    "    # ---- stage helpers ------------------------------------------------------\n",
    "    def out_dir(self, sub: str | None = None) -> Path:\n",
    "        path = self.paths.stage_dir(self.current_stage)\n",
    "        if sub:\n",
    "            path = path / sub\n",
    "            path.mkdir(parents=True, exist_ok=True)\n",
    "        return path\n",
    "\n",
    "    def stage_available(self, stage_id: str) -> bool:\n",
    "        return stage_id in self.available_stages\n",
    "\n",
    "    def save_df(self, df: pd.DataFrame, name: str, fmt: str = \"parquet\", also_csv: bool = False) -> Path:\n",
    "        if not self.config.get(\"save_tables\", True) and fmt == \"csv\" and not name.startswith(\"P01_\"):\n",
    "            # Tables are always written as parquet for downstream stages.\n",
    "            fmt = \"parquet\"\n",
    "        path = self.store.save_df(df, name, self.out_dir(), self.current_stage, fmt=fmt)\n",
    "        if also_csv and fmt != \"csv\" and self.config.get(\"save_tables\", True):\n",
    "            atomic_write_csv(df, path.with_suffix(\".csv\"))\n",
    "        return path\n",
    "\n",
    "    def save_json(self, obj, name: str) -> Path:\n",
    "        return self.store.save_json(obj, name, self.out_dir(), self.current_stage)\n",
    "\n",
    "    def load_df(self, name: str, required: bool = True) -> pd.DataFrame | None:\n",
    "        try:\n",
    "            return self.store.load_df(name)\n",
    "        except ArtifactMissing:\n",
    "            if required:\n",
    "                raise\n",
    "            return None\n",
    "\n",
    "    def load_json(self, name: str, required: bool = True):\n",
    "        try:\n",
    "            return self.store.load_json(name)\n",
    "        except ArtifactMissing:\n",
    "            if required:\n",
    "                raise\n",
    "            return None\n",
    "\n",
    "    def has(self, name: str) -> bool:\n",
    "        return self.store.has(name)\n",
    "\n",
    "    def set_data_root(self, path: Path) -> None:\n",
    "        self.state[\"data_root\"] = Path(path)\n",
    "        atomic_write_json(self.paths.cache_dir(\"manifests\") / \"data_root.json\", {\"data_root\": str(path)})\n",
    "\n",
    "    def data_root(self) -> Path:\n",
    "        if \"data_root\" in self.state:\n",
    "            return self.state[\"data_root\"]\n",
    "        stored = read_json(self.paths.cache_dir(\"manifests\") / \"data_root.json\")\n",
    "        if stored and Path(stored[\"data_root\"]).exists():\n",
    "            self.state[\"data_root\"] = Path(stored[\"data_root\"])\n",
    "            return self.state[\"data_root\"]\n",
    "        if self.config.get(\"data_root\"):\n",
    "            return Path(self.config[\"data_root\"])\n",
    "        raise FileNotFoundError(\"Data root unknown: run stage 00 first\")\n",
    "\n",
    "    def figure(self, fig, fig_id: str, title: str, question: str, source_table: str, n, description: str,\n",
    "               sub: str | None = None) -> Path | None:\n",
    "        return self.figures.save(fig, section=self.current_stage, fig_id=fig_id, title=title,\n",
    "                                 question=question, source_table=source_table, sample_size=n,\n",
    "                                 description=description, directory=self.out_dir(sub or \"figures\"))\n",
    "\n",
    "\n",
    "class Pipeline:\n",
    "    def __init__(self, ctx: RunContext, specs: dict | None = None):\n",
    "        self.ctx = ctx\n",
    "        self.specs = specs or STAGE_SPECS\n",
    "        self.manifest_path = ctx.paths.outputs / \"00_environment\" / \"stage_manifest.json\"\n",
    "        self.report_path = ctx.paths.outputs / \"00_environment\" / \"stage_execution_report.csv\"\n",
    "        self.manifest: dict = read_json(self.manifest_path, default={}) or {}\n",
    "        self.session_rows: list = []\n",
    "        self.cfg_hash = config_hash(ctx.config)\n",
    "        for sid, entry in self.manifest.items():\n",
    "            if entry.get(\"status\") in AVAILABLE_STATES and ctx.store.outputs_exist(entry.get(\"outputs\", [])):\n",
    "                ctx.available_stages.add(sid)\n",
    "\n",
    "    # ---- dependency resolution ---------------------------------------------\n",
    "    def resolve(self, targets: list, include_dependencies: bool = True) -> list:\n",
    "        unknown = [t for t in targets if t not in self.specs]\n",
    "        if unknown:\n",
    "            raise KeyError(f\"unknown stages {unknown}\")\n",
    "        selected: set = set(targets)\n",
    "        if include_dependencies:\n",
    "            stack = list(targets)\n",
    "            while stack:\n",
    "                sid = stack.pop()\n",
    "                for dep in self.specs[sid].requires:\n",
    "                    if dep not in selected:\n",
    "                        selected.add(dep)\n",
    "                        stack.append(dep)\n",
    "        edges = {sid: [d for d in self.specs[sid].requires + self.specs[sid].optional if d in selected]\n",
    "                 for sid in selected}\n",
    "        order: list = []\n",
    "        remaining = dict(edges)\n",
    "        while remaining:\n",
    "            ready = sorted(s for s, deps in remaining.items() if all(d in order for d in deps))\n",
    "            if not ready:\n",
    "                raise RuntimeError(f\"dependency cycle among {sorted(remaining)}\")\n",
    "            order.append(ready[0])\n",
    "            remaining.pop(ready[0])\n",
    "        return order\n",
    "\n",
    "    def default_targets(self) -> list:\n",
    "        cfg = self.ctx.config\n",
    "        if cfg.get(\"stage_selection\"):\n",
    "            return [str(s).zfill(2) for s in cfg[\"stage_selection\"]]\n",
    "        mode = cfg.get(\"resumed_profile\") or cfg.get(\"run_mode\")\n",
    "        if mode in PROFILE_DEFAULT_STAGES:\n",
    "            return list(PROFILE_DEFAULT_STAGES[mode])\n",
    "        return sorted(self.specs)\n",
    "\n",
    "    # ---- execution ------------------------------------------------------------\n",
    "    def _dep_ok(self, sid: str) -> bool:\n",
    "        entry = self.manifest.get(sid)\n",
    "        return bool(entry and entry.get(\"status\") in AVAILABLE_STATES\n",
    "                    and self.ctx.store.outputs_exist(entry.get(\"outputs\", [])))\n",
    "\n",
    "    def _record(self, sid: str, **fields) -> None:\n",
    "        entry = self.manifest.get(sid, {})\n",
    "        entry.update(fields)\n",
    "        entry[\"stage_id\"] = sid\n",
    "        entry[\"name\"] = self.specs[sid].name\n",
    "        entry[\"updated_at\"] = _dt.datetime.now().isoformat(timespec=\"seconds\")\n",
    "        self.manifest[sid] = entry\n",
    "        atomic_write_json(self.manifest_path, self.manifest)\n",
    "\n",
    "    def run_stage(self, sid: str, force: bool = False) -> str:\n",
    "        spec = self.specs[sid]\n",
    "        cfg = self.ctx.config\n",
    "        logger = self.ctx.logger\n",
    "        enabled, reason = spec.enabled(cfg)\n",
    "        if not enabled:\n",
    "            self._finish(sid, SKIPPED_DISABLED, reason=reason)\n",
    "            return SKIPPED_DISABLED\n",
    "        missing = [d for d in spec.requires if not self._dep_ok(d)]\n",
    "        if missing:\n",
    "            states = {d: self.manifest.get(d, {}).get(\"status\", NOT_STARTED) for d in missing}\n",
    "            self._finish(sid, BLOCKED_DEPENDENCY, reason=f\"required dependencies unavailable: {states}\")\n",
    "            return BLOCKED_DEPENDENCY\n",
    "        optional_ok = [d for d in spec.optional if self._dep_ok(d)]\n",
    "        dep_fps = {d: self.manifest[d].get(\"fingerprint\") for d in spec.requires + optional_ok}\n",
    "        input_fp = stable_hash({\"version\": spec.version, \"config\": self.cfg_hash, \"deps\": dep_fps})\n",
    "        prev = self.manifest.get(sid)\n",
    "        if (not force and not spec.always_run and cfg.get(\"resume\") and not cfg.get(\"overwrite_cache\")\n",
    "                and prev and prev.get(\"status\") in AVAILABLE_STATES and prev.get(\"input_fingerprint\") == input_fp\n",
    "                and self.ctx.store.outputs_exist(prev.get(\"outputs\", []))):\n",
    "            self.ctx.available_stages.add(sid)\n",
    "            self._finish(sid, CACHED, reason=\"validated cached artifacts\", outputs=prev.get(\"outputs\", []),\n",
    "                         fingerprint=prev.get(\"fingerprint\"), input_fingerprint=input_fp)\n",
    "            return CACHED\n",
    "        self._record(sid, status=RUNNING, started_at=_dt.datetime.now().isoformat(timespec=\"seconds\"))\n",
    "        self.ctx.current_stage = sid\n",
    "        self.ctx.available_stages.discard(sid)\n",
    "        timer = StageTimer(f\"stage {sid} {spec.name}\", logger)\n",
    "        try:\n",
    "            with timer:\n",
    "                result = spec.func(self.ctx) or {}\n",
    "        except Exception as exc:\n",
    "            tb = traceback.format_exc()\n",
    "            tb_path = self.ctx.paths.logs / f\"stage_{sid}_traceback.txt\"\n",
    "            tb_path.write_text(tb, encoding=\"utf-8\")\n",
    "            logger.error(\"Stage %s failed: %s (traceback: %s)\", sid, exc, tb_path)\n",
    "            self._finish(sid, FAILED, reason=f\"{type(exc).__name__}: {exc}\", traceback_path=str(tb_path),\n",
    "                         timing=timer.as_dict())\n",
    "            release_memory()\n",
    "            return FAILED\n",
    "        status = result.get(\"status\", COMPLETE)\n",
    "        outputs = list(result.get(\"outputs\", []))\n",
    "        if \"fingerprint_extra\" in result:\n",
    "            fingerprint = stable_hash({\"input\": input_fp, \"extra\": result[\"fingerprint_extra\"]})\n",
    "        else:\n",
    "            # Re-executing a stage rewrites its outputs, so dependants are invalidated.\n",
    "            out_fps = [file_fingerprint(self.ctx.store.path(o)) for o in outputs if self.ctx.store.has(o)]\n",
    "            fingerprint = stable_hash({\"input\": input_fp, \"outputs\": out_fps})\n",
    "        if status == COMPLETE:\n",
    "            self.ctx.available_stages.add(sid)\n",
    "        self._finish(sid, status, reason=result.get(\"reason\", \"\"), outputs=outputs, summary=result.get(\"summary\", {}),\n",
    "                     fingerprint=fingerprint, input_fingerprint=input_fp, timing=timer.as_dict())\n",
    "        release_memory()\n",
    "        return status\n",
    "\n",
    "    def _finish(self, sid: str, status: str, **fields) -> None:\n",
    "        self._record(sid, status=status, **fields)\n",
    "        row = {\"stage_id\": sid, \"name\": self.specs[sid].name, \"status\": status,\n",
    "               \"reason\": fields.get(\"reason\", \"\"), \"elapsed_s\": (fields.get(\"timing\") or {}).get(\"elapsed_s\"),\n",
    "               \"finished_at\": _dt.datetime.now().isoformat(timespec=\"seconds\")}\n",
    "        self.session_rows.append(row)\n",
    "        self.ctx.logger.info(\"Stage %s -> %s %s\", sid, status, fields.get(\"reason\", \"\"))\n",
    "\n",
    "    def run(self, stages: list | None = None, include_dependencies: bool = True, force: tuple = ()) -> pd.DataFrame:\n",
    "        targets = [str(s).zfill(2) for s in (stages or self.default_targets())]\n",
    "        order = self.resolve(targets, include_dependencies)\n",
    "        self.ctx.logger.info(\"Execution order: %s\", order)\n",
    "        for sid in order:\n",
    "            self.run_stage(sid, force=sid in force)\n",
    "        report = pd.DataFrame(self.session_rows)\n",
    "        previous = pd.read_csv(self.report_path) if self.report_path.exists() else pd.DataFrame()\n",
    "        atomic_write_csv(pd.concat([previous, report], ignore_index=True), self.report_path)\n",
    "        return report\n",
    "\n",
    "    def status_table(self) -> pd.DataFrame:\n",
    "        rows = []\n",
    "        for sid, spec in sorted(self.specs.items()):\n",
    "            entry = self.manifest.get(sid, {})\n",
    "            rows.append({\"stage_id\": sid, \"name\": spec.name, \"status\": entry.get(\"status\", NOT_STARTED),\n",
    "                         \"requires\": \",\".join(spec.requires), \"optional\": \",\".join(spec.optional),\n",
    "                         \"reason\": entry.get(\"reason\", \"\"), \"updated_at\": entry.get(\"updated_at\", \"\")})\n",
    "        return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def build_context(user_config: dict | None = None, profile: str | None = None,\n",
    "                  yaml_path: str | Path | None = None) -> RunContext:\n",
    "    \"\"\"Create a run context. Mounts Drive only in an authorised Colab runtime.\"\"\"\n",
    "    requested = (profile or (user_config or {}).get(\"run_mode\") or \"FULL\").upper()\n",
    "    prelim = build_config(user_config, profile=\"FULL\" if requested == \"RESUME\" else requested, yaml_path=yaml_path)\n",
    "    detected = environment.detect_environment()\n",
    "    environment.check_environment_authorisation(prelim, detected)\n",
    "    boot_logger = get_logger(\"wildspeech.bootstrap\")\n",
    "    if detected == \"COLAB\":\n",
    "        environment.mount_drive(prelim, boot_logger)\n",
    "    paths = build_project_tree(prelim, prelim[\"environment\"])\n",
    "    if requested == \"RESUME\":\n",
    "        cfg = build_config(user_config, profile=\"RESUME\", yaml_path=yaml_path,\n",
    "                           last_run_path=paths.configs / prelim[\"last_run_config_name\"])\n",
    "    else:\n",
    "        cfg = prelim\n",
    "    logger = get_logger(\"wildspeech\", paths.logs)\n",
    "    store = ArtifactStore(paths.cache_dir(\"manifests\") / \"artifact_index.json\")\n",
    "    figures = visualization.FigureRegistry(paths.outputs / \"figure_index.csv\", dpi=int(cfg[\"figure_dpi\"]),\n",
    "                                           enabled=bool(cfg[\"save_figures\"]))\n",
    "    save_config(cfg, paths.configs)\n",
    "    environment.set_seeds(int(cfg[\"seed\"]))\n",
    "    return RunContext(cfg, paths, logger, store, figures)\n",
    "\n",
    "\n",
    "def run_pipeline(ctx: RunContext, stages: list | None = None, include_dependencies: bool = True,\n",
    "                 force: tuple = ()) -> pd.DataFrame:\n",
    "    return Pipeline(ctx).run(stages, include_dependencies=include_dependencies, force=force)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-032",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/prosody_features.py\n",
    "\"\"\"Section 10 - prosody, articulation and voice-conversion robustness.\n",
    "\n",
    "All ``p_`` features describe the anonymised (voice-converted) signal. Pitch,\n",
    "formant, jitter, shimmer and harmonicity measures are flagged a priori as\n",
    "POTENTIALLY_VOICE_CONVERSION_SENSITIVE. Nothing here infers speaker identity,\n",
    "age, sex or medical conditions, and no attempt is made to reverse the\n",
    "anonymisation.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from .stats_utils import robust_stats\n",
    "\n",
    "EPS = 1e-12\n",
    "PROSODY_KEYS = [\n",
    "    \"p_voiced_frac\", \"p_f0_median\", \"p_f0_mean\", \"p_f0_std_st\", \"p_f0_range_st\", \"p_f0_slope_st_per_s\",\n",
    "    \"p_f0_transition_var_st\", \"p_f0_jump_frac\", \"p_jitter_local\", \"p_shimmer_local\", \"p_shimmer_db\",\n",
    "    \"p_hnr_db_median\", \"p_f1_median\", \"p_f2_median\", \"p_f3_median\", \"p_f1_std\", \"p_f2_std\",\n",
    "    \"p_f2_transition_rate\", \"p_f2_f1_ratio_median\", \"p_int_mean\", \"p_int_std\", \"p_int_range\", \"p_int_slope\",\n",
    "    \"p_prosody_cv\",\n",
    "]\n",
    "\n",
    "\n",
    "def f0_track(b, cfg: dict) -> tuple[np.ndarray, np.ndarray]:\n",
    "    import librosa\n",
    "\n",
    "    fmin, fmax = float(cfg[\"f0_min_hz\"]), float(cfg[\"f0_max_hz\"])\n",
    "    frame_length = 1024 if b.sr >= 16000 else 512\n",
    "    if len(b.y) < frame_length:\n",
    "        return np.zeros(0), np.zeros(0, bool)\n",
    "    if cfg.get(\"prosody_f0_method\", \"pyin\") == \"pyin\":\n",
    "        f0, voiced, _ = librosa.pyin(b.y, fmin=fmin, fmax=fmax, sr=b.sr, frame_length=frame_length,\n",
    "                                     hop_length=b.hop, center=True)\n",
    "        voiced = np.asarray(voiced, dtype=bool) & np.isfinite(f0)\n",
    "    else:\n",
    "        f0 = librosa.yin(b.y, fmin=fmin, fmax=fmax, sr=b.sr, frame_length=frame_length, hop_length=b.hop, center=True)\n",
    "        T = min(len(f0), len(b.vad_mask))\n",
    "        voiced = np.zeros(len(f0), bool)\n",
    "        voiced[:T] = b.vad_mask[:T]\n",
    "    T = min(len(f0), len(b.vad_mask))\n",
    "    voiced = voiced[:T] & b.vad_mask[:T]\n",
    "    return np.asarray(f0[:T], dtype=float), voiced\n",
    "\n",
    "\n",
    "def _formants(frame: np.ndarray, sr: int) -> tuple:\n",
    "    import librosa\n",
    "\n",
    "    if np.std(frame) == 0:\n",
    "        return (np.nan, np.nan, np.nan)\n",
    "    x = np.append(frame[0], frame[1:] - 0.97 * frame[:-1]) * np.hamming(len(frame))\n",
    "    order = int(2 + sr / 1000)\n",
    "    try:\n",
    "        a = librosa.lpc(x, order=order)\n",
    "    except Exception:\n",
    "        return (np.nan, np.nan, np.nan)\n",
    "    roots = np.roots(a)\n",
    "    roots = roots[np.imag(roots) >= 0.01]\n",
    "    if len(roots) == 0:\n",
    "        return (np.nan, np.nan, np.nan)\n",
    "    freqs = np.angle(roots) * sr / (2 * np.pi)\n",
    "    bws = -0.5 * (sr / (2 * np.pi)) * np.log(np.abs(roots))\n",
    "    good = np.sort(freqs[(freqs > 90) & (bws < 400)])\n",
    "    good = list(good[:3]) + [np.nan] * (3 - min(3, len(good)))\n",
    "    return tuple(good[:3])\n",
    "\n",
    "\n",
    "def prosody_features(b, cfg: dict) -> dict:\n",
    "    out: dict = {k: np.nan for k in PROSODY_KEYS}\n",
    "    f0, voiced = f0_track(b, cfg)\n",
    "    n_speech = int(b.vad_mask.sum())\n",
    "    hop_s = b.hop / b.sr\n",
    "    if n_speech > 0 and len(voiced):\n",
    "        out[\"p_voiced_frac\"] = float(voiced.sum() / n_speech)\n",
    "    sp_db = b.rms_db[b.vad_mask[:len(b.rms_db)]]\n",
    "    if len(sp_db) >= 3:\n",
    "        out[\"p_int_mean\"] = float(sp_db.mean())\n",
    "        out[\"p_int_std\"] = float(sp_db.std(ddof=1))\n",
    "        out[\"p_int_range\"] = float(np.percentile(sp_db, 95) - np.percentile(sp_db, 5))\n",
    "        t = np.flatnonzero(b.vad_mask[:len(b.rms_db)]) * hop_s\n",
    "        out[\"p_int_slope\"] = float(np.polyfit(t, sp_db, 1)[0]) if np.ptp(t) > 0 else np.nan\n",
    "    if voiced.sum() >= 5:\n",
    "        fv = f0[voiced]\n",
    "        st = 12 * np.log2(fv / np.median(fv))\n",
    "        out[\"p_f0_median\"] = float(np.median(fv))\n",
    "        out[\"p_f0_mean\"] = float(fv.mean())\n",
    "        out[\"p_f0_std_st\"] = float(st.std(ddof=1))\n",
    "        out[\"p_f0_range_st\"] = float(np.percentile(st, 95) - np.percentile(st, 5))\n",
    "        tv = np.flatnonzero(voiced) * hop_s\n",
    "        out[\"p_f0_slope_st_per_s\"] = float(np.polyfit(tv, st, 1)[0]) if np.ptp(tv) > 0 else np.nan\n",
    "        idx = np.flatnonzero(voiced)\n",
    "        consecutive = np.diff(idx) == 1\n",
    "        if consecutive.sum() >= 3:\n",
    "            d = np.diff(st)[consecutive]\n",
    "            out[\"p_f0_transition_var_st\"] = float(d.std(ddof=1))\n",
    "            out[\"p_f0_jump_frac\"] = float((np.abs(d) > 2.0).mean())\n",
    "            periods = 1.0 / fv\n",
    "            dp = np.abs(np.diff(periods))[consecutive]\n",
    "            out[\"p_jitter_local\"] = float(dp.mean() / periods.mean())\n",
    "            amps = np.array([np.max(np.abs(b.y[int(i * b.hop):int(i * b.hop + b.win)])) if int(i * b.hop) < len(b.y) else np.nan\n",
    "                             for i in idx])\n",
    "            amps = np.where(amps > 0, amps, np.nan)\n",
    "            da = np.abs(np.diff(amps))[consecutive]\n",
    "            ratio = np.abs(20 * np.log10(amps[1:] / amps[:-1]))[consecutive]\n",
    "            out[\"p_shimmer_local\"] = float(np.nanmean(da) / np.nanmean(amps)) if np.isfinite(amps).sum() > 3 else np.nan\n",
    "            out[\"p_shimmer_db\"] = float(np.nanmean(ratio)) if np.isfinite(ratio).any() else np.nan\n",
    "        hnr = []\n",
    "        rng = np.random.default_rng(0)\n",
    "        sel = idx if len(idx) <= 100 else np.sort(rng.choice(idx, 100, replace=False))\n",
    "        for i in sel:\n",
    "            start = int(i * b.hop)\n",
    "            seg = b.y[start:start + 2 * b.win].astype(float)\n",
    "            lag = int(round(b.sr / f0[i])) if np.isfinite(f0[i]) and f0[i] > 0 else 0\n",
    "            if lag <= 0 or len(seg) <= lag + 8 or np.std(seg) == 0:\n",
    "                continue\n",
    "            seg = seg - seg.mean()\n",
    "            r = float((seg[:-lag] * seg[lag:]).sum() / np.sqrt((seg[:-lag] ** 2).sum() * (seg[lag:] ** 2).sum() + EPS))\n",
    "            if 0 < r < 1:\n",
    "                hnr.append(10 * np.log10(r / (1 - r)))\n",
    "        out[\"p_hnr_db_median\"] = float(np.median(hnr)) if hnr else np.nan\n",
    "        max_frames = int(cfg[\"formant_max_frames\"])\n",
    "        fsel = idx if len(idx) <= max_frames else idx[np.linspace(0, len(idx) - 1, max_frames).astype(int)]\n",
    "        forms = np.array([_formants(b.y[int(i * b.hop):int(i * b.hop) + b.win].astype(float), b.sr)\n",
    "                          for i in fsel if int(i * b.hop) + b.win <= len(b.y)], dtype=float)\n",
    "        if len(forms) >= 3:\n",
    "            out[\"p_f1_median\"], out[\"p_f2_median\"], out[\"p_f3_median\"] = [float(np.nanmedian(forms[:, k])) if np.isfinite(forms[:, k]).any() else np.nan for k in range(3)]\n",
    "            out[\"p_f1_std\"] = float(np.nanstd(forms[:, 0], ddof=1)) if np.isfinite(forms[:, 0]).sum() > 2 else np.nan\n",
    "            out[\"p_f2_std\"] = float(np.nanstd(forms[:, 1], ddof=1)) if np.isfinite(forms[:, 1]).sum() > 2 else np.nan\n",
    "            out[\"p_f2_transition_rate\"] = float(np.nanmean(np.abs(np.diff(forms[:, 1])))) if np.isfinite(forms[:, 1]).sum() > 2 else np.nan\n",
    "            ratio = forms[:, 1] / forms[:, 0]\n",
    "            out[\"p_f2_f1_ratio_median\"] = float(np.nanmedian(ratio)) if np.isfinite(ratio).any() else np.nan\n",
    "        lin = 10 ** (sp_db / 20) if len(sp_db) else np.array([])\n",
    "        cv_f0 = fv.std(ddof=1) / fv.mean() if fv.mean() > 0 else np.nan\n",
    "        cv_int = lin.std(ddof=1) / lin.mean() if len(lin) > 2 and lin.mean() > 0 else np.nan\n",
    "        out[\"p_prosody_cv\"] = float(np.nanmean([cv_f0, cv_int]))\n",
    "    return out\n",
    "\n",
    "\n",
    "def anonymization_sensitivity(ctx, clip_df: pd.DataFrame, feature_cols: list) -> pd.DataFrame:\n",
    "    \"\"\"Classify features as content-related, voice-conversion- or artifact-sensitive.\"\"\"\n",
    "    from .families import feature_family, is_voice_prior\n",
    "    from .stats_utils import icc1, safe_corr\n",
    "\n",
    "    cfg = ctx.config\n",
    "    artifact_cols = [c for c in (\"q_snr_db_approx\", \"q_noise_floor_db\", \"q_eff_bandwidth_hz\", \"s_bg_level_db\",\n",
    "                                 \"q_clip_ratio\") if c in clip_df.columns]\n",
    "    has_correct = \"correct\" in clip_df.columns and clip_df[\"correct\"].notna().sum() > 50\n",
    "    if has_correct:\n",
    "        demeaned_correct = clip_df[\"correct\"] - clip_df.groupby(\"item_key\")[\"correct\"].transform(\"mean\")\n",
    "    rows = []\n",
    "    rng = np.random.default_rng(int(cfg[\"seed\"]))\n",
    "    sample = clip_df if len(clip_df) <= 50000 else clip_df.iloc[rng.choice(len(clip_df), 50000, replace=False)]\n",
    "    for col in feature_cols:\n",
    "        x = pd.to_numeric(sample[col], errors=\"coerce\")\n",
    "        fam = feature_family(col)\n",
    "        item_icc = icc1(x, sample[\"item_key\"]) if \"item_key\" in sample.columns else np.nan\n",
    "        student_icc = icc1(x, sample[\"student_id\"])\n",
    "        art = [abs(safe_corr(x, sample[a], \"spearman\", 30)[0]) for a in artifact_cols if a != col]\n",
    "        art_max = float(np.nanmax(art)) if art and np.isfinite(art).any() else np.nan\n",
    "        corr_r = np.nan\n",
    "        if has_correct:\n",
    "            xd = x - x.groupby(sample[\"item_key\"]).transform(\"mean\")\n",
    "            corr_r = safe_corr(xd, demeaned_correct.loc[sample.index], \"pearson\", 30)[0]\n",
    "        if is_voice_prior(col):\n",
    "            label, reason = \"POTENTIALLY_VOICE_CONVERSION_SENSITIVE\", \"physiological voice measure (a priori)\"\n",
    "        elif fam in {\"QUALITY\", \"BACKGROUND\", \"RECORDING_METADATA\"} or (np.isfinite(art_max) and art_max >= cfg[\"sensitivity_artifact_corr\"]):\n",
    "            label, reason = \"RECORDING_ARTIFACT_SENSITIVE\", f\"max |rho| with artifact indicators={art_max:.2f}\"\n",
    "        elif np.isfinite(student_icc) and student_icc > 0.5 and (not np.isfinite(item_icc) or item_icc < 0.05):\n",
    "            label, reason = \"POTENTIALLY_VOICE_CONVERSION_SENSITIVE\", \"high speaker consistency, little item dependence\"\n",
    "        elif (np.isfinite(item_icc) and item_icc >= cfg[\"sensitivity_item_icc\"]) or (\n",
    "                np.isfinite(corr_r) and abs(corr_r) >= cfg[\"sensitivity_correctness_r\"]):\n",
    "            label, reason = \"LIKELY_CONTENT_RELATED\", f\"item ICC={item_icc:.2f}, within-item correctness r={corr_r:.2f}\"\n",
    "        else:\n",
    "            label, reason = \"UNDETERMINED\", \"no decisive evidence\"\n",
    "        rows.append({\"feature\": col, \"family\": fam, \"item_icc\": item_icc, \"student_icc\": student_icc,\n",
    "                     \"artifact_max_abs_rho\": art_max, \"within_item_correctness_r\": corr_r,\n",
    "                     \"sensitivity\": label, \"reason\": reason})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def stage_prosody(ctx) -> dict:\n",
    "    from . import data_access as da\n",
    "    from . import visualization as viz\n",
    "    from .family_analysis import analyze_family\n",
    "\n",
    "    outputs: list = []\n",
    "    summary: dict = {}\n",
    "    if ctx.config.get(\"enable_prosody\"):\n",
    "        result = analyze_family(ctx, family=\"PROSODY\", prefixes=(\"p_\",), split_by_correctness=False, control_quality=True)\n",
    "        outputs += result[\"outputs\"]\n",
    "        summary.update(result[\"summary\"])\n",
    "    clips = da.clip_table(ctx, \"train\")\n",
    "    feats = [c for c in clips.columns if c.startswith((\"q_\", \"t_\", \"s_\", \"m_\", \"w_\", \"p_\", \"ph_\"))\n",
    "             and pd.api.types.is_numeric_dtype(clips[c])]\n",
    "    report = anonymization_sensitivity(ctx, clips, feats)\n",
    "    ctx.save_df(report, \"anonymization_sensitivity\", also_csv=True)\n",
    "    outputs.append(\"anonymization_sensitivity\")\n",
    "    counts = report.groupby([\"family\", \"sensitivity\"]).size().unstack(fill_value=0)\n",
    "    fig, axes = viz.new_figure(1, 1, (9, 4.5))\n",
    "    counts.plot(kind=\"bar\", stacked=True, ax=axes[0, 0])\n",
    "    viz.finalize_axis(axes[0, 0], \"Anonymisation sensitivity by feature family\", \"family\", \"features\", int(len(report)))\n",
    "    ctx.figure(fig, \"anonymization_sensitivity\", \"Anonymisation sensitivity report\",\n",
    "               \"Which features remain useful after voice conversion?\", \"anonymization_sensitivity\", int(len(report)),\n",
    "               \"; \".join(f\"{k}={v}\" for k, v in report[\"sensitivity\"].value_counts().items()))\n",
    "    summary[\"sensitivity_counts\"] = report[\"sensitivity\"].value_counts().to_dict()\n",
    "    return {\"outputs\": outputs, \"summary\": summary}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-033",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/reporting.py\n",
    "\"\"\"Section 28 - final automated scientific report.\n",
    "\n",
    "All conclusions are generated programmatically from executed artifacts.\n",
    "Skipped or failed modules are reported as such; no findings are fabricated.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import html\n",
    "import os\n",
    "import shutil\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from .config import config_hash\n",
    "from .io_utils import atomic_write_csv, atomic_write_json, atomic_write_parquet, atomic_write_text, read_json\n",
    "\n",
    "QUESTIONS = [\n",
    "    \"What is the actual structure of the competition data?\",\n",
    "    \"How much variation is explained by conventional screening?\",\n",
    "    \"Which tasks carry the strongest predictive information?\",\n",
    "    \"Which items are the most discriminative?\",\n",
    "    \"Does adaptive testing behavior provide additional signal?\",\n",
    "    \"Which acoustic feature families contain robust information?\",\n",
    "    \"Which features predict outcomes after screening adjustment?\",\n",
    "    \"Which discovered patterns generalize across schools?\",\n",
    "    \"Which features appear sensitive to technical confounds?\",\n",
    "    \"Does phonetic processing provide additional value?\",\n",
    "    \"Are there reproducible student phenotypes?\",\n",
    "    \"Which student profiles are difficult to predict?\",\n",
    "    \"Which modalities recover baseline failures?\",\n",
    "    \"Which experimental literacy indices are worth retaining?\",\n",
    "    \"Which feature families are redundant or unstable?\",\n",
    "    \"What should be prioritized in P02?\",\n",
    "    \"Which hypotheses remain untested?\",\n",
    "    \"What are the limitations of the current evidence?\",\n",
    "]\n",
    "\n",
    "\n",
    "class Report:\n",
    "    def __init__(self, ctx):\n",
    "        self.ctx = ctx\n",
    "        self.manifest = read_json(ctx.paths.outputs / \"00_environment\" / \"stage_manifest.json\", default={}) or {}\n",
    "\n",
    "    def status(self, sid: str) -> str:\n",
    "        return self.manifest.get(sid, {}).get(\"status\", \"NOT_STARTED\")\n",
    "\n",
    "    def ok(self, sid: str) -> bool:\n",
    "        return self.ctx.stage_available(sid)\n",
    "\n",
    "    def df(self, name: str, sid: str):\n",
    "        return self.ctx.load_df(name, required=False) if self.ok(sid) else None\n",
    "\n",
    "    def js(self, name: str, sid: str):\n",
    "        return self.ctx.load_json(name, required=False) if self.ok(sid) else None\n",
    "\n",
    "    def missing(self, *sids) -> str:\n",
    "        return \"Not answered: \" + \", \".join(f\"Section {s} status={self.status(s)}\" for s in sids if not self.ok(s)) + \".\"\n",
    "\n",
    "\n",
    "def _fmt(x, nd=3):\n",
    "    try:\n",
    "        return f\"{float(x):.{nd}f}\" if x is not None and np.isfinite(float(x)) else \"NA\"\n",
    "    except (TypeError, ValueError):\n",
    "        return str(x)\n",
    "\n",
    "\n",
    "def answers(R: Report) -> list:\n",
    "    cfg = R.ctx.config\n",
    "    out = []\n",
    "    q = R.js(\"data_quality_report\", \"01\")\n",
    "    out.append(f\"{q['n_students']} students and {q['n_clips']} clips; task families {q['task_families']}; {q['n_items']} items \"\n",
    "               f\"(key source: {q['item_key_source']}); {q['n_schools']} schools; {q['n_instruments']} instruments; \"\n",
    "               f\"{q['clips_missing_audio']} clips without matched audio.\" if q else R.missing(\"01\"))\n",
    "    b = R.df(\"baseline_results\", \"14\")\n",
    "    if b is not None and \"pooled_r2\" in b:\n",
    "        r = b[(b[\"model_id\"] == cfg[\"primary_baseline\"]) & (b[\"scheme\"] == cfg[\"primary_cv_scheme\"])]\n",
    "        best = b[b[\"scheme\"] == cfg[\"primary_cv_scheme\"]].sort_values(\"pooled_r2\", ascending=False).head(1)\n",
    "        out.append(f\"Primary baseline {cfg['primary_baseline']}: pooled OOF R²={_fmt(r['pooled_r2'].iloc[0])} \"\n",
    "                   f\"[{_fmt(r['pooled_r2_ci_lower'].iloc[0])}, {_fmt(r['pooled_r2_ci_upper'].iloc[0])}], mean fold R²={_fmt(r['mean_fold_r2'].iloc[0])}; \"\n",
    "                   f\"best screening-only model {best['model_id'].iloc[0]} (R²={_fmt(best['pooled_r2'].iloc[0])}).\" if len(r) else \"Primary baseline not available.\")\n",
    "    else:\n",
    "        out.append(R.missing(\"14\"))\n",
    "    rel = R.df(\"task_relevance_matrix\", \"12\")\n",
    "    if rel is not None and len(rel):\n",
    "        cols = [c for c in (\"screening_signal\", \"correctness_signal\", \"residual_signal\") if c in rel]\n",
    "        out.append(\"; \".join(f\"{r['task_family']}: \" + \", \".join(f\"{c}={_fmt(r[c])}\" for c in cols) for _, r in rel.iterrows()))\n",
    "    else:\n",
    "        out.append(R.missing(\"12\"))\n",
    "    it = R.df(\"item_registry\", \"04\")\n",
    "    if it is not None and \"point_biserial_rest\" in it:\n",
    "        top = it.sort_values(\"point_biserial_rest\", ascending=False).head(5)\n",
    "        out.append(\"Most discriminative items (rest-score point-biserial): \" + \", \".join(f\"{r['item_key']} ({_fmt(r['point_biserial_rest'], 2)})\" for _, r in top.iterrows()))\n",
    "    else:\n",
    "        out.append(R.missing(\"04\"))\n",
    "    ov = R.js(\"order_validity\", \"05\")\n",
    "    abl = R.df(\"ablation_results\", \"20\")\n",
    "\n",
    "    def abl_row(exp, scheme=\"CV_A_REPEATED_STUDENT_KFOLD\"):\n",
    "        if abl is None:\n",
    "            return None\n",
    "        r = abl[(abl[\"experiment\"] == exp) & (abl[\"scheme\"] == scheme) & (abl[\"model\"] == cfg[\"ablation_primary_model\"])]\n",
    "        return r.iloc[0] if len(r) else None\n",
    "    if ov is not None and not ov.get(\"valid\"):\n",
    "        out.append(f\"Sequential analysis disabled: {ov.get('reason')}.\")\n",
    "    else:\n",
    "        a4 = abl_row(\"A04_THETA_ADAPTIVE_BEHAVIOR\")\n",
    "        out.append(f\"A04 vs screening: delta R²={_fmt(a4['delta_r2_vs_screening'], 4)} [{_fmt(a4['delta_r2_vs_screening_ci_lower'], 4)}, \"\n",
    "                   f\"{_fmt(a4['delta_r2_vs_screening_ci_upper'], 4)}].\" if a4 is not None else R.missing(\"05\", \"20\"))\n",
    "    reg = R.df(\"feature_registry\", \"24\")\n",
    "    if reg is not None:\n",
    "        fam = reg[reg[\"selection_status\"] == \"ROBUST_SIGNAL\"][\"feature_family\"].value_counts()\n",
    "        out.append(\"Robust-signal features per family: \" + (\", \".join(f\"{k}={v}\" for k, v in fam.items()) if len(fam) else \"none met all robustness criteria\") + \".\")\n",
    "        top = reg[reg[\"selection_status\"].isin([\"ROBUST_SIGNAL\", \"PROMISING_SIGNAL\"])].assign(a=lambda d: d[\"residual_spearman\"].abs()).sort_values(\"a\", ascending=False).head(8)\n",
    "        out.append(\"Top screening-adjusted features: \" + (\", \".join(f\"{r['feature_name']} (rho_res={_fmt(r['residual_spearman'])}, {r['selection_status']})\" for _, r in top.iterrows()) or \"none\") + \".\")\n",
    "    else:\n",
    "        out += [R.missing(\"24\"), R.missing(\"24\")]\n",
    "    if abl is not None:\n",
    "        b13 = abl_row(\"A13_TABULAR_MULTIMODAL\", \"CV_B_SCHOOL_GROUP_KFOLD\")\n",
    "        sc = R.df(\"sign_consistency\", \"17\")\n",
    "        txt = f\"School-grouped multimodal gain vs tabular: {_fmt(b13['delta_r2_vs_full_tabular'], 4)}\" if b13 is not None else \"School-grouped ablation unavailable\"\n",
    "        if sc is not None and len(sc):\n",
    "            txt += f\"; median school sign consistency of top speech features {_fmt(sc['school_sign_consistency'].median(), 2)}\"\n",
    "        out.append(txt + \".\")\n",
    "    else:\n",
    "        out.append(R.missing(\"20\"))\n",
    "    nc = R.df(\"negative_controls\", \"17\")\n",
    "    if nc is not None and \"pooled_r2\" in nc:\n",
    "        sub = nc[nc[\"control\"].str.startswith(\"NC\") & (nc.get(\"variant\") == \"alone\")]\n",
    "        out.append(\"Negative controls (alone, pooled R²): \" + \", \".join(f\"{r['control']}={_fmt(r['pooled_r2'])}\" for _, r in sub.iterrows()) + \".\"\n",
    "                   + (f\" Confounded-signal features: {int((reg['selection_status'] == 'CONFOUNDED_SIGNAL').sum())}.\" if reg is not None else \"\"))\n",
    "    else:\n",
    "        out.append(R.missing(\"17\"))\n",
    "    a11 = abl_row(\"A11_TABULAR_PHONETIC\") if abl is not None else None\n",
    "    asr = R.js(\"asr_status\", \"11\")\n",
    "    out.append(f\"A11 phonetic gain vs tabular: {_fmt(a11['delta_r2_vs_full_tabular'], 4)}.\" if a11 is not None else\n",
    "               f\"Phonetic ASR not evaluated (ASR status: {(asr or {}).get('status', R.status('11'))}).\")\n",
    "    info = R.js(\"cluster_space_info\", \"15\")\n",
    "    out.append(\"; \".join(f\"{k}: {v.get('method')} k={v.get('k')} stable={v.get('stable')}\" for k, v in info.items() if v.get(\"method\")) if info else R.missing(\"15\"))\n",
    "    fs = R.df(\"failure_summary\", \"22\")\n",
    "    if fs is not None:\n",
    "        top = fs.sort_values(\"mean_abs_baseline_error\", ascending=False).head(4)\n",
    "        out.append(\"Hardest phenotypes by mean |baseline error|: \" + \", \".join(f\"{r['phenotype']} ({_fmt(r['mean_abs_baseline_error'])}, n={r['n']})\" for _, r in top.iterrows()) + \".\")\n",
    "        rec = fs.sort_values(\"mean_error_reduction\", ascending=False).head(3)\n",
    "        out.append(\"Largest multimodal error reductions: \" + \", \".join(f\"{r['phenotype']} ({_fmt(r['mean_error_reduction'])})\" for _, r in rec.iterrows()) + \".\")\n",
    "    else:\n",
    "        out += [R.missing(\"22\"), R.missing(\"22\")]\n",
    "    li = R.df(\"literacy_index_report\", \"19\")\n",
    "    out.append((\"Retained indices: \" + (\", \".join(li.loc[li.get(\"retention\") == \"RETAIN\", \"index\"]) or \"none\") + \".\") if li is not None and \"retention\" in li else R.missing(\"19\"))\n",
    "    if reg is not None:\n",
    "        red = reg[reg[\"selection_status\"].isin([\"REDUNDANT_SIGNAL\", \"UNSTABLE_SIGNAL\"])][\"feature_family\"].value_counts()\n",
    "        out.append(\"Redundant/unstable features by family: \" + (\", \".join(f\"{k}={v}\" for k, v in red.items()) or \"none\") + \".\")\n",
    "    else:\n",
    "        out.append(R.missing(\"24\"))\n",
    "    hyp = R.df(\"hypothesis_registry\", \"25\")\n",
    "    prio = []\n",
    "    if hyp is not None:\n",
    "        prio = hyp[hyp[\"support_status\"].isin([\"SUPPORTED\", \"PARTIALLY_SUPPORTED\"])][\"research_question\"].tolist()\n",
    "    if reg is not None:\n",
    "        fams = reg[reg[\"selection_status\"] == \"ROBUST_SIGNAL\"][\"feature_family\"].value_counts().head(3).index.tolist()\n",
    "        prio.append(f\"Feature engineering for families with robust signals: {fams or 'none yet'}\")\n",
    "    out.append(\"; \".join(prio) + \".\" if prio else \"No supported findings yet; prioritise enabling skipped modalities and confirmation.\")\n",
    "    out.append(\", \".join(hyp.loc[hyp[\"support_status\"] == \"NOT_TESTED\", \"hypothesis_id\"]) or \"none\" if hyp is not None else R.missing(\"25\"))\n",
    "    lim = [\"observational associations only (no causal claims)\", \"voice conversion alters physiological voice measures\",\n",
    "           \"VAD is not speaker identification; other voices may be present\", \"ASR disagreement is an uncertain proxy\",\n",
    "           \"feature-level screening has selection-induced optimism; rely on nested CV deltas\"]\n",
    "    if not cfg.get(\"official_metric_verified\"):\n",
    "        lim.append(f\"official metric assumed to be '{cfg['official_metric']}' (unverified)\")\n",
    "    failed = [s for s, e in R.manifest.items() if e.get(\"status\") in {\"FAILED\", \"BLOCKED_DEPENDENCY\", \"SKIPPED_DISABLED\"}]\n",
    "    if failed:\n",
    "        lim.append(f\"stages not completed: {sorted(failed)}\")\n",
    "    out.append(\"; \".join(lim) + \".\")\n",
    "    return out\n",
    "\n",
    "\n",
    "def _copy_or_status(R: Report, name: str, sid: str, path, kind: str = \"csv\") -> None:\n",
    "    df = R.df(name, sid)\n",
    "    if df is None:\n",
    "        df = pd.DataFrame([{\"status\": f\"NOT_AVAILABLE: Section {sid} status={R.status(sid)}\"}])\n",
    "    if kind == \"csv\":\n",
    "        atomic_write_csv(df, path)\n",
    "    else:\n",
    "        atomic_write_parquet(df, path)\n",
    "\n",
    "\n",
    "def stage_final_report(ctx) -> dict:\n",
    "    R = Report(ctx)\n",
    "    out_dir = ctx.out_dir()\n",
    "    ans = answers(R)\n",
    "    q = R.js(\"data_quality_report\", \"01\")\n",
    "    atomic_write_json(out_dir / \"P01_DATA_QUALITY_REPORT.json\", q or {\"status\": f\"NOT_AVAILABLE: Section 01 status={R.status('01')}\"})\n",
    "    _copy_or_status(R, \"feature_registry\", \"24\", out_dir / \"P01_FEATURE_DISCOVERY_REPORT.csv\")\n",
    "    _copy_or_status(R, \"hypothesis_registry\", \"25\", out_dir / \"P01_HYPOTHESIS_REGISTRY.csv\")\n",
    "    parts = []\n",
    "    b = R.df(\"baseline_results\", \"14\")\n",
    "    if b is not None:\n",
    "        parts.append(b.assign(source=\"baseline_screening\"))\n",
    "    rl = R.df(\"residual_learning_results\", \"21\")\n",
    "    if rl is not None:\n",
    "        parts.append(rl.rename(columns={\"approach\": \"model_id\"}).assign(source=\"residual_learning\"))\n",
    "    atomic_write_csv(pd.concat(parts, ignore_index=True) if parts else pd.DataFrame([{\"status\": \"NOT_AVAILABLE\"}]),\n",
    "                     out_dir / \"P01_MODEL_COMPARISON.csv\")\n",
    "    _copy_or_status(R, \"ablation_results\", \"20\", out_dir / \"P01_ABLATION_RESULTS.csv\")\n",
    "    nc = R.df(\"negative_controls\", \"17\")\n",
    "    cm = R.df(\"confound_matrix\", \"17\")\n",
    "    conf = pd.concat([nc.assign(section=\"negative_controls\"), cm.assign(section=\"confound_matrix\")], ignore_index=True) \\\n",
    "        if nc is not None and cm is not None else pd.DataFrame([{\"status\": f\"NOT_AVAILABLE: Section 17 status={R.status('17')}\"}])\n",
    "    atomic_write_csv(conf, out_dir / \"P01_CONFOUND_REPORT.csv\")\n",
    "    _copy_or_status(R, \"failure_registry\", \"22\", out_dir / \"P01_FAILURE_REGISTRY.parquet\", kind=\"parquet\")\n",
    "    status_rows = [{\"stage\": s, \"name\": e.get(\"name\"), \"status\": e.get(\"status\"), \"reason\": e.get(\"reason\", \"\")}\n",
    "                   for s, e in sorted(R.manifest.items())]\n",
    "    md = [\"# WildSpeech P01 - Executive summary\", \"\",\n",
    "          f\"Configuration hash: `{config_hash(ctx.config)}` | profile: {ctx.config.get('run_mode')}\", \"\",\n",
    "          \"All statements below are generated from executed artifacts. Skipped or failed sections are stated explicitly.\", \"\"]\n",
    "    for i, (qq, a) in enumerate(zip(QUESTIONS, ans), 1):\n",
    "        md += [f\"**{i}. {qq}**\", \"\", a, \"\"]\n",
    "    md += [\"## Stage status\", \"\", \"| stage | name | status | reason |\", \"|---|---|---|---|\"]\n",
    "    md += [f\"| {r['stage']} | {r['name']} | {r['status']} | {str(r['reason'])[:120]} |\" for r in status_rows]\n",
    "    atomic_write_text(out_dir / \"P01_EXECUTIVE_SUMMARY.md\", \"\\n\".join(md))\n",
    "    hyp = R.df(\"hypothesis_registry\", \"25\")\n",
    "    nxt = [\"# P01 next-step recommendations\", \"\"]\n",
    "    if hyp is not None:\n",
    "        for _, r in hyp.iterrows():\n",
    "            nxt.append(f\"- **{r['hypothesis_id']}** ({r['support_status']}): {r['research_question']} -> {r['recommended_next_step']}\")\n",
    "    else:\n",
    "        nxt.append(f\"- Hypothesis registry unavailable (Section 25 status={R.status('25')}).\")\n",
    "    nxt += [\"\", f\"- Priorities: {ans[15]}\"]\n",
    "    atomic_write_text(out_dir / \"P01_NEXT_STEP_RECOMMENDATIONS.md\", \"\\n\".join(nxt))\n",
    "    outputs = []\n",
    "    if ctx.config.get(\"save_html_report\", True):\n",
    "        figs = ctx.figures.index\n",
    "        h = [\"<html><head><meta charset='utf-8'><title>WildSpeech P01 scientific report</title><style>body{font-family:sans-serif;max-width:1100px;margin:auto}\"\n",
    "             \"table{border-collapse:collapse;font-size:12px}td,th{border:1px solid #ccc;padding:3px}img{max-width:100%}</style></head><body>\",\n",
    "             \"<h1>WildSpeech P01 - Literacy signal discovery report</h1><p>Local, self-contained report generated from execution artifacts.</p>\"]\n",
    "        for i, (qq, a) in enumerate(zip(QUESTIONS, ans), 1):\n",
    "            h.append(f\"<h3>{i}. {html.escape(qq)}</h3><p>{html.escape(a)}</p>\")\n",
    "        h.append(\"<h2>Stage status</h2>\" + pd.DataFrame(status_rows).to_html(index=False, escape=True))\n",
    "        for name, sid, title in ((\"baseline_results\", \"14\", \"Screening baselines\"), (\"ablation_results\", \"20\", \"Ablation\"),\n",
    "                                 (\"hypothesis_registry\", \"25\", \"Hypotheses\"), (\"negative_controls\", \"17\", \"Negative controls\")):\n",
    "            d = R.df(name, sid)\n",
    "            if d is not None:\n",
    "                h.append(f\"<h2>{title}</h2>\" + d.head(60).to_html(index=False, float_format=lambda v: f\"{v:.4f}\"))\n",
    "        h.append(f\"<h2>Figures ({len(figs)})</h2>\")\n",
    "        for _, r in figs.iterrows():\n",
    "            try:\n",
    "                rel = os.path.relpath(str(r[\"filename\"]), str(out_dir))\n",
    "            except ValueError:\n",
    "                rel = str(r[\"filename\"])\n",
    "            h.append(f\"<h4>{html.escape(str(r['title']))}</h4><p>{html.escape(str(r['description']))} (n={html.escape(str(r['sample_size']))})</p>\"\n",
    "                     f\"<img src='{html.escape(rel)}'>\")\n",
    "        h.append(\"</body></html>\")\n",
    "        atomic_write_text(out_dir / \"P01_SCIENTIFIC_REPORT.html\", \"\\n\".join(h))\n",
    "        outputs.append(\"P01_SCIENTIFIC_REPORT.html\")\n",
    "    for f in [\"P01_EXECUTIVE_SUMMARY.md\", \"P01_DATA_QUALITY_REPORT.json\", \"P01_FEATURE_DISCOVERY_REPORT.csv\",\n",
    "              \"P01_HYPOTHESIS_REGISTRY.csv\", \"P01_MODEL_COMPARISON.csv\", \"P01_ABLATION_RESULTS.csv\",\n",
    "              \"P01_CONFOUND_REPORT.csv\", \"P01_FAILURE_REGISTRY.parquet\", \"P01_NEXT_STEP_RECOMMENDATIONS.md\"] + outputs:\n",
    "        ctx.store.register(f, out_dir / f, ctx.current_stage, \"report\")\n",
    "        shutil.copy2(out_dir / f, ctx.paths.reports / f)\n",
    "    names = [\"P01_EXECUTIVE_SUMMARY.md\", \"P01_DATA_QUALITY_REPORT.json\", \"P01_FEATURE_DISCOVERY_REPORT.csv\",\n",
    "             \"P01_HYPOTHESIS_REGISTRY.csv\", \"P01_MODEL_COMPARISON.csv\", \"P01_ABLATION_RESULTS.csv\", \"P01_CONFOUND_REPORT.csv\",\n",
    "             \"P01_FAILURE_REGISTRY.parquet\", \"P01_NEXT_STEP_RECOMMENDATIONS.md\"] + outputs\n",
    "    return {\"outputs\": names, \"summary\": {\"n_answered\": sum(not a.startswith(\"Not answered\") for a in ans)}}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-034",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/residual_discovery.py\n",
    "\"\"\"Section 16 - residual literacy signal discovery (central scientific module).\n",
    "\n",
    "residual = observed_outcome - oof_screening_prediction (Section 14).\n",
    "\n",
    "All associations are observational; nothing here is a causal effect. Primary\n",
    "analyses use continuous residuals. Exploratory discoveries are confirmed on\n",
    "held-out student halves (features selected on one half, evaluated on the\n",
    "other) rather than on the observations used for selection.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .families import feature_family, modeling_columns\n",
    "from .stats_utils import bh_fdr, bootstrap_ci, cluster_robust_ols, partial_corr, permutation_pvalue, safe_corr, smd, spearman_stat\n",
    "\n",
    "DISCOVERY_FAMILIES = [\"CORRECTNESS\", \"ITEM_DIFFICULTY\", \"ADAPTIVE\", \"LINGUISTIC\", \"TEMPORAL\", \"SPECTRAL\", \"MFCC\", \"WAVELETS\",\n",
    "                      \"PROSODY\", \"PHONETIC\", \"ITEM_ADJUSTED_AUDIO\", \"COMPLEXITY_SENSITIVITY\", \"CORRECTNESS_CONTRAST\",\n",
    "                      \"CROSS_TASK\", \"EMBEDDINGS\", \"QUALITY\", \"BACKGROUND\", \"RECORDING_METADATA\"]\n",
    "\n",
    "\n",
    "def candidate_features(S: pd.DataFrame, max_missing: float = 0.7) -> list:\n",
    "    cols = [c for c in S.columns if feature_family(c) in DISCOVERY_FAMILIES and pd.api.types.is_numeric_dtype(S[c])]\n",
    "    cols = [c for c in cols if not c.endswith((\"_reliable\", \"_n\", \"_n_min\", \"_se\")) or c.startswith(\"meta_\")]\n",
    "    keep = []\n",
    "    for c in cols:\n",
    "        s = S[c]\n",
    "        if s.isna().mean() <= max_missing and s.nunique(dropna=True) > 3:\n",
    "            keep.append(c)\n",
    "    return keep\n",
    "\n",
    "\n",
    "def _z(s: pd.Series) -> pd.Series:\n",
    "    sd = s.std()\n",
    "    return (s - s.mean()) / sd if sd and np.isfinite(sd) and sd > 0 else s * np.nan\n",
    "\n",
    "\n",
    "def association_screen(D: pd.DataFrame, feats: list, theta: list, cfg: dict) -> pd.DataFrame:\n",
    "    min_n = int(cfg[\"min_n_correlation\"])\n",
    "    schools = D[\"school_id\"] if \"school_id\" in D.columns and D[\"school_id\"].notna().all() else None\n",
    "    inst = pd.get_dummies(D[\"instrument\"].astype(str), prefix=\"inst\", drop_first=True, dtype=float) \\\n",
    "        if \"instrument\" in D.columns and D[\"instrument\"].nunique() > 1 else pd.DataFrame(index=D.index)\n",
    "    sch_fe = pd.get_dummies(D[\"school_id\"].astype(str), prefix=\"sch\", drop_first=True, dtype=float) \\\n",
    "        if schools is not None and 2 <= D[\"school_id\"].nunique() <= int(cfg[\"max_schools_for_loso\"]) else None\n",
    "    exposure = [c for c in (\"l_n_phonemes__mean\", \"l_n_chars__mean\", \"meta_n_clips\") if c in D.columns]\n",
    "    rows = []\n",
    "    for f in feats:\n",
    "        x = _z(D[f])\n",
    "        r = {\"feature\": f, \"family\": feature_family(f), \"n\": int(x.notna().sum())}\n",
    "        r[\"target_spearman\"], r[\"target_p\"], _ = safe_corr(x, D[\"target\"], \"spearman\", min_n)\n",
    "        r[\"target_pearson\"] = safe_corr(x, D[\"target\"], \"pearson\", min_n)[0]\n",
    "        r[\"residual_spearman\"], r[\"residual_p\"], _ = safe_corr(x, D[\"residual\"], \"spearman\", min_n)\n",
    "        r[\"residual_pearson\"], r[\"residual_pearson_p\"], _ = safe_corr(x, D[\"residual\"], \"pearson\", min_n)\n",
    "        if theta:\n",
    "            r[\"partial_r_target_given_theta\"], r[\"partial_p\"], _ = partial_corr(x, D[\"target\"], D[theta], \"pearson\", min_n)\n",
    "            reg = cluster_robust_ols(D[\"target\"], pd.concat([x.rename(\"x\"), D[theta]], axis=1), schools)\n",
    "            row = reg[reg[\"term\"] == \"x\"].iloc[0]\n",
    "            r[\"screening_adjusted_coef\"], r[\"screening_adjusted_se\"], r[\"screening_adjusted_p\"] = row[\"coef\"], row[\"se\"], row[\"p\"]\n",
    "        for label, ctrl in ((\"item_adjusted\", D[exposure] if exposure else None),\n",
    "                            (\"correctness_adjusted\", D[[\"acc_all\"]] if \"acc_all\" in D.columns else None),\n",
    "                            (\"instrument_adjusted\", inst if inst.shape[1] else None),\n",
    "                            (\"school_fe_adjusted\", sch_fe)):\n",
    "            if ctrl is None:\n",
    "                continue\n",
    "            reg = cluster_robust_ols(D[\"residual\"], pd.concat([x.rename(\"x\"), ctrl], axis=1), schools)\n",
    "            row = reg[reg[\"term\"] == \"x\"].iloc[0]\n",
    "            r[f\"{label}_coef\"], r[f\"{label}_p\"] = row[\"coef\"], row[\"p\"]\n",
    "        rows.append(r)\n",
    "    out = pd.DataFrame(rows)\n",
    "    for p in [c for c in out.columns if c.endswith(\"_p\")]:\n",
    "        out[p[:-2] + \"_q\"] = bh_fdr(out[p])\n",
    "    return out\n",
    "\n",
    "\n",
    "def held_out_replication(D: pd.DataFrame, feats: list, cfg: dict) -> pd.DataFrame:\n",
    "    rng = np.random.default_rng(int(cfg[\"seed\"]))\n",
    "    top_k = int(cfg[\"discovery_top_k\"])\n",
    "    groups = D[\"school_id\"] if \"school_id\" in D.columns and D[\"school_id\"].nunique() >= 4 else None\n",
    "    tallies = {f: {\"selected\": 0, \"replicated\": 0, \"rho_heldout\": []} for f in feats}\n",
    "    for rep in range(int(cfg[\"discovery_split_repeats\"])):\n",
    "        if groups is not None:\n",
    "            schools = groups.unique()\n",
    "            half = set(rng.choice(schools, len(schools) // 2, replace=False))\n",
    "            a = D.index[groups.isin(half)]\n",
    "        else:\n",
    "            a = D.index[rng.permutation(len(D))[: len(D) // 2]]\n",
    "        b = D.index.difference(a)\n",
    "        rho_a = {f: spearman_stat(D.loc[a, f], D.loc[a, \"residual\"]) for f in feats}\n",
    "        ranked = sorted((f for f in feats if np.isfinite(rho_a[f])), key=lambda f: -abs(rho_a[f]))[:top_k]\n",
    "        for f in ranked:\n",
    "            rb, pb, _ = safe_corr(D.loc[b, f], D.loc[b, \"residual\"], \"spearman\", 10)\n",
    "            tallies[f][\"selected\"] += 1\n",
    "            tallies[f][\"rho_heldout\"].append(rb)\n",
    "            if np.isfinite(rb) and np.sign(rb) == np.sign(rho_a[f]) and pb < 0.05:\n",
    "                tallies[f][\"replicated\"] += 1\n",
    "    rows = []\n",
    "    for f, t in tallies.items():\n",
    "        if t[\"selected\"]:\n",
    "            rows.append({\"feature\": f, \"family\": feature_family(f), \"times_selected\": t[\"selected\"],\n",
    "                         \"times_replicated\": t[\"replicated\"], \"replication_rate\": t[\"replicated\"] / t[\"selected\"],\n",
    "                         \"median_heldout_rho\": float(np.nanmedian(t[\"rho_heldout\"]))})\n",
    "    return pd.DataFrame(rows).sort_values(\"replication_rate\", ascending=False) if rows else pd.DataFrame(\n",
    "        columns=[\"feature\", \"family\", \"times_selected\", \"times_replicated\", \"replication_rate\", \"median_heldout_rho\"])\n",
    "\n",
    "\n",
    "def greedy_match(treated: pd.DataFrame, control: pd.DataFrame, caliper: float, exact: str | None) -> list:\n",
    "    pairs = []\n",
    "    used: set = set()\n",
    "    for tid, trow in treated.iterrows():\n",
    "        cand = control if exact is None else control[control[exact] == trow[exact]]\n",
    "        cand = cand.drop(index=[c for c in cand.index if c in used], errors=\"ignore\")\n",
    "        if cand.empty:\n",
    "            continue\n",
    "        num = cand.drop(columns=[exact] if exact else []).to_numpy(dtype=float)\n",
    "        t = trow.drop(labels=[exact] if exact else []).to_numpy(dtype=float)\n",
    "        d = np.sqrt(np.nanmean((num - t) ** 2, axis=1))\n",
    "        j = int(np.nanargmin(d))\n",
    "        if d[j] <= caliper:\n",
    "            pairs.append((tid, cand.index[j], float(d[j])))\n",
    "            used.add(cand.index[j])\n",
    "    return pairs\n",
    "\n",
    "\n",
    "def matched_analysis(D: pd.DataFrame, theta: list, feats: list, cfg: dict) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:\n",
    "    covs = theta + [c for c in (\"meta_n_clips\", \"acc_all\", \"q_snr_db_approx__mean\", \"q_duration_s__mean\") if c in D.columns]\n",
    "    exact = \"instrument\" if \"instrument\" in D.columns and D[\"instrument\"].nunique() > 1 else None\n",
    "    Z = D[covs].apply(_z).fillna(0.0)\n",
    "    if exact:\n",
    "        Z[exact] = D[exact].astype(str)\n",
    "    treated = Z[D[\"residual_group\"] == \"POSITIVE_RESIDUAL\"]\n",
    "    control = Z[D[\"residual_group\"] == \"NEGATIVE_RESIDUAL\"]\n",
    "    pairs_all, balance, comparisons = [], [], []\n",
    "    rng = np.random.default_rng(int(cfg[\"seed\"]))\n",
    "    for cal in cfg[\"matching_calipers\"]:\n",
    "        pairs = greedy_match(treated, control, float(cal), exact)\n",
    "        pairs_all += [{\"caliper\": cal, \"treated\": a, \"control\": b, \"distance\": d} for a, b, d in pairs]\n",
    "        if not pairs:\n",
    "            continue\n",
    "        t_ids = [p[0] for p in pairs]\n",
    "        c_ids = [p[1] for p in pairs]\n",
    "        for c in covs:\n",
    "            balance.append({\"caliper\": cal, \"covariate\": c, \"smd_before\": smd(D.loc[treated.index, c], D.loc[control.index, c]),\n",
    "                            \"smd_after\": smd(D.loc[t_ids, c], D.loc[c_ids, c]), \"n_pairs\": len(pairs)})\n",
    "        for f in feats:\n",
    "            diff = D.loc[t_ids, f].to_numpy() - D.loc[c_ids, f].to_numpy()\n",
    "            diff = diff[np.isfinite(diff)]\n",
    "            if len(diff) < 10:\n",
    "                continue\n",
    "            boots = [rng.choice(diff, len(diff)).mean() for _ in range(min(int(cfg[\"bootstrap_iterations\"]), 500))]\n",
    "            sd = D[f].std()\n",
    "            comparisons.append({\"caliper\": cal, \"feature\": f, \"n_pairs\": len(diff), \"mean_paired_diff\": float(diff.mean()),\n",
    "                                \"std_paired_diff_units\": float(diff.mean() / sd) if sd > 0 else np.nan,\n",
    "                                \"ci_lower\": float(np.quantile(boots, 0.025)), \"ci_upper\": float(np.quantile(boots, 0.975))})\n",
    "    return pd.DataFrame(pairs_all), pd.DataFrame(balance), pd.DataFrame(comparisons)\n",
    "\n",
    "\n",
    "def stage_residual_discovery(ctx) -> dict:\n",
    "    cfg = ctx.config\n",
    "    S = da.student_features(ctx, \"train\")\n",
    "    meta = da.student_meta(ctx, \"train\")\n",
    "    resid = ctx.load_df(\"baseline_residuals\").set_index(\"student_id\")\n",
    "    D = S.join(meta, rsuffix=\"_meta\").join(resid[[\"residual\", \"oof_prediction\", \"residual_group\"]], how=\"inner\")\n",
    "    theta = [c for c in da.raw_theta_columns(D)]\n",
    "    feats = candidate_features(D)\n",
    "    ctx.logger.info(\"Residual discovery over %d candidate features and %d students\", len(feats), len(D))\n",
    "    assoc = association_screen(D, feats, theta, cfg)\n",
    "    top_boot = assoc.reindex(assoc[\"residual_spearman\"].abs().sort_values(ascending=False).index).head(int(cfg[\"feature_registry_bootstrap_top_k\"]))\n",
    "    groups = D[\"school_id\"] if D[\"school_id\"].notna().all() and D[\"school_id\"].nunique() > 1 else None\n",
    "    ci_rows = []\n",
    "    for f in top_boot[\"feature\"]:\n",
    "        sub = D[[f, \"residual\"]].dropna()\n",
    "        ci = bootstrap_ci(spearman_stat, sub[f].to_numpy(), sub[\"residual\"].to_numpy(),\n",
    "                          n_boot=int(cfg[\"bootstrap_iterations\"]), seed=int(cfg[\"seed\"]),\n",
    "                          groups=groups.reindex(sub.index).to_numpy() if groups is not None else None)\n",
    "        ci_rows.append({\"feature\": f, \"residual_rho_ci_lower\": ci[\"lower\"], \"residual_rho_ci_upper\": ci[\"upper\"]})\n",
    "    assoc = assoc.merge(pd.DataFrame(ci_rows, columns=[\"feature\", \"residual_rho_ci_lower\", \"residual_rho_ci_upper\"]),\n",
    "                        on=\"feature\", how=\"left\")\n",
    "    perm_rows = []\n",
    "    for f in top_boot[\"feature\"].head(int(cfg[\"permutation_top_k\"])):\n",
    "        pr = permutation_pvalue(D[f], D[\"residual\"], n_perm=int(cfg[\"permutation_iterations\"]),\n",
    "                                groups=groups.to_numpy() if groups is not None else None, seed=int(cfg[\"seed\"]))\n",
    "        perm_rows.append({\"feature\": f, \"residual_perm_p_within_school\": pr[\"p_perm\"]})\n",
    "    assoc = assoc.merge(pd.DataFrame(perm_rows, columns=[\"feature\", \"residual_perm_p_within_school\"]), on=\"feature\", how=\"left\")\n",
    "    repl = held_out_replication(D, feats, cfg)\n",
    "    assoc = assoc.merge(repl[[\"feature\", \"replication_rate\", \"median_heldout_rho\"]], on=\"feature\", how=\"left\")\n",
    "    ctx.save_df(assoc, \"residual_associations\", also_csv=True)\n",
    "    ctx.save_df(repl, \"residual_replication\", fmt=\"csv\")\n",
    "    fam = assoc.groupby(\"family\").agg(n_features=(\"feature\", \"size\"),\n",
    "                                      n_residual_fdr=(\"residual_q\", lambda q: int((q < cfg[\"fdr_alpha\"]).sum())),\n",
    "                                      median_abs_residual_rho=(\"residual_spearman\", lambda s: float(s.abs().median())),\n",
    "                                      max_abs_residual_rho=(\"residual_spearman\", lambda s: float(s.abs().max())),\n",
    "                                      mean_replication_rate=(\"replication_rate\", \"mean\")).reset_index()\n",
    "    fam = fam.sort_values([\"n_residual_fdr\", \"max_abs_residual_rho\"], ascending=False)\n",
    "    ctx.save_df(fam, \"residual_family_ranking\", fmt=\"csv\")\n",
    "    top_feats = assoc.reindex(assoc[\"residual_spearman\"].abs().sort_values(ascending=False).index)[\"feature\"].head(30).tolist()\n",
    "    pairs, balance, comps = matched_analysis(D, theta, top_feats, cfg)\n",
    "    ctx.save_df(pairs, \"matched_pairs\", fmt=\"csv\")\n",
    "    ctx.save_df(balance, \"matched_balance\", fmt=\"csv\")\n",
    "    ctx.save_df(comps, \"matched_feature_comparison\", fmt=\"csv\")\n",
    "    _residual_figures(ctx, D, assoc, top_feats, comps, balance)\n",
    "    return {\"outputs\": [\"residual_associations\", \"residual_replication\", \"residual_family_ranking\", \"matched_pairs\",\n",
    "                        \"matched_balance\", \"matched_feature_comparison\"],\n",
    "            \"summary\": {\"n_features\": len(feats), \"n_residual_fdr\": int((assoc[\"residual_q\"] < cfg[\"fdr_alpha\"]).sum()),\n",
    "                        \"top_families\": fam.head(5).to_dict(\"records\"),\n",
    "                        \"note\": \"Observational associations; not causal effects.\"}}\n",
    "\n",
    "\n",
    "def _residual_figures(ctx, D, assoc, top_feats, comps, balance) -> None:\n",
    "    cfg = ctx.config\n",
    "    n = int(len(D))\n",
    "    fig, axes = viz.new_figure(1, 2)\n",
    "    viz.scatter_fit(axes[0, 0], D[\"oof_prediction\"], D[\"target\"], \"OOF screening prediction\", \"observed\", \"actual vs predicted\")\n",
    "    viz.hist_kde(axes[0, 1], D[\"residual\"], \"OOF screening residual\")\n",
    "    ctx.figure(fig, \"residual_overview\", \"Out-of-fold screening residuals\", \"What remains unexplained by screening?\",\n",
    "               \"baseline_residuals\", n, f\"Residual SD={D['residual'].std():.3g}.\")\n",
    "    top = assoc[assoc[\"feature\"].isin(top_feats)].copy()\n",
    "    if \"screening_adjusted_coef\" in top.columns:\n",
    "        top[\"lo\"] = top[\"screening_adjusted_coef\"] - 1.96 * top[\"screening_adjusted_se\"]\n",
    "        top[\"hi\"] = top[\"screening_adjusted_coef\"] + 1.96 * top[\"screening_adjusted_se\"]\n",
    "        top = top.sort_values(\"screening_adjusted_coef\")\n",
    "        fig, axes = viz.new_figure(1, 1, (8, 0.25 * len(top) + 2))\n",
    "        viz.forest(axes[0, 0], top, \"feature\", \"screening_adjusted_coef\", \"lo\", \"hi\",\n",
    "                   \"Screening-adjusted effect per SD (cluster-robust 95% CI)\", \"outcome units per feature SD\")\n",
    "        ctx.figure(fig, \"residual_forest\", \"Feature effect-size forest plot\", \"Which features predict outcome after screening adjustment?\",\n",
    "                   \"residual_associations\", n, \"Top 30 features by |residual rho|; selection and estimation use the same data (exploratory).\")\n",
    "    viz.top_correlation_heatmap(ctx, D, top_feats + [\"residual\", \"target\"], \"residual_feature_heatmap\",\n",
    "                                \"Residual-feature correlation heatmap\", \"Are residual-related features redundant?\", \"residual_associations\")\n",
    "    if len(comps):\n",
    "        c = comps[comps[\"caliper\"] == comps[\"caliper\"].median()] if comps[\"caliper\"].nunique() > 1 else comps\n",
    "        c = c.sort_values(\"std_paired_diff_units\")\n",
    "        c = c.assign(lo=c[\"ci_lower\"] / D[c[\"feature\"]].std().to_numpy(), hi=c[\"ci_upper\"] / D[c[\"feature\"]].std().to_numpy())\n",
    "        fig, axes = viz.new_figure(1, 1, (8, 0.25 * len(c) + 2))\n",
    "        viz.forest(axes[0, 0], c, \"feature\", \"std_paired_diff_units\", \"lo\", \"hi\",\n",
    "                   \"Matched positive vs negative residual students (paired diff, SD units)\", \"SD units\")\n",
    "        ctx.figure(fig, \"matched_comparison\", \"Matched-student comparison\", \"Do similar-screening students with different outcomes differ acoustically?\",\n",
    "                   \"matched_feature_comparison\", int(c[\"n_pairs\"].max()), \"Greedy nearest-neighbour matching with caliper; descriptive only.\")\n",
    "    if len(balance):\n",
    "        b = balance.groupby(\"caliper\")[[\"smd_before\", \"smd_after\"]].apply(lambda g: g.abs().mean())\n",
    "        fig, axes = viz.new_figure(1, 1)\n",
    "        b.plot(kind=\"bar\", ax=axes[0, 0])\n",
    "        viz.finalize_axis(axes[0, 0], \"Covariate balance (mean |SMD|) by caliper\", \"caliper\", \"|SMD|\", n)\n",
    "        ctx.figure(fig, \"matching_balance\", \"Matching covariate balance\", \"Were matched groups comparable?\", \"matched_balance\", n,\n",
    "                   \"Lower |SMD| after matching indicates better balance; sensitivity across calipers.\")\n",
    "    if top_feats and \"theta_mean\" in D.columns:\n",
    "        f = top_feats[0]\n",
    "        surf = viz.binned_surface(D, f, \"theta_mean\", \"residual\", bins=5, min_count=int(cfg[\"min_group_size\"]))\n",
    "        if not surf.empty:\n",
    "            fig, axes = viz.new_figure(1, 1, (7, 5))\n",
    "            viz.heatmap(axes[0, 0], surf, f\"mean residual by {f} (x) and theta_mean (y)\", cbar_label=\"residual\")\n",
    "            ctx.figure(fig, \"residual_response_surface\", \"Residual response surface\", \"Does the residual association depend on ability?\",\n",
    "                       \"residual_associations\", n, f\"Feature {f}; masked cells have < {cfg['min_group_size']} students.\")\n",
    "        rows = {}\n",
    "        terc = pd.qcut(D[\"theta_mean\"], 3, labels=[\"low\", \"mid\", \"high\"], duplicates=\"drop\")\n",
    "        for f in top_feats[:25]:\n",
    "            rows[f] = {f\"theta_{lvl}\": safe_corr(D.loc[terc == lvl, f], D.loc[terc == lvl, \"residual\"], \"spearman\", 15)[0]\n",
    "                       for lvl in terc.dropna().unique()}\n",
    "            if \"instrument\" in D.columns and D[\"instrument\"].nunique() > 1:\n",
    "                for inst, g in D.groupby(\"instrument\"):\n",
    "                    rows[f][f\"inst_{inst}\"] = safe_corr(g[f], g[\"residual\"], \"spearman\", 15)[0]\n",
    "        M = pd.DataFrame(rows).T\n",
    "        fig, axes = viz.new_figure(1, 1, (6, 0.25 * len(M) + 2))\n",
    "        viz.heatmap(axes[0, 0], M, \"Conditional residual associations (Spearman rho)\", vmin=-1, vmax=1, cbar_label=\"rho\")\n",
    "        ctx.figure(fig, \"conditional_association_matrix\", \"Conditional association matrix\",\n",
    "                   \"Are residual associations stable across ability and instrument?\", \"residual_associations\", n,\n",
    "                   \"Within-subgroup Spearman correlations (min 15 students).\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-035",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/residual_models.py\n",
    "\"\"\"Section 21 - properly nested two-stage residual learning.\n",
    "\n",
    "prediction = baseline_prediction + alpha * residual_prediction\n",
    "\n",
    "Within every outer fold:\n",
    "1. inner-fold screening/tabular predictions on outer-training students;\n",
    "2. inner out-of-fold residual targets;\n",
    "3. acoustic residual model fitted on outer-training data only;\n",
    "4. fusion coefficient alpha selected on inner validation predictions;\n",
    "5. components refitted on all outer-training students;\n",
    "6. outer-validation students predicted;\n",
    "7. evaluation on the original target scale.\n",
    "\n",
    "Outer-validation outcomes are never used for alpha selection. Within the inner\n",
    "loop, residual targets of inner-training students come from inner OOF\n",
    "predictions (standard stacking); the outer fold remains fully untouched.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.model_selection import KFold\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .baseline_models import make_fit_predict\n",
    "from .families import TABULAR_FAMILIES\n",
    "from .validation import (available_schemes, iter_folds, official_score, paired_bootstrap_delta, pooled_predictions,\n",
    "                         regression_metrics, summarize_cv, CVResult)\n",
    "\n",
    "AUDIO_RESIDUAL_FAMILIES = [\"TEMPORAL\", \"SPECTRAL\", \"MFCC\", \"WAVELETS\", \"PROSODY\", \"PHONETIC\", \"ITEM_ADJUSTED_AUDIO\",\n",
    "                           \"COMPLEXITY_SENSITIVITY\", \"CORRECTNESS_CONTRAST\", \"CROSS_TASK\", \"EMBEDDINGS\"]\n",
    "\n",
    "\n",
    "def _inner_oof(builder, fams, model, cfg, target: pd.Series, ids: np.ndarray, splitter, key_prefix) -> pd.Series:\n",
    "    out = pd.Series(np.nan, index=ids)\n",
    "    fp = make_fit_predict(builder, set(fams), model, cfg, target)\n",
    "    for k, (itr, iva) in enumerate(splitter.split(ids)):\n",
    "        out.iloc[iva] = fp(ids[itr], ids[iva], key_prefix + (\"inner\", k))\n",
    "    return out\n",
    "\n",
    "\n",
    "def nested_two_stage_cv(builder, y: pd.Series, assign: pd.DataFrame, scheme: str, cfg: dict, stage1_families: list,\n",
    "                        stage2_families: list, groups=None, model: str | None = None, repeats=None) -> CVResult:\n",
    "    model = model or cfg[\"ablation_primary_model\"]\n",
    "    alphas = [float(a) for a in cfg[\"residual_fusion_alphas\"]]\n",
    "    rows, fm = [], []\n",
    "    for rep, fold, tr, va in iter_folds(assign, scheme, repeats):\n",
    "        tr = np.array([s for s in tr if s in y.index])\n",
    "        va = np.array([s for s in va if s in y.index])\n",
    "        if len(tr) < 20 or len(va) == 0:\n",
    "            continue\n",
    "        inner = KFold(int(cfg[\"inner_cv_folds\"]), shuffle=True, random_state=int(cfg[\"seed\"]) + 97 * fold + rep)\n",
    "        key = (scheme, rep, fold)\n",
    "        base_oof = _inner_oof(builder, stage1_families, model, cfg, y, tr, inner, key)\n",
    "        resid = (y.loc[tr] - base_oof).rename(\"residual\")\n",
    "        res_oof = _inner_oof(builder, stage2_families, model, cfg, resid, tr, inner, key)\n",
    "        losses = {a: float(np.nanmean((y.loc[tr] - (base_oof + a * res_oof)) ** 2)) for a in alphas}\n",
    "        alpha = min(losses, key=losses.get)\n",
    "        base_pred = make_fit_predict(builder, set(stage1_families), model, cfg, y)(tr, va, key + (\"outer\",))\n",
    "        res_pred = make_fit_predict(builder, set(stage2_families), model, cfg, resid)(tr, va, key + (\"outer\",))\n",
    "        pred = base_pred + alpha * res_pred\n",
    "        yv = y.loc[va].to_numpy()\n",
    "        rows.append(pd.DataFrame({\"student_id\": va, \"repeat\": rep, \"fold\": fold, \"y\": yv, \"pred\": pred,\n",
    "                                  \"baseline_pred\": base_pred, \"residual_pred\": res_pred, \"alpha\": alpha}))\n",
    "        m = regression_metrics(yv, pred)\n",
    "        m.update({\"repeat\": rep, \"fold\": fold, \"alpha\": alpha, \"official\": official_score(yv, pred, cfg),\n",
    "                  \"inner_loss_alpha0\": losses[min(alphas)], \"inner_loss_selected\": losses[alpha]})\n",
    "        fm.append(m)\n",
    "    oof = pd.concat(rows, ignore_index=True) if rows else pd.DataFrame(columns=[\"student_id\", \"repeat\", \"fold\", \"y\", \"pred\"])\n",
    "    fold_metrics = pd.DataFrame(fm)\n",
    "    res = CVResult(scheme, oof, fold_metrics)\n",
    "    res.summary = summarize_cv(oof, fold_metrics, cfg, groups)\n",
    "    res.summary[\"alpha_mean\"] = float(fold_metrics[\"alpha\"].mean()) if len(fold_metrics) else np.nan\n",
    "    res.summary[\"alpha_values\"] = fold_metrics[\"alpha\"].tolist() if len(fold_metrics) else []\n",
    "    return res\n",
    "\n",
    "\n",
    "def nested_blend_cv(builder, y, assign, scheme, cfg, fams_a, fams_b, groups=None, model=None, repeats=None) -> CVResult:\n",
    "    \"\"\"Simple prediction blending w*A + (1-w)*B with w chosen on inner OOF predictions.\"\"\"\n",
    "    model = model or cfg[\"ablation_primary_model\"]\n",
    "    grid = np.linspace(0, 1, 11)\n",
    "    rows, fm = [], []\n",
    "    for rep, fold, tr, va in iter_folds(assign, scheme, repeats):\n",
    "        tr = np.array([s for s in tr if s in y.index])\n",
    "        va = np.array([s for s in va if s in y.index])\n",
    "        if len(tr) < 20 or len(va) == 0:\n",
    "            continue\n",
    "        inner = KFold(int(cfg[\"inner_cv_folds\"]), shuffle=True, random_state=int(cfg[\"seed\"]) + 131 * fold + rep)\n",
    "        key = (scheme, rep, fold)\n",
    "        oa = _inner_oof(builder, fams_a, model, cfg, y, tr, inner, key)\n",
    "        ob = _inner_oof(builder, fams_b, model, cfg, y, tr, inner, key)\n",
    "        w = grid[int(np.argmin([np.nanmean((y.loc[tr] - (g * oa + (1 - g) * ob)) ** 2) for g in grid]))]\n",
    "        pa = make_fit_predict(builder, set(fams_a), model, cfg, y)(tr, va, key + (\"outer\",))\n",
    "        pb = make_fit_predict(builder, set(fams_b), model, cfg, y)(tr, va, key + (\"outer\",))\n",
    "        pred = w * pa + (1 - w) * pb\n",
    "        yv = y.loc[va].to_numpy()\n",
    "        rows.append(pd.DataFrame({\"student_id\": va, \"repeat\": rep, \"fold\": fold, \"y\": yv, \"pred\": pred, \"weight_a\": w}))\n",
    "        m = regression_metrics(yv, pred)\n",
    "        m.update({\"repeat\": rep, \"fold\": fold, \"weight_a\": w, \"official\": official_score(yv, pred, cfg)})\n",
    "        fm.append(m)\n",
    "    oof = pd.concat(rows, ignore_index=True) if rows else pd.DataFrame(columns=[\"student_id\", \"repeat\", \"fold\", \"y\", \"pred\"])\n",
    "    res = CVResult(scheme, oof, pd.DataFrame(fm))\n",
    "    res.summary = summarize_cv(oof, res.fold_metrics, cfg, groups)\n",
    "    return res\n",
    "\n",
    "\n",
    "def stage_residual_learning(ctx) -> dict:\n",
    "    from .ablation import cv_evaluate, family_available\n",
    "    from .fold_features import FoldFeatureBuilder\n",
    "\n",
    "    cfg = ctx.config\n",
    "    meta = da.student_meta(ctx, \"train\")\n",
    "    y = meta[\"target\"].dropna().astype(float)\n",
    "    assign = ctx.load_df(\"cv_assignments\")\n",
    "    builder = FoldFeatureBuilder(ctx)\n",
    "    builder.base = builder.base.reindex(y.index)\n",
    "    groups = meta[\"school_id\"] if meta[\"school_id\"].notna().any() else None\n",
    "    s1 = [f for f in TABULAR_FAMILIES if family_available(f, builder, ctx)]\n",
    "    s2 = [f for f in AUDIO_RESIDUAL_FAMILIES if family_available(f, builder, ctx)]\n",
    "    if not s2:\n",
    "        ctx.save_json({\"status\": \"SKIPPED_UNAVAILABLE\", \"reason\": \"no acoustic/phonetic families available\"}, \"residual_learning_status\")\n",
    "        return {\"outputs\": [\"residual_learning_status\"], \"summary\": {\"status\": \"SKIPPED_UNAVAILABLE\"}}\n",
    "    schemes = [s for s in (\"CV_A_REPEATED_STUDENT_KFOLD\", \"CV_B_SCHOOL_GROUP_KFOLD\") if s in available_schemes(assign)]\n",
    "    rows, oofs = [], []\n",
    "    for scheme in schemes:\n",
    "        repeats = [0] if scheme == \"CV_A_REPEATED_STUDENT_KFOLD\" and int(cfg[\"cv_repeats\"]) > 1 else None\n",
    "        runs = {\n",
    "            \"BASELINE_TABULAR\": cv_evaluate(builder, s1, y, assign, scheme, cfg, repeats=repeats, groups=groups),\n",
    "            \"DIRECT_MULTIMODAL\": cv_evaluate(builder, s1 + s2, y, assign, scheme, cfg, repeats=repeats, groups=groups),\n",
    "            \"TWO_STAGE_RESIDUAL\": nested_two_stage_cv(builder, y, assign, scheme, cfg, s1, s2, groups, repeats=repeats),\n",
    "            \"NESTED_BLEND\": nested_blend_cv(builder, y, assign, scheme, cfg, s1, s1 + s2, groups, repeats=repeats),\n",
    "        }\n",
    "        pooled = {k: pooled_predictions(v.oof) for k, v in runs.items()}\n",
    "        for name, res in runs.items():\n",
    "            row = {\"approach\": name, \"scheme\": scheme, **{k: v for k, v in res.summary.items() if not isinstance(v, list)}}\n",
    "            for ref in (\"BASELINE_TABULAR\", \"DIRECT_MULTIMODAL\"):\n",
    "                if ref != name:\n",
    "                    common = pooled[name].index.intersection(pooled[ref].index)\n",
    "                    d = paired_bootstrap_delta(pooled[name].loc[common, \"y\"], pooled[name].loc[common, \"pred\"],\n",
    "                                               pooled[ref].loc[common, \"pred\"], cfg, \"r2\")\n",
    "                    row[f\"delta_r2_vs_{ref.lower()}\"] = d[\"delta\"]\n",
    "                    row[f\"delta_r2_vs_{ref.lower()}_ci_lower\"] = d[\"ci_lower\"]\n",
    "                    row[f\"delta_r2_vs_{ref.lower()}_ci_upper\"] = d[\"ci_upper\"]\n",
    "            rows.append(row)\n",
    "            oofs.append(res.oof.assign(approach=name, scheme=scheme))\n",
    "    results = pd.DataFrame(rows)\n",
    "    oof = pd.concat(oofs, ignore_index=True)\n",
    "    ctx.save_df(results, \"residual_learning_results\", also_csv=True)\n",
    "    ctx.save_df(oof, \"residual_learning_oof\")\n",
    "    fig, axes = viz.new_figure(1, len(schemes), (6, 3.6))\n",
    "    for ax, scheme in zip(axes.ravel(), schemes):\n",
    "        g = results[results[\"scheme\"] == scheme]\n",
    "        ax.errorbar(g[\"pooled_r2\"], g[\"approach\"], xerr=[(g[\"pooled_r2\"] - g[\"pooled_r2_ci_lower\"]).clip(lower=0).fillna(0),\n",
    "                                                       (g[\"pooled_r2_ci_upper\"] - g[\"pooled_r2\"]).clip(lower=0).fillna(0)],\n",
    "                    fmt=\"o\", capsize=3)\n",
    "        viz.finalize_axis(ax, f\"Residual learning ({scheme})\", \"pooled OOF R² (95% CI)\", \"\", int(g[\"n_students\"].max()))\n",
    "    ctx.figure(fig, \"residual_learning_comparison\", \"Two-stage residual learning vs direct regression and blending\",\n",
    "               \"Does residual learning improve upon direct multimodal regression?\", \"residual_learning_results\",\n",
    "               int(results[\"n_students\"].max()), \"Alpha and blend weights chosen on inner folds only.\")\n",
    "    two = oof[oof[\"approach\"] == \"TWO_STAGE_RESIDUAL\"]\n",
    "    if \"alpha\" in two.columns:\n",
    "        fig, axes = viz.new_figure(1, 1)\n",
    "        two.groupby([\"scheme\", \"repeat\", \"fold\"])[\"alpha\"].first().plot(kind=\"hist\", bins=len(cfg[\"residual_fusion_alphas\"]) * 2, ax=axes[0, 0])\n",
    "        viz.finalize_axis(axes[0, 0], \"Selected fusion coefficients alpha\", \"alpha\", \"folds\", None)\n",
    "        ctx.figure(fig, \"residual_alpha_distribution\", \"Selected residual fusion coefficients\", \"How much residual correction is chosen?\",\n",
    "                   \"residual_learning_oof\", None, f\"Grid {cfg['residual_fusion_alphas']}.\")\n",
    "    return {\"outputs\": [\"residual_learning_results\", \"residual_learning_oof\"],\n",
    "            \"summary\": results[[\"approach\", \"scheme\", \"pooled_r2\"]].to_dict(\"records\")}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-036",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/screening_eda.py\n",
    "\"\"\"Section 03 - beginning-of-year literacy (screening) intelligence.\n",
    "\n",
    "Scientific question: how much of the future reading outcome can be explained\n",
    "by conventional literacy screening?\n",
    "\n",
    "``theta_common_factor`` (first principal component of the standardised\n",
    "skill estimates) is fitted on training students for EDA; predictive stages\n",
    "refit it inside each training fold.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import itertools\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy import stats as sps\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .stats_utils import (association_table, distance_correlation, mutual_information, partial_corr,\n",
    "                          quantile_bins, safe_corr)\n",
    "\n",
    "SKILLS = (\"blending\", \"deletion\", \"repetition\")\n",
    "\n",
    "\n",
    "def derive_screening_features(df: pd.DataFrame, pca_params: dict | None = None) -> tuple[pd.DataFrame, dict]:\n",
    "    \"\"\"Row-wise screening features plus the (optionally pre-fitted) common factor.\"\"\"\n",
    "    cols = da.raw_theta_columns(df)\n",
    "    out = pd.DataFrame(index=df.index)\n",
    "    for c in cols:\n",
    "        out[c] = pd.to_numeric(df[c], errors=\"coerce\")\n",
    "    for c in df.columns:\n",
    "        if c.startswith(\"theta_se_\"):\n",
    "            out[c] = pd.to_numeric(df[c], errors=\"coerce\")\n",
    "    if not cols:\n",
    "        return out, pca_params or {}\n",
    "    T = out[cols]\n",
    "    out[\"theta_mean\"] = T.mean(axis=1)\n",
    "    out[\"theta_min\"] = T.min(axis=1)\n",
    "    out[\"theta_max\"] = T.max(axis=1)\n",
    "    out[\"theta_std\"] = T.std(axis=1, ddof=0)\n",
    "    out[\"theta_range\"] = out[\"theta_max\"] - out[\"theta_min\"]\n",
    "    out[\"theta_median\"] = T.median(axis=1)\n",
    "    out[\"theta_skill_imbalance\"] = (T.sub(out[\"theta_mean\"], axis=0).abs()).mean(axis=1)\n",
    "    out[\"theta_n_available\"] = T.notna().sum(axis=1)\n",
    "    present = {s: f\"theta_{s}\" for s in SKILLS if f\"theta_{s}\" in out.columns}\n",
    "    for a, b in itertools.combinations(SKILLS, 2):\n",
    "        if a in present and b in present:\n",
    "            out[f\"theta_{a}_minus_{b}\"] = out[present[a]] - out[present[b]]\n",
    "            out[f\"theta_{a}_x_{b}\"] = out[present[a]] * out[present[b]]\n",
    "    for c in cols:\n",
    "        out[f\"theta_missing_{c[6:]}\"] = out[c].isna().astype(float)\n",
    "    if pca_params is None:\n",
    "        Z = T.copy()\n",
    "        mu, sd = Z.mean(), Z.std(ddof=0).replace(0, 1)\n",
    "        Zs = ((Z - mu) / sd).fillna(0.0)\n",
    "        if Zs.shape[1] >= 2 and len(Zs) >= 5:\n",
    "            _, _, vt = np.linalg.svd(Zs.to_numpy() - Zs.to_numpy().mean(0), full_matrices=False)\n",
    "            loadings = vt[0]\n",
    "            if loadings.sum() < 0:\n",
    "                loadings = -loadings\n",
    "        else:\n",
    "            loadings = np.ones(Zs.shape[1])\n",
    "        pca_params = {\"columns\": cols, \"mean\": mu.to_dict(), \"sd\": sd.to_dict(), \"loadings\": loadings.tolist()}\n",
    "    Zs = ((T[pca_params[\"columns\"]] - pd.Series(pca_params[\"mean\"])) / pd.Series(pca_params[\"sd\"])).fillna(0.0)\n",
    "    out[\"theta_common_factor\"] = Zs.to_numpy() @ np.asarray(pca_params[\"loadings\"])\n",
    "    return out, pca_params\n",
    "\n",
    "\n",
    "def stage_screening_intelligence(ctx) -> dict:\n",
    "    cfg = ctx.config\n",
    "    min_n = int(cfg[\"min_n_correlation\"])\n",
    "    sm = da.students(ctx, \"train\").set_index(\"student_id\")\n",
    "    feats, pca = derive_screening_features(sm)\n",
    "    feats_out = feats.reset_index()\n",
    "    ctx.save_df(feats_out, \"screening_features\")\n",
    "    outputs = [\"screening_features\"]\n",
    "    st = da.students(ctx, \"test\").set_index(\"student_id\")\n",
    "    if len(st):\n",
    "        tfeat, _ = derive_screening_features(st, pca)\n",
    "        ctx.save_df(tfeat.reset_index(), \"screening_features_test\")\n",
    "        outputs.append(\"screening_features_test\")\n",
    "    ctx.save_json(pca, \"screening_common_factor_params\")\n",
    "    y = pd.to_numeric(sm[\"target\"], errors=\"coerce\")\n",
    "    raw = da.raw_theta_columns(feats)\n",
    "    if not raw:\n",
    "        ctx.save_json({\"status\": \"NO_SCREENING_VARIABLES\"}, \"screening_status\")\n",
    "        return {\"outputs\": outputs + [\"screening_status\"], \"summary\": {\"status\": \"NO_SCREENING_VARIABLES\"}}\n",
    "    fcols = [c for c in feats.columns if c.startswith(\"theta_\") and not c.startswith(\"theta_missing_\")]\n",
    "    assoc = association_table(feats[fcols], y, methods=(\"pearson\", \"spearman\", \"kendall\"), min_n=min_n)\n",
    "    assoc[\"mutual_information\"] = assoc[\"feature\"].map(mutual_information(feats[fcols], y, int(cfg[\"seed\"]), min_n))\n",
    "    assoc[\"distance_correlation\"] = [distance_correlation(feats[c], y, seed=int(cfg[\"seed\"])) for c in fcols]\n",
    "    lin_r2, spl_r2 = [], []\n",
    "    from sklearn.model_selection import cross_val_score\n",
    "    from sklearn.pipeline import make_pipeline\n",
    "    from sklearn.preprocessing import SplineTransformer, StandardScaler\n",
    "    from sklearn.linear_model import RidgeCV\n",
    "\n",
    "    for c in fcols:\n",
    "        d = pd.concat([feats[c], y], axis=1).dropna()\n",
    "        if len(d) < 50 or d[c].nunique() < 6:\n",
    "            lin_r2.append(np.nan)\n",
    "            spl_r2.append(np.nan)\n",
    "            continue\n",
    "        X, yy = d[[c]].to_numpy(), d.iloc[:, 1].to_numpy()\n",
    "        lin_r2.append(float(cross_val_score(make_pipeline(StandardScaler(), RidgeCV()), X, yy, cv=5, scoring=\"r2\").mean()))\n",
    "        spl_r2.append(float(cross_val_score(make_pipeline(SplineTransformer(n_knots=5), RidgeCV()), X, yy, cv=5, scoring=\"r2\").mean()))\n",
    "    assoc[\"cv_r2_linear\"] = lin_r2\n",
    "    assoc[\"cv_r2_spline\"] = spl_r2\n",
    "    assoc[\"nonlinearity_gain\"] = assoc[\"cv_r2_spline\"] - assoc[\"cv_r2_linear\"]\n",
    "    ctx.save_df(assoc, \"screening_associations\", also_csv=True)\n",
    "    outputs.append(\"screening_associations\")\n",
    "    partial = []\n",
    "    for c in raw:\n",
    "        others = [o for o in raw if o != c]\n",
    "        if others:\n",
    "            r, p, n = partial_corr(feats[c], y, feats[others], \"pearson\", min_n)\n",
    "            rs, ps, _ = partial_corr(feats[c], y, feats[others], \"spearman\", min_n)\n",
    "            partial.append({\"feature\": c, \"controls\": \",\".join(others), \"partial_pearson\": r, \"p_pearson\": p,\n",
    "                            \"partial_spearman\": rs, \"p_spearman\": ps, \"n\": n})\n",
    "    ctx.save_df(pd.DataFrame(partial), \"screening_partial_correlations\", fmt=\"csv\")\n",
    "    outputs.append(\"screening_partial_correlations\")\n",
    "    sm_full = sm.join(feats[[c for c in feats.columns if c not in sm.columns]])\n",
    "    cond_rows = []\n",
    "    for c in raw + [\"theta_mean\", \"theta_common_factor\"]:\n",
    "        bins = quantile_bins(sm_full[c], 5, int(cfg[\"min_group_size\"]), \"Q\")\n",
    "        for b, g in sm_full.groupby(bins):\n",
    "            t = pd.to_numeric(g[\"target\"], errors=\"coerce\").dropna()\n",
    "            cond_rows.append({\"feature\": c, \"bin\": b, \"n\": len(t), \"target_mean\": t.mean(), \"target_sd\": t.std(),\n",
    "                              \"target_q25\": t.quantile(.25), \"target_q75\": t.quantile(.75),\n",
    "                              \"feature_mean\": g[c].mean()})\n",
    "    ctx.save_df(pd.DataFrame(cond_rows), \"screening_conditional_outcomes\", fmt=\"csv\")\n",
    "    outputs.append(\"screening_conditional_outcomes\")\n",
    "    conditioned = []\n",
    "    for col in (\"instrument\", \"school_id\"):\n",
    "        if col in sm_full.columns and sm_full[col].nunique() > 1:\n",
    "            for level, g in sm_full.groupby(col):\n",
    "                for c in raw + [\"theta_mean\"]:\n",
    "                    r, p, n = safe_corr(g[c], g[\"target\"], \"spearman\", int(cfg[\"min_group_size\"]))\n",
    "                    conditioned.append({\"by\": col, \"level\": level, \"feature\": c, \"spearman\": r, \"p\": p, \"n\": n})\n",
    "    if conditioned:\n",
    "        cond = pd.DataFrame(conditioned)\n",
    "        # shrink school-level correlations towards the pooled correlation (Fisher-z, weight n-3)\n",
    "        pooled = {c: safe_corr(sm_full[c], sm_full[\"target\"], \"spearman\", min_n)[0] for c in raw + [\"theta_mean\"]}\n",
    "        z0 = cond[\"feature\"].map(lambda f: np.arctanh(np.clip(pooled.get(f, np.nan), -0.999, 0.999)))\n",
    "        z = np.arctanh(cond[\"spearman\"].clip(-0.999, 0.999))\n",
    "        w = (cond[\"n\"] - 3).clip(lower=0) / ((cond[\"n\"] - 3).clip(lower=0) + 20)\n",
    "        cond[\"spearman_shrunk\"] = np.tanh(w * z.fillna(z0) + (1 - w) * z0)\n",
    "        ctx.save_df(cond, \"screening_group_conditioned\", fmt=\"csv\")\n",
    "        outputs.append(\"screening_group_conditioned\")\n",
    "    Z = feats[raw].apply(lambda s: (s - s.mean()) / s.std(ddof=0) if s.std(ddof=0) > 0 else s * 0)\n",
    "    Zc = Z.dropna()\n",
    "    pca_rep: dict = {}\n",
    "    if len(Zc) >= 10 and Zc.shape[1] >= 2:\n",
    "        _, svals, vt = np.linalg.svd(Zc.to_numpy() - Zc.to_numpy().mean(0), full_matrices=False)\n",
    "        ev = svals ** 2 / (svals ** 2).sum()\n",
    "        pca_rep = {\"explained_variance_ratio\": ev.tolist(), \"loadings\": {f\"PC{i + 1}\": dict(zip(raw, vt[i].tolist())) for i in range(len(ev))}}\n",
    "    ctx.save_json(pca_rep, \"screening_pca\")\n",
    "    outputs.append(\"screening_pca\")\n",
    "    miss = feats[raw].isna()\n",
    "    miss_rep = {\"missing_rate\": miss.mean().to_dict(),\n",
    "                \"target_mean_missing_vs_present\": {c: {\"missing\": float(y[miss[c]].mean()) if miss[c].any() else None,\n",
    "                                                      \"present\": float(y[~miss[c]].mean())} for c in raw}}\n",
    "    ctx.save_json(miss_rep, \"screening_missingness\")\n",
    "    outputs.append(\"screening_missingness\")\n",
    "    _screening_figures(ctx, sm_full, raw, assoc, pca_rep)\n",
    "    best = assoc.reindex(assoc[\"spearman_r\"].abs().sort_values(ascending=False).index).head(5)\n",
    "    return {\"outputs\": outputs, \"summary\": {\"theta_columns\": raw, \"top\": best[[\"feature\", \"spearman_r\"]].to_dict(\"records\"),\n",
    "                                            \"pca_explained\": pca_rep.get(\"explained_variance_ratio\")}}\n",
    "\n",
    "\n",
    "def _screening_figures(ctx, sm: pd.DataFrame, raw: list, assoc: pd.DataFrame, pca_rep: dict) -> None:\n",
    "    n = int(sm[\"target\"].notna().sum())\n",
    "    cols = raw + [\"target\"]\n",
    "    k = len(cols)\n",
    "    fig, axes = viz.new_figure(k, k, (2.4, 2.2))\n",
    "    for i, a in enumerate(cols):\n",
    "        for j, b in enumerate(cols):\n",
    "            ax = axes[i, j]\n",
    "            if i == j:\n",
    "                ax.hist(pd.to_numeric(sm[a], errors=\"coerce\").dropna(), bins=30)\n",
    "            else:\n",
    "                ax.scatter(sm[b], sm[a], s=3, alpha=0.4)\n",
    "            if i == k - 1:\n",
    "                ax.set_xlabel(b, fontsize=7)\n",
    "            if j == 0:\n",
    "                ax.set_ylabel(a, fontsize=7)\n",
    "    ctx.figure(fig, \"screening_pairplot\", \"Screening skills and outcome pair plot\",\n",
    "               \"How do screening skills relate to each other and to the outcome?\", \"screening_features\", n,\n",
    "               \"Diagonal: histograms; off-diagonal: scatter plots.\")\n",
    "    corr = sm[cols].apply(pd.to_numeric, errors=\"coerce\").corr(method=\"spearman\")\n",
    "    fig, axes = viz.new_figure(1, 1, (6, 5))\n",
    "    viz.heatmap(axes[0, 0], corr, \"Spearman correlation matrix\", vmin=-1, vmax=1, annotate=True, cbar_label=\"rho\")\n",
    "    ctx.figure(fig, \"screening_correlation_matrix\", \"Screening correlation matrix\", \"How correlated are the skills?\",\n",
    "               \"screening_features\", n, f\"Skill-target rho: \" + \", \".join(f\"{c}={corr.loc[c, 'target']:.3f}\" for c in raw))\n",
    "    if len(raw) >= 3:\n",
    "        fig = viz._plt().figure(figsize=(7, 6))\n",
    "        ax = fig.add_subplot(111, projection=\"3d\")\n",
    "        d = sm[raw[:3] + [\"target\"]].dropna()\n",
    "        sc = ax.scatter(d[raw[0]], d[raw[1]], d[raw[2]], c=d[\"target\"], s=6, cmap=\"viridis\")\n",
    "        ax.set_xlabel(raw[0])\n",
    "        ax.set_ylabel(raw[1])\n",
    "        ax.set_zlabel(raw[2])\n",
    "        fig.colorbar(sc, label=\"outcome\", fraction=0.03)\n",
    "        ctx.figure(fig, \"ability_map_3d\", \"Three-dimensional ability map\", \"Where are students in skill space?\",\n",
    "                   \"screening_features\", len(d), \"Colour encodes end-of-year outcome.\")\n",
    "    pairs = list(itertools.combinations(raw, 2))\n",
    "    if pairs:\n",
    "        fig, axes = viz.new_figure(1, len(pairs), (5, 4.2))\n",
    "        for ax, (a, b) in zip(axes.ravel(), pairs):\n",
    "            surf = viz.binned_surface(sm, a, b, \"target\", bins=5, min_count=int(ctx.config[\"min_group_size\"]))\n",
    "            if not surf.empty:\n",
    "                viz.heatmap(ax, surf, f\"mean outcome: {a} (x) x {b} (y)\", cmap=\"viridis\", cbar_label=\"outcome\")\n",
    "        ctx.figure(fig, \"screening_response_surfaces\", \"Pairwise outcome response surfaces\",\n",
    "                   \"Do skills combine non-additively?\", \"screening_features\", n,\n",
    "                   f\"Quantile-binned means; cells with < {ctx.config['min_group_size']} students masked.\")\n",
    "    from sklearn.cluster import KMeans\n",
    "\n",
    "    Z = sm[raw].apply(lambda s: (s - s.mean()) / s.std()).dropna()\n",
    "    if len(Z) >= 30:\n",
    "        km = KMeans(4, random_state=int(ctx.config[\"seed\"]), n_init=10).fit(Z)\n",
    "        prof = pd.DataFrame(km.cluster_centers_, columns=raw)\n",
    "        fig = viz._plt().figure(figsize=(6, 6))\n",
    "        ax = fig.add_subplot(111, polar=True)\n",
    "        viz.radar(ax, raw, {f\"profile {i} (n={int((km.labels_ == i).sum())})\": prof.loc[i].tolist() for i in prof.index},\n",
    "                  \"Screening profiles (z-scores, k-means k=4, descriptive)\")\n",
    "        ctx.figure(fig, \"screening_profile_radar\", \"Radar charts of screening profiles\",\n",
    "                   \"What screening profiles exist?\", \"screening_features\", len(Z),\n",
    "                   \"Descriptive k-means profiles on standardised skills; not used for prediction.\")\n",
    "        dom = sm.loc[Z.index, raw].apply(lambda s: (s - s.mean()) / s.std()).idxmax(axis=1)\n",
    "        fig, axes = viz.new_figure(1, 2)\n",
    "        dom.value_counts().plot(kind=\"bar\", ax=axes[0, 0])\n",
    "        viz.finalize_axis(axes[0, 0], \"Dominant (relatively strongest) skill\", \"skill\", \"students\", len(dom))\n",
    "        tmp = pd.DataFrame({\"dominant\": dom, \"target\": sm.loc[Z.index, \"target\"]})\n",
    "        viz.grouped_box(axes[0, 1], tmp, \"target\", \"dominant\", \"outcome\")\n",
    "        ctx.figure(fig, \"skill_dominance\", \"Skill dominance\", \"Does relative skill strength relate to outcome?\",\n",
    "                   \"screening_features\", len(dom), \"Dominant skill = largest within-student z-score.\")\n",
    "    fig, axes = viz.new_figure(1, len(raw) + 1, (4, 3.6))\n",
    "    for ax, c in zip(axes.ravel(), raw + [\"theta_mean\"]):\n",
    "        bins = quantile_bins(sm[c], 8, int(ctx.config[\"min_group_size\"]), \"Q\")\n",
    "        g = sm.groupby(bins)\n",
    "        means = g[\"target\"].mean()\n",
    "        se = g[\"target\"].std() / np.sqrt(g[\"target\"].count())\n",
    "        x = g[c].mean()\n",
    "        ax.errorbar(x, means, yerr=1.96 * se, fmt=\"o-\")\n",
    "        viz.finalize_axis(ax, f\"outcome | {c}\", c, \"mean outcome (95% CI)\", int(sm[c].notna().sum()))\n",
    "    ctx.figure(fig, \"conditional_target\", \"Conditional outcome by screening bins\",\n",
    "               \"Is the screening-outcome relation linear?\", \"screening_conditional_outcomes\", n,\n",
    "               \"Quantile bins with at least min_group_size students; error bars are 95% normal CIs.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-037",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/spectral_features.py\n",
    "\"\"\"Section 08 - spectral and spectrotemporal intelligence.\n",
    "\n",
    "Computes frame-level spectral descriptors once from the shared STFT and\n",
    "summarises them separately for speech-active frames (``s_sp_``), all frames\n",
    "(``s_full_``) and background frames (``s_bg_``). Cepstral features use the\n",
    "``m_`` prefix.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "from .stats_utils import robust_stats\n",
    "\n",
    "EPS = 1e-12\n",
    "FRAME_FEATURES = [\"centroid\", \"bandwidth\", \"rolloff\", \"flatness\", \"entropy\", \"flux\", \"zcr\", \"slope\",\n",
    "                  \"skew\", \"kurt\", \"dominant\"]\n",
    "PSD_BANDS = [(0, 250), (250, 500), (500, 1000), (1000, 2000), (2000, 4000), (4000, 8000)]\n",
    "\n",
    "\n",
    "def frame_descriptors(b) -> dict:\n",
    "    import librosa\n",
    "\n",
    "    P = b.power + EPS\n",
    "    f = b.freqs[:, None]\n",
    "    total = P.sum(axis=0)\n",
    "    pn = P / total\n",
    "    centroid = (f * pn).sum(axis=0)\n",
    "    dev = f - centroid\n",
    "    bandwidth = np.sqrt((dev ** 2 * pn).sum(axis=0))\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        skewness = (dev ** 3 * pn).sum(axis=0) / np.maximum(bandwidth ** 3, EPS)\n",
    "        kurt = (dev ** 4 * pn).sum(axis=0) / np.maximum(bandwidth ** 4, EPS)\n",
    "    cum = np.cumsum(pn, axis=0)\n",
    "    rolloff = b.freqs[np.argmax(cum >= 0.85, axis=0)]\n",
    "    flatness = np.exp(np.log(P).mean(axis=0)) / P.mean(axis=0)\n",
    "    entropy = -(pn * np.log(pn)).sum(axis=0) / np.log(P.shape[0])\n",
    "    logS = np.log1p(b.S)\n",
    "    flux = np.concatenate([[0.0], np.sqrt((np.clip(np.diff(logS, axis=1), 0, None) ** 2).sum(axis=0))])\n",
    "    db = 10 * np.log10(P)\n",
    "    fc = b.freqs - b.freqs.mean()\n",
    "    slope = (fc[:, None] * (db - db.mean(axis=0))).sum(axis=0) / max((fc ** 2).sum(), EPS)\n",
    "    zcr = librosa.feature.zero_crossing_rate(b.y, frame_length=b.n_fft, hop_length=b.hop, center=True)[0]\n",
    "    T = P.shape[1]\n",
    "    zcr = np.resize(zcr, T) if len(zcr) != T else zcr\n",
    "    dominant = b.freqs[np.argmax(P, axis=0)]\n",
    "    return {\"centroid\": centroid, \"bandwidth\": bandwidth, \"rolloff\": rolloff, \"flatness\": flatness,\n",
    "            \"entropy\": entropy, \"flux\": flux, \"zcr\": zcr, \"slope\": slope * 1000.0, \"skew\": skewness,\n",
    "            \"kurt\": kurt, \"dominant\": dominant}\n",
    "\n",
    "\n",
    "def _region_masks(b) -> dict:\n",
    "    T = b.power.shape[1]\n",
    "    energetic = b.rms_db[:T] > (np.nanmin(b.rms_db) + 1.0) if T else np.zeros(0, bool)\n",
    "    sp = b.vad_mask[:T]\n",
    "    return {\"full\": energetic if energetic.any() else np.ones(T, bool), \"sp\": sp, \"bg\": ~sp}\n",
    "\n",
    "\n",
    "def _psd_bands(x: np.ndarray, sr: int, prefix: str) -> dict:\n",
    "    from scipy.signal import welch\n",
    "\n",
    "    out = {}\n",
    "    names = [f\"{prefix}_band{lo}_{hi}_rel\" for lo, hi in PSD_BANDS]\n",
    "    if len(x) < 256:\n",
    "        out.update({n: np.nan for n in names})\n",
    "        out.update({f\"{prefix}_ratio_low_high\": np.nan, f\"{prefix}_ratio_mid_high\": np.nan,\n",
    "                    f\"{prefix}_psd_dominant_hz\": np.nan, f\"{prefix}_psd_slope\": np.nan})\n",
    "        return out\n",
    "    freqs, pxx = welch(x, fs=sr, nperseg=min(1024, len(x)))\n",
    "    total = pxx.sum() + EPS\n",
    "    for (lo, hi), name in zip(PSD_BANDS, names):\n",
    "        out[name] = float(pxx[(freqs >= lo) & (freqs < hi)].sum() / total)\n",
    "    low = pxx[freqs < 1000].sum()\n",
    "    mid = pxx[(freqs >= 1000) & (freqs < 3000)].sum()\n",
    "    high = pxx[freqs >= 3000].sum() + EPS\n",
    "    out[f\"{prefix}_ratio_low_high\"] = float(np.log10((low + EPS) / high))\n",
    "    out[f\"{prefix}_ratio_mid_high\"] = float(np.log10((mid + EPS) / high))\n",
    "    out[f\"{prefix}_psd_dominant_hz\"] = float(freqs[np.argmax(pxx)])\n",
    "    valid = (freqs > 50) & (pxx > 0)\n",
    "    out[f\"{prefix}_psd_slope\"] = float(np.polyfit(np.log10(freqs[valid]), np.log10(pxx[valid]), 1)[0]) if valid.sum() > 5 else np.nan\n",
    "    return out\n",
    "\n",
    "\n",
    "def _active_signal(b) -> np.ndarray:\n",
    "    if not b.segments:\n",
    "        return np.zeros(0, dtype=np.float32)\n",
    "    parts = [b.y[int(s * b.sr):int(e * b.sr)] for s, e in b.segments]\n",
    "    return np.concatenate(parts) if parts else np.zeros(0, dtype=np.float32)\n",
    "\n",
    "\n",
    "def _background_signal(b) -> np.ndarray:\n",
    "    keep = np.ones(len(b.y), dtype=bool)\n",
    "    for s, e in b.segments:\n",
    "        keep[int(s * b.sr):int(e * b.sr)] = False\n",
    "    return b.y[keep]\n",
    "\n",
    "\n",
    "def spectral_features(b, cfg: dict) -> dict:\n",
    "    import librosa\n",
    "\n",
    "    out: dict = {}\n",
    "    frames = frame_descriptors(b)\n",
    "    masks = _region_masks(b)\n",
    "    min_frames = int(cfg[\"spectral_min_frames\"])\n",
    "    full_stats = list(cfg[\"spectral_robust_stats\"])\n",
    "    for region, mask in masks.items():\n",
    "        stats = full_stats if region == \"sp\" else [\"mean\", \"std\", \"median\"]\n",
    "        n = int(mask.sum())\n",
    "        out[f\"s_{region}_n_frames\"] = float(n)\n",
    "        for name in FRAME_FEATURES:\n",
    "            values = frames[name][mask] if n >= min_frames else np.array([])\n",
    "            out.update(robust_stats(values, f\"s_{region}_{name}\", stats, min_n=min_frames))\n",
    "    n_bands = int(min(6, np.floor(np.log2((b.sr / 2.0) / 100.0) - 1e-9)))\n",
    "    contrast = librosa.feature.spectral_contrast(S=b.S, sr=b.sr, n_fft=b.n_fft, n_bands=n_bands, fmin=100.0)\n",
    "    T = contrast.shape[1]\n",
    "    sp = masks[\"sp\"][:T]\n",
    "    for k in range(contrast.shape[0]):\n",
    "        vals = contrast[k, sp] if sp.sum() >= min_frames else np.array([])\n",
    "        out[f\"s_sp_contrast{k}_mean\"] = float(vals.mean()) if len(vals) else np.nan\n",
    "        out[f\"s_sp_contrast{k}_std\"] = float(vals.std(ddof=1)) if len(vals) > 1 else np.nan\n",
    "    out.update(_psd_bands(_active_signal(b), b.sr, \"s_sp\"))\n",
    "    bg = _background_signal(b)\n",
    "    out.update(_psd_bands(bg, b.sr, \"s_bg\"))\n",
    "    out[\"s_bg_level_db\"] = float(np.median(b.rms_db[masks[\"bg\"][:len(b.rms_db)]])) if masks[\"bg\"].any() else np.nan\n",
    "    out[\"s_bg_duration_s\"] = float(len(bg) / b.sr)\n",
    "    # Time-frequency entropy, stationarity and spectrotemporal modulation (speech region)\n",
    "    lm = b.logmel[:, masks[\"sp\"][:b.logmel.shape[1]]] if masks[\"sp\"].any() else np.zeros((b.logmel.shape[0], 0))\n",
    "    if lm.shape[1] >= min_frames:\n",
    "        pw = np.power(10.0, lm / 10.0)\n",
    "        pn = pw / (pw.sum() + EPS)\n",
    "        out[\"s_sp_tf_entropy\"] = float(-(pn * np.log(pn + EPS)).sum() / np.log(pn.size))\n",
    "        chunks = np.array_split(lm, 4, axis=1)\n",
    "        means = np.stack([c.mean(axis=1) for c in chunks if c.shape[1] > 0])\n",
    "        within = np.mean([c.std(axis=1).mean() for c in chunks if c.shape[1] > 1]) if lm.shape[1] >= 8 else np.nan\n",
    "        between = np.mean([np.linalg.norm(means[i] - means[j]) / np.sqrt(means.shape[1])\n",
    "                           for i in range(len(means)) for j in range(i + 1, len(means))]) if len(means) > 1 else np.nan\n",
    "        out[\"s_sp_stationarity\"] = float(between / within) if within and np.isfinite(within) and within > 0 else np.nan\n",
    "        mod = np.abs(np.fft.rfft2(lm - lm.mean())) ** 2\n",
    "        tf = np.fft.rfftfreq(lm.shape[1], d=b.hop / b.sr)\n",
    "        total = mod.sum() + EPS\n",
    "        for lo, hi in ((0, 4), (4, 8), (8, 16), (16, 32)):\n",
    "            out[f\"s_sp_stmod_t{lo}_{hi}hz_rel\"] = float(mod[:, (tf >= lo) & (tf < hi)].sum() / total)\n",
    "        spec_axis = mod.sum(axis=1)\n",
    "        half = max(1, len(spec_axis) // 8)\n",
    "        out[\"s_sp_stmod_spectral_low_rel\"] = float((spec_axis[:half].sum() + spec_axis[-half:].sum()) / (spec_axis.sum() + EPS))\n",
    "    else:\n",
    "        out.update({\"s_sp_tf_entropy\": np.nan, \"s_sp_stationarity\": np.nan, \"s_sp_stmod_spectral_low_rel\": np.nan})\n",
    "        out.update({f\"s_sp_stmod_t{lo}_{hi}hz_rel\": np.nan for lo, hi in ((0, 4), (4, 8), (8, 16), (16, 32))})\n",
    "    if cfg.get(\"enable_chroma\"):\n",
    "        chroma = librosa.feature.chroma_stft(S=b.power, sr=b.sr, n_fft=b.n_fft)\n",
    "        c = chroma[:, masks[\"sp\"][:chroma.shape[1]]]\n",
    "        if c.shape[1] >= min_frames:\n",
    "            cn = c / (c.sum(axis=0, keepdims=True) + EPS)\n",
    "            ent = -(cn * np.log(cn + EPS)).sum(axis=0) / np.log(12)\n",
    "            out[\"s_sp_chroma_entropy_mean\"] = float(ent.mean())\n",
    "            out[\"s_sp_chroma_peak_ratio_mean\"] = float(cn.max(axis=0).mean())\n",
    "        else:\n",
    "            out[\"s_sp_chroma_entropy_mean\"] = out[\"s_sp_chroma_peak_ratio_mean\"] = np.nan\n",
    "    if cfg.get(\"enable_hpss\"):\n",
    "        H, Pm = librosa.decompose.hpss(b.S)\n",
    "        sp_mask = masks[\"sp\"][:H.shape[1]]\n",
    "        if sp_mask.sum() >= min_frames:\n",
    "            h, p = (H[:, sp_mask] ** 2).sum(), (Pm[:, sp_mask] ** 2).sum()\n",
    "            out[\"s_sp_harmonic_ratio\"] = float(h / (h + p + EPS))\n",
    "            out[\"s_sp_percussive_ratio\"] = float(p / (h + p + EPS))\n",
    "        else:\n",
    "            out[\"s_sp_harmonic_ratio\"] = out[\"s_sp_percussive_ratio\"] = np.nan\n",
    "    return out\n",
    "\n",
    "\n",
    "def mfcc_features(b, cfg: dict) -> dict:\n",
    "    import librosa\n",
    "\n",
    "    out: dict = {}\n",
    "    min_frames = int(cfg[\"spectral_min_frames\"])\n",
    "    M = b.mfcc\n",
    "    T = M.shape[1]\n",
    "    width = min(9, T if T % 2 == 1 else T - 1)\n",
    "    if width >= 3:\n",
    "        d1 = librosa.feature.delta(M, width=width, order=1)\n",
    "        d2 = librosa.feature.delta(M, width=width, order=2)\n",
    "    else:\n",
    "        d1 = d2 = np.full_like(M, np.nan)\n",
    "    regions = {\"sp\": b.vad_mask[:T], \"full\": np.ones(T, dtype=bool)}\n",
    "    n_mfcc = M.shape[0]\n",
    "    for region, mask in regions.items():\n",
    "        ok = mask.sum() >= min_frames\n",
    "        Mr, D1, D2 = M[:, mask], d1[:, mask], d2[:, mask]\n",
    "        for k in range(n_mfcc):\n",
    "            out[f\"m_{region}_mfcc{k}_mean\"] = float(Mr[k].mean()) if ok else np.nan\n",
    "            out[f\"m_{region}_mfcc{k}_std\"] = float(Mr[k].std(ddof=1)) if ok else np.nan\n",
    "            if region == \"sp\":\n",
    "                out[f\"m_sp_dmfcc{k}_std\"] = float(np.nanstd(D1[k], ddof=1)) if ok else np.nan\n",
    "                out[f\"m_sp_ddmfcc{k}_std\"] = float(np.nanstd(D2[k], ddof=1)) if ok else np.nan\n",
    "        if region != \"sp\":\n",
    "            continue\n",
    "        C = Mr[1:] if ok else np.zeros((n_mfcc - 1, 0))\n",
    "        if ok and C.shape[1] >= max(min_frames, 3):\n",
    "            out[\"m_sp_cepstral_variability\"] = float(C.std(axis=1, ddof=1).mean())\n",
    "            steps = np.linalg.norm(np.diff(C, axis=1), axis=0)\n",
    "            dur = C.shape[1] * b.hop / b.sr\n",
    "            out[\"m_sp_cepstral_traj_length_per_s\"] = float(steps.sum() / dur)\n",
    "            net = np.linalg.norm(C[:, -1] - C[:, 0])\n",
    "            out[\"m_sp_cepstral_traj_tortuosity\"] = float(steps.sum() / (net + 1e-6))\n",
    "            cov = np.cov(C) + 1e-6 * np.eye(C.shape[0])\n",
    "            sign, logdet = np.linalg.slogdet(cov)\n",
    "            out[\"m_sp_cov_logdet\"] = float(logdet) if sign > 0 else np.nan\n",
    "            out[\"m_sp_cov_trace\"] = float(np.trace(cov))\n",
    "            corr = np.corrcoef(C)\n",
    "            off = corr[np.triu_indices_from(corr, 1)]\n",
    "            out[\"m_sp_corr_mean_abs_offdiag\"] = float(np.nanmean(np.abs(off)))\n",
    "            lm = b.logmel[:, mask]\n",
    "            a, bb = lm[:, :-1], lm[:, 1:]\n",
    "            cos = (a * bb).sum(axis=0) / (np.linalg.norm(a, axis=0) * np.linalg.norm(bb, axis=0) + EPS)\n",
    "            out[\"m_sp_transition_rate\"] = float(np.mean(1 - cos))\n",
    "            out[\"m_sp_transition_rate_std\"] = float(np.std(1 - cos, ddof=1)) if len(cos) > 1 else np.nan\n",
    "        else:\n",
    "            for key in (\"m_sp_cepstral_variability\", \"m_sp_cepstral_traj_length_per_s\", \"m_sp_cepstral_traj_tortuosity\",\n",
    "                        \"m_sp_cov_logdet\", \"m_sp_cov_trace\", \"m_sp_corr_mean_abs_offdiag\", \"m_sp_transition_rate\",\n",
    "                        \"m_sp_transition_rate_std\"):\n",
    "                out[key] = np.nan\n",
    "    return out\n",
    "\n",
    "\n",
    "def stage_spectral_features(ctx) -> dict:\n",
    "    from .family_analysis import analyze_family\n",
    "\n",
    "    return analyze_family(ctx, family=\"SPECTRAL\", prefixes=(\"s_full_\", \"s_sp_\", \"s_bg_\", \"m_\"),\n",
    "                          split_by_correctness=False, control_quality=True)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-038",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/stats_utils.py\n",
    "\"\"\"Statistical helpers that return explicit NaN/status values on insufficient data.\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy import stats as sps\n",
    "\n",
    "\n",
    "def _clean_xy(x, y):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    mask = np.isfinite(x) & np.isfinite(y)\n",
    "    return x[mask], y[mask]\n",
    "\n",
    "\n",
    "def safe_corr(x, y, method: str = \"spearman\", min_n: int = 10) -> tuple[float, float, int]:\n",
    "    x, y = _clean_xy(x, y)\n",
    "    n = int(len(x))\n",
    "    if n < min_n or np.std(x) == 0 or np.std(y) == 0:\n",
    "        return np.nan, np.nan, n\n",
    "    if method == \"pearson\":\n",
    "        r, p = sps.pearsonr(x, y)\n",
    "    elif method == \"spearman\":\n",
    "        r, p = sps.spearmanr(x, y)\n",
    "    elif method == \"kendall\":\n",
    "        r, p = sps.kendalltau(x, y)\n",
    "    else:\n",
    "        raise ValueError(method)\n",
    "    return float(r), float(p), n\n",
    "\n",
    "\n",
    "def association_table(X: pd.DataFrame, y, methods=(\"pearson\", \"spearman\"), min_n: int = 10) -> pd.DataFrame:\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    rows = []\n",
    "    for col in X.columns:\n",
    "        row = {\"feature\": col}\n",
    "        values = pd.to_numeric(X[col], errors=\"coerce\").to_numpy(dtype=float)\n",
    "        for m in methods:\n",
    "            r, p, n = safe_corr(values, y, m, min_n)\n",
    "            row[f\"{m}_r\"], row[f\"{m}_p\"], row[\"n\"] = r, p, n\n",
    "        rows.append(row)\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def residualize(v: np.ndarray, Z: np.ndarray) -> np.ndarray:\n",
    "    Z1 = np.column_stack([np.ones(len(v)), Z]) if Z.size else np.ones((len(v), 1))\n",
    "    beta, *_ = np.linalg.lstsq(Z1, v, rcond=None)\n",
    "    return v - Z1 @ beta\n",
    "\n",
    "\n",
    "def partial_corr(x, y, Z, method: str = \"pearson\", min_n: int = 15) -> tuple[float, float, int]:\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    Z = np.asarray(Z, dtype=float)\n",
    "    if Z.ndim == 1:\n",
    "        Z = Z[:, None]\n",
    "    mask = np.isfinite(x) & np.isfinite(y) & np.all(np.isfinite(Z), axis=1)\n",
    "    n = int(mask.sum())\n",
    "    k = Z.shape[1]\n",
    "    if n < max(min_n, k + 5):\n",
    "        return np.nan, np.nan, n\n",
    "    xs, ys, Zs = x[mask], y[mask], Z[mask]\n",
    "    if method == \"spearman\":\n",
    "        xs, ys = sps.rankdata(xs), sps.rankdata(ys)\n",
    "        Zs = np.column_stack([sps.rankdata(Zs[:, j]) for j in range(k)])\n",
    "    rx, ry = residualize(xs, Zs), residualize(ys, Zs)\n",
    "    if np.std(rx) == 0 or np.std(ry) == 0:\n",
    "        return np.nan, np.nan, n\n",
    "    r = float(np.corrcoef(rx, ry)[0, 1])\n",
    "    dof = n - 2 - k\n",
    "    if dof <= 0 or abs(r) >= 1:\n",
    "        return r, np.nan, n\n",
    "    t = r * np.sqrt(dof / (1 - r ** 2))\n",
    "    p = float(2 * sps.t.sf(abs(t), dof))\n",
    "    return r, p, n\n",
    "\n",
    "\n",
    "def bh_fdr(pvalues) -> np.ndarray:\n",
    "    p = np.asarray(pvalues, dtype=float)\n",
    "    out = np.full_like(p, np.nan)\n",
    "    mask = np.isfinite(p)\n",
    "    if not mask.any():\n",
    "        return out\n",
    "    pv = p[mask]\n",
    "    order = np.argsort(pv)\n",
    "    ranked = pv[order] * len(pv) / (np.arange(len(pv)) + 1)\n",
    "    ranked = np.minimum.accumulate(ranked[::-1])[::-1]\n",
    "    adj = np.empty_like(pv)\n",
    "    adj[order] = np.clip(ranked, 0, 1)\n",
    "    out[mask] = adj\n",
    "    return out\n",
    "\n",
    "\n",
    "def bootstrap_ci(func, *arrays, n_boot: int = 1000, alpha: float = 0.05, seed: int = 0,\n",
    "                 groups=None) -> dict:\n",
    "    \"\"\"Percentile bootstrap; resamples whole groups (clusters) when given.\"\"\"\n",
    "    arrays = [np.asarray(a) for a in arrays]\n",
    "    n = len(arrays[0])\n",
    "    rng = np.random.default_rng(seed)\n",
    "    try:\n",
    "        estimate = float(func(*arrays))\n",
    "    except Exception:\n",
    "        estimate = np.nan\n",
    "    if n < 5:\n",
    "        return {\"estimate\": estimate, \"lower\": np.nan, \"upper\": np.nan, \"se\": np.nan, \"n_boot\": 0}\n",
    "    if groups is not None:\n",
    "        groups = np.asarray(groups)\n",
    "        uniq = np.unique(groups)\n",
    "        index_by_group = {g: np.flatnonzero(groups == g) for g in uniq}\n",
    "    stats = []\n",
    "    for _ in range(int(n_boot)):\n",
    "        if groups is None:\n",
    "            idx = rng.integers(0, n, n)\n",
    "        else:\n",
    "            chosen = rng.choice(uniq, size=len(uniq), replace=True)\n",
    "            idx = np.concatenate([index_by_group[g] for g in chosen])\n",
    "        try:\n",
    "            value = func(*[a[idx] for a in arrays])\n",
    "        except Exception:\n",
    "            continue\n",
    "        if np.isfinite(value):\n",
    "            stats.append(value)\n",
    "    if len(stats) < max(10, n_boot // 10):\n",
    "        return {\"estimate\": estimate, \"lower\": np.nan, \"upper\": np.nan, \"se\": np.nan, \"n_boot\": len(stats)}\n",
    "    arr = np.asarray(stats)\n",
    "    return {\"estimate\": estimate, \"lower\": float(np.quantile(arr, alpha / 2)),\n",
    "            \"upper\": float(np.quantile(arr, 1 - alpha / 2)), \"se\": float(arr.std(ddof=1)), \"n_boot\": len(arr)}\n",
    "\n",
    "\n",
    "def spearman_stat(x, y) -> float:\n",
    "    x, y = _clean_xy(x, y)\n",
    "    if len(x) < 5 or np.std(x) == 0 or np.std(y) == 0:\n",
    "        return np.nan\n",
    "    return float(sps.spearmanr(x, y)[0])\n",
    "\n",
    "\n",
    "def distance_correlation(x, y, max_n: int = 2000, seed: int = 0) -> float:\n",
    "    x, y = _clean_xy(x, y)\n",
    "    n = len(x)\n",
    "    if n < 10:\n",
    "        return np.nan\n",
    "    if n > max_n:\n",
    "        idx = np.random.default_rng(seed).choice(n, max_n, replace=False)\n",
    "        x, y = x[idx], y[idx]\n",
    "    a = np.abs(x[:, None] - x[None, :])\n",
    "    b = np.abs(y[:, None] - y[None, :])\n",
    "    A = a - a.mean(0) - a.mean(1)[:, None] + a.mean()\n",
    "    B = b - b.mean(0) - b.mean(1)[:, None] + b.mean()\n",
    "    dcov = (A * B).mean()\n",
    "    dvar = np.sqrt((A * A).mean() * (B * B).mean())\n",
    "    return float(np.sqrt(max(dcov, 0) / dvar)) if dvar > 0 else np.nan\n",
    "\n",
    "\n",
    "def mutual_information(X: pd.DataFrame, y, seed: int = 0, min_n: int = 20) -> pd.Series:\n",
    "    from sklearn.feature_selection import mutual_info_regression\n",
    "\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    out = {}\n",
    "    for col in X.columns:\n",
    "        x = pd.to_numeric(X[col], errors=\"coerce\").to_numpy(dtype=float)\n",
    "        mask = np.isfinite(x) & np.isfinite(y)\n",
    "        if mask.sum() < min_n or np.std(x[mask]) == 0:\n",
    "            out[col] = np.nan\n",
    "            continue\n",
    "        out[col] = float(mutual_info_regression(x[mask, None], y[mask], random_state=seed, n_neighbors=3)[0])\n",
    "    return pd.Series(out)\n",
    "\n",
    "\n",
    "def icc1(values, groups, min_groups: int = 3) -> float:\n",
    "    \"\"\"One-way random-effects ICC(1) with unequal group sizes.\"\"\"\n",
    "    df = pd.DataFrame({\"v\": np.asarray(values, dtype=float), \"g\": np.asarray(groups)}).dropna()\n",
    "    if df.empty:\n",
    "        return np.nan\n",
    "    stats = df.groupby(\"g\")[\"v\"].agg([\"count\", \"mean\", \"var\"])\n",
    "    stats = stats[stats[\"count\"] >= 2]\n",
    "    k = len(stats)\n",
    "    if k < min_groups:\n",
    "        return np.nan\n",
    "    N = stats[\"count\"].sum()\n",
    "    grand = (stats[\"count\"] * stats[\"mean\"]).sum() / N\n",
    "    ss_between = (stats[\"count\"] * (stats[\"mean\"] - grand) ** 2).sum()\n",
    "    ss_within = ((stats[\"count\"] - 1) * stats[\"var\"]).sum()\n",
    "    ms_between = ss_between / (k - 1)\n",
    "    ms_within = ss_within / (N - k) if N > k else np.nan\n",
    "    n0 = (N - (stats[\"count\"] ** 2).sum() / N) / (k - 1)\n",
    "    denom = ms_between + (n0 - 1) * ms_within\n",
    "    if not np.isfinite(denom) or denom <= 0:\n",
    "        return np.nan\n",
    "    return float((ms_between - ms_within) / denom)\n",
    "\n",
    "\n",
    "def variance_decomposition(values, groups) -> dict:\n",
    "    df = pd.DataFrame({\"v\": np.asarray(values, dtype=float), \"g\": np.asarray(groups)}).dropna()\n",
    "    if df.empty or df[\"g\"].nunique() < 2:\n",
    "        return {\"n\": len(df), \"n_groups\": int(df[\"g\"].nunique()) if not df.empty else 0,\n",
    "                \"between_var\": np.nan, \"within_var\": np.nan, \"icc1\": np.nan}\n",
    "    total = df[\"v\"].var(ddof=1)\n",
    "    group_means = df.groupby(\"g\")[\"v\"].transform(\"mean\")\n",
    "    within = (df[\"v\"] - group_means).var(ddof=1)\n",
    "    return {\"n\": int(len(df)), \"n_groups\": int(df[\"g\"].nunique()), \"total_var\": float(total),\n",
    "            \"between_var\": float(group_means.var(ddof=1)), \"within_var\": float(within),\n",
    "            \"icc1\": icc1(df[\"v\"], df[\"g\"])}\n",
    "\n",
    "\n",
    "def smd(a, b) -> float:\n",
    "    a = np.asarray(a, dtype=float)\n",
    "    b = np.asarray(b, dtype=float)\n",
    "    a, b = a[np.isfinite(a)], b[np.isfinite(b)]\n",
    "    if len(a) < 2 or len(b) < 2:\n",
    "        return np.nan\n",
    "    pooled = np.sqrt((a.var(ddof=1) + b.var(ddof=1)) / 2)\n",
    "    return float((a.mean() - b.mean()) / pooled) if pooled > 0 else np.nan\n",
    "\n",
    "\n",
    "def hedges_g(a, b) -> float:\n",
    "    a = np.asarray(a, dtype=float)\n",
    "    b = np.asarray(b, dtype=float)\n",
    "    a, b = a[np.isfinite(a)], b[np.isfinite(b)]\n",
    "    n1, n2 = len(a), len(b)\n",
    "    if n1 < 2 or n2 < 2:\n",
    "        return np.nan\n",
    "    sp = np.sqrt(((n1 - 1) * a.var(ddof=1) + (n2 - 1) * b.var(ddof=1)) / (n1 + n2 - 2))\n",
    "    if sp == 0:\n",
    "        return np.nan\n",
    "    d = (a.mean() - b.mean()) / sp\n",
    "    return float(d * (1 - 3 / (4 * (n1 + n2) - 9)))\n",
    "\n",
    "\n",
    "def cluster_robust_ols(y, X: pd.DataFrame, groups=None) -> pd.DataFrame:\n",
    "    \"\"\"OLS with HC1 (no groups) or CR1 cluster-robust standard errors.\"\"\"\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    Xv = np.column_stack([np.ones(len(y)), X.to_numpy(dtype=float)])\n",
    "    names = [\"intercept\"] + list(X.columns)\n",
    "    mask = np.isfinite(y) & np.all(np.isfinite(Xv), axis=1)\n",
    "    if groups is not None:\n",
    "        groups = np.asarray(groups)\n",
    "        mask &= pd.notna(groups)\n",
    "    y, Xv = y[mask], Xv[mask]\n",
    "    n, k = Xv.shape\n",
    "    if n <= k + 2:\n",
    "        return pd.DataFrame({\"term\": names, \"coef\": np.nan, \"se\": np.nan, \"t\": np.nan, \"p\": np.nan, \"n\": n})\n",
    "    XtX_inv = np.linalg.pinv(Xv.T @ Xv)\n",
    "    beta = XtX_inv @ Xv.T @ y\n",
    "    resid = y - Xv @ beta\n",
    "    if groups is None:\n",
    "        meat = (Xv * resid[:, None] ** 2).T @ Xv\n",
    "        V = XtX_inv @ meat @ XtX_inv * n / (n - k)\n",
    "        dof = n - k\n",
    "    else:\n",
    "        g = groups[mask]\n",
    "        uniq = pd.unique(g)\n",
    "        G = len(uniq)\n",
    "        meat = np.zeros((k, k))\n",
    "        for level in uniq:\n",
    "            idx = g == level\n",
    "            s = Xv[idx].T @ resid[idx]\n",
    "            meat += np.outer(s, s)\n",
    "        V = XtX_inv @ meat @ XtX_inv * (G / max(G - 1, 1)) * ((n - 1) / max(n - k, 1))\n",
    "        dof = max(G - 1, 1)\n",
    "    se = np.sqrt(np.clip(np.diag(V), 0, None))\n",
    "    t = np.divide(beta, se, out=np.full_like(beta, np.nan), where=se > 0)\n",
    "    p = 2 * sps.t.sf(np.abs(t), dof)\n",
    "    return pd.DataFrame({\"term\": names, \"coef\": beta, \"se\": se, \"t\": t, \"p\": p, \"n\": n})\n",
    "\n",
    "\n",
    "def permute_within_groups(n: int, groups, rng: np.random.Generator) -> np.ndarray:\n",
    "    idx = np.arange(n)\n",
    "    if groups is None:\n",
    "        return rng.permutation(n)\n",
    "    groups = np.asarray(groups)\n",
    "    out = idx.copy()\n",
    "    for g in pd.unique(groups):\n",
    "        members = np.flatnonzero(groups == g)\n",
    "        out[members] = rng.permutation(members)\n",
    "    return out\n",
    "\n",
    "\n",
    "def permutation_pvalue(x, y, n_perm: int = 1000, groups=None, seed: int = 0, stat=spearman_stat) -> dict:\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    mask = np.isfinite(x) & np.isfinite(y)\n",
    "    if groups is not None:\n",
    "        groups = np.asarray(groups)[mask]\n",
    "    x, y = x[mask], y[mask]\n",
    "    if len(x) < 10:\n",
    "        return {\"stat\": np.nan, \"p_perm\": np.nan, \"n\": len(x)}\n",
    "    rng = np.random.default_rng(seed)\n",
    "    observed = stat(x, y)\n",
    "    exceed = 0\n",
    "    valid = 0\n",
    "    for _ in range(int(n_perm)):\n",
    "        perm = permute_within_groups(len(y), groups, rng)\n",
    "        s = stat(x, y[perm])\n",
    "        if np.isfinite(s):\n",
    "            valid += 1\n",
    "            exceed += abs(s) >= abs(observed)\n",
    "    p = (exceed + 1) / (valid + 1) if valid else np.nan\n",
    "    return {\"stat\": observed, \"p_perm\": p, \"n\": len(x), \"n_perm\": valid}\n",
    "\n",
    "\n",
    "def bimodality_coefficient(x) -> float:\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    x = x[np.isfinite(x)]\n",
    "    n = len(x)\n",
    "    if n < 10:\n",
    "        return np.nan\n",
    "    g = sps.skew(x, bias=False)\n",
    "    k = sps.kurtosis(x, bias=False)\n",
    "    return float((g ** 2 + 1) / (k + 3 * (n - 1) ** 2 / ((n - 2) * (n - 3))))\n",
    "\n",
    "\n",
    "def robust_z(x: pd.Series) -> pd.Series:\n",
    "    med = x.median()\n",
    "    mad = (x - med).abs().median() * 1.4826\n",
    "    if not np.isfinite(mad) or mad == 0:\n",
    "        sd = x.std()\n",
    "        return (x - x.mean()) / sd if sd and np.isfinite(sd) and sd > 0 else x * np.nan\n",
    "    return (x - med) / mad\n",
    "\n",
    "\n",
    "def quantile_bins(x: pd.Series, q: int, min_count: int = 10, labels_prefix: str = \"Q\") -> pd.Series:\n",
    "    \"\"\"Quantile bins; reduces the number of bins until each has min_count members.\"\"\"\n",
    "    x = pd.to_numeric(x, errors=\"coerce\")\n",
    "    for k in range(q, 1, -1):\n",
    "        try:\n",
    "            bins = pd.qcut(x, k, duplicates=\"drop\")\n",
    "        except ValueError:\n",
    "            continue\n",
    "        counts = bins.value_counts()\n",
    "        if len(counts) >= 2 and counts.min() >= min_count:\n",
    "            codes = bins.cat.codes.astype(float).where(bins.notna())\n",
    "            return codes.map(lambda c: f\"{labels_prefix}{int(c) + 1}\" if np.isfinite(c) else np.nan)\n",
    "    return pd.Series(np.nan, index=x.index, dtype=object)\n",
    "\n",
    "\n",
    "def cramers_v(a, b) -> float:\n",
    "    tab = pd.crosstab(pd.Series(a), pd.Series(b))\n",
    "    if tab.shape[0] < 2 or tab.shape[1] < 2:\n",
    "        return np.nan\n",
    "    chi2 = sps.chi2_contingency(tab, correction=False)[0]\n",
    "    n = tab.to_numpy().sum()\n",
    "    r, k = tab.shape\n",
    "    return float(np.sqrt(chi2 / (n * (min(r, k) - 1))))\n",
    "\n",
    "\n",
    "def robust_stats(values, prefix: str, stats: list, min_n: int = 5) -> dict:\n",
    "    \"\"\"Robust summary statistics with NaN for insufficient observations.\"\"\"\n",
    "    x = np.asarray(values, dtype=float)\n",
    "    x = x[np.isfinite(x)]\n",
    "    n = len(x)\n",
    "    out: dict = {}\n",
    "    for s in stats:\n",
    "        key = f\"{prefix}_{s}\"\n",
    "        if n == 0:\n",
    "            out[key] = np.nan\n",
    "            continue\n",
    "        if s == \"mean\":\n",
    "            out[key] = float(x.mean())\n",
    "        elif s == \"std\":\n",
    "            out[key] = float(x.std(ddof=1)) if n >= 2 else np.nan\n",
    "        elif s == \"median\":\n",
    "            out[key] = float(np.median(x))\n",
    "        elif s == \"mad\":\n",
    "            out[key] = float(np.median(np.abs(x - np.median(x)))) if n >= 2 else np.nan\n",
    "        elif s == \"min\":\n",
    "            out[key] = float(x.min())\n",
    "        elif s == \"max\":\n",
    "            out[key] = float(x.max())\n",
    "        elif s.startswith(\"p\") and s[1:].isdigit():\n",
    "            out[key] = float(np.percentile(x, int(s[1:]))) if n >= 2 else np.nan\n",
    "        elif s == \"iqr\":\n",
    "            out[key] = float(np.percentile(x, 75) - np.percentile(x, 25)) if n >= 4 else np.nan\n",
    "        elif s == \"skewness\":\n",
    "            out[key] = float(sps.skew(x)) if n >= max(min_n, 3) and np.std(x) > 0 else np.nan\n",
    "        elif s == \"kurtosis\":\n",
    "            out[key] = float(sps.kurtosis(x)) if n >= max(min_n, 4) and np.std(x) > 0 else np.nan\n",
    "        elif s == \"cv\":\n",
    "            m = x.mean()\n",
    "            out[key] = float(x.std(ddof=1) / abs(m)) if n >= 2 and abs(m) > 1e-9 else np.nan\n",
    "        elif s == \"count\":\n",
    "            out[key] = float(n)\n",
    "        else:\n",
    "            raise ValueError(f\"unknown statistic {s}\")\n",
    "    return out\n",
    "\n",
    "\n",
    "def linear_slope(x, y) -> float:\n",
    "    x, y = _clean_xy(x, y)\n",
    "    if len(x) < 3 or np.var(x) == 0:\n",
    "        return np.nan\n",
    "    return float(np.polyfit(x, y, 1)[0])\n",
    "\n",
    "\n",
    "def shrink_towards(estimates: pd.Series, counts: pd.Series, prior: float, k: float) -> pd.Series:\n",
    "    w = counts / (counts + k)\n",
    "    return w * estimates.fillna(prior) + (1 - w) * prior\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-039",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/student_aggregation.py\n",
    "\"\"\"Section 13 - intelligent student-level aggregation.\n",
    "\n",
    "The target is student-level: clips are never treated as independent labelled\n",
    "regression examples. This engine converts clip-level measurements into\n",
    "student-level representations (global, conditional, cross-task,\n",
    "item-conditioned, complexity-sensitivity and correctness-contrast features)\n",
    "with observation counts, reliability flags and missingness indicators.\n",
    "\n",
    "Item reference statistics used for item adjustment are fitted on training\n",
    "students only; for predictive evaluation they are refitted within each fold\n",
    "(see ``fold_features.FoldFeatureBuilder``). Difficulty-conditioned aggregates\n",
    "(``__diff=``) use all-training item parameters and are EDA-only.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .families import columns_by_family, sanitize_token\n",
    "\n",
    "DEFAULT_CORE = [\n",
    "    \"q_duration_s\", \"q_snr_db_approx\", \"t_active_dur\", \"t_active_ratio\", \"t_initial_sil\", \"t_internal_sil\",\n",
    "    \"t_n_pauses\", \"t_pause_speech_ratio\", \"t_pause_dur_mean\", \"t_n_segments\", \"t_rhythm_regularity\",\n",
    "    \"t_temporal_entropy\", \"t_mod_freq_hz\", \"t_onset_sharpness\", \"s_sp_centroid_mean\", \"s_sp_bandwidth_mean\",\n",
    "    \"s_sp_flatness_mean\", \"s_sp_entropy_mean\", \"s_sp_flux_mean\", \"s_sp_zcr_mean\", \"s_sp_slope_mean\",\n",
    "    \"s_sp_tf_entropy\", \"m_sp_cepstral_variability\", \"m_sp_transition_rate\", \"m_sp_cepstral_traj_length_per_s\",\n",
    "    \"w_db4_entropy\", \"w_db4_transient_density\", \"w_wp_entropy\", \"p_f0_std_st\", \"p_voiced_frac\", \"p_hnr_db_median\",\n",
    "]\n",
    "CLIP_PREFIXES = (\"q_\", \"t_\", \"s_\", \"m_\", \"w_\", \"p_\", \"ph_\", \"meta_\", \"e_\")\n",
    "QUANTILE_STATS = {\"p05\": 0.05, \"p10\": 0.10, \"p25\": 0.25, \"p75\": 0.75, \"p90\": 0.90, \"p95\": 0.95}\n",
    "\n",
    "\n",
    "def numeric_clip_features(df: pd.DataFrame) -> list:\n",
    "    return [c for c in df.columns if c.startswith(CLIP_PREFIXES) and pd.api.types.is_numeric_dtype(df[c])\n",
    "            and not c.startswith(\"meta_decode\")]\n",
    "\n",
    "\n",
    "def core_features(available: list, cfg: dict) -> list:\n",
    "    core = cfg.get(\"aggregation_core_features\") or DEFAULT_CORE\n",
    "    core = [c for c in core if c in available]\n",
    "    ph_conf = [c for c in available if c.startswith(\"ph_\") and c.endswith((\"_seq_confidence\", \"_phone_er\", \"_word_er\"))]\n",
    "    return core + [c for c in ph_conf if c not in core]\n",
    "\n",
    "\n",
    "def group_stats(df: pd.DataFrame, key: str, feats: list, stats: list, min_obs: int) -> pd.DataFrame:\n",
    "    if not feats:\n",
    "        return pd.DataFrame(index=pd.Index(df[key].unique(), name=key))\n",
    "    g = df.groupby(key, sort=False)[feats]\n",
    "    parts = []\n",
    "    count = g.count()\n",
    "    if \"mean\" in stats or \"cv\" in stats:\n",
    "        mean = g.mean()\n",
    "    for s in stats:\n",
    "        if s == \"mean\":\n",
    "            frame = mean\n",
    "        elif s == \"median\":\n",
    "            frame = g.median()\n",
    "        elif s == \"std\":\n",
    "            frame = g.std(ddof=1)\n",
    "        elif s == \"min\":\n",
    "            frame = g.min()\n",
    "        elif s == \"max\":\n",
    "            frame = g.max()\n",
    "        elif s in QUANTILE_STATS:\n",
    "            frame = g.quantile(QUANTILE_STATS[s])\n",
    "        elif s == \"iqr\":\n",
    "            frame = g.quantile(0.75) - g.quantile(0.25)\n",
    "        elif s == \"mad\":\n",
    "            med = g.transform(\"median\")\n",
    "            frame = (df[feats] - med).abs().groupby(df[key], sort=False).median()\n",
    "        elif s == \"cv\":\n",
    "            sd = g.std(ddof=1)\n",
    "            frame = (sd / mean.abs().where(mean.abs() > 1e-9)).where(count >= min_obs)\n",
    "        elif s == \"count\":\n",
    "            frame = count.astype(float)\n",
    "        else:\n",
    "            raise ValueError(s)\n",
    "        if s in {\"std\", \"mad\", \"iqr\"} or s in QUANTILE_STATS:\n",
    "            frame = frame.where(count >= (2 if s == \"std\" else min_obs))\n",
    "        frame = frame.copy()\n",
    "        frame.columns = [f\"{c}__{s}\" for c in feats]\n",
    "        parts.append(frame)\n",
    "    return pd.concat(parts, axis=1)\n",
    "\n",
    "\n",
    "def conditional_stats(df: pd.DataFrame, cond: str, label: str, feats: list, stats: list, min_obs: int) -> pd.DataFrame:\n",
    "    d = df.dropna(subset=[cond])\n",
    "    if d.empty or not feats:\n",
    "        return pd.DataFrame()\n",
    "    pieces = []\n",
    "    for level, g in d.groupby(cond):\n",
    "        st = group_stats(g, \"student_id\", feats, stats + [\"count\"] if \"count\" not in stats else stats, min_obs)\n",
    "        tag = f\"{label}={sanitize_token(level)}\"\n",
    "        st.columns = [c.replace(\"__\", f\"__{tag}__\", 1) for c in st.columns]\n",
    "        pieces.append(st)\n",
    "    return pd.concat(pieces, axis=1)\n",
    "\n",
    "\n",
    "def shrunk_slopes(df: pd.DataFrame, group: str, x: str, y: str, k: float, min_obs: int) -> pd.DataFrame:\n",
    "    \"\"\"Per-group OLS slopes shrunk towards the pooled within-group slope (empirical Bayes style).\"\"\"\n",
    "    d = df[[group, x, y]].dropna()\n",
    "    if d.empty:\n",
    "        return pd.DataFrame(columns=[\"slope_raw\", \"slope_shrunk\", \"n\", \"reliable\"])\n",
    "    g = d.groupby(group)\n",
    "    dx = d[x] - g[x].transform(\"mean\")\n",
    "    dy = d[y] - g[y].transform(\"mean\")\n",
    "    n = g.size()\n",
    "    sxx = (dx ** 2).groupby(d[group]).sum()\n",
    "    sxy = (dx * dy).groupby(d[group]).sum()\n",
    "    raw = sxy / sxx.where(sxx > 1e-12)\n",
    "    pooled = float(sxy.sum() / sxx.sum()) if sxx.sum() > 0 else np.nan\n",
    "    w = n / (n + k)\n",
    "    reliable = (n >= min_obs) & (sxx > 1e-12)\n",
    "    shrunk = (w * raw + (1 - w) * pooled).where(reliable, pooled)\n",
    "    return pd.DataFrame({\"slope_raw\": raw, \"slope_shrunk\": shrunk, \"n\": n, \"reliable\": reliable.astype(float)})\n",
    "\n",
    "\n",
    "def item_reference(fit: pd.DataFrame, feats: list, k: float) -> dict:\n",
    "    task_mean = fit.groupby(\"task_family\")[feats].mean()\n",
    "    task_sd = fit.groupby(\"task_family\")[feats].std(ddof=1)\n",
    "    g = fit.groupby(\"item_key\")\n",
    "    n = g[feats].count()\n",
    "    m = g[feats].mean()\n",
    "    task_of_item = g[\"task_family\"].first()\n",
    "    prior = task_mean.reindex(task_of_item.values)\n",
    "    prior.index = task_of_item.index\n",
    "    shrunk = (n * m.fillna(0) + k * prior) / (n + k)\n",
    "    return {\"item_mean\": shrunk, \"task_mean\": task_mean, \"task_sd\": task_sd.replace(0, np.nan)}\n",
    "\n",
    "\n",
    "def apply_item_reference(clips: pd.DataFrame, feats: list, ref: dict) -> pd.DataFrame:\n",
    "    mu = ref[\"item_mean\"].reindex(clips[\"item_key\"]).to_numpy()\n",
    "    fallback = ref[\"task_mean\"].reindex(clips[\"task_family\"]).to_numpy()\n",
    "    mu = np.where(np.isnan(mu), fallback, mu)\n",
    "    sd = ref[\"task_sd\"].reindex(clips[\"task_family\"]).to_numpy()\n",
    "    z = (clips[feats].to_numpy(dtype=float) - mu) / sd\n",
    "    return pd.DataFrame(z, columns=feats, index=clips.index)\n",
    "\n",
    "\n",
    "def item_adjusted_features(clips: pd.DataFrame, feats: list, fit_students, k: float, prefix: str = \"ia_\") -> pd.DataFrame:\n",
    "    feats = [f for f in feats if f in clips.columns]\n",
    "    if not feats or \"item_key\" not in clips.columns or clips[\"item_key\"].isna().all():\n",
    "        return pd.DataFrame()\n",
    "    fit = clips[clips[\"student_id\"].isin(set(fit_students))]\n",
    "    ref = item_reference(fit, feats, k)\n",
    "    z = apply_item_reference(clips, feats, ref)\n",
    "    z[\"student_id\"] = clips[\"student_id\"].to_numpy()\n",
    "    z[\"task_family\"] = clips[\"task_family\"].to_numpy()\n",
    "    g = z.groupby(\"student_id\")[feats]\n",
    "    out = pd.concat([g.mean().add_prefix(prefix).add_suffix(\"__mean\"), g.std(ddof=1).add_prefix(prefix).add_suffix(\"__std\")], axis=1)\n",
    "    for task, gt in z.groupby(\"task_family\"):\n",
    "        out = out.join(gt.groupby(\"student_id\")[feats].mean().add_prefix(prefix).add_suffix(f\"__task={sanitize_token(task)}__mean\"))\n",
    "    alias = {\"item_adjusted_duration\": [\"t_active_dur\"],\n",
    "             \"item_adjusted_spectral_features\": [f for f in feats if f.startswith(\"s_sp_\")],\n",
    "             \"item_adjusted_phonetic_confidence\": [f for f in feats if f.startswith(\"ph_\") and f.endswith(\"seq_confidence\")],\n",
    "             \"item_adjusted_fluency\": [\"t_pause_speech_ratio\", \"t_n_pauses\", \"t_internal_sil\"]}\n",
    "    means = g.mean()\n",
    "    for name, cols in alias.items():\n",
    "        cols = [c for c in cols if c in means.columns]\n",
    "        if cols:\n",
    "            sign = -1.0 if name == \"item_adjusted_fluency\" else 1.0\n",
    "            out[f\"{prefix}{name}\"] = sign * means[cols].mean(axis=1)\n",
    "    out[f\"{prefix}item_adjusted_acoustic_variability\"] = g.std(ddof=1).mean(axis=1)\n",
    "    out.index.name = \"student_id\"\n",
    "    return out\n",
    "\n",
    "\n",
    "def accuracy_features(clips: pd.DataFrame, k: float = 5.0) -> pd.DataFrame:\n",
    "    out = pd.DataFrame(index=pd.Index(clips[\"student_id\"].unique(), name=\"student_id\"))\n",
    "    out[\"meta_n_clips\"] = clips.groupby(\"student_id\").size()\n",
    "    out[\"meta_n_tasks\"] = clips.groupby(\"student_id\")[\"task_family\"].nunique()\n",
    "    for task, g in clips.groupby(\"task_family\"):\n",
    "        out[f\"acc_n_attempted_{task}\"] = g.groupby(\"student_id\").size()\n",
    "    out = out.fillna({c: 0 for c in out.columns if c.startswith(\"acc_n_attempted_\")})\n",
    "    if \"correct\" not in clips.columns or clips[\"correct\"].notna().sum() == 0:\n",
    "        return out\n",
    "    out[\"acc_all\"] = clips.groupby(\"student_id\")[\"correct\"].mean()\n",
    "    out[\"acc_n_scored_all\"] = clips.groupby(\"student_id\")[\"correct\"].count()\n",
    "    for task, g in clips.groupby(\"task_family\"):\n",
    "        gs = g.groupby(\"student_id\")[\"correct\"]\n",
    "        mean, n = gs.mean(), gs.count()\n",
    "        prior = g[\"correct\"].mean()\n",
    "        out[f\"acc_{task}\"] = mean\n",
    "        out[f\"acc_{task}_n\"] = n\n",
    "        out[f\"acc_{task}_shrunk\"] = (mean * n + prior * k) / (n + k)\n",
    "    return out\n",
    "\n",
    "\n",
    "def correctness_contrasts(clips: pd.DataFrame, feats: dict, min_obs: int) -> pd.DataFrame:\n",
    "    if \"correct\" not in clips.columns:\n",
    "        return pd.DataFrame()\n",
    "    frames = []\n",
    "    tasks = [(\"all\", clips)] + list(clips.groupby(\"task_family\"))\n",
    "    for task, g in tasks:\n",
    "        for label, col in feats.items():\n",
    "            if col not in g.columns:\n",
    "                continue\n",
    "            c = g[g[\"correct\"] == 1].groupby(\"student_id\")[col].agg([\"mean\", \"var\", \"count\"])\n",
    "            i = g[g[\"correct\"] == 0].groupby(\"student_id\")[col].agg([\"mean\", \"var\", \"count\"])\n",
    "            j = c.join(i, lsuffix=\"_c\", rsuffix=\"_i\", how=\"outer\")\n",
    "            name = f\"cc_correct_minus_incorrect_{label}__{sanitize_token(task)}\"\n",
    "            ok = (j[\"count_c\"] >= min_obs) & (j[\"count_i\"] >= min_obs)\n",
    "            diff = (j[\"mean_c\"] - j[\"mean_i\"]).where(ok)\n",
    "            se = np.sqrt(j[\"var_c\"] / j[\"count_c\"] + j[\"var_i\"] / j[\"count_i\"]).where(ok)\n",
    "            frames.append(pd.DataFrame({name: diff, f\"{name}_se\": se,\n",
    "                                        f\"{name}_n_min\": j[[\"count_c\", \"count_i\"]].min(axis=1).fillna(0)}))\n",
    "    return pd.concat(frames, axis=1) if frames else pd.DataFrame()\n",
    "\n",
    "\n",
    "def complexity_sensitivity(clips: pd.DataFrame, feats: list, cplx: str, k: float, min_obs: int) -> pd.DataFrame:\n",
    "    frames = []\n",
    "    targets = [f for f in feats if f in clips.columns] + ([\"correct\"] if \"correct\" in clips.columns else [])\n",
    "    for task, g in [(\"all\", clips)] + list(clips.groupby(\"task_family\")):\n",
    "        for f in targets:\n",
    "            sl = shrunk_slopes(g, \"student_id\", cplx, f, k, min_obs)\n",
    "            if sl.empty:\n",
    "                continue\n",
    "            name = f\"cx_{f}__vs_{cplx}__{sanitize_token(task)}\"\n",
    "            frames.append(pd.DataFrame({name: sl[\"slope_shrunk\"], f\"{name}_reliable\": sl[\"reliable\"], f\"{name}_n\": sl[\"n\"]}))\n",
    "    return pd.concat(frames, axis=1) if frames else pd.DataFrame()\n",
    "\n",
    "\n",
    "def cross_task(clips: pd.DataFrame, core: list, acc: pd.DataFrame) -> pd.DataFrame:\n",
    "    tasks = sorted(clips[\"task_family\"].dropna().unique())\n",
    "    out = pd.DataFrame(index=pd.Index(clips[\"student_id\"].unique(), name=\"student_id\"))\n",
    "    if len(tasks) < 2:\n",
    "        return out\n",
    "    means = clips.groupby([\"student_id\", \"task_family\"])[core].mean()\n",
    "    sds = clips.groupby(\"student_id\")[core].std(ddof=1)\n",
    "    asym = []\n",
    "    for f in core:\n",
    "        wide = means[f].unstack()\n",
    "        for i, a in enumerate(tasks):\n",
    "            for b in tasks[i + 1:]:\n",
    "                if a in wide.columns and b in wide.columns:\n",
    "                    out[f\"xt_{f}__{a}_minus_{b}\"] = wide[a] - wide[b]\n",
    "                    asym.append(((wide[a] - wide[b]).abs() / sds[f].where(sds[f] > 0)).rename(f))\n",
    "        out[f\"xt_{f}__between_task_std\"] = wide.std(axis=1, ddof=1)\n",
    "    if asym:\n",
    "        out[\"xt_acoustic_asymmetry\"] = pd.concat(asym, axis=1).mean(axis=1)\n",
    "    acc_cols = [f\"acc_{t}\" for t in tasks if f\"acc_{t}\" in acc.columns]\n",
    "    if len(acc_cols) >= 2:\n",
    "        out[\"xt_skill_asymmetry_accuracy_range\"] = acc[acc_cols].max(axis=1) - acc[acc_cols].min(axis=1)\n",
    "        out[\"xt_accuracy_between_task_std\"] = acc[acc_cols].std(axis=1, ddof=1)\n",
    "        out[\"xt_strongest_task_accuracy_gap\"] = acc[acc_cols].max(axis=1) - acc[acc_cols].median(axis=1)\n",
    "    return out\n",
    "\n",
    "\n",
    "def build_student_features(ctx, split: str) -> tuple[pd.DataFrame, dict]:\n",
    "    cfg = ctx.config\n",
    "    min_obs = int(cfg[\"aggregation_min_obs\"])\n",
    "    k_slope = float(cfg[\"slope_shrinkage_k\"])\n",
    "    sm = da.students(ctx, split).set_index(\"student_id\")\n",
    "    clips = da.clip_table(ctx, split, with_audio=ctx.stage_available(\"06\"))\n",
    "    report: dict = {\"split\": split}\n",
    "    feats = numeric_clip_features(clips)\n",
    "    core = core_features(feats, cfg)\n",
    "    report[\"n_clip_features\"] = len(feats)\n",
    "    report[\"core_features\"] = core\n",
    "    out = pd.DataFrame(index=sm.index)\n",
    "    acc = accuracy_features(clips)\n",
    "    out = out.join(acc)\n",
    "    glob = group_stats(clips, \"student_id\", [f for f in feats if f not in core], list(cfg[\"aggregation_global_stats\"]), min_obs)\n",
    "    core_stats = group_stats(clips, \"student_id\", core, list(cfg[\"aggregation_core_stats\"]), min_obs)\n",
    "    out = out.join(glob).join(core_stats)\n",
    "    ling = [c for c in clips.columns if c.startswith(\"l_\") and pd.api.types.is_numeric_dtype(clips[c])]\n",
    "    if ling:\n",
    "        out = out.join(group_stats(clips, \"student_id\", ling, [\"mean\", \"max\"], min_obs))\n",
    "        out = out.join(conditional_stats(clips, \"task_family\", \"task\", ling, [\"mean\"], min_obs))\n",
    "    if core:\n",
    "        cond_stats = [\"mean\", \"std\"]\n",
    "        out = out.join(conditional_stats(clips, \"task_family\", \"task\", core, cond_stats, min_obs))\n",
    "        if \"correct\" in clips.columns:\n",
    "            out = out.join(conditional_stats(clips, \"correct\", \"corr\", core, cond_stats, min_obs))\n",
    "        if \"item_b\" in clips.columns and clips[\"item_b\"].notna().any():\n",
    "            items = clips.drop_duplicates(\"item_key\")[\"item_b\"]\n",
    "            lo, hi = items.quantile([1 / 3, 2 / 3])\n",
    "            clips[\"diff_level\"] = pd.cut(clips[\"item_b\"], [-np.inf, lo, hi, np.inf], labels=[\"low\", \"mid\", \"high\"])\n",
    "            out = out.join(conditional_stats(clips, \"diff_level\", \"diff\", core, cond_stats, min_obs))\n",
    "        cplx = next((c for c in (\"l_n_phonemes\", \"l_n_chars\") if c in clips.columns and clips[c].notna().any()), None)\n",
    "        if cplx:\n",
    "            item_cplx = ctx.load_df(\"item_linguistic_features\")[cplx]\n",
    "            lo, hi = item_cplx.quantile([1 / 3, 2 / 3])\n",
    "            clips[\"cplx_level\"] = pd.cut(clips[cplx], [-np.inf, lo, hi, np.inf], labels=[\"low\", \"mid\", \"high\"])\n",
    "            out = out.join(conditional_stats(clips, \"cplx_level\", \"cplx\", core, cond_stats, min_obs))\n",
    "        if \"q_snr_db_approx\" in clips.columns:\n",
    "            qual = pd.Series(np.where(clips[\"q_snr_db_approx\"] >= float(cfg[\"quality_good_snr_db\"]), \"good\", \"poor\"),\n",
    "                             index=clips.index, dtype=object)\n",
    "            clips[\"qual_level\"] = qual.where(clips[\"q_snr_db_approx\"].notna())\n",
    "            out = out.join(conditional_stats(clips, \"qual_level\", \"qual\", core, cond_stats, min_obs))\n",
    "        if \"q_duration_s\" in clips.columns:\n",
    "            clips[\"len_level\"] = pd.cut(clips[\"q_duration_s\"], cfg[\"length_bins_s\"], labels=False, include_lowest=True)\n",
    "            out = out.join(conditional_stats(clips, \"len_level\", \"len\", core, cond_stats, min_obs))\n",
    "        if \"t_active_ratio\" in clips.columns:\n",
    "            clips[\"act_level\"] = pd.cut(clips[\"t_active_ratio\"], cfg[\"activity_bins\"], labels=False, include_lowest=True)\n",
    "            out = out.join(conditional_stats(clips, \"act_level\", \"act\", core, cond_stats, min_obs))\n",
    "        order_ok = ctx.stage_available(\"05\") and (ctx.load_json(\"order_validity\", required=False) or {}).get(\"valid\")\n",
    "        if order_ok:\n",
    "            key = ctx.load_json(\"order_validity\")[\"source\"]\n",
    "            rank = clips.groupby([\"student_id\", \"task_family\"])[key].rank(pct=True)\n",
    "            stage = pd.Series(np.where(rank <= 0.5, \"early\", \"late\"), index=clips.index, dtype=object)\n",
    "            clips[\"stage_level\"] = stage.where(rank.notna())\n",
    "            out = out.join(conditional_stats(clips, \"stage_level\", \"stage\", core, cond_stats, min_obs))\n",
    "        phc = next((c for c in clips.columns if c.startswith(\"ph_\") and c.endswith(\"_seq_confidence\")), None)\n",
    "        if phc:\n",
    "            clips[\"phconf_level\"] = pd.cut(clips[phc], cfg[\"phonetic_confidence_bins\"], labels=False, include_lowest=True)\n",
    "            out = out.join(conditional_stats(clips, \"phconf_level\", \"phconf\", core, cond_stats, min_obs))\n",
    "        out = out.join(cross_task(clips, core, acc))\n",
    "        contrast_map = {\"duration\": \"t_active_dur\", \"pause_ratio\": \"t_pause_speech_ratio\",\n",
    "                        \"spectral_entropy\": \"s_sp_entropy_mean\",\n",
    "                        \"wavelet_entropy\": f\"w_{cfg['wavelet_primary_family']}_entropy\"}\n",
    "        if phc:\n",
    "            contrast_map[\"phoneme_confidence\"] = phc\n",
    "        out = out.join(correctness_contrasts(clips, contrast_map, max(2, min_obs - 1)))\n",
    "        if cplx:\n",
    "            cx_feats = [f for f in (\"t_active_dur\", \"t_n_pauses\", \"t_pause_speech_ratio\", \"s_sp_entropy_std\", \"m_sp_cepstral_variability\") if f in clips.columns]\n",
    "            if phc:\n",
    "                cx_feats.append(phc)\n",
    "            out = out.join(complexity_sensitivity(clips, cx_feats, cplx, k_slope, min_obs))\n",
    "        train_students = da.students(ctx, \"train\")[\"student_id\"]\n",
    "        ref_clips = da.clip_table(ctx, \"train\", with_audio=True) if split != \"train\" else clips\n",
    "        both = pd.concat([ref_clips, clips], ignore_index=True) if split != \"train\" else clips\n",
    "        ia = item_adjusted_features(both, core, train_students, float(cfg[\"item_shrinkage_k\"]))\n",
    "        if not ia.empty:\n",
    "            out = out.join(ia.reindex(out.index))\n",
    "    tab_sources = [(\"03\", \"screening_features\" if split == \"train\" else \"screening_features_test\"),\n",
    "                   (\"04\", \"irt_student_features\"), (\"05\", \"trajectory_features\"),\n",
    "                   (\"23\", \"embedding_student_features\" if split == \"train\" else \"embedding_student_features_test\")]\n",
    "    for stage, name in tab_sources:\n",
    "        if ctx.stage_available(stage) and ctx.has(name):\n",
    "            tab = ctx.load_df(name).set_index(\"student_id\")\n",
    "            tab = tab[[c for c in tab.columns if c not in out.columns]]\n",
    "            out = out.join(tab)\n",
    "            report[f\"merged_{name}\"] = int(tab.shape[1])\n",
    "    if not any(c.startswith(\"theta_\") for c in out.columns):\n",
    "        raw = [c for c in sm.columns if c.startswith(\"theta_\")]\n",
    "        out = out.join(sm[raw])\n",
    "    fams = columns_by_family(out.columns)\n",
    "    for fam, cols in fams.items():\n",
    "        out[f\"meta_missing_{fam.lower()}\"] = out[cols].isna().all(axis=1).astype(float)\n",
    "    if \"proc_status\" in clips.columns:\n",
    "        out[\"meta_frac_failed_audio\"] = clips.groupby(\"student_id\")[\"proc_status\"].apply(lambda s: float((s == \"FAILED\").mean()))\n",
    "    if \"q_n_flags\" in clips.columns:\n",
    "        out[\"meta_frac_quality_flagged\"] = clips.groupby(\"student_id\")[\"q_n_flags\"].apply(lambda s: float((s > 0).mean()))\n",
    "    if \"audio_sample_rate\" in clips.columns:\n",
    "        out[\"meta_orig_sr_mode\"] = clips.groupby(\"student_id\")[\"audio_sample_rate\"].agg(lambda s: s.mode().iloc[0] if s.notna().any() else np.nan)\n",
    "    out = out.replace([np.inf, -np.inf], np.nan)\n",
    "    out = out.loc[:, ~out.columns.duplicated()]\n",
    "    report[\"n_students\"] = int(len(out))\n",
    "    report[\"n_features\"] = int(out.shape[1])\n",
    "    report[\"family_counts\"] = {k: len(v) for k, v in columns_by_family(out.columns).items()}\n",
    "    return out, report\n",
    "\n",
    "\n",
    "def stage_student_aggregation(ctx) -> dict:\n",
    "    feats, report = build_student_features(ctx, \"train\")\n",
    "    if feats.index.duplicated().any():\n",
    "        raise RuntimeError(\"student feature table has duplicated students\")\n",
    "    ctx.save_df(feats.reset_index(), \"student_features\")\n",
    "    outputs = [\"student_features\"]\n",
    "    reports = {\"train\": report}\n",
    "    if ctx.config.get(\"allow_test_inference\"):\n",
    "        tfeats, trep = build_student_features(ctx, \"test\")\n",
    "        missing_cols = [c for c in feats.columns if c not in tfeats.columns]\n",
    "        tfeats = tfeats.reindex(columns=feats.columns)\n",
    "        trep[\"columns_missing_in_test\"] = len(missing_cols)\n",
    "        ctx.save_df(tfeats.reset_index(), \"student_features_test\")\n",
    "        outputs.append(\"student_features_test\")\n",
    "        reports[\"test\"] = trep\n",
    "    ctx.save_json(reports, \"aggregation_report\")\n",
    "    outputs.append(\"aggregation_report\")\n",
    "    fam = pd.Series(report[\"family_counts\"]).sort_values()\n",
    "    fig, axes = viz.new_figure(1, 2, (6, 4.5))\n",
    "    fam.plot(kind=\"barh\", ax=axes[0, 0])\n",
    "    viz.finalize_axis(axes[0, 0], \"Student-level features per family\", \"features\", \"family\", report[\"n_students\"])\n",
    "    miss = feats.isna().mean()\n",
    "    viz.hist_kde(axes[0, 1], miss.to_numpy(), \"per-feature missing rate\")\n",
    "    ctx.figure(fig, \"aggregation_overview\", \"Student-level aggregation overview\",\n",
    "               \"What student representation was built?\", \"student_features\", report[\"n_students\"],\n",
    "               f\"{report['n_features']} features; median missing rate {miss.median():.1%}.\")\n",
    "    return {\"outputs\": outputs, \"summary\": {\"n_students\": report[\"n_students\"], \"n_features\": report[\"n_features\"]}}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-040",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/submission.py\n",
    "\"\"\"Section 27 - submission generation (disabled by default).\n",
    "\n",
    "When explicitly enabled (``enable_submission`` and ``allow_test_inference``):\n",
    "all transformations are fitted on training students only, each test student's\n",
    "features depend only on that student's own data plus training-fitted\n",
    "parameters, the official submission order and identifiers are preserved and\n",
    "the file is validated against ``submission_format.csv``. No pseudo-labelling,\n",
    "no test-batch statistics, no test-driven selection, no automatic upload.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import datetime as _dt\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from .ablation import EXPERIMENTS\n",
    "from .baseline_models import BASELINE_MODELS, make_model\n",
    "from .config import config_hash\n",
    "from .data_audit import _adapt_kwargs, load_read_kwargs, FILE_ROLES\n",
    "\n",
    "\n",
    "def read_submission_format(ctx) -> pd.DataFrame:\n",
    "    root = ctx.data_root()\n",
    "    per_file, _ = load_read_kwargs(root / \"pandas_read_csv_kwargs.json\", list(FILE_ROLES))\n",
    "    kwargs, _ = _adapt_kwargs(root / \"submission_format.csv\", per_file.get(\"submission_format.csv\", {}))\n",
    "    return pd.read_csv(root / \"submission_format.csv\", **kwargs)\n",
    "\n",
    "\n",
    "def validate_submission(sub: pd.DataFrame, fmt: pd.DataFrame, id_col: str, target_col: str) -> dict:\n",
    "    checks = {\n",
    "        \"row_count_matches\": len(sub) == len(fmt),\n",
    "        \"column_names_match\": list(sub.columns) == list(fmt.columns),\n",
    "        \"no_missing_predictions\": bool(sub[target_col].notna().all()),\n",
    "        \"all_finite\": bool(np.isfinite(pd.to_numeric(sub[target_col], errors=\"coerce\")).all()),\n",
    "        \"no_duplicate_ids\": not sub[id_col].duplicated().any(),\n",
    "        \"exact_id_coverage\": set(sub[id_col].astype(str)) == set(fmt[id_col].astype(str)),\n",
    "        \"order_preserved\": list(sub[id_col].astype(str)) == list(fmt[id_col].astype(str)),\n",
    "    }\n",
    "    checks[\"valid\"] = all(checks.values())\n",
    "    return checks\n",
    "\n",
    "\n",
    "def stage_submission(ctx) -> dict:\n",
    "    from .fold_features import FoldFeatureBuilder\n",
    "    from .io_utils import atomic_write_csv, atomic_write_json\n",
    "\n",
    "    cfg = ctx.config\n",
    "    if not (cfg.get(\"enable_submission\") and cfg.get(\"allow_test_inference\")):\n",
    "        return {\"outputs\": [], \"status\": \"SKIPPED_DISABLED\", \"reason\": \"submission disabled\"}\n",
    "    schema = ctx.load_json(\"schema_registry\")\n",
    "    sub_fields = schema[\"groups\"][\"submission\"][\"assigned\"]\n",
    "    id_col = sub_fields[\"student_id\"]\n",
    "    fmt = read_submission_format(ctx)\n",
    "    target_col = sub_fields.get(\"target\") or [c for c in fmt.columns if c != id_col][0]\n",
    "    fset = cfg[\"submission_feature_set\"]\n",
    "    if fset not in EXPERIMENTS or fset in (\"A23_RESIDUAL_MULTIMODAL\",):\n",
    "        raise ValueError(f\"submission_feature_set {fset} not supported for submission\")\n",
    "    families = set(EXPERIMENTS[fset]) or {\"SCREENING\"}\n",
    "    kind = BASELINE_MODELS.get(cfg[\"submission_model\"], cfg[\"submission_model\"])\n",
    "    meta = da.student_meta(ctx, \"train\")\n",
    "    y = meta[\"target\"].dropna().astype(float)\n",
    "    if families <= {\"SCREENING\"}:\n",
    "        tr = da.screening(ctx, \"train\")\n",
    "        te = da.screening(ctx, \"test\")\n",
    "        if te is None:\n",
    "            raise RuntimeError(\"screening_features_test missing: rerun Section 03\")\n",
    "        base = pd.concat([tr, te])\n",
    "        builder = FoldFeatureBuilder(ctx, base=base)\n",
    "    else:\n",
    "        if not ctx.has(\"student_features_test\"):\n",
    "            raise RuntimeError(\"student_features_test missing: rerun Section 13 with allow_test_inference=True\")\n",
    "        builder = FoldFeatureBuilder(ctx, include_test=True)\n",
    "    test_ids = [str(i) for i in fmt[id_col].astype(str)]\n",
    "    missing = [i for i in test_ids if i not in builder.base.index]\n",
    "    if missing:\n",
    "        ctx.logger.warning(\"%d submission ids lack features; their predictions fall back to the training mean\", len(missing))\n",
    "    train_ids = [i for i in y.index if i in builder.base.index]\n",
    "    present_test = [i for i in test_ids if i in builder.base.index]\n",
    "    Xtr, Xte = builder.build(train_ids, present_test, families, key=(\"SUBMISSION\",))\n",
    "    model = make_model(kind, cfg, n_features=Xtr.shape[1], n_samples=len(Xtr))\n",
    "    model.fit(Xtr, y.loc[train_ids].to_numpy())\n",
    "    pred = pd.Series(model.predict(Xte), index=present_test)\n",
    "    fallback = float(y.loc[train_ids].mean())\n",
    "    out = fmt.copy()\n",
    "    out[target_col] = [float(pred.get(i, fallback)) for i in test_ids]\n",
    "    if pd.api.types.is_integer_dtype(fmt[target_col]):\n",
    "        ctx.logger.warning(\"submission_format target column is integer-typed; writing floats as required for regression\")\n",
    "    checks = validate_submission(out, fmt, id_col, target_col)\n",
    "    checks[\"n_fallback_predictions\"] = len(missing)\n",
    "    path = ctx.paths.submissions / cfg[\"submission_filename\"]\n",
    "    if not checks[\"valid\"]:\n",
    "        ctx.save_json(checks, \"submission_validation\")\n",
    "        raise RuntimeError(f\"submission failed validation: {checks}\")\n",
    "    atomic_write_csv(out, path)\n",
    "    provenance = {\"model\": cfg[\"submission_model\"], \"kind\": kind, \"feature_set\": fset, \"families\": sorted(families),\n",
    "                  \"n_train_students\": len(train_ids), \"n_features\": int(Xtr.shape[1]), \"config_hash\": config_hash(cfg),\n",
    "                  \"created_at\": _dt.datetime.now().isoformat(timespec=\"seconds\"), \"file\": str(path),\n",
    "                  \"note\": \"Not uploaded automatically. Fitted on training students only.\"}\n",
    "    atomic_write_json(path.with_suffix(\".provenance.json\"), provenance)\n",
    "    ctx.save_json(checks, \"submission_validation\")\n",
    "    ctx.save_json(provenance, \"submission_provenance\")\n",
    "    ctx.store.register(\"submission_csv\", path, ctx.current_stage, \"csv\")\n",
    "    return {\"outputs\": [\"submission_validation\", \"submission_provenance\", \"submission_csv\"], \"summary\": {**checks, \"file\": str(path)}}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-041",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/target_eda.py\n",
    "\"\"\"Section 02 - target variable intelligence.\n",
    "\n",
    "Scientific question: what determines the distribution and predictability of\n",
    "end-of-year reading outcomes? Instruments are never assumed interchangeable:\n",
    "their distributions and their relationships with screening are compared.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy import stats as sps\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .stats_utils import bimodality_coefficient, quantile_bins, variance_decomposition\n",
    "\n",
    "\n",
    "def _describe(y: pd.Series) -> dict:\n",
    "    y = y.dropna()\n",
    "    if len(y) == 0:\n",
    "        return {\"n\": 0}\n",
    "    q1, q3 = y.quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "    mad = float((y - y.median()).abs().median())\n",
    "    mn, mx = y.min(), y.max()\n",
    "    return {\n",
    "        \"n\": int(len(y)), \"mean\": float(y.mean()), \"std\": float(y.std()), \"median\": float(y.median()), \"mad\": mad,\n",
    "        \"min\": float(mn), \"max\": float(mx), \"iqr\": float(iqr), \"skewness\": float(sps.skew(y)) if len(y) > 2 else np.nan,\n",
    "        \"excess_kurtosis\": float(sps.kurtosis(y)) if len(y) > 3 else np.nan,\n",
    "        \"bimodality_coefficient\": bimodality_coefficient(y),\n",
    "        \"n_outliers_iqr\": int(((y < q1 - 1.5 * iqr) | (y > q3 + 1.5 * iqr)).sum()),\n",
    "        \"n_outliers_mad\": int(((y - y.median()).abs() > 3.5 * 1.4826 * mad).sum()) if mad > 0 else 0,\n",
    "        \"floor_fraction\": float((y == mn).mean()), \"ceiling_fraction\": float((y == mx).mean()),\n",
    "        \"n_unique\": int(y.nunique()),\n",
    "    }\n",
    "\n",
    "\n",
    "def gmm_modes(y: pd.Series, seed: int) -> dict:\n",
    "    from sklearn.mixture import GaussianMixture\n",
    "\n",
    "    x = y.dropna().to_numpy().reshape(-1, 1)\n",
    "    if len(x) < 30:\n",
    "        return {\"status\": \"INSUFFICIENT_DATA\"}\n",
    "    bics = {}\n",
    "    for k in range(1, 5):\n",
    "        g = GaussianMixture(k, random_state=seed, n_init=3).fit(x)\n",
    "        bics[k] = float(g.bic(x))\n",
    "    best = min(bics, key=bics.get)\n",
    "    return {\"bic_by_components\": bics, \"bic_best_components\": best,\n",
    "            \"note\": \"BIC preference for >1 component suggests, but does not prove, multimodality.\"}\n",
    "\n",
    "\n",
    "def heteroscedasticity(y: pd.Series, x: pd.Series) -> dict:\n",
    "    d = pd.concat([y, x], axis=1).dropna()\n",
    "    if len(d) < 30:\n",
    "        return {\"status\": \"INSUFFICIENT_DATA\"}\n",
    "    yy, xx = d.iloc[:, 0].to_numpy(), d.iloc[:, 1].to_numpy()\n",
    "    beta = np.polyfit(xx, yy, 1)\n",
    "    r2 = (yy - np.polyval(beta, xx)) ** 2\n",
    "    aux = np.polyfit(xx, r2, 1)\n",
    "    fitted = np.polyval(aux, xx)\n",
    "    ss_res = ((r2 - fitted) ** 2).sum()\n",
    "    ss_tot = ((r2 - r2.mean()) ** 2).sum()\n",
    "    rsq = 1 - ss_res / ss_tot if ss_tot > 0 else np.nan\n",
    "    lm = len(d) * rsq\n",
    "    return {\"breusch_pagan_lm\": float(lm), \"p\": float(sps.chi2.sf(lm, 1)), \"n\": int(len(d))}\n",
    "\n",
    "\n",
    "def stage_target_intelligence(ctx) -> dict:\n",
    "    cfg = ctx.config\n",
    "    sm = da.students(ctx, \"train\")\n",
    "    y = pd.to_numeric(sm[\"target\"], errors=\"coerce\")\n",
    "    sm = sm.assign(target=y)\n",
    "    thetas = da.raw_theta_columns(sm)\n",
    "    if thetas:\n",
    "        sm[\"theta_mean_raw\"] = sm[thetas].mean(axis=1)\n",
    "    summary = {\"overall\": _describe(y), \"missing_outcomes\": int(y.isna().sum()),\n",
    "               \"gmm\": gmm_modes(y, int(cfg[\"seed\"]))}\n",
    "    quant = y.quantile([0.01, 0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99]).rename(\"value\").reset_index().rename(columns={\"index\": \"quantile\"})\n",
    "    ctx.save_df(quant, \"target_quantiles\", fmt=\"csv\")\n",
    "    groups = {}\n",
    "    for col in (\"instrument\", \"school_id\"):\n",
    "        if col in sm.columns and sm[col].notna().any():\n",
    "            tab = sm.groupby(col)[\"target\"].apply(lambda s: pd.Series(_describe(s))).unstack()\n",
    "            groups[col] = tab\n",
    "            ctx.save_df(tab.reset_index(), f\"target_by_{col}\", fmt=\"csv\")\n",
    "    decomp = {}\n",
    "    if \"school_id\" in sm.columns and sm[\"school_id\"].nunique() > 1:\n",
    "        decomp[\"school\"] = variance_decomposition(y, sm[\"school_id\"])\n",
    "        if \"instrument\" in sm.columns and sm[\"instrument\"].nunique() > 1:\n",
    "            decomp[\"school_within_instrument\"] = {\n",
    "                str(inst): variance_decomposition(g[\"target\"], g[\"school_id\"]) for inst, g in sm.groupby(\"instrument\")}\n",
    "    if \"instrument\" in sm.columns and sm[\"instrument\"].nunique() > 1:\n",
    "        decomp[\"instrument\"] = variance_decomposition(y, sm[\"instrument\"])\n",
    "        valid = [g[\"target\"].dropna() for _, g in sm.groupby(\"instrument\") if g[\"target\"].notna().sum() >= 5]\n",
    "        if len(valid) >= 2:\n",
    "            summary[\"instrument_kruskal\"] = dict(zip([\"h\", \"p\"], map(float, sps.kruskal(*valid))))\n",
    "            summary[\"instrument_levene\"] = dict(zip([\"w\", \"p\"], map(float, sps.levene(*valid))))\n",
    "            if len(valid) == 2:\n",
    "                summary[\"instrument_ks\"] = dict(zip([\"d\", \"p\"], map(float, sps.ks_2samp(*valid))))\n",
    "        if thetas:\n",
    "            rel = []\n",
    "            for inst, g in sm.groupby(\"instrument\"):\n",
    "                d = g[[\"theta_mean_raw\", \"target\"]].dropna()\n",
    "                if len(d) >= 10:\n",
    "                    slope = np.polyfit(d[\"theta_mean_raw\"], d[\"target\"], 1)[0]\n",
    "                    rel.append({\"instrument\": inst, \"n\": len(d), \"slope_target_on_theta_mean\": float(slope),\n",
    "                                \"spearman\": float(sps.spearmanr(d[\"theta_mean_raw\"], d[\"target\"])[0])})\n",
    "            summary[\"instrument_screening_relationship\"] = rel\n",
    "    if thetas:\n",
    "        summary[\"heteroscedasticity_vs_theta_mean\"] = heteroscedasticity(sm[\"target\"], sm[\"theta_mean_raw\"])\n",
    "        sm[\"screening_band\"] = quantile_bins(sm[\"theta_mean_raw\"], 5, int(cfg[\"min_group_size\"]), \"S\")\n",
    "        ctx.save_df(sm.groupby(\"screening_band\")[\"target\"].apply(lambda s: pd.Series(_describe(s))).unstack().reset_index(),\n",
    "                    \"target_by_screening_band\", fmt=\"csv\")\n",
    "    cm = da.clips(ctx, \"train\")\n",
    "    completion = cm.groupby(\"student_id\").agg(n_clips=(\"clip_id\", \"size\"), n_tasks=(\"task_family\", \"nunique\"))\n",
    "    sm = sm.merge(completion, left_on=\"student_id\", right_index=True, how=\"left\")\n",
    "    sm[\"completion_band\"] = quantile_bins(sm[\"n_clips\"], 4, int(cfg[\"min_group_size\"]), \"C\")\n",
    "    summary[\"variance_decomposition\"] = decomp\n",
    "    ctx.save_json(summary, \"target_summary\")\n",
    "    _target_figures(ctx, sm, summary)\n",
    "    return {\"outputs\": [\"target_summary\", \"target_quantiles\"], \"summary\": {\"n\": summary[\"overall\"].get(\"n\"),\n",
    "                                                                          \"skewness\": summary[\"overall\"].get(\"skewness\")}}\n",
    "\n",
    "\n",
    "def _target_figures(ctx, sm: pd.DataFrame, summary: dict) -> None:\n",
    "    y = sm[\"target\"]\n",
    "    n = int(y.notna().sum())\n",
    "    fig, axes = viz.new_figure(1, 3, (5, 4))\n",
    "    viz.hist_kde(axes[0, 0], y, \"end-of-year outcome\")\n",
    "    viz.ecdf(axes[0, 1], y, \"end-of-year outcome\")\n",
    "    viz.qq(axes[0, 2], y, \"end-of-year outcome\")\n",
    "    o = summary[\"overall\"]\n",
    "    ctx.figure(fig, \"target_distribution\", \"End-of-year outcome distribution\",\n",
    "               \"What is the shape of the outcome distribution?\", \"student_master\", n,\n",
    "               f\"mean={o.get('mean', np.nan):.3g}, sd={o.get('std', np.nan):.3g}, skew={o.get('skewness', np.nan):.2f}, \"\n",
    "               f\"floor={o.get('floor_fraction', np.nan):.1%}, ceiling={o.get('ceiling_fraction', np.nan):.1%}.\")\n",
    "    for col in (\"instrument\", \"school_id\", \"screening_band\", \"completion_band\"):\n",
    "        if col in sm.columns and sm[col].notna().any():\n",
    "            fig, axes = viz.new_figure(1, 2, (max(6, sm[col].nunique() * 0.3 + 3), 4.5))\n",
    "            viz.grouped_box(axes[0, 0], sm, \"target\", col, \"outcome\", violin=False)\n",
    "            viz.grouped_box(axes[0, 1], sm, \"target\", col, \"outcome\", violin=True)\n",
    "            ctx.figure(fig, f\"target_by_{col}\", f\"Outcome by {col}\", f\"Does the outcome differ by {col}?\",\n",
    "                       \"student_master\", n, f\"Groups with fewer than 3 students are omitted ({sm[col].nunique()} levels).\")\n",
    "    if \"instrument\" in sm.columns and sm[\"instrument\"].nunique() > 1 and \"theta_mean_raw\" in sm.columns:\n",
    "        fig, axes = viz.new_figure(1, 1)\n",
    "        ax = axes[0, 0]\n",
    "        for inst, g in sm.groupby(\"instrument\"):\n",
    "            ax.scatter(g[\"theta_mean_raw\"], g[\"target\"], s=8, alpha=0.5, label=f\"{inst} (n={len(g)})\")\n",
    "        ax.legend(fontsize=7)\n",
    "        viz.finalize_axis(ax, \"Outcome vs mean screening theta by instrument\", \"mean screening theta\", \"outcome\", n)\n",
    "        ctx.figure(fig, \"instrument_screening_relationship\", \"Instrument comparison\",\n",
    "                   \"Are instruments interchangeable given screening?\", \"student_master\", n,\n",
    "                   \"; \".join(f\"{r['instrument']}: slope={r['slope_target_on_theta_mean']:.3g}\"\n",
    "                             for r in summary.get(\"instrument_screening_relationship\", [])))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-042",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/task_intelligence.py\n",
    "\"\"\"Section 12 - task-specific cognitive intelligence.\n",
    "\n",
    "The three task families (blending, deletion, sentence repetition) are analysed\n",
    "independently after their dataset names have been resolved in Section 01.\n",
    "Deletion-specific error categories are only computed when the original item\n",
    "and the intended deletion operation are both known.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .families import feature_family\n",
    "from .linguistic_features import G2P, tokenize_words\n",
    "from .stats_utils import bh_fdr, safe_corr\n",
    "\n",
    "SIGNAL_FAMILIES = {\"temporal_signal\": [\"TEMPORAL\"], \"spectral_signal\": [\"SPECTRAL\", \"MFCC\"],\n",
    "                   \"wavelet_signal\": [\"WAVELETS\"], \"phonetic_signal\": [\"PHONETIC\"]}\n",
    "\n",
    "\n",
    "def _assoc(df: pd.DataFrame, cols: list, y: pd.Series, min_n: int) -> pd.DataFrame:\n",
    "    rows = []\n",
    "    for c in cols:\n",
    "        r, p, n = safe_corr(df[c], y.reindex(df.index), \"spearman\", min_n)\n",
    "        rows.append({\"feature\": c, \"rho\": r, \"p\": p, \"n\": n})\n",
    "    out = pd.DataFrame(rows)\n",
    "    if len(out):\n",
    "        out[\"q\"] = bh_fdr(out[\"p\"])\n",
    "    return out\n",
    "\n",
    "\n",
    "def _school_stability(df: pd.DataFrame, col: str, y: pd.Series, schools: pd.Series, min_n: int) -> float:\n",
    "    overall = safe_corr(df[col], y.reindex(df.index), \"spearman\", min_n)[0]\n",
    "    if not np.isfinite(overall):\n",
    "        return np.nan\n",
    "    signs = []\n",
    "    for _, idx in schools.reindex(df.index).dropna().groupby(schools.reindex(df.index).dropna()).groups.items():\n",
    "        r = safe_corr(df.loc[idx, col], y.reindex(idx), \"spearman\", 10)[0]\n",
    "        if np.isfinite(r):\n",
    "            signs.append(np.sign(r) == np.sign(overall))\n",
    "    return float(np.mean(signs)) if signs else np.nan\n",
    "\n",
    "\n",
    "def relevance_matrix(ctx) -> pd.DataFrame:\n",
    "    cfg = ctx.config\n",
    "    min_n = int(cfg[\"min_n_correlation\"])\n",
    "    S = da.student_features(ctx, \"train\")\n",
    "    y = da.target(ctx)\n",
    "    res = da.residuals(ctx)\n",
    "    schools = da.student_meta(ctx, \"train\")[\"school_id\"]\n",
    "    rows = []\n",
    "    for task in da.task_families(ctx):\n",
    "        tag = f\"task={task}\"\n",
    "        row = {\"task_family\": task}\n",
    "        theta = f\"theta_{task}\"\n",
    "        row[\"screening_signal\"] = abs(safe_corr(S[theta], y, \"spearman\", min_n)[0]) if theta in S.columns else np.nan\n",
    "        acc = f\"acc_{task}\"\n",
    "        row[\"correctness_signal\"] = abs(safe_corr(S[acc], y, \"spearman\", min_n)[0]) if acc in S.columns else np.nan\n",
    "        task_cols = [c for c in S.columns if f\"__{tag}\" in c or c.startswith(f\"traj_{task}_\") or c.startswith(f\"irt_{task}_\")]\n",
    "        best_res, best_col = 0.0, None\n",
    "        for key, fams in SIGNAL_FAMILIES.items():\n",
    "            cols = [c for c in task_cols if feature_family(c) in fams]\n",
    "            a = _assoc(S, cols, y, min_n)\n",
    "            row[key] = float(a[\"rho\"].abs().max()) if len(a) and a[\"rho\"].notna().any() else np.nan\n",
    "            row[f\"{key}_n_fdr\"] = int((a[\"q\"] < cfg[\"fdr_alpha\"]).sum()) if len(a) else 0\n",
    "        if res is not None:\n",
    "            a = _assoc(S, task_cols, res, min_n)\n",
    "            if len(a) and a[\"rho\"].notna().any():\n",
    "                i = a[\"rho\"].abs().idxmax()\n",
    "                best_res, best_col = float(abs(a.loc[i, \"rho\"])), a.loc[i, \"feature\"]\n",
    "            row[\"residual_signal\"] = best_res if best_col else np.nan\n",
    "            row[\"residual_best_feature\"] = best_col\n",
    "            row[\"residual_n_fdr\"] = int((a[\"q\"] < cfg[\"fdr_alpha\"]).sum()) if len(a) else 0\n",
    "        else:\n",
    "            row[\"residual_signal\"] = np.nan\n",
    "        stab_col = best_col or (acc if acc in S.columns else None)\n",
    "        row[\"school_stability\"] = _school_stability(S, stab_col, res if best_col else y, schools, min_n) if stab_col else np.nan\n",
    "        row[\"school_stability_feature\"] = stab_col\n",
    "        rows.append(row)\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def task_specific_analyses(ctx) -> pd.DataFrame:\n",
    "    cfg = ctx.config\n",
    "    min_n = int(cfg[\"min_n_correlation\"])\n",
    "    clips = da.clip_table(ctx, \"train\")\n",
    "    y = da.target(ctx)\n",
    "    res = da.residuals(ctx)\n",
    "    rows = []\n",
    "\n",
    "    def add(task, analysis, series, status=\"OK\", note=\"\"):\n",
    "        if series is None:\n",
    "            rows.append({\"task_family\": task, \"analysis\": analysis, \"status\": status, \"note\": note})\n",
    "            return\n",
    "        s = series.dropna()\n",
    "        r, p, n = safe_corr(s, y.reindex(s.index), \"spearman\", min_n)\n",
    "        rr = safe_corr(s, res.reindex(s.index), \"spearman\", min_n)[0] if res is not None else np.nan\n",
    "        rows.append({\"task_family\": task, \"analysis\": analysis, \"status\": status if n >= min_n else \"INSUFFICIENT_DATA\",\n",
    "                     \"n_students\": n, \"target_rho\": r, \"target_p\": p, \"residual_rho\": rr, \"note\": note})\n",
    "\n",
    "    ph = [c for c in clips.columns if c.startswith(\"ph_\")]\n",
    "    alias = sorted({c.split(\"_\")[1] for c in ph}) if ph else []\n",
    "    pfx = f\"ph_{alias[0]}\" if alias else None\n",
    "    for task in sorted(clips[\"task_family\"].dropna().unique()):\n",
    "        g = clips[clips[\"task_family\"] == task]\n",
    "        by = g.groupby(\"student_id\")\n",
    "        if task == \"blending\":\n",
    "            add(task, \"segmented_speech_fraction\", by[\"t_n_segments\"].apply(lambda s: (s > 1).mean()) if \"t_n_segments\" in g else None,\n",
    "                \"UNAVAILABLE\", \"requires acoustic features\")\n",
    "            if pfx:\n",
    "                add(task, \"partial_word_rate\", by[f\"{pfx}_word_completeness\"].apply(lambda s: (s < 1).mean()), note=\"ASR proxy\")\n",
    "                add(task, \"sound_repetition_rate\", by[f\"{pfx}_self_corrections\"].mean(), note=\"ASR proxy\")\n",
    "            else:\n",
    "                add(task, \"partial_word_rate\", None, \"UNAVAILABLE\", \"requires ASR\")\n",
    "            add(task, \"phonetic_transition_rate\", by[\"m_sp_transition_rate\"].mean() if \"m_sp_transition_rate\" in g else None,\n",
    "                \"UNAVAILABLE\", \"requires acoustic features\")\n",
    "        elif task == \"deletion\":\n",
    "            if {\"deletion_source_text\", \"deletion_target_sound\"} <= set(g.columns) and pfx:\n",
    "                g2p = G2P(cfg.get(\"g2p_backend\", \"auto\"))\n",
    "                cats = []\n",
    "                for _, r in g.iterrows():\n",
    "                    src = [p for w in tokenize_words(r[\"deletion_source_text\"]) for p in g2p.word(w)]\n",
    "                    target = [p for w in tokenize_words(r[\"deletion_target_sound\"]) for p in g2p.word(w)]\n",
    "                    exp = [p for w in tokenize_words(r.get(\"expected_text\", \"\")) for p in g2p.word(w)]\n",
    "                    hyp = [p for w in tokenize_words(r.get(f\"{pfx}_text\", \"\")) for p in g2p.word(w)] if f\"{pfx}_text\" in g else []\n",
    "                    if not hyp:\n",
    "                        cats.append(np.nan)\n",
    "                    elif hyp == src:\n",
    "                        cats.append(\"no_deletion\")\n",
    "                    elif hyp == exp:\n",
    "                        cats.append(\"correct_deletion\")\n",
    "                    elif any(t in hyp for t in target) and len(hyp) < len(src):\n",
    "                        cats.append(\"incorrect_sound_removed\")\n",
    "                    elif len(hyp) < len(exp):\n",
    "                        cats.append(\"additional_omission\")\n",
    "                    else:\n",
    "                        cats.append(\"substitution_or_other\")\n",
    "                g = g.assign(deletion_category=cats)\n",
    "                for cat in (\"no_deletion\", \"incorrect_sound_removed\", \"additional_omission\", \"substitution_or_other\"):\n",
    "                    add(task, f\"rate_{cat}\", g.groupby(\"student_id\")[\"deletion_category\"].apply(lambda s: (s == cat).mean()), note=\"ASR proxy\")\n",
    "            else:\n",
    "                add(task, \"deletion_error_categories\", None, \"UNAVAILABLE\",\n",
    "                    \"original item and intended deletion operation not both known, or ASR disabled\")\n",
    "            if pfx:\n",
    "                add(task, \"response_completeness\", by[f\"{pfx}_phone_completeness\"].mean(), note=\"ASR proxy\")\n",
    "        elif task == \"repetition\":\n",
    "            if pfx:\n",
    "                add(task, \"word_preservation\", by[f\"{pfx}_word_er\"].apply(lambda s: 1 - s.clip(upper=1).mean()), note=\"ASR proxy\")\n",
    "                add(task, \"word_order_preservation\", by[f\"{pfx}_word_order_preservation\"].mean(), note=\"ASR proxy\")\n",
    "                add(task, \"sentence_completeness\", by[f\"{pfx}_word_completeness\"].mean(), note=\"ASR proxy\")\n",
    "                add(task, \"omission_rate\", by[f\"{pfx}_word_del_rate\"].mean(), note=\"ASR proxy\")\n",
    "                add(task, \"repetition_rate\", by[f\"{pfx}_self_corrections\"].mean(), note=\"ASR proxy\")\n",
    "            else:\n",
    "                add(task, \"word_preservation\", None, \"UNAVAILABLE\", \"requires ASR\")\n",
    "            if \"t_n_long_pauses\" in g:\n",
    "                add(task, \"phrase_level_long_pauses\", by[\"t_n_long_pauses\"].mean())\n",
    "            if \"l_n_words\" in g and \"t_active_dur\" in g:\n",
    "                from .student_aggregation import shrunk_slopes\n",
    "\n",
    "                sl = shrunk_slopes(g, \"student_id\", \"l_n_words\", \"t_active_dur\", k=float(cfg[\"slope_shrinkage_k\"]),\n",
    "                                   min_obs=int(cfg[\"aggregation_min_obs\"]))\n",
    "                add(task, \"sentence_length_sensitivity\", sl[\"slope_shrunk\"], note=\"shrunk duration-per-word slope\")\n",
    "            if \"p_f0_std_st\" in g:\n",
    "                add(task, \"prosodic_organisation_f0_variability\", by[\"p_f0_std_st\"].mean(), note=\"voice-conversion sensitive\")\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def stage_task_intelligence(ctx) -> dict:\n",
    "    rel = relevance_matrix(ctx)\n",
    "    ctx.save_df(rel, \"task_relevance_matrix\", also_csv=True)\n",
    "    spec = task_specific_analyses(ctx)\n",
    "    ctx.save_df(spec, \"task_specific_report\", also_csv=True)\n",
    "    cols = [\"screening_signal\", \"correctness_signal\", \"temporal_signal\", \"spectral_signal\", \"wavelet_signal\",\n",
    "            \"phonetic_signal\", \"residual_signal\", \"school_stability\"]\n",
    "    M = rel.set_index(\"task_family\")[[c for c in cols if c in rel.columns]].astype(float)\n",
    "    if len(M):\n",
    "        fig, axes = viz.new_figure(1, 1, (8, 0.6 * len(M) + 2.5))\n",
    "        viz.heatmap(axes[0, 0], M, \"Task-level scientific relevance (|Spearman rho|; stability = sign agreement)\",\n",
    "                    cmap=\"viridis\", vmin=0, vmax=1, annotate=True)\n",
    "        ctx.figure(fig, \"task_relevance_matrix\", \"Task-level scientific relevance matrix\",\n",
    "                   \"Which tasks carry the strongest information?\", \"task_relevance_matrix\", int(len(da.target(ctx))),\n",
    "                   \"Max |rho| per family among task-conditioned features; residual uses OOF screening residuals.\")\n",
    "    return {\"outputs\": [\"task_relevance_matrix\", \"task_specific_report\"],\n",
    "            \"summary\": rel[[\"task_family\"] + [c for c in cols if c in rel.columns]].to_dict(\"records\")}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-043",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/temporal_features.py\n",
    "\"\"\"Section 07 - temporal, rhythm and fluency intelligence.\n",
    "\n",
    "Scientific question: does response organisation predict later reading\n",
    "performance?\n",
    "\n",
    "Note: ``t_initial_sil`` is the silence before the first detected speech\n",
    "segment in the recording. It is NOT a verified reaction time: the recording\n",
    "start is not known to coincide with prompt offset.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from .stats_utils import robust_stats\n",
    "\n",
    "TEMPORAL_NAN_KEYS = [\n",
    "    \"t_total_dur\", \"t_active_dur\", \"t_active_ratio\", \"t_n_segments\", \"t_initial_sil\", \"t_final_sil\",\n",
    "    \"t_internal_sil\", \"t_n_pauses\", \"t_n_short_pauses\", \"t_n_long_pauses\", \"t_pause_speech_ratio\",\n",
    "    \"t_pause_cv\", \"t_peak_rate_hz\", \"t_peak_spacing_mean\", \"t_peak_spacing_std\", \"t_rhythm_regularity\",\n",
    "    \"t_npvi\", \"t_mod_freq_hz\", \"t_mod_energy_ratio_2_8hz\", \"t_temporal_entropy\", \"t_energy_transitions\",\n",
    "    \"t_onset_sharpness\", \"t_offset_sharpness\",\n",
    "]\n",
    "\n",
    "\n",
    "def _speech_span(b) -> tuple[int, int]:\n",
    "    if not b.segments:\n",
    "        return 0, len(b.rms)\n",
    "    hop_s = b.hop / b.sr\n",
    "    start = int(np.floor(b.segments[0][0] / hop_s))\n",
    "    end = int(np.ceil(b.segments[-1][1] / hop_s))\n",
    "    return max(0, start), min(len(b.rms), max(end, start + 1))\n",
    "\n",
    "\n",
    "def temporal_features(b, cfg: dict) -> dict:\n",
    "    from scipy.signal import find_peaks\n",
    "    from scipy.stats import kurtosis, skew\n",
    "\n",
    "    out: dict = {k: np.nan for k in TEMPORAL_NAN_KEYS}\n",
    "    dur = float(b.duration)\n",
    "    segs = list(b.segments)\n",
    "    hop_s = b.hop / b.sr\n",
    "    fs_env = 1.0 / hop_s\n",
    "    out[\"t_total_dur\"] = dur\n",
    "    seg_durs = np.array([e - s for s, e in segs], dtype=float)\n",
    "    active = float(seg_durs.sum()) if len(seg_durs) else 0.0\n",
    "    out[\"t_active_dur\"] = active\n",
    "    out[\"t_active_ratio\"] = active / dur if dur > 0 else np.nan\n",
    "    out[\"t_n_segments\"] = float(len(segs))\n",
    "    out.update(robust_stats(seg_durs, \"t_seg_dur\", [\"mean\", \"std\", \"median\", \"max\"], min_n=2))\n",
    "    if segs:\n",
    "        gaps = np.array([segs[i + 1][0] - segs[i][1] for i in range(len(segs) - 1)], dtype=float)\n",
    "        out[\"t_initial_sil\"] = float(segs[0][0])\n",
    "        out[\"t_final_sil\"] = float(max(dur - segs[-1][1], 0.0))\n",
    "        out[\"t_internal_sil\"] = float(gaps.sum()) if len(gaps) else 0.0\n",
    "        out[\"t_n_pauses\"] = float(len(gaps))\n",
    "        out[\"t_n_short_pauses\"] = float((gaps < cfg[\"long_pause_s\"]).sum()) if len(gaps) else 0.0\n",
    "        out[\"t_n_long_pauses\"] = float((gaps >= cfg[\"long_pause_s\"]).sum()) if len(gaps) else 0.0\n",
    "        out[\"t_pause_speech_ratio\"] = float(gaps.sum() / active) if active > 0 else np.nan\n",
    "        out.update(robust_stats(gaps, \"t_pause_dur\", [\"mean\", \"std\", \"median\", \"max\"], min_n=2))\n",
    "        if len(gaps) >= 2 and gaps.mean() > 0:\n",
    "            out[\"t_pause_cv\"] = float(gaps.std(ddof=1) / gaps.mean())\n",
    "    else:\n",
    "        out.update({f\"t_pause_dur_{s}\": np.nan for s in [\"mean\", \"std\", \"median\", \"max\"]})\n",
    "    lo, hi = _speech_span(b)\n",
    "    env = b.rms[lo:hi].astype(float)\n",
    "    env_db = b.rms_db[lo:hi].astype(float)\n",
    "    if len(env_db) >= 3:\n",
    "        out[\"t_env_mean\"] = float(env_db.mean())\n",
    "        out[\"t_env_std\"] = float(env_db.std(ddof=1))\n",
    "        out[\"t_env_skew\"] = float(skew(env_db)) if env_db.std() > 0 else np.nan\n",
    "        out[\"t_env_kurt\"] = float(kurtosis(env_db)) if env_db.std() > 0 else np.nan\n",
    "    else:\n",
    "        out.update({\"t_env_mean\": np.nan, \"t_env_std\": np.nan, \"t_env_skew\": np.nan, \"t_env_kurt\": np.nan})\n",
    "    if len(env_db) >= 5 and active > 0:\n",
    "        distance = max(1, int(round(0.08 / hop_s)))\n",
    "        peaks, _ = find_peaks(env_db, prominence=3.0, distance=distance)\n",
    "        out[\"t_peak_rate_hz\"] = float(len(peaks) / active)\n",
    "        if len(peaks) >= 3:\n",
    "            intervals = np.diff(peaks) * hop_s\n",
    "            out[\"t_peak_spacing_mean\"] = float(intervals.mean())\n",
    "            out[\"t_peak_spacing_std\"] = float(intervals.std(ddof=1))\n",
    "            cv = intervals.std(ddof=1) / intervals.mean() if intervals.mean() > 0 else np.nan\n",
    "            out[\"t_rhythm_regularity\"] = float(1.0 / (1.0 + cv)) if np.isfinite(cv) else np.nan\n",
    "            pair = np.abs(np.diff(intervals)) / ((intervals[1:] + intervals[:-1]) / 2)\n",
    "            out[\"t_npvi\"] = float(100 * pair.mean())\n",
    "        crossings = np.diff((env_db > np.median(env_db)).astype(int))\n",
    "        out[\"t_energy_transitions\"] = float(np.abs(crossings).sum() / max(len(env_db) * hop_s, 1e-6))\n",
    "    centered = env - env.mean() if len(env) else env\n",
    "    denom = float((centered ** 2).sum()) if len(env) else 0.0\n",
    "    for lag_s in (0.1, 0.2, 0.3, 0.5):\n",
    "        lag = int(round(lag_s / hop_s))\n",
    "        key = f\"t_env_autocorr_{int(lag_s * 1000)}ms\"\n",
    "        if denom > 0 and len(env) > lag + 5:\n",
    "            out[key] = float((centered[:-lag] * centered[lag:]).sum() / denom)\n",
    "        else:\n",
    "            out[key] = np.nan\n",
    "    if len(env) >= int(fs_env):  # at least one second for modulation analysis\n",
    "        spec = np.abs(np.fft.rfft(centered * np.hanning(len(centered)))) ** 2\n",
    "        freqs = np.fft.rfftfreq(len(centered), d=hop_s)\n",
    "        band = (freqs >= 1) & (freqs <= 16)\n",
    "        if band.any() and spec[band].sum() > 0:\n",
    "            out[\"t_mod_freq_hz\"] = float(freqs[band][np.argmax(spec[band])])\n",
    "            mid = (freqs >= 2) & (freqs <= 8)\n",
    "            out[\"t_mod_energy_ratio_2_8hz\"] = float(spec[mid].sum() / spec[band].sum())\n",
    "    if len(env) >= 5 and env.sum() > 0:\n",
    "        p = env / env.sum()\n",
    "        p = p[p > 0]\n",
    "        out[\"t_temporal_entropy\"] = float(-(p * np.log(p)).sum() / np.log(len(env)))\n",
    "    if segs and len(b.rms_db) >= 5:\n",
    "        slope = np.diff(b.rms_db) / hop_s\n",
    "        w = max(1, int(round(0.05 / hop_s)))\n",
    "        s0 = int(round(segs[0][0] / hop_s))\n",
    "        e0 = int(round(segs[-1][1] / hop_s))\n",
    "        on = slope[max(0, s0 - w):min(len(slope), s0 + w + 1)]\n",
    "        off = slope[max(0, e0 - w - 1):min(len(slope), e0 + w)]\n",
    "        out[\"t_onset_sharpness\"] = float(on.max()) if len(on) else np.nan\n",
    "        out[\"t_offset_sharpness\"] = float(-off.min()) if len(off) else np.nan\n",
    "    return out\n",
    "\n",
    "\n",
    "def stage_temporal_features(ctx) -> dict:\n",
    "    from .family_analysis import analyze_family, complexity_surface\n",
    "\n",
    "    result = analyze_family(ctx, family=\"TEMPORAL\", prefixes=(\"t_\",), split_by_correctness=True)\n",
    "    complexity_surface(ctx, feature=\"t_active_dur\", outputs=result[\"outputs\"])\n",
    "    return result\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-044",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/validation.py\n",
    "\"\"\"Student-disjoint cross-validation schemes, metrics and CV runner.\n",
    "\n",
    "Schemes:\n",
    "* CV_A_REPEATED_STUDENT_KFOLD - repeated K-fold over students, stratified by target quantile\n",
    "* CV_B_SCHOOL_GROUP_KFOLD    - grouped by school (stratified-group K-fold)\n",
    "* CV_C_LEAVE_ONE_SCHOOL_OUT  - leave one school out\n",
    "* CV_D_INSTRUMENT_STRATIFIED - stratified by instrument x target bin\n",
    "* CV_E_CROSS_INSTRUMENT_TRANSFER - train on other instruments, validate on one\n",
    "\n",
    "Every fold partitions students, so all clips of a student stay together\n",
    "(modelling happens at student level). Schemes whose metadata is missing are\n",
    "reported as unavailable instead of being silently replaced.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "from dataclasses import dataclass, field\n",
    "from typing import Callable\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy import stats as sps\n",
    "\n",
    "SCHEMES = [\"CV_A_REPEATED_STUDENT_KFOLD\", \"CV_B_SCHOOL_GROUP_KFOLD\", \"CV_C_LEAVE_ONE_SCHOOL_OUT\",\n",
    "           \"CV_D_INSTRUMENT_STRATIFIED\", \"CV_E_CROSS_INSTRUMENT_TRANSFER\"]\n",
    "GREATER_IS_BETTER = {\"r2\": True, \"rmse\": False, \"mae\": False, \"spearman\": True, \"pearson\": True}\n",
    "\n",
    "\n",
    "def _ybins(y: pd.Series, q: int) -> np.ndarray:\n",
    "    ranks = y.rank(method=\"first\")\n",
    "    return pd.qcut(ranks, min(q, max(2, len(y) // 10)), labels=False, duplicates=\"drop\").to_numpy()\n",
    "\n",
    "\n",
    "def make_cv_assignments(meta: pd.DataFrame, cfg: dict) -> tuple[pd.DataFrame, dict]:\n",
    "    \"\"\"meta: index student_id with columns target, school_id, instrument.\"\"\"\n",
    "    from sklearn.model_selection import StratifiedGroupKFold, StratifiedKFold\n",
    "\n",
    "    seed = int(cfg[\"seed\"])\n",
    "    k = int(cfg[\"cv_folds\"])\n",
    "    meta = meta[meta[\"target\"].notna()]\n",
    "    ids = meta.index.to_numpy()\n",
    "    yb = _ybins(meta[\"target\"], int(cfg[\"target_bins_for_stratification\"]))\n",
    "    rows, status = [], {}\n",
    "    for r in range(int(cfg[\"cv_repeats\"])):\n",
    "        skf = StratifiedKFold(n_splits=k, shuffle=True, random_state=seed + r)\n",
    "        for f, (_, va) in enumerate(skf.split(ids, yb)):\n",
    "            rows += [(\"CV_A_REPEATED_STUDENT_KFOLD\", r, f, sid) for sid in ids[va]]\n",
    "    status[\"CV_A_REPEATED_STUDENT_KFOLD\"] = {\"status\": \"OK\", \"repeats\": int(cfg[\"cv_repeats\"]), \"folds\": k}\n",
    "    schools = meta[\"school_id\"] if \"school_id\" in meta.columns else pd.Series(np.nan, index=meta.index)\n",
    "    n_schools = int(schools.nunique())\n",
    "    if n_schools >= 2 and schools.notna().all():\n",
    "        kk = min(k, n_schools)\n",
    "        sgk = StratifiedGroupKFold(n_splits=kk, shuffle=True, random_state=seed)\n",
    "        for f, (_, va) in enumerate(sgk.split(ids, yb, groups=schools.to_numpy())):\n",
    "            rows += [(\"CV_B_SCHOOL_GROUP_KFOLD\", 0, f, sid) for sid in ids[va]]\n",
    "        status[\"CV_B_SCHOOL_GROUP_KFOLD\"] = {\"status\": \"OK\", \"folds\": kk, \"n_schools\": n_schools}\n",
    "    else:\n",
    "        status[\"CV_B_SCHOOL_GROUP_KFOLD\"] = {\"status\": \"UNAVAILABLE_MISSING_METADATA\",\n",
    "                                             \"reason\": f\"{n_schools} schools; school_id missing for {int(schools.isna().sum())} students\"}\n",
    "    if 3 <= n_schools <= int(cfg[\"max_schools_for_loso\"]) and schools.notna().all():\n",
    "        codes = {s: i for i, s in enumerate(sorted(schools.unique(), key=str))}\n",
    "        rows += [(\"CV_C_LEAVE_ONE_SCHOOL_OUT\", 0, codes[schools[sid]], sid) for sid in ids]\n",
    "        status[\"CV_C_LEAVE_ONE_SCHOOL_OUT\"] = {\"status\": \"OK\", \"folds\": n_schools}\n",
    "    else:\n",
    "        status[\"CV_C_LEAVE_ONE_SCHOOL_OUT\"] = {\"status\": \"UNAVAILABLE\", \"reason\": f\"{n_schools} schools (need 3..{cfg['max_schools_for_loso']})\"}\n",
    "    inst = meta[\"instrument\"] if \"instrument\" in meta.columns else pd.Series(np.nan, index=meta.index)\n",
    "    n_inst = int(inst.nunique())\n",
    "    if n_inst >= 1 and inst.notna().all():\n",
    "        label = inst.astype(str) + \"_\" + pd.Series(yb, index=meta.index).astype(str)\n",
    "        counts = label.value_counts()\n",
    "        label = label.where(label.map(counts) >= k, inst.astype(str))\n",
    "        if label.value_counts().min() >= k:\n",
    "            skf = StratifiedKFold(n_splits=k, shuffle=True, random_state=seed + 1000)\n",
    "            for f, (_, va) in enumerate(skf.split(ids, label.to_numpy())):\n",
    "                rows += [(\"CV_D_INSTRUMENT_STRATIFIED\", 0, f, sid) for sid in ids[va]]\n",
    "            status[\"CV_D_INSTRUMENT_STRATIFIED\"] = {\"status\": \"OK\", \"folds\": k, \"n_instruments\": n_inst}\n",
    "        else:\n",
    "            status[\"CV_D_INSTRUMENT_STRATIFIED\"] = {\"status\": \"UNAVAILABLE\", \"reason\": \"instrument strata smaller than cv_folds\"}\n",
    "    else:\n",
    "        status[\"CV_D_INSTRUMENT_STRATIFIED\"] = {\"status\": \"UNAVAILABLE_MISSING_METADATA\", \"reason\": \"instrument missing\"}\n",
    "    if n_inst >= 2 and inst.notna().all():\n",
    "        codes = {s: i for i, s in enumerate(sorted(inst.unique(), key=str))}\n",
    "        rows += [(\"CV_E_CROSS_INSTRUMENT_TRANSFER\", 0, codes[inst[sid]], sid) for sid in ids]\n",
    "        status[\"CV_E_CROSS_INSTRUMENT_TRANSFER\"] = {\"status\": \"OK\", \"folds\": n_inst, \"instrument_codes\": {str(k_): v for k_, v in codes.items()},\n",
    "                                                    \"note\": \"Targets of different instruments may not share a scale.\"}\n",
    "    else:\n",
    "        status[\"CV_E_CROSS_INSTRUMENT_TRANSFER\"] = {\"status\": \"UNAVAILABLE\", \"reason\": f\"{n_inst} instruments\"}\n",
    "    assign = pd.DataFrame(rows, columns=[\"scheme\", \"repeat\", \"fold\", \"student_id\"])\n",
    "    assert_student_disjoint(assign)\n",
    "    return assign, status\n",
    "\n",
    "\n",
    "def assert_student_disjoint(assign: pd.DataFrame) -> None:\n",
    "    dup = assign.duplicated([\"scheme\", \"repeat\", \"student_id\"])\n",
    "    if dup.any():\n",
    "        raise AssertionError(\"a student appears in more than one validation fold within a scheme repeat\")\n",
    "\n",
    "\n",
    "def available_schemes(assign: pd.DataFrame) -> list:\n",
    "    return [s for s in SCHEMES if s in set(assign[\"scheme\"])]\n",
    "\n",
    "\n",
    "def iter_folds(assign: pd.DataFrame, scheme: str, repeats: list | None = None):\n",
    "    sub = assign[assign[\"scheme\"] == scheme]\n",
    "    for rep in sorted(sub[\"repeat\"].unique()):\n",
    "        if repeats is not None and rep not in repeats:\n",
    "            continue\n",
    "        rs = sub[sub[\"repeat\"] == rep]\n",
    "        all_ids = rs[\"student_id\"].to_numpy()\n",
    "        for fold in sorted(rs[\"fold\"].unique()):\n",
    "            val = rs.loc[rs[\"fold\"] == fold, \"student_id\"].to_numpy()\n",
    "            train = np.setdiff1d(all_ids, val)\n",
    "            if len(np.intersect1d(train, val)):\n",
    "                raise AssertionError(\"train/validation overlap\")\n",
    "            yield int(rep), int(fold), train, val\n",
    "\n",
    "\n",
    "def regression_metrics(y, p) -> dict:\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    p = np.asarray(p, dtype=float)\n",
    "    m = np.isfinite(y) & np.isfinite(p)\n",
    "    y, p = y[m], p[m]\n",
    "    n = len(y)\n",
    "    if n < 3:\n",
    "        return {\"n\": n, \"r2\": np.nan, \"rmse\": np.nan, \"mae\": np.nan, \"medae\": np.nan, \"pearson\": np.nan, \"spearman\": np.nan}\n",
    "    ss_res = float(((y - p) ** 2).sum())\n",
    "    ss_tot = float(((y - y.mean()) ** 2).sum())\n",
    "    return {\"n\": n, \"r2\": 1 - ss_res / ss_tot if ss_tot > 0 else np.nan, \"rmse\": float(np.sqrt(ss_res / n)),\n",
    "            \"mae\": float(np.abs(y - p).mean()), \"medae\": float(np.median(np.abs(y - p))),\n",
    "            \"pearson\": float(np.corrcoef(y, p)[0, 1]) if np.std(p) > 0 else np.nan,\n",
    "            \"spearman\": float(sps.spearmanr(y, p)[0]) if np.std(p) > 0 else np.nan}\n",
    "\n",
    "\n",
    "def official_score(y, p, cfg: dict) -> float:\n",
    "    return regression_metrics(y, p)[cfg.get(\"official_metric\", \"r2\")]\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class CVResult:\n",
    "    scheme: str\n",
    "    oof: pd.DataFrame\n",
    "    fold_metrics: pd.DataFrame\n",
    "    summary: dict = field(default_factory=dict)\n",
    "\n",
    "\n",
    "def run_cv(y: pd.Series, assign: pd.DataFrame, scheme: str, fit_predict: Callable, cfg: dict,\n",
    "           repeats: list | None = None, groups: pd.Series | None = None, label: str = \"\") -> CVResult:\n",
    "    \"\"\"fit_predict(train_ids, val_ids, fold_key) -> predictions for val_ids (original target scale).\"\"\"\n",
    "    oof_rows, fm = [], []\n",
    "    for rep, fold, tr, va in iter_folds(assign, scheme, repeats):\n",
    "        tr = np.array([s for s in tr if s in y.index])\n",
    "        va = np.array([s for s in va if s in y.index])\n",
    "        if len(va) == 0 or len(tr) < 5:\n",
    "            continue\n",
    "        pred = np.asarray(fit_predict(tr, va, (scheme, rep, fold)), dtype=float)\n",
    "        yv = y.loc[va].to_numpy()\n",
    "        oof_rows.append(pd.DataFrame({\"student_id\": va, \"repeat\": rep, \"fold\": fold, \"y\": yv, \"pred\": pred}))\n",
    "        m = regression_metrics(yv, pred)\n",
    "        m.update({\"repeat\": rep, \"fold\": fold, \"n_train\": len(tr), \"official\": official_score(yv, pred, cfg)})\n",
    "        fm.append(m)\n",
    "    oof = pd.concat(oof_rows, ignore_index=True) if oof_rows else pd.DataFrame(columns=[\"student_id\", \"repeat\", \"fold\", \"y\", \"pred\"])\n",
    "    fold_metrics = pd.DataFrame(fm)\n",
    "    res = CVResult(scheme, oof, fold_metrics)\n",
    "    res.summary = summarize_cv(oof, fold_metrics, cfg, groups)\n",
    "    res.summary[\"label\"] = label\n",
    "    return res\n",
    "\n",
    "\n",
    "def pooled_predictions(oof: pd.DataFrame) -> pd.DataFrame:\n",
    "    return oof.groupby(\"student_id\").agg(y=(\"y\", \"first\"), pred=(\"pred\", \"mean\"), n_preds=(\"pred\", \"count\"))\n",
    "\n",
    "\n",
    "def summarize_cv(oof: pd.DataFrame, fold_metrics: pd.DataFrame, cfg: dict, groups: pd.Series | None = None) -> dict:\n",
    "    from .stats_utils import bootstrap_ci\n",
    "\n",
    "    if oof.empty:\n",
    "        return {\"status\": \"NO_FOLDS\"}\n",
    "    pooled = pooled_predictions(oof)\n",
    "    metric = cfg.get(\"official_metric\", \"r2\")\n",
    "    out = {\"status\": \"OK\", \"n_students\": int(len(pooled)), \"n_folds\": int(len(fold_metrics))}\n",
    "    pm = regression_metrics(pooled[\"y\"], pooled[\"pred\"])\n",
    "    out.update({f\"pooled_{k}\": v for k, v in pm.items() if k != \"n\"})\n",
    "    out[\"pooled_official\"] = pm[metric]\n",
    "    for k in (\"r2\", \"rmse\", \"mae\", \"spearman\", \"official\"):\n",
    "        if k in fold_metrics.columns:\n",
    "            out[f\"mean_fold_{k}\"] = float(fold_metrics[k].mean())\n",
    "            out[f\"std_fold_{k}\"] = float(fold_metrics[k].std(ddof=1)) if len(fold_metrics) > 1 else np.nan\n",
    "    yv, pv = pooled[\"y\"].to_numpy(), pooled[\"pred\"].to_numpy()\n",
    "    n_boot = int(cfg[\"bootstrap_iterations\"])\n",
    "    for k in (\"r2\", \"rmse\"):\n",
    "        ci = bootstrap_ci(lambda a, b, k=k: regression_metrics(a, b)[k], yv, pv, n_boot=n_boot, seed=int(cfg[\"seed\"]))\n",
    "        out[f\"pooled_{k}_ci_lower\"], out[f\"pooled_{k}_ci_upper\"] = ci[\"lower\"], ci[\"upper\"]\n",
    "    if groups is not None:\n",
    "        g = groups.reindex(pooled.index)\n",
    "        gm = []\n",
    "        for level, idx in g.dropna().groupby(g.dropna()).groups.items():\n",
    "            if len(idx) >= int(cfg[\"min_group_size\"]):\n",
    "                m = regression_metrics(pooled.loc[idx, \"y\"], pooled.loc[idx, \"pred\"])\n",
    "                gm.append(m[\"r2\"])\n",
    "        out[\"group_r2_median\"] = float(np.median(gm)) if gm else np.nan\n",
    "        out[\"group_r2_min\"] = float(np.min(gm)) if gm else np.nan\n",
    "        out[\"n_groups_evaluated\"] = len(gm)\n",
    "    return out\n",
    "\n",
    "\n",
    "def quantile_performance(pooled: pd.DataFrame, q: int = 5) -> pd.DataFrame:\n",
    "    bins = pd.qcut(pooled[\"y\"].rank(method=\"first\"), q, labels=[f\"Q{i + 1}\" for i in range(q)])\n",
    "    rows = []\n",
    "    for b, g in pooled.groupby(bins, observed=True):\n",
    "        err = g[\"pred\"] - g[\"y\"]\n",
    "        rows.append({\"target_quantile\": b, \"n\": len(g), \"rmse\": float(np.sqrt((err ** 2).mean())),\n",
    "                     \"mae\": float(err.abs().mean()), \"mean_signed_error\": float(err.mean())})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def group_performance(pooled: pd.DataFrame, groups: pd.Series, min_n: int) -> pd.DataFrame:\n",
    "    g = groups.reindex(pooled.index)\n",
    "    rows = []\n",
    "    for level, idx in g.dropna().groupby(g.dropna()).groups.items():\n",
    "        m = regression_metrics(pooled.loc[idx, \"y\"], pooled.loc[idx, \"pred\"])\n",
    "        m.update({\"group\": level, \"reliable\": len(idx) >= min_n})\n",
    "        rows.append(m)\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def paired_bootstrap_delta(y, p_new, p_ref, cfg: dict, metric: str = \"r2\") -> dict:\n",
    "    \"\"\"Bootstrap CI of metric(new) - metric(ref) on the same students.\"\"\"\n",
    "    from .stats_utils import bootstrap_ci\n",
    "\n",
    "    y, a, b = (np.asarray(v, dtype=float) for v in (y, p_new, p_ref))\n",
    "    sign = 1.0 if GREATER_IS_BETTER.get(metric, True) else -1.0\n",
    "    ci = bootstrap_ci(lambda yy, aa, bb: sign * (regression_metrics(yy, aa)[metric] - regression_metrics(yy, bb)[metric]),\n",
    "                      y, a, b, n_boot=int(cfg[\"bootstrap_iterations\"]), seed=int(cfg[\"seed\"]))\n",
    "    return {\"delta\": ci[\"estimate\"], \"ci_lower\": ci[\"lower\"], \"ci_upper\": ci[\"upper\"],\n",
    "            \"p_le_zero\": np.nan if not np.isfinite(ci[\"se\"]) or ci[\"se\"] == 0 else float(sps.norm.cdf(-ci[\"estimate\"] / ci[\"se\"]))}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-045",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/visualization.py\n",
    "\"\"\"Plotting helpers, the figure registry and Section 26 (visual atlas).\n",
    "\n",
    "Every figure is saved with a reproducible filename, a descriptive title, axis\n",
    "labels, sample size and a description computed from actual results, and is\n",
    "registered in ``figure_index.csv``. No figure is ever drawn from fabricated\n",
    "values: helpers receive computed data only.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import html\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from .io_utils import atomic_write_csv, atomic_write_text\n",
    "\n",
    "FIGURE_COLUMNS = [\"figure_id\", \"section\", \"title\", \"scientific_question\", \"filename\", \"source_table\",\n",
    "                  \"sample_size\", \"description\"]\n",
    "\n",
    "\n",
    "def _plt():\n",
    "    import matplotlib\n",
    "\n",
    "    if matplotlib.get_backend().lower() in {\"\", \"agg\"} or not _in_notebook():\n",
    "        matplotlib.use(\"Agg\", force=False)\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    return plt\n",
    "\n",
    "\n",
    "def _in_notebook() -> bool:\n",
    "    try:\n",
    "        from IPython import get_ipython  # type: ignore\n",
    "\n",
    "        return get_ipython() is not None\n",
    "    except Exception:\n",
    "        return False\n",
    "\n",
    "\n",
    "class FigureRegistry:\n",
    "    def __init__(self, index_path: Path, dpi: int = 160, enabled: bool = True):\n",
    "        self.index_path = Path(index_path)\n",
    "        self.dpi = dpi\n",
    "        self.enabled = enabled\n",
    "        if self.index_path.exists():\n",
    "            self.index = pd.read_csv(self.index_path)\n",
    "        else:\n",
    "            self.index = pd.DataFrame(columns=FIGURE_COLUMNS)\n",
    "\n",
    "    def save(self, fig, section: str, fig_id: str, title: str, question: str, source_table: str,\n",
    "             sample_size, description: str, directory: Path) -> Path | None:\n",
    "        plt = _plt()\n",
    "        if not self.enabled:\n",
    "            plt.close(fig)\n",
    "            return None\n",
    "        directory.mkdir(parents=True, exist_ok=True)\n",
    "        safe_id = \"\".join(ch if ch.isalnum() or ch in \"-_\" else \"_\" for ch in fig_id)\n",
    "        filename = directory / f\"S{section}_{safe_id}.png\"\n",
    "        if not fig._suptitle and title:\n",
    "            fig.suptitle(title, fontsize=11)\n",
    "        fig.savefig(filename, dpi=self.dpi, bbox_inches=\"tight\")\n",
    "        plt.close(fig)\n",
    "        row = {\"figure_id\": f\"S{section}_{safe_id}\", \"section\": section, \"title\": title,\n",
    "               \"scientific_question\": question, \"filename\": str(filename), \"source_table\": source_table,\n",
    "               \"sample_size\": sample_size, \"description\": description}\n",
    "        self.index = self.index[self.index[\"figure_id\"] != row[\"figure_id\"]]\n",
    "        self.index = pd.concat([self.index, pd.DataFrame([row])], ignore_index=True)\n",
    "        atomic_write_csv(self.index, self.index_path)\n",
    "        return filename\n",
    "\n",
    "\n",
    "def new_figure(nrows: int = 1, ncols: int = 1, size=(7, 4.5)):\n",
    "    plt = _plt()\n",
    "    fig, axes = plt.subplots(nrows, ncols, figsize=(size[0] * ncols, size[1] * nrows), squeeze=False)\n",
    "    return fig, axes\n",
    "\n",
    "\n",
    "def finalize_axis(ax, title: str, xlabel: str, ylabel: str, n=None) -> None:\n",
    "    ax.set_title(title + (f\" (n={n})\" if n is not None else \"\"), fontsize=10)\n",
    "    ax.set_xlabel(xlabel)\n",
    "    ax.set_ylabel(ylabel)\n",
    "    ax.grid(alpha=0.25)\n",
    "\n",
    "\n",
    "def hist_kde(ax, values, label: str, unit: str = \"\", bins: int = 40) -> int:\n",
    "    from scipy.stats import gaussian_kde\n",
    "\n",
    "    x = np.asarray(values, dtype=float)\n",
    "    n_missing = int((~np.isfinite(x)).sum())\n",
    "    x = x[np.isfinite(x)]\n",
    "    if len(x) == 0:\n",
    "        ax.text(0.5, 0.5, \"no finite values\", ha=\"center\", transform=ax.transAxes)\n",
    "        return 0\n",
    "    ax.hist(x, bins=bins, density=True, alpha=0.55, color=\"#4C72B0\")\n",
    "    if len(x) >= 10 and np.std(x) > 0:\n",
    "        grid = np.linspace(x.min(), x.max(), 256)\n",
    "        ax.plot(grid, gaussian_kde(x)(grid), color=\"#C44E52\", lw=1.5, label=\"KDE\")\n",
    "        ax.legend(fontsize=8)\n",
    "    finalize_axis(ax, f\"{label} (missing={n_missing})\", f\"{label}{' [' + unit + ']' if unit else ''}\", \"density\", len(x))\n",
    "    return len(x)\n",
    "\n",
    "\n",
    "def ecdf(ax, values, label: str, unit: str = \"\") -> None:\n",
    "    x = np.sort(np.asarray(values, dtype=float))\n",
    "    x = x[np.isfinite(x)]\n",
    "    if len(x) == 0:\n",
    "        return\n",
    "    ax.step(x, np.arange(1, len(x) + 1) / len(x), where=\"post\")\n",
    "    finalize_axis(ax, f\"ECDF of {label}\", f\"{label}{' [' + unit + ']' if unit else ''}\", \"cumulative proportion\", len(x))\n",
    "\n",
    "\n",
    "def qq(ax, values, label: str) -> None:\n",
    "    from scipy import stats\n",
    "\n",
    "    x = np.asarray(values, dtype=float)\n",
    "    x = x[np.isfinite(x)]\n",
    "    if len(x) < 3:\n",
    "        return\n",
    "    (osm, osr), (slope, intercept, r) = stats.probplot(x, dist=\"norm\")\n",
    "    ax.scatter(osm, osr, s=6, alpha=0.6)\n",
    "    ax.plot(osm, slope * osm + intercept, color=\"#C44E52\")\n",
    "    finalize_axis(ax, f\"Normal Q-Q of {label} (r={r:.3f})\", \"theoretical quantile\", \"sample quantile\", len(x))\n",
    "\n",
    "\n",
    "def grouped_box(ax, df: pd.DataFrame, value: str, group: str, label: str, violin: bool = False,\n",
    "                min_count: int = 3, max_groups: int = 30) -> None:\n",
    "    sub = df[[value, group]].dropna()\n",
    "    counts = sub[group].value_counts()\n",
    "    keep = counts[counts >= min_count].index[:max_groups]\n",
    "    sub = sub[sub[group].isin(keep)]\n",
    "    order = sub.groupby(group)[value].median().sort_values().index.tolist()\n",
    "    data = [sub.loc[sub[group] == g, value].to_numpy() for g in order]\n",
    "    if not data:\n",
    "        ax.text(0.5, 0.5, \"insufficient groups\", ha=\"center\", transform=ax.transAxes)\n",
    "        return\n",
    "    if violin:\n",
    "        ax.violinplot(data, showmedians=True)\n",
    "    else:\n",
    "        ax.boxplot(data, showfliers=False)\n",
    "    ax.set_xticks(range(1, len(order) + 1))\n",
    "    ax.set_xticklabels([f\"{g}\\n(n={counts[g]})\" for g in order], rotation=60, fontsize=7)\n",
    "    finalize_axis(ax, f\"{label} by {group}\", group, label, len(sub))\n",
    "\n",
    "\n",
    "def heatmap(ax, matrix: pd.DataFrame, title: str, cmap: str = \"RdBu_r\", vmin=None, vmax=None,\n",
    "            annotate: bool = False, cbar_label: str = \"\") -> None:\n",
    "    data = matrix.to_numpy(dtype=float)\n",
    "    if vmin is None and vmax is None and cmap == \"RdBu_r\":\n",
    "        lim = np.nanmax(np.abs(data)) if np.isfinite(data).any() else 1.0\n",
    "        vmin, vmax = -lim, lim\n",
    "    im = ax.imshow(np.ma.masked_invalid(data), cmap=cmap, vmin=vmin, vmax=vmax, aspect=\"auto\")\n",
    "    ax.set_xticks(range(matrix.shape[1]))\n",
    "    ax.set_xticklabels([str(c)[:40] for c in matrix.columns], rotation=90, fontsize=6)\n",
    "    ax.set_yticks(range(matrix.shape[0]))\n",
    "    ax.set_yticklabels([str(r)[:40] for r in matrix.index], fontsize=6)\n",
    "    if annotate and matrix.size <= 400:\n",
    "        for i in range(matrix.shape[0]):\n",
    "            for j in range(matrix.shape[1]):\n",
    "                if np.isfinite(data[i, j]):\n",
    "                    ax.text(j, i, f\"{data[i, j]:.2f}\", ha=\"center\", va=\"center\", fontsize=6)\n",
    "    cb = ax.figure.colorbar(im, ax=ax, fraction=0.04)\n",
    "    if cbar_label:\n",
    "        cb.set_label(cbar_label)\n",
    "    ax.set_title(title + \" (grey = missing)\", fontsize=10)\n",
    "\n",
    "\n",
    "def scatter_fit(ax, x, y, xlabel: str, ylabel: str, title: str) -> dict:\n",
    "    from .stats_utils import safe_corr\n",
    "\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    y = np.asarray(y, dtype=float)\n",
    "    mask = np.isfinite(x) & np.isfinite(y)\n",
    "    ax.scatter(x[mask], y[mask], s=8, alpha=0.5)\n",
    "    r, p, n = safe_corr(x, y, \"pearson\", 3)\n",
    "    if n >= 3 and np.std(x[mask]) > 0:\n",
    "        coef = np.polyfit(x[mask], y[mask], 1)\n",
    "        grid = np.linspace(np.nanmin(x[mask]), np.nanmax(x[mask]), 50)\n",
    "        ax.plot(grid, np.polyval(coef, grid), color=\"#C44E52\")\n",
    "    finalize_axis(ax, f\"{title} (r={r:.3f})\" if np.isfinite(r) else title, xlabel, ylabel, n)\n",
    "    return {\"pearson_r\": r, \"p\": p, \"n\": n}\n",
    "\n",
    "\n",
    "def forest(ax, df: pd.DataFrame, label_col: str, est_col: str, lo_col: str, hi_col: str, title: str,\n",
    "           xlabel: str) -> None:\n",
    "    d = df.dropna(subset=[est_col]).reset_index(drop=True)\n",
    "    y = np.arange(len(d))\n",
    "    err_lo = (d[est_col] - d[lo_col]).clip(lower=0).fillna(0)\n",
    "    err_hi = (d[hi_col] - d[est_col]).clip(lower=0).fillna(0)\n",
    "    ax.errorbar(d[est_col], y, xerr=[err_lo, err_hi], fmt=\"o\", ms=3, capsize=2)\n",
    "    ax.axvline(0, color=\"grey\", lw=0.8)\n",
    "    ax.set_yticks(y)\n",
    "    ax.set_yticklabels([str(v)[:50] for v in d[label_col]], fontsize=6)\n",
    "    finalize_axis(ax, title, xlabel, \"\", len(d))\n",
    "\n",
    "\n",
    "def radar(ax, labels: list, series: dict, title: str) -> None:\n",
    "    angles = np.linspace(0, 2 * np.pi, len(labels), endpoint=False).tolist()\n",
    "    angles += angles[:1]\n",
    "    for name, values in series.items():\n",
    "        vals = list(np.nan_to_num(np.asarray(values, dtype=float))) + [np.nan_to_num(values[0])]\n",
    "        ax.plot(angles, vals, lw=1.2, label=str(name))\n",
    "        ax.fill(angles, vals, alpha=0.08)\n",
    "    ax.set_xticks(angles[:-1])\n",
    "    ax.set_xticklabels([str(l)[:22] for l in labels], fontsize=6)\n",
    "    ax.set_title(title, fontsize=10)\n",
    "    ax.legend(fontsize=6, loc=\"upper right\", bbox_to_anchor=(1.3, 1.1))\n",
    "\n",
    "\n",
    "def binned_surface(df: pd.DataFrame, x: str, y: str, z: str, bins: int = 6, min_count: int = 10) -> pd.DataFrame:\n",
    "    \"\"\"Mean of z over quantile bins of x and y; cells with < min_count are NaN.\"\"\"\n",
    "    d = df[[x, y, z]].dropna()\n",
    "    if len(d) < min_count * 2:\n",
    "        return pd.DataFrame()\n",
    "    xb = pd.qcut(d[x], bins, duplicates=\"drop\")\n",
    "    yb = pd.qcut(d[y], bins, duplicates=\"drop\")\n",
    "    grouped = d.groupby([yb, xb], observed=True)[z]\n",
    "    mean = grouped.mean().unstack()\n",
    "    count = grouped.count().unstack()\n",
    "    mean = mean.where(count >= min_count)\n",
    "    mean.index = [f\"{iv.left:.2g}..{iv.right:.2g}\" for iv in mean.index]\n",
    "    mean.columns = [f\"{iv.left:.2g}..{iv.right:.2g}\" for iv in mean.columns]\n",
    "    return mean\n",
    "\n",
    "\n",
    "def top_correlation_heatmap(ctx, df: pd.DataFrame, cols: list, fig_id: str, title: str, question: str,\n",
    "                            source: str) -> None:\n",
    "    cols = [c for c in cols if c in df.columns][: int(ctx.config[\"max_features_for_heatmap\"])]\n",
    "    if len(cols) < 2:\n",
    "        return\n",
    "    corr = df[cols].corr(method=\"spearman\", min_periods=20)\n",
    "    fig, axes = new_figure(1, 1, (max(6, len(cols) * 0.18 + 3), max(5, len(cols) * 0.18 + 2)))\n",
    "    heatmap(axes[0, 0], corr, f\"Spearman correlation among {len(cols)} features\", vmin=-1, vmax=1,\n",
    "            cbar_label=\"Spearman rho\")\n",
    "    ctx.figure(fig, fig_id, title, question, source, len(df),\n",
    "               f\"Pairwise Spearman correlations (min 20 pairs) of {len(cols)} features; \"\n",
    "               f\"median |rho|={np.nanmedian(np.abs(corr.to_numpy()[np.triu_indices(len(cols), 1)])):.3f}.\")\n",
    "\n",
    "\n",
    "def missingness_matrix(ctx, df: pd.DataFrame, fig_id: str, title: str, source: str, max_cols: int = 80) -> None:\n",
    "    cols = list(df.columns)[:max_cols]\n",
    "    if not cols:\n",
    "        return\n",
    "    miss = df[cols].isna().to_numpy()\n",
    "    fig, axes = new_figure(1, 1, (max(6, len(cols) * 0.15 + 2), 5))\n",
    "    ax = axes[0, 0]\n",
    "    sample = miss if len(miss) <= 2000 else miss[np.linspace(0, len(miss) - 1, 2000).astype(int)]\n",
    "    ax.imshow(sample, aspect=\"auto\", cmap=\"Greys\", interpolation=\"nearest\")\n",
    "    ax.set_xticks(range(len(cols)))\n",
    "    ax.set_xticklabels([c[:30] for c in cols], rotation=90, fontsize=6)\n",
    "    finalize_axis(ax, \"Missingness (black = missing)\", \"column\", \"row (sampled)\", len(df))\n",
    "    rate = float(miss.mean())\n",
    "    ctx.figure(fig, fig_id, title, \"Where are values missing?\", source, len(df),\n",
    "               f\"Overall missing rate {rate:.3%} across {len(cols)} columns.\")\n",
    "\n",
    "\n",
    "def stage_visualization_atlas(ctx) -> dict:\n",
    "    \"\"\"Section 26: collate every registered figure into a local HTML atlas.\"\"\"\n",
    "    reg = ctx.figures.index.copy()\n",
    "    groups = {\n",
    "        \"Dataset atlas\": [\"01\", \"02\"],\n",
    "        \"Literacy atlas\": [\"03\", \"04\", \"05\"],\n",
    "        \"Acoustic atlas\": [\"06\", \"07\", \"08\", \"09\", \"10\", \"11\"],\n",
    "        \"Scientific discovery atlas\": [\"12\", \"13\", \"15\", \"16\", \"17\", \"18\", \"19\"],\n",
    "        \"Predictive atlas\": [\"14\", \"20\", \"21\", \"22\", \"23\", \"24\", \"25\"],\n",
    "    }\n",
    "    # Dataset-level figures produced here from actual tables.\n",
    "    sm = ctx.load_df(\"student_master\", required=False)\n",
    "    cm = ctx.load_df(\"clip_master\", required=False)\n",
    "    if sm is not None:\n",
    "        missingness_matrix(ctx, sm, \"dataset_student_missingness\", \"Student master missingness\", \"student_master\")\n",
    "        for col in (\"school_id\", \"instrument\"):\n",
    "            if col in sm.columns and sm[col].notna().any():\n",
    "                counts = sm.groupby([\"split\", col]).size().unstack(0).fillna(0)\n",
    "                fig, axes = new_figure(1, 1, (max(6, len(counts) * 0.25 + 2), 4))\n",
    "                counts.head(60).plot(kind=\"bar\", ax=axes[0, 0])\n",
    "                finalize_axis(axes[0, 0], f\"Students per {col} and split\", col, \"students\", int(len(sm)))\n",
    "                ctx.figure(fig, f\"dataset_{col}_distribution\", f\"Students per {col}\",\n",
    "                           f\"How are students distributed across {col}?\", \"student_master\", int(len(sm)),\n",
    "                           f\"{counts.shape[0]} distinct {col} values; largest has {int(counts.sum(1).max())} students.\")\n",
    "    if cm is not None and \"task_family\" in cm.columns:\n",
    "        cov = cm.groupby([\"split\", \"task_family\"])[\"student_id\"].nunique().unstack(0).fillna(0)\n",
    "        fig, axes = new_figure(1, 1)\n",
    "        cov.plot(kind=\"bar\", ax=axes[0, 0])\n",
    "        finalize_axis(axes[0, 0], \"Students with at least one clip per task\", \"task family\", \"students\", int(len(cm)))\n",
    "        ctx.figure(fig, \"dataset_task_coverage\", \"Student coverage per task\", \"Which tasks cover which students?\",\n",
    "                   \"clip_master\", int(cm[\"student_id\"].nunique()), \"Counts of distinct students per task family and split.\")\n",
    "        fig, axes = new_figure(1, 1, (8, 3.5))\n",
    "        ax = axes[0, 0]\n",
    "        levels = [(\"students\", sm[\"student_id\"].nunique() if sm is not None else np.nan),\n",
    "                  (\"tasks\", cm[\"task_family\"].nunique()), (\"items\", cm[\"item_key\"].nunique()),\n",
    "                  (\"clips\", len(cm))]\n",
    "        from matplotlib.patches import FancyBboxPatch\n",
    "\n",
    "        for i, (name, value) in enumerate(levels):\n",
    "            ax.add_patch(FancyBboxPatch((i * 2.2, 0.3), 1.8, 1.0, boxstyle=\"round,pad=0.05\",\n",
    "                                        fc=\"#DDE6F2\", ec=\"#4C72B0\"))\n",
    "            ax.text(i * 2.2 + 0.9, 0.8, f\"{name}\\n{value}\", ha=\"center\", va=\"center\", fontsize=9)\n",
    "            if i:\n",
    "                ax.annotate(\"\", xy=(i * 2.2, 0.8), xytext=(i * 2.2 - 0.4, 0.8), arrowprops={\"arrowstyle\": \"->\"})\n",
    "        ax.set_xlim(-0.2, len(levels) * 2.2)\n",
    "        ax.set_ylim(0, 1.6)\n",
    "        ax.axis(\"off\")\n",
    "        ax.set_title(\"Hierarchical data structure: student > task > item > clip > acoustic frames\", fontsize=10)\n",
    "        ctx.figure(fig, \"dataset_hierarchy\", \"Hierarchical data diagram\", \"How is the dataset nested?\",\n",
    "                   \"clip_master\", int(len(cm)), \"Counts at each hierarchical level computed from the master tables.\")\n",
    "    reg = ctx.figures.index.copy()\n",
    "    parts = [\"<html><head><meta charset='utf-8'><title>WildSpeech P01 visual atlas</title>\",\n",
    "             \"<style>body{font-family:sans-serif;max-width:1200px;margin:auto}img{max-width:100%;border:1px solid #ccc}\"\n",
    "             \".fig{margin:18px 0}</style></head><body><h1>WildSpeech P01 visual atlas</h1>\",\n",
    "             \"<p>Local file. Contains derived figures only; do not publish recordings or identifiable material.</p>\"]\n",
    "    for group, sections in groups.items():\n",
    "        sub = reg[reg[\"section\"].astype(str).str.zfill(2).isin(sections)]\n",
    "        parts.append(f\"<h2>{html.escape(group)} ({len(sub)} figures)</h2>\")\n",
    "        for _, r in sub.iterrows():\n",
    "            try:\n",
    "                rel = Path(os.path.relpath(str(r[\"filename\"]), str(ctx.out_dir()))).as_posix()\n",
    "            except ValueError:  # different drive on Windows\n",
    "                rel = Path(str(r[\"filename\"])).as_posix()\n",
    "            parts.append(f\"<div class='fig'><h3>{html.escape(str(r['title']))}</h3>\"\n",
    "                         f\"<p><b>Question:</b> {html.escape(str(r['scientific_question']))}<br>\"\n",
    "                         f\"<b>n:</b> {html.escape(str(r['sample_size']))} &middot; <b>Source:</b> {html.escape(str(r['source_table']))}<br>\"\n",
    "                         f\"{html.escape(str(r['description']))}</p><img src='{html.escape(str(rel))}'></div>\")\n",
    "    parts.append(\"</body></html>\")\n",
    "    out = ctx.out_dir() / \"P01_VISUAL_ATLAS.html\"\n",
    "    atomic_write_text(out, \"\\n\".join(parts))\n",
    "    ctx.store.register(\"visual_atlas_html\", out, ctx.current_stage, \"html\")\n",
    "    ctx.save_df(reg, \"figure_index_snapshot\", fmt=\"csv\")\n",
    "    return {\"outputs\": [\"visual_atlas_html\", \"figure_index_snapshot\"], \"summary\": {\"n_figures\": int(len(reg))}}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-046",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/wavelet_features.py\n",
    "\"\"\"Section 09 - wavelet and multiscale signal discovery.\n",
    "\n",
    "Discrete families (DWT, wavelet packets) and continuous families (CWT) are\n",
    "kept strictly separate: a continuous wavelet (morl, mexh, cmor) is never\n",
    "passed to a discrete transform and vice versa. Decomposition depth adapts to\n",
    "signal length; CWT is limited by downsampling, a configurable number of\n",
    "scales and a maximum analysed duration. Only interpretable summary features\n",
    "are retained - no scalograms are stored.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "EPS = 1e-12\n",
    "CWT_BANDS_HZ = [(0, 125), (125, 250), (250, 500), (500, 1000), (1000, 2000)]\n",
    "ENV_LEVELS = 5\n",
    "\n",
    "\n",
    "def compatible_families(families: list) -> dict:\n",
    "    import pywt\n",
    "\n",
    "    discrete = set(pywt.wavelist(kind=\"discrete\"))\n",
    "    continuous = set(pywt.wavelist(kind=\"continuous\"))\n",
    "    out = {\"discrete\": [], \"continuous\": [], \"rejected\": []}\n",
    "    for fam in families:\n",
    "        base = fam.split(\"-\")[0].rstrip(\"0123456789.\")\n",
    "        if fam in discrete:\n",
    "            out[\"discrete\"].append(fam)\n",
    "        elif fam in continuous or (base in {\"cmor\", \"shan\", \"fbsp\"} and base in continuous):\n",
    "            out[\"continuous\"].append(fam)\n",
    "        else:\n",
    "            out[\"rejected\"].append(fam)\n",
    "    return out\n",
    "\n",
    "\n",
    "def _entropy(p: np.ndarray) -> float:\n",
    "    p = p[p > 0]\n",
    "    return float(-(p * np.log(p)).sum() / np.log(len(p))) if len(p) > 1 else np.nan\n",
    "\n",
    "\n",
    "def _analysis_signal(b) -> np.ndarray:\n",
    "    if b.segments:\n",
    "        parts = [b.y[int(s * b.sr):int(e * b.sr)] for s, e in b.segments]\n",
    "        x = np.concatenate(parts) if parts else b.y\n",
    "        if len(x) >= int(0.2 * b.sr):\n",
    "            return x.astype(float)\n",
    "    return b.y.astype(float)\n",
    "\n",
    "\n",
    "def dwt_features(x: np.ndarray, sr: int, family: str, max_level: int, detailed: bool) -> dict:\n",
    "    import pywt\n",
    "    from scipy.stats import kurtosis\n",
    "\n",
    "    prefix = f\"w_{family}\"\n",
    "    names = [f\"{prefix}_D{j}_rel\" for j in range(1, max_level + 1)] + [f\"{prefix}_A_rel\", f\"{prefix}_entropy\",\n",
    "                                                                       f\"{prefix}_transient_density\", f\"{prefix}_levels\"]\n",
    "    out = {n: np.nan for n in names}\n",
    "    if detailed:\n",
    "        for j in range(1, min(max_level, 6) + 1):\n",
    "            out[f\"{prefix}_D{j}_kurt\"] = np.nan\n",
    "            out[f\"{prefix}_D{j}_logstd\"] = np.nan\n",
    "        for k in (\"ratio_D1_D3\", \"ratio_D2_D4\", \"ratio_hi_lo\", \"xscale_consistency\", \"ms_variability\", \"hf_bursts_per_s\"):\n",
    "            out[f\"{prefix}_{k}\"] = np.nan\n",
    "    w = pywt.Wavelet(family)\n",
    "    level = min(max_level, pywt.dwt_max_level(len(x), w.dec_len))\n",
    "    if level < 2:\n",
    "        return out\n",
    "    coeffs = pywt.wavedec(x, w, level=level)\n",
    "    approx, details = coeffs[0], coeffs[1:][::-1]  # details[0] is D1 (finest)\n",
    "    energies = np.array([np.sum(d ** 2) for d in details] + [np.sum(approx ** 2)])\n",
    "    total = energies.sum() + EPS\n",
    "    rel = energies / total\n",
    "    for j in range(level):\n",
    "        out[f\"{prefix}_D{j + 1}_rel\"] = float(rel[j])\n",
    "    out[f\"{prefix}_A_rel\"] = float(rel[-1])\n",
    "    out[f\"{prefix}_entropy\"] = _entropy(rel)\n",
    "    out[f\"{prefix}_levels\"] = float(level)\n",
    "    dur = len(x) / sr\n",
    "    count = 0\n",
    "    for d in details[:3]:\n",
    "        mad = np.median(np.abs(d - np.median(d))) / 0.6745\n",
    "        if mad > 0:\n",
    "            count += int((np.abs(d) > 4 * mad).sum())\n",
    "    out[f\"{prefix}_transient_density\"] = float(count / dur) if dur > 0 else np.nan\n",
    "    if detailed:\n",
    "        for j, d in enumerate(details[:6]):\n",
    "            if len(d) >= 8 and np.std(d) > 0:\n",
    "                out[f\"{prefix}_D{j + 1}_kurt\"] = float(kurtosis(d))\n",
    "                out[f\"{prefix}_D{j + 1}_logstd\"] = float(np.log10(np.std(d) + EPS))\n",
    "        e = energies\n",
    "        if level >= 3:\n",
    "            out[f\"{prefix}_ratio_D1_D3\"] = float(np.log10((e[0] + EPS) / (e[2] + EPS)))\n",
    "        if level >= 4:\n",
    "            out[f\"{prefix}_ratio_D2_D4\"] = float(np.log10((e[1] + EPS) / (e[3] + EPS)))\n",
    "            out[f\"{prefix}_ratio_hi_lo\"] = float(np.log10((e[:2].sum() + EPS) / (e[3:level].sum() + EPS)))\n",
    "        # cross-scale consistency: correlation of adjacent detail envelopes on a common grid\n",
    "        n_grid = max(16, min(512, len(details[min(level - 1, 3)])))\n",
    "        envs = []\n",
    "        for d in details[:min(level, 5)]:\n",
    "            env = np.abs(d)\n",
    "            idx = np.linspace(0, len(env) - 1, n_grid)\n",
    "            envs.append(np.interp(idx, np.arange(len(env)), env))\n",
    "        cors = [np.corrcoef(envs[i], envs[i + 1])[0, 1] for i in range(len(envs) - 1)\n",
    "                if np.std(envs[i]) > 0 and np.std(envs[i + 1]) > 0]\n",
    "        out[f\"{prefix}_xscale_consistency\"] = float(np.mean(cors)) if cors else np.nan\n",
    "        cvs = []\n",
    "        for j, d in enumerate(details[:min(level, 5)]):\n",
    "            win = max(4, int(0.05 * sr / (2 ** (j + 1))))\n",
    "            nwin = len(d) // win\n",
    "            if nwin >= 3:\n",
    "                we = (d[:nwin * win].reshape(nwin, win) ** 2).sum(axis=1)\n",
    "                if we.mean() > 0:\n",
    "                    cvs.append(we.std(ddof=1) / we.mean())\n",
    "        out[f\"{prefix}_ms_variability\"] = float(np.mean(cvs)) if cvs else np.nan\n",
    "        d1 = np.abs(details[0])\n",
    "        win = max(4, int(0.01 * sr / 2))\n",
    "        nwin = len(d1) // win\n",
    "        if nwin >= 5:\n",
    "            we = d1[:nwin * win].reshape(nwin, win).mean(axis=1)\n",
    "            thr = np.median(we) + 3 * (np.median(np.abs(we - np.median(we))) / 0.6745 + EPS)\n",
    "            bursts = np.flatnonzero(np.diff((we > thr).astype(int)) == 1)\n",
    "            out[f\"{prefix}_hf_bursts_per_s\"] = float(len(bursts) / dur) if dur > 0 else np.nan\n",
    "    return out\n",
    "\n",
    "\n",
    "def packet_features(x: np.ndarray, family: str, level_cfg: int) -> dict:\n",
    "    import pywt\n",
    "\n",
    "    n_nodes = 2 ** level_cfg\n",
    "    out = {f\"w_wp_node{k}_rel\": np.nan for k in range(n_nodes)}\n",
    "    out[\"w_wp_entropy\"] = np.nan\n",
    "    out[\"w_wp_level\"] = np.nan\n",
    "    w = pywt.Wavelet(family)\n",
    "    level = min(level_cfg, pywt.dwt_max_level(len(x), w.dec_len))\n",
    "    if level < 2:\n",
    "        return out\n",
    "    wp = pywt.WaveletPacket(data=x, wavelet=w, mode=\"symmetric\", maxlevel=level)\n",
    "    nodes = wp.get_level(level, order=\"freq\")\n",
    "    e = np.array([np.sum(np.asarray(n.data) ** 2) for n in nodes])\n",
    "    rel = e / (e.sum() + EPS)\n",
    "    out[\"w_wp_entropy\"] = _entropy(rel)\n",
    "    out[\"w_wp_level\"] = float(level)\n",
    "    if level == level_cfg:\n",
    "        for k, v in enumerate(rel):\n",
    "            out[f\"w_wp_node{k}_rel\"] = float(v)\n",
    "    return out\n",
    "\n",
    "\n",
    "def cwt_features(x: np.ndarray, sr: int, wavelet: str, cwt_sr: int, n_scales: int, max_seconds: float) -> dict:\n",
    "    import pywt\n",
    "    from scipy.signal import resample_poly\n",
    "\n",
    "    tag = wavelet.replace(\".\", \"p\").replace(\"-\", \"_\")\n",
    "    prefix = f\"w_cwt_{tag}\"\n",
    "    out = {f\"{prefix}_band{k}_rel\": np.nan for k in range(len(CWT_BANDS_HZ))}\n",
    "    out[f\"{prefix}_entropy\"] = np.nan\n",
    "    out[f\"{prefix}_temporal_cv\"] = np.nan\n",
    "    if len(x) < int(0.1 * sr):\n",
    "        return out\n",
    "    g = np.gcd(int(sr), int(cwt_sr))\n",
    "    xd = resample_poly(x, int(cwt_sr) // g, int(sr) // g) if cwt_sr < sr else x\n",
    "    xd = xd[: int(max_seconds * cwt_sr)]\n",
    "    if len(xd) < 64:\n",
    "        return out\n",
    "    fc = pywt.central_frequency(wavelet)\n",
    "    freqs = np.geomspace(40, min(2000, cwt_sr / 2 * 0.95), n_scales)\n",
    "    scales = fc * cwt_sr / freqs\n",
    "    coefs, pf = pywt.cwt(xd, scales, wavelet, sampling_period=1.0 / cwt_sr)\n",
    "    power = np.abs(coefs) ** 2\n",
    "    scale_energy = power.sum(axis=1)\n",
    "    total = scale_energy.sum() + EPS\n",
    "    for k, (lo, hi) in enumerate(CWT_BANDS_HZ):\n",
    "        out[f\"{prefix}_band{k}_rel\"] = float(scale_energy[(pf >= lo) & (pf < hi)].sum() / total)\n",
    "    out[f\"{prefix}_entropy\"] = _entropy(scale_energy / total)\n",
    "    tp = power.sum(axis=0)\n",
    "    out[f\"{prefix}_temporal_cv\"] = float(tp.std() / tp.mean()) if tp.mean() > 0 else np.nan\n",
    "    return out\n",
    "\n",
    "\n",
    "def envelope_wavelet_features(rms: np.ndarray) -> dict:\n",
    "    import pywt\n",
    "\n",
    "    out = {f\"w_env_D{j}_rel\": np.nan for j in range(1, ENV_LEVELS + 1)}\n",
    "    out[\"w_env_entropy\"] = np.nan\n",
    "    if len(rms) < 16:\n",
    "        return out\n",
    "    w = pywt.Wavelet(\"db4\")\n",
    "    level = min(ENV_LEVELS, pywt.dwt_max_level(len(rms), w.dec_len))\n",
    "    if level < 2:\n",
    "        return out\n",
    "    coeffs = pywt.wavedec(rms - rms.mean(), w, level=level)\n",
    "    details = coeffs[1:][::-1]\n",
    "    e = np.array([np.sum(d ** 2) for d in details])\n",
    "    rel = e / (e.sum() + EPS)\n",
    "    for j, v in enumerate(rel):\n",
    "        out[f\"w_env_D{j + 1}_rel\"] = float(v)\n",
    "    out[\"w_env_entropy\"] = _entropy(rel)\n",
    "    return out\n",
    "\n",
    "\n",
    "def wavelet_features(b, cfg: dict) -> dict:\n",
    "    x = _analysis_signal(b)\n",
    "    fams = compatible_families(list(cfg[\"wavelet_families_dwt\"]) + list(cfg.get(\"cwt_wavelets\") or []))\n",
    "    out: dict = {}\n",
    "    max_level = int(cfg[\"wavelet_max_level\"])\n",
    "    primary = cfg[\"wavelet_primary_family\"]\n",
    "    for fam in fams[\"discrete\"]:\n",
    "        if fam in cfg[\"wavelet_families_dwt\"]:\n",
    "            out.update(dwt_features(x, b.sr, fam, max_level, detailed=(fam == primary)))\n",
    "    if primary not in fams[\"discrete\"] or primary not in cfg[\"wavelet_families_dwt\"]:\n",
    "        out.update(dwt_features(x, b.sr, primary, max_level, detailed=True))\n",
    "    out.update(packet_features(x, cfg[\"wavelet_packet_family\"], int(cfg[\"wavelet_packet_level\"])))\n",
    "    if cfg.get(\"enable_cwt\"):\n",
    "        for wav in fams[\"continuous\"]:\n",
    "            if wav in (cfg.get(\"cwt_wavelets\") or []):\n",
    "                out.update(cwt_features(x, b.sr, wav, int(cfg[\"cwt_sr\"]), int(cfg[\"cwt_n_scales\"]),\n",
    "                                        float(cfg[\"cwt_max_seconds\"])))\n",
    "    out.update(envelope_wavelet_features(b.rms.astype(float)))\n",
    "    return out\n",
    "\n",
    "\n",
    "def stage_wavelet_features(ctx) -> dict:\n",
    "    from .family_analysis import analyze_family, multiscale_comparisons\n",
    "\n",
    "    result = analyze_family(ctx, family=\"WAVELETS\", prefixes=(\"w_\",), split_by_correctness=False, control_quality=True)\n",
    "    multiscale_comparisons(ctx, prefixes=(\"w_\",), outputs=result[\"outputs\"])\n",
    "    compat = compatible_families(list(ctx.config[\"wavelet_families_all\"]))\n",
    "    ctx.save_json(compat, \"wavelet_family_compatibility\")\n",
    "    result[\"outputs\"].append(\"wavelet_family_compatibility\")\n",
    "    return result\n"
   ]
  },
