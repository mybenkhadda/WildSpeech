    "%%writefile {CODE_ROOT}/tests/conftest.py\n",
    "\"\"\"Shared fixtures. Tests use tiny synthetic tables only - never competition data.\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
