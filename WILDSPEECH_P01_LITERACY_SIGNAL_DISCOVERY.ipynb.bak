   "cell_type": "code",
   "execution_count": null,
   "id": "cell-021",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/foundation_models.py\n",
    "\"\"\"Optional Section 23 - speech foundation-model exploration (disabled by default).\n",
    "\n",
    "Frozen-encoder embeddings (Whisper encoder, wav2vec2, HuBERT, WavLM or a\n",
    "suitable child-speech model) with layer selection, mean / std / quantile /\n",
    "speech-active-frame pooling, task-conditioned and student-level hierarchical\n",
    "pooling, and train-fitted PCA. No fine-tuning in P01.\n",
    "\n",
    "EMBEDDING_MODEL_SPEC (one dict per model)::\n",
    "\n",
    "    {\"alias\": \"wavlm_base\", \"type\": \"whisper_encoder\" | \"ssl\",\n",
    "     \"checkpoint\": \"<local path or hub id>\", \"layers\": [6, 12],\n",
    "     \"license_verified\": True, \"eligible_for_competition\": True,\n",
    "     \"data_overlap_checked\": True, \"batch_size\": 16}\n",
    "\n",
    "Each entry must be explicitly license-verified, competition-eligible and\n",
    "checked for pretraining-data overlap by the user before it is used.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "\n",
    "EMBEDDING_MODEL_SPEC = {\"alias\": str, \"type\": str, \"checkpoint\": str, \"layers\": list, \"license_verified\": bool,\n",
    "                        \"eligible_for_competition\": bool, \"data_overlap_checked\": bool}\n",
    "\n",
    "\n",
    "class EmbeddingExtractor:\n",
    "    def __init__(self, spec: dict, cfg: dict):\n",
    "        for flag in (\"license_verified\", \"eligible_for_competition\", \"data_overlap_checked\"):\n",
    "            if not spec.get(flag):\n",
    "                raise PermissionError(f\"embedding model {spec.get('alias')} requires {flag}=True\")\n",
    "        import torch\n",
    "\n",
    "        self.torch = torch\n",
    "        self.spec = spec\n",
    "        self.alias = spec.get(\"alias\") or spec[\"type\"]\n",
    "        self.device = \"cuda\" if cfg.get(\"use_gpu\") and torch.cuda.is_available() else \"cpu\"\n",
    "        local = bool(cfg.get(\"hf_local_files_only\", True))\n",
    "        if spec[\"type\"] == \"whisper_encoder\":\n",
    "            from transformers import WhisperFeatureExtractor, WhisperModel\n",
    "\n",
    "            self.fe = WhisperFeatureExtractor.from_pretrained(spec[\"checkpoint\"], local_files_only=local)\n",
    "            self.model = WhisperModel.from_pretrained(spec[\"checkpoint\"], local_files_only=local).encoder.to(self.device).eval()\n",
    "            self.frame_s = 0.02\n",
    "        else:\n",
    "            from transformers import AutoFeatureExtractor, AutoModel\n",
    "\n",
    "            self.fe = AutoFeatureExtractor.from_pretrained(spec[\"checkpoint\"], local_files_only=local)\n",
    "            self.model = AutoModel.from_pretrained(spec[\"checkpoint\"], local_files_only=local).to(self.device).eval()\n",
    "            self.frame_s = 0.02\n",
    "        self.layers = list(spec.get(\"layers\") or [-1])\n",
    "        self.amp = self.device == \"cuda\"\n",
    "\n",
    "    def embed(self, waves: list, sr: int, masks: list) -> list:\n",
    "        torch = self.torch\n",
    "        if self.spec[\"type\"] == \"whisper_encoder\":\n",
    "            inputs = self.fe(waves, sampling_rate=sr, return_tensors=\"pt\")\n",
    "            x = inputs.input_features.to(self.device)\n",
    "            kwargs = {}\n",
    "        else:\n",
    "            inputs = self.fe(waves, sampling_rate=sr, return_tensors=\"pt\", padding=True, return_attention_mask=True)\n",
    "            x = inputs.input_values.to(self.device)\n",
    "            kwargs = {\"attention_mask\": inputs[\"attention_mask\"].to(self.device)} if \"attention_mask\" in inputs else {}\n",
    "        with torch.no_grad(), torch.autocast(device_type=\"cuda\", enabled=self.amp):\n",
    "            out = self.model(x, output_hidden_states=True, **kwargs)\n",
    "        hidden = out.hidden_states\n",
    "        results = []\n",
    "        for k, w in enumerate(waves):\n",
    "            n_frames = int(min(hidden[0].shape[1], np.ceil(len(w) / sr / self.frame_s)))\n",
    "            rec = {}\n",
    "            vad = masks[k]\n",
    "            for layer in self.layers:\n",
    "                H = hidden[layer][k, :n_frames].float().cpu().numpy()\n",
    "                tag = f\"L{layer if layer >= 0 else len(hidden) + layer}\"\n",
    "                rec[tag] = {\"mean\": H.mean(0), \"std\": H.std(0), \"q10\": np.quantile(H, 0.1, axis=0), \"q90\": np.quantile(H, 0.9, axis=0)}\n",
    "                if vad is not None:\n",
    "                    idx = np.clip((np.arange(n_frames) * self.frame_s / vad[\"hop_s\"]).astype(int), 0, len(vad[\"mask\"]) - 1)\n",
    "                    sel = vad[\"mask\"][idx]\n",
    "                    rec[tag][\"speech_mean\"] = H[sel].mean(0) if sel.sum() >= 2 else np.full(H.shape[1], np.nan)\n",
    "            results.append(rec)\n",
    "        return results\n",
    "\n",
    "\n",
    "def _vad_masks(ctx, clip_ids: list, split: str) -> dict:\n",
    "    name = \"vad_segments\" if split == \"train\" else \"vad_segments_test\"\n",
    "    segs = ctx.load_df(name, required=False)\n",
    "    if segs is None:\n",
    "        return {}\n",
    "    hop_s = ctx.config[\"hop_length\"] / ctx.config[\"sample_rate\"]\n",
    "    out = {}\n",
    "    for cid, g in segs[segs[\"clip_id\"].isin(set(clip_ids))].groupby(\"clip_id\"):\n",
    "        n = int(np.ceil(g[\"end_s\"].max() / hop_s)) + 1\n",
    "        m = np.zeros(n, bool)\n",
    "        for s, e in zip(g[\"start_s\"], g[\"end_s\"]):\n",
    "            m[int(s / hop_s):int(e / hop_s) + 1] = True\n",
    "        out[cid] = {\"mask\": m, \"hop_s\": hop_s}\n",
    "    return out\n",
    "\n",
    "\n",
    "def extract_embeddings(ctx, extractor: EmbeddingExtractor, split: str) -> pd.DataFrame:\n",
    "    from . import audio_manifest as am\n",
    "    from .audio_processing import decode_audio\n",
    "    from .io_utils import atomic_write_parquet\n",
    "    from .logging_utils import progress, release_memory\n",
    "\n",
    "    cfg = ctx.config\n",
    "    clips = da.clips(ctx, split)\n",
    "    clips = clips[clips[\"audio_member\"].notna()]\n",
    "    cache = ctx.paths.cache_dir(\"embeddings\") / f\"{split}_{extractor.alias}\"\n",
    "    cache.mkdir(parents=True, exist_ok=True)\n",
    "    done = set()\n",
    "    for p in cache.glob(\"chunk_*.parquet\"):\n",
    "        done |= set(pd.read_parquet(p, columns=[\"clip_id\"])[\"clip_id\"])\n",
    "    todo = clips[~clips[\"clip_id\"].isin(done)]\n",
    "    archive = ctx.data_root() / (\"train_audio.tar\" if split == \"train\" else \"test_audio.tar\")\n",
    "    extracted = ctx.paths.extracted_train if split == \"train\" else ctx.paths.extracted_test\n",
    "    sr = 16000\n",
    "    bs0 = int(extractor.spec.get(\"batch_size\", cfg[\"audio_batch_size\"]))\n",
    "    chunk = max(bs0 * 8, 64)\n",
    "    start = len(list(cache.glob(\"chunk_*.parquet\")))\n",
    "    for ci, s0 in enumerate(progress(range(0, len(todo), chunk), desc=f\"embed {extractor.alias}\")):\n",
    "        part = todo.iloc[s0:s0 + chunk]\n",
    "        use_files = all((extracted / m).exists() for m in part[\"audio_member\"])\n",
    "        blobs = {} if use_files else am.read_member_bytes(archive, part[\"audio_member\"].tolist())\n",
    "        vad = _vad_masks(ctx, part[\"clip_id\"].tolist(), split)\n",
    "        waves, ids = [], []\n",
    "        for _, r in part.iterrows():\n",
    "            src = str(extracted / r[\"audio_member\"]) if use_files else blobs.get(r[\"audio_member\"])\n",
    "            if src is None:\n",
    "                continue\n",
    "            y, _ = decode_audio(src, sr)\n",
    "            waves.append(y[: int(float(cfg[\"embedding_max_seconds\"]) * sr)])\n",
    "            ids.append(r[\"clip_id\"])\n",
    "        rows, k, bs = [], 0, bs0\n",
    "        while k < len(waves):\n",
    "            try:\n",
    "                res = extractor.embed(waves[k:k + bs], sr, [vad.get(c) for c in ids[k:k + bs]])\n",
    "            except RuntimeError as exc:\n",
    "                if \"out of memory\" in str(exc).lower() and bs > 1:\n",
    "                    release_memory()\n",
    "                    bs = max(1, bs // 2)\n",
    "                    ctx.logger.warning(\"CUDA OOM during embedding; batch -> %d\", bs)\n",
    "                    continue\n",
    "                raise\n",
    "            for cid, rec in zip(ids[k:k + bs], res):\n",
    "                row = {\"clip_id\": cid}\n",
    "                for layer, pools in rec.items():\n",
    "                    for pool, vec in pools.items():\n",
    "                        row.update({f\"emb_{extractor.alias}_{layer}_{pool}_{j}\": float(v) for j, v in enumerate(vec)})\n",
    "                rows.append(row)\n",
    "            k += bs\n",
    "        atomic_write_parquet(pd.DataFrame(rows), cache / f\"chunk_{start + ci:05d}.parquet\")\n",
    "        release_memory()\n",
    "    parts = [pd.read_parquet(p) for p in sorted(cache.glob(\"chunk_*.parquet\"))]\n",
    "    return pd.concat(parts, ignore_index=True).drop_duplicates(\"clip_id\", keep=\"last\") if parts else pd.DataFrame(columns=[\"clip_id\"])\n",
    "\n",
    "\n",
    "def reduce_and_pool(ctx, emb_train: pd.DataFrame, emb_test: pd.DataFrame | None, alias: str) -> tuple[pd.DataFrame, pd.DataFrame | None, dict]:\n",
    "    \"\"\"Train-fitted PCA per (layer, pool) block, then task-conditioned and student-level pooling (e_ prefix).\"\"\"\n",
    "    from sklearn.decomposition import PCA\n",
    "\n",
    "    cfg = ctx.config\n",
    "    n_comp = int(cfg[\"embedding_pca_components\"])\n",
    "    blocks = {}\n",
    "    for c in emb_train.columns:\n",
    "        if c.startswith(f\"emb_{alias}_\"):\n",
    "            key = \"_\".join(c.split(\"_\")[:-1])\n",
    "            blocks.setdefault(key, []).append(c)\n",
    "    reduced_tr, reduced_te, info = [emb_train[[\"clip_id\"]]], [emb_test[[\"clip_id\"]]] if emb_test is not None else None, {}\n",
    "    for key, cols in blocks.items():\n",
    "        Xtr = emb_train[cols].to_numpy(dtype=float)\n",
    "        mu = np.nanmean(Xtr, axis=0)\n",
    "        Xtr = np.where(np.isnan(Xtr), mu, Xtr)\n",
    "        k = min(n_comp, Xtr.shape[1], max(1, Xtr.shape[0] - 1))\n",
    "        pca = PCA(k, random_state=int(cfg[\"seed\"])).fit(Xtr)\n",
    "        name = key.replace(f\"emb_{alias}_\", f\"e_{alias}_\")\n",
    "        reduced_tr.append(pd.DataFrame(pca.transform(Xtr), columns=[f\"{name}_pc{j}\" for j in range(k)]))\n",
    "        info[key] = {\"components\": k, \"explained\": float(pca.explained_variance_ratio_.sum())}\n",
    "        if emb_test is not None:\n",
    "            Xte = emb_test[cols].to_numpy(dtype=float)\n",
    "            Xte = np.where(np.isnan(Xte), mu, Xte)\n",
    "            reduced_te.append(pd.DataFrame(pca.transform(Xte), columns=[f\"{name}_pc{j}\" for j in range(k)]))\n",
    "\n",
    "    def pool(red: pd.DataFrame, split: str) -> pd.DataFrame:\n",
    "        cm = da.clips(ctx, split)[[\"clip_id\", \"student_id\", \"task_family\"]]\n",
    "        d = red.merge(cm, on=\"clip_id\", how=\"inner\")\n",
    "        feats = [c for c in d.columns if c.startswith(\"e_\")]\n",
    "        g = d.groupby(\"student_id\")[feats]\n",
    "        out = pd.concat([g.mean().add_suffix(\"__mean\"), g.std(ddof=1).add_suffix(\"__std\")], axis=1)\n",
    "        for task, gt in d.groupby(\"task_family\"):\n",
    "            out = out.join(gt.groupby(\"student_id\")[feats].mean().add_suffix(f\"__task={task}__mean\"))\n",
    "        return out.reset_index()\n",
    "\n",
    "    tr = pd.concat(reduced_tr, axis=1)\n",
    "    te = pd.concat(reduced_te, axis=1) if emb_test is not None else None\n",
    "    return pool(tr, \"train\"), (pool(te, \"test\") if te is not None else None), info\n",
    "\n",
    "\n",
    "def embedding_similarity(ctx, red_student: pd.DataFrame) -> dict:\n",
    "    cols = [c for c in red_student.columns if c.endswith(\"__mean\") and \"__task=\" not in c]\n",
    "    if len(cols) < 2:\n",
    "        return {}\n",
    "    X = red_student[cols].fillna(0.0).to_numpy()\n",
    "    X = X / (np.linalg.norm(X, axis=1, keepdims=True) + 1e-9)\n",
    "    sim = X @ X.T\n",
    "    cov = np.cov(red_student[cols].fillna(0.0).to_numpy().T)\n",
    "    eig = np.linalg.eigvalsh(cov)[::-1]\n",
    "    pos = eig[eig > 0]\n",
    "    eff_rank = np.nan\n",
    "    if len(pos):\n",
    "        p = pos / pos.sum()\n",
    "        eff_rank = float(np.exp(-(p * np.log(p)).sum()))\n",
    "    return {\"mean_cosine_similarity\": float(sim[np.triu_indices_from(sim, 1)].mean()), \"effective_rank\": eff_rank}\n",
    "\n",
    "\n",
    "def stage_foundation_models(ctx) -> dict:\n",
    "    cfg = ctx.config\n",
    "    specs = cfg.get(\"embedding_models\") or []\n",
    "    if not specs:\n",
    "        ctx.save_json({\"status\": \"NOT_CONFIGURED\", \"reason\": \"no entries in CONFIG['embedding_models']\"}, \"embedding_status\")\n",
    "        return {\"outputs\": [\"embedding_status\"], \"status\": \"SKIPPED_DISABLED\", \"reason\": \"no embedding models configured\"}\n",
    "    status, train_parts, test_parts = [], [], []\n",
    "    for spec in specs:\n",
    "        try:\n",
    "            ext = EmbeddingExtractor(spec, cfg)\n",
    "        except Exception as exc:\n",
    "            status.append({\"alias\": spec.get(\"alias\"), \"status\": \"UNAVAILABLE\", \"reason\": str(exc)})\n",
    "            continue\n",
    "        emb_tr = extract_embeddings(ctx, ext, \"train\")\n",
    "        emb_te = extract_embeddings(ctx, ext, \"test\") if cfg.get(\"allow_test_inference\") else None\n",
    "        st_tr, st_te, info = reduce_and_pool(ctx, emb_tr, emb_te, ext.alias)\n",
    "        train_parts.append(st_tr.set_index(\"student_id\"))\n",
    "        if st_te is not None:\n",
    "            test_parts.append(st_te.set_index(\"student_id\"))\n",
    "        status.append({\"alias\": ext.alias, \"status\": \"OK\", \"n_clips\": int(len(emb_tr)), \"pca\": info,\n",
    "                       \"similarity\": embedding_similarity(ctx, st_tr)})\n",
    "        del ext\n",
    "    outputs = [\"embedding_status\"]\n",
    "    if train_parts:\n",
    "        tr = pd.concat(train_parts, axis=1).reset_index()\n",
    "        ctx.save_df(tr, \"embedding_student_features\")\n",
    "        outputs.append(\"embedding_student_features\")\n",
    "        if test_parts:\n",
    "            ctx.save_df(pd.concat(test_parts, axis=1).reset_index(), \"embedding_student_features_test\")\n",
    "            outputs.append(\"embedding_student_features_test\")\n",
    "        y = da.target(ctx)\n",
    "        cols = [c for c in tr.columns if c.endswith(\"__mean\") and \"__task=\" not in c][:200]\n",
    "        from .stats_utils import safe_corr\n",
    "\n",
    "        rhos = pd.Series({c: safe_corr(tr.set_index(\"student_id\")[c], y, \"spearman\", 20)[0] for c in cols})\n",
    "        fig, axes = viz.new_figure(1, 1)\n",
    "        viz.hist_kde(axes[0, 0], rhos.to_numpy(), \"Spearman rho of embedding PCs with outcome\")\n",
    "        ctx.figure(fig, \"embedding_target_associations\", \"Foundation-model embedding associations\",\n",
    "                   \"Do pretrained representations capture outcome-related information?\", \"embedding_student_features\",\n",
    "                   int(len(tr)), f\"Max |rho|={rhos.abs().max():.3f}; controlled comparison in Section 20 (EMBEDDINGS family).\")\n",
    "    ctx.save_json({\"models\": status}, \"embedding_status\")\n",
    "    return {\"outputs\": outputs, \"summary\": {\"models\": status}}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-022",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/hypothesis_registry.py\n",
    "\"\"\"Section 25 - scientific hypothesis registry (H01-H20).\n",
    "\n",
    "Each hypothesis is evaluated programmatically from executed artifacts only.\n",
    "A hypothesis is never marked SUPPORTED on correlation or nominal significance\n",
    "alone: support requires out-of-fold incremental evidence with a confidence\n",
    "interval excluding zero and, where available, school-grouped confirmation.\n",
    "Missing artifacts yield NOT_TESTED.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "HYPOTHESES = {\n",
    "    \"H01\": \"Audio adds predictive information beyond conventional screening\",\n",
    "    \"H02\": \"Correct responses contain heterogeneous phonetic information\",\n",
    "    \"H03\": \"Complexity sensitivity predicts future reading performance\",\n",
    "    \"H04\": \"Within-student acoustic consistency predicts outcomes\",\n",
    "    \"H05\": \"Different literacy tasks provide complementary information\",\n",
    "    \"H06\": \"Specific phonetic error patterns have incremental relevance\",\n",
    "    \"H07\": \"Distinct literacy profiles exist among similar screening scores\",\n",
    "    \"H08\": \"Multiscale acoustic features contain additional signal\",\n",
    "    \"H09\": \"Pretrained representations capture complementary information\",\n",
    "    \"H10\": \"Acoustic features explain screening prediction residuals\",\n",
    "    \"H11\": \"Useful acoustic signals generalize across schools\",\n",
    "    \"H12\": \"Speech-related information outperforms technical artifacts\",\n",
    "    \"H13\": \"Task-specific processing improves upon global aggregation\",\n",
    "    \"H14\": \"Response variability is more informative than averages alone\",\n",
    "    \"H15\": \"Acoustic characteristics interact with initial literacy ability\",\n",
    "    \"H16\": \"Item-conditioned features outperform unadjusted acoustic features\",\n",
    "    \"H17\": \"Composite literacy indices improve interpretability or prediction\",\n",
    "    \"H18\": \"Adaptive assessment behavior contains complementary information\",\n",
    "    \"H19\": \"Multimodal features recover identifiable baseline failure patterns\",\n",
    "    \"H20\": \"Residual learning improves upon direct multimodal regression\",\n",
    "}\n",
    "\n",
    "\n",
    "class Evidence:\n",
    "    def __init__(self, ctx):\n",
    "        self.ctx = ctx\n",
    "        self._cache: dict = {}\n",
    "\n",
    "    def table(self, name: str, stage: str) -> pd.DataFrame | None:\n",
    "        if name not in self._cache:\n",
    "            self._cache[name] = self.ctx.load_df(name, required=False) if self.ctx.stage_available(stage) else None\n",
    "        return self._cache[name]\n",
    "\n",
    "\n",
    "def _delta_status(delta, lo, hi, grouped=None) -> tuple[str, str]:\n",
    "    if delta is None or not np.isfinite(delta):\n",
    "        return \"INCONCLUSIVE\", \"no estimate\"\n",
    "    if np.isfinite(lo) and lo > 0:\n",
    "        if grouped is None or not np.isfinite(grouped):\n",
    "            return \"PARTIALLY_SUPPORTED\", \"CI excludes 0 under student CV; school-grouped confirmation unavailable\"\n",
    "        return (\"SUPPORTED\", \"CI excludes 0 and school-grouped gain is positive\") if grouped > 0 else (\n",
    "            \"PARTIALLY_SUPPORTED\", \"student-CV gain does not hold under school-grouped CV\")\n",
    "    if np.isfinite(hi) and hi <= 0:\n",
    "        return \"NOT_SUPPORTED\", \"CI upper bound <= 0\"\n",
    "    return \"INCONCLUSIVE\", \"CI includes 0\"\n",
    "\n",
    "\n",
    "def _ablation_row(ev: Evidence, exp: str, scheme: str = \"CV_A_REPEATED_STUDENT_KFOLD\"):\n",
    "    abl = ev.table(\"ablation_results\", \"20\")\n",
    "    if abl is None:\n",
    "        return None\n",
    "    model = ev.ctx.config[\"ablation_primary_model\"]\n",
    "    r = abl[(abl[\"experiment\"] == exp) & (abl[\"scheme\"] == scheme) & (abl[\"model\"].isin([model, f\"TWO_STAGE_{model}\"]))]\n",
    "    return r.iloc[0] if len(r) else None\n",
    "\n",
    "\n",
    "def _ablation_test(ev, exp, ref=\"full_tabular\"):\n",
    "    a = _ablation_row(ev, exp)\n",
    "    if a is None:\n",
    "        return None\n",
    "    b = _ablation_row(ev, exp, \"CV_B_SCHOOL_GROUP_KFOLD\")\n",
    "    grouped = b[f\"delta_r2_vs_{ref}\"] if b is not None else np.nan\n",
    "    status, why = _delta_status(a[f\"delta_r2_vs_{ref}\"], a[f\"delta_r2_vs_{ref}_ci_lower\"], a[f\"delta_r2_vs_{ref}_ci_upper\"], grouped)\n",
    "    return {\"observed_effect\": f\"delta R2 vs {ref} = {a[f'delta_r2_vs_{ref}']:.4f}\",\n",
    "            \"uncertainty\": f\"95% CI [{a[f'delta_r2_vs_{ref}_ci_lower']:.4f}, {a[f'delta_r2_vs_{ref}_ci_upper']:.4f}]\",\n",
    "            \"robustness\": f\"school-grouped delta = {grouped:.4f}\" if np.isfinite(grouped) else \"school-grouped CV unavailable\",\n",
    "            \"support_status\": status, \"limitations\": why}\n",
    "\n",
    "\n",
    "def _registry_family(ev, families, pattern=None):\n",
    "    reg = ev.table(\"feature_registry\", \"24\")\n",
    "    if reg is None:\n",
    "        return None\n",
    "    r = reg[reg[\"feature_family\"].isin(families)]\n",
    "    if pattern:\n",
    "        r = r[r[\"feature_name\"].str.contains(pattern, regex=True)]\n",
    "    if r.empty:\n",
    "        return None\n",
    "    counts = r[\"selection_status\"].value_counts()\n",
    "    robust, promising = int(counts.get(\"ROBUST_SIGNAL\", 0)), int(counts.get(\"PROMISING_SIGNAL\", 0))\n",
    "    status = \"PARTIALLY_SUPPORTED\" if robust else (\"INCONCLUSIVE\" if promising else \"NOT_SUPPORTED\")\n",
    "    return {\"observed_effect\": f\"{robust} robust and {promising} promising of {len(r)} features; max |residual rho|={r['residual_spearman'].abs().max():.3f}\",\n",
    "            \"uncertainty\": \"bootstrap CIs and FDR in feature registry\", \"robustness\": f\"median school sign consistency {r['cross_school_sign_consistency'].median():.2f}\",\n",
    "            \"support_status\": status, \"limitations\": \"feature-level evidence; selection-induced optimism possible; needs CV confirmation\"}\n",
    "\n",
    "\n",
    "def evaluate(ev: Evidence, hid: str) -> dict:\n",
    "    cfg = ev.ctx.config\n",
    "    res = None\n",
    "    if hid == \"H01\":\n",
    "        res = _ablation_test(ev, \"A13_TABULAR_MULTIMODAL\")\n",
    "    elif hid == \"H02\":\n",
    "        res = _registry_family(ev, [\"TEMPORAL\", \"SPECTRAL\", \"MFCC\", \"PHONETIC\", \"WAVELETS\"], r\"__corr=1\")\n",
    "    elif hid == \"H03\":\n",
    "        res = _registry_family(ev, [\"COMPLEXITY_SENSITIVITY\"])\n",
    "    elif hid == \"H04\":\n",
    "        res = _registry_family(ev, [\"TEMPORAL\", \"SPECTRAL\", \"MFCC\", \"WAVELETS\", \"ITEM_ADJUSTED_AUDIO\"], r\"__(std|mad|cv|iqr)$\")\n",
    "    elif hid == \"H05\":\n",
    "        rel = ev.table(\"task_relevance_matrix\", \"12\")\n",
    "        if rel is not None and \"residual_signal\" in rel:\n",
    "            n_tasks = int((rel[\"residual_n_fdr\"] > 0).sum()) if \"residual_n_fdr\" in rel else 0\n",
    "            res = {\"observed_effect\": f\"{n_tasks} task families with FDR-significant residual features\",\n",
    "                   \"uncertainty\": \"FDR within task\", \"robustness\": f\"school stability {rel['school_stability'].round(2).tolist()}\",\n",
    "                   \"support_status\": \"PARTIALLY_SUPPORTED\" if n_tasks >= 2 else \"INCONCLUSIVE\",\n",
    "                   \"limitations\": \"association-level evidence; complementarity in prediction tested in H13/ablation\"}\n",
    "    elif hid == \"H06\":\n",
    "        res = _ablation_test(ev, \"A11_TABULAR_PHONETIC\")\n",
    "    elif hid == \"H07\":\n",
    "        prof = ev.table(\"cluster_profiles\", \"15\")\n",
    "        if prof is not None and \"residual_mean\" in prof:\n",
    "            sub = prof[prof[\"space\"] == \"C09_SCREENING_ADJUSTED_AUDIO\"]\n",
    "            spread = float(sub[\"residual_mean\"].max() - sub[\"residual_mean\"].min()) if len(sub) else np.nan\n",
    "            info = ev.ctx.load_json(\"cluster_space_info\", required=False) or {}\n",
    "            stable = (info.get(\"C09_SCREENING_ADJUSTED_AUDIO\") or {}).get(\"stable\")\n",
    "            res = {\"observed_effect\": f\"residual-mean spread across C09 clusters = {spread:.3f}\",\n",
    "                   \"uncertainty\": \"bootstrap ARI stability\", \"robustness\": f\"stable={stable}\",\n",
    "                   \"support_status\": \"PARTIALLY_SUPPORTED\" if stable and np.isfinite(spread) and spread > 0 else \"INCONCLUSIVE\",\n",
    "                   \"limitations\": \"descriptive clusters; residual differences not tested out of fold\"}\n",
    "    elif hid == \"H08\":\n",
    "        res = _ablation_test(ev, \"A09_TABULAR_WAVELETS\")\n",
    "    elif hid == \"H09\":\n",
    "        reg = ev.table(\"feature_registry\", \"24\")\n",
    "        if ev.ctx.stage_available(\"23\") and reg is not None:\n",
    "            res = _registry_family(ev, [\"EMBEDDINGS\"])\n",
    "    elif hid == \"H10\":\n",
    "        fam = ev.table(\"residual_family_ranking\", \"16\")\n",
    "        if fam is not None:\n",
    "            audio = fam[fam[\"family\"].isin([\"TEMPORAL\", \"SPECTRAL\", \"MFCC\", \"WAVELETS\", \"PROSODY\", \"PHONETIC\", \"ITEM_ADJUSTED_AUDIO\"])]\n",
    "            sig = audio[(audio[\"n_residual_fdr\"] > 0) & (audio[\"mean_replication_rate\"].fillna(0) >= 0.5)]\n",
    "            res = {\"observed_effect\": f\"{len(sig)} acoustic families with FDR-significant and replicated residual associations\",\n",
    "                   \"uncertainty\": \"held-out half replication\", \"robustness\": \"within-school permutation for top features\",\n",
    "                   \"support_status\": \"PARTIALLY_SUPPORTED\" if len(sig) else \"NOT_SUPPORTED\" if len(audio) else \"INCONCLUSIVE\",\n",
    "                   \"limitations\": \"associations; predictive value is H01\"}\n",
    "    elif hid == \"H11\":\n",
    "        b = _ablation_row(ev, \"A13_TABULAR_MULTIMODAL\", \"CV_B_SCHOOL_GROUP_KFOLD\")\n",
    "        if b is not None:\n",
    "            status, why = _delta_status(b[\"delta_r2_vs_full_tabular\"], b[\"delta_r2_vs_full_tabular_ci_lower\"], b[\"delta_r2_vs_full_tabular_ci_upper\"], b[\"delta_r2_vs_full_tabular\"])\n",
    "            res = {\"observed_effect\": f\"school-grouped delta R2 = {b['delta_r2_vs_full_tabular']:.4f}\",\n",
    "                   \"uncertainty\": f\"CI [{b['delta_r2_vs_full_tabular_ci_lower']:.4f}, {b['delta_r2_vs_full_tabular_ci_upper']:.4f}]\",\n",
    "                   \"robustness\": f\"generalization gap {b.get('school_generalization_gap', np.nan):.4f}\", \"support_status\": status, \"limitations\": why}\n",
    "    elif hid == \"H12\":\n",
    "        nc = ev.table(\"negative_controls\", \"17\")\n",
    "        if nc is not None and \"delta_r2_vs_screening\" in nc:\n",
    "            sp = nc[(nc[\"control\"] == \"SPEECH_FEATURES_REFERENCE\") & (nc[\"variant\"] == \"with_screening\")]\n",
    "            te = nc[(nc[\"control\"] == \"NC07_TECHNICAL_FEATURES_ONLY\") & (nc[\"variant\"] == \"with_screening\")]\n",
    "            if len(sp) and len(te):\n",
    "                s, t = sp.iloc[0], te.iloc[0]\n",
    "                ok = np.isfinite(s[\"delta_ci_lower\"]) and s[\"delta_ci_lower\"] > 0 and s[\"delta_r2_vs_screening\"] > t[\"delta_r2_vs_screening\"]\n",
    "                res = {\"observed_effect\": f\"speech delta={s['delta_r2_vs_screening']:.4f} vs technical delta={t['delta_r2_vs_screening']:.4f}\",\n",
    "                       \"uncertainty\": f\"speech CI [{s['delta_ci_lower']:.4f}, {s['delta_ci_upper']:.4f}]\",\n",
    "                       \"robustness\": \"shuffled controls NC05/NC06 reported separately\",\n",
    "                       \"support_status\": \"SUPPORTED\" if ok and t[\"delta_ci_lower\"] <= 0 else (\"PARTIALLY_SUPPORTED\" if ok else \"INCONCLUSIVE\"),\n",
    "                       \"limitations\": \"technical features may partially encode speech; speaker roles not identified\"}\n",
    "    elif hid in {\"H13\", \"H15\"}:\n",
    "        inter = ev.table(\"interaction_results\", \"18\")\n",
    "        if inter is not None:\n",
    "            label = \"TASK x ACOUSTIC\" if hid == \"H13\" else None\n",
    "            rows = inter[inter[\"interaction\"] == label] if label else inter[inter[\"interaction\"].str.startswith(\"SCREENING x\") & (inter[\"status\"] == \"OK\")]\n",
    "            rows = rows.dropna(subset=[\"delta_r2_interaction\"]) if \"delta_r2_interaction\" in rows else rows.iloc[0:0]\n",
    "            if len(rows):\n",
    "                r = rows.sort_values(\"ci_lower\", ascending=False).iloc[0]\n",
    "                status, why = _delta_status(r[\"delta_r2_interaction\"], r[\"ci_lower\"], r[\"ci_upper\"])\n",
    "                res = {\"observed_effect\": f\"{r['interaction']}: delta R2 = {r['delta_r2_interaction']:.4f}\",\n",
    "                       \"uncertainty\": f\"CI [{r['ci_lower']:.4f}, {r['ci_upper']:.4f}]\",\n",
    "                       \"robustness\": f\"fold sign consistency {r.get('fold_sign_consistency', np.nan)}\",\n",
    "                       \"support_status\": status if hid == \"H13\" else (\"PARTIALLY_SUPPORTED\" if status == \"SUPPORTED\" else status),\n",
    "                       \"limitations\": \"best of several predefined interactions (multiplicity)\" if hid == \"H15\" else why}\n",
    "    elif hid == \"H14\":\n",
    "        reg = ev.table(\"feature_registry\", \"24\")\n",
    "        if reg is not None:\n",
    "            audio = reg[reg[\"feature_family\"].isin([\"TEMPORAL\", \"SPECTRAL\", \"MFCC\", \"WAVELETS\", \"PROSODY\"])]\n",
    "            var = audio[audio[\"feature_name\"].str.contains(r\"__(std|mad|cv|iqr)$\")][\"residual_spearman\"].abs()\n",
    "            avg = audio[audio[\"feature_name\"].str.endswith(\"__mean\")][\"residual_spearman\"].abs()\n",
    "            if len(var) and len(avg):\n",
    "                res = {\"observed_effect\": f\"median |residual rho| variability={var.median():.3f} vs mean={avg.median():.3f}; max {var.max():.3f} vs {avg.max():.3f}\",\n",
    "                       \"uncertainty\": \"descriptive comparison of distributions\", \"robustness\": \"see feature registry stability\",\n",
    "                       \"support_status\": \"PARTIALLY_SUPPORTED\" if var.max() > avg.max() and var.median() > avg.median() else \"NOT_SUPPORTED\",\n",
    "                       \"limitations\": \"no direct CV comparison of variability-only vs mean-only feature sets\"}\n",
    "    elif hid == \"H16\":\n",
    "        a12, a06 = _ablation_row(ev, \"A12_TABULAR_ITEM_ADJUSTED_AUDIO\"), _ablation_row(ev, \"A06_TABULAR_TEMPORAL\")\n",
    "        if a12 is not None and a06 is not None:\n",
    "            d = a12[\"delta_r2_vs_full_tabular\"] - a06[\"delta_r2_vs_full_tabular\"]\n",
    "            res = {\"observed_effect\": f\"item-adjusted gain {a12['delta_r2_vs_full_tabular']:.4f} vs temporal gain {a06['delta_r2_vs_full_tabular']:.4f}\",\n",
    "                   \"uncertainty\": f\"A12 CI [{a12['delta_r2_vs_full_tabular_ci_lower']:.4f}, {a12['delta_r2_vs_full_tabular_ci_upper']:.4f}]\",\n",
    "                   \"robustness\": \"student CV\", \"support_status\": \"PARTIALLY_SUPPORTED\" if d > 0 and a12[\"delta_r2_vs_full_tabular_ci_lower\"] > 0 else \"INCONCLUSIVE\",\n",
    "                   \"limitations\": \"difference of deltas not directly bootstrapped\"}\n",
    "    elif hid == \"H17\":\n",
    "        rep = ev.table(\"literacy_index_report\", \"19\")\n",
    "        if rep is not None and \"retention\" in rep:\n",
    "            n = int((rep[\"retention\"] == \"RETAIN\").sum())\n",
    "            a14 = _ablation_test(ev, \"A14_TABULAR_LITERACY_INDICES\")\n",
    "            res = a14 or {}\n",
    "            res.update({\"observed_effect\": f\"{n} indices retained; \" + res.get(\"observed_effect\", \"A14 not run\"),\n",
    "                        \"support_status\": res.get(\"support_status\", \"PARTIALLY_SUPPORTED\" if n else \"NOT_SUPPORTED\"),\n",
    "                        \"uncertainty\": res.get(\"uncertainty\", \"bootstrap CIs per index\"), \"robustness\": res.get(\"robustness\", \"cross-school sign consistency\"),\n",
    "                        \"limitations\": \"experimental constructs, not established assessments\"})\n",
    "    elif hid == \"H18\":\n",
    "        res = _ablation_test(ev, \"A04_THETA_ADAPTIVE_BEHAVIOR\", ref=\"screening\")\n",
    "    elif hid == \"H19\":\n",
    "        reg = ev.table(\"failure_registry\", \"22\")\n",
    "        if reg is not None and reg[\"error_reduction\"].notna().any():\n",
    "            from .stats_utils import bootstrap_ci\n",
    "\n",
    "            hard = reg[reg[\"baseline_error\"].abs() >= reg[\"baseline_error\"].abs().quantile(0.8)][\"error_reduction\"].dropna().to_numpy()\n",
    "            ci = bootstrap_ci(np.mean, hard, n_boot=int(cfg[\"bootstrap_iterations\"]), seed=int(cfg[\"seed\"]))\n",
    "            status, why = _delta_status(ci[\"estimate\"], ci[\"lower\"], ci[\"upper\"])\n",
    "            res = {\"observed_effect\": f\"mean |error| reduction among hardest 20% = {ci['estimate']:.4f}\",\n",
    "                   \"uncertainty\": f\"CI [{ci['lower']:.4f}, {ci['upper']:.4f}]\", \"robustness\": \"see failure phenotype summary\",\n",
    "                   \"support_status\": \"PARTIALLY_SUPPORTED\" if status == \"SUPPORTED\" else status,\n",
    "                   \"limitations\": \"regression to the mean inflates apparent recovery for extreme baseline errors\"}\n",
    "    elif hid == \"H20\":\n",
    "        rl = ev.table(\"residual_learning_results\", \"21\")\n",
    "        if rl is not None:\n",
    "            a = rl[(rl[\"approach\"] == \"TWO_STAGE_RESIDUAL\") & (rl[\"scheme\"] == \"CV_A_REPEATED_STUDENT_KFOLD\")]\n",
    "            b = rl[(rl[\"approach\"] == \"TWO_STAGE_RESIDUAL\") & (rl[\"scheme\"] == \"CV_B_SCHOOL_GROUP_KFOLD\")]\n",
    "            if len(a):\n",
    "                r = a.iloc[0]\n",
    "                status, why = _delta_status(r[\"delta_r2_vs_direct_multimodal\"], r[\"delta_r2_vs_direct_multimodal_ci_lower\"],\n",
    "                                            r[\"delta_r2_vs_direct_multimodal_ci_upper\"],\n",
    "                                            b.iloc[0][\"delta_r2_vs_direct_multimodal\"] if len(b) else None)\n",
    "                res = {\"observed_effect\": f\"delta R2 vs direct = {r['delta_r2_vs_direct_multimodal']:.4f}\",\n",
    "                       \"uncertainty\": f\"CI [{r['delta_r2_vs_direct_multimodal_ci_lower']:.4f}, {r['delta_r2_vs_direct_multimodal_ci_upper']:.4f}]\",\n",
    "                       \"robustness\": \"school-grouped run reported\" if len(b) else \"student CV only\", \"support_status\": status, \"limitations\": why}\n",
    "    return res\n",
    "\n",
    "\n",
    "DESIGN = {\n",
    "    \"H01\": (\"Ablation A13 vs A05\", \"SCREENING+tabular\", \"paired bootstrap on pooled OOF R2\"),\n",
    "    \"H02\": (\"Correct-only aggregates vs residual\", \"screening via residual\", \"Spearman+FDR+bootstrap\"),\n",
    "    \"H03\": (\"Shrunk complexity slopes\", \"screening via residual\", \"Spearman+FDR; ablation A12\"),\n",
    "    \"H04\": (\"Within-student dispersion features\", \"screening via residual\", \"Spearman+FDR\"),\n",
    "    \"H05\": (\"Task relevance matrix\", \"screening via residual\", \"per-task FDR\"),\n",
    "    \"H06\": (\"Ablation A11 vs A05\", \"SCREENING+tabular\", \"paired bootstrap\"),\n",
    "    \"H07\": (\"Clustering in screening-adjusted audio space\", \"screening (residualised space)\", \"bootstrap ARI\"),\n",
    "    \"H08\": (\"Ablation A09 vs A05\", \"SCREENING+tabular\", \"paired bootstrap\"),\n",
    "    \"H09\": (\"Embedding features in registry/ablation\", \"SCREENING\", \"registry evidence\"),\n",
    "    \"H10\": (\"Residual discovery with held-out replication\", \"OOF screening residual\", \"FDR+replication\"),\n",
    "    \"H11\": (\"School-grouped ablation\", \"SCREENING+tabular\", \"CV_B paired bootstrap\"),\n",
    "    \"H12\": (\"Negative controls NC01-NC07\", \"SCREENING\", \"paired bootstrap\"),\n",
    "    \"H13\": (\"Task-specific vs pooled representations\", \"SCREENING\", \"paired bootstrap\"),\n",
    "    \"H14\": (\"Dispersion vs mean aggregates\", \"screening via residual\", \"descriptive\"),\n",
    "    \"H15\": (\"Screening x acoustic interactions\", \"main effects\", \"paired bootstrap\"),\n",
    "    \"H16\": (\"Ablation A12 vs A06\", \"SCREENING+tabular\", \"paired bootstrap\"),\n",
    "    \"H17\": (\"Index report and ablation A14\", \"SCREENING\", \"bootstrap\"),\n",
    "    \"H18\": (\"Ablation A04 vs A01\", \"SCREENING\", \"paired bootstrap\"),\n",
    "    \"H19\": (\"Failure registry error reduction\", \"baseline OOF\", \"bootstrap mean\"),\n",
    "    \"H20\": (\"Nested two-stage vs direct\", \"SCREENING+tabular\", \"paired bootstrap\"),\n",
    "}\n",
    "VALIDATION = {\"H07\": \"unsupervised; descriptive\", \"H14\": \"descriptive\", \"H05\": \"association\"}\n",
    "\n",
    "\n",
    "def stage_hypothesis_registry(ctx) -> dict:\n",
    "    ev = Evidence(ctx)\n",
    "    rows = []\n",
    "    for hid, question in HYPOTHESES.items():\n",
    "        try:\n",
    "            res = evaluate(ev, hid)\n",
    "        except Exception as exc:\n",
    "            res = {\"support_status\": \"NOT_TESTED\", \"limitations\": f\"evaluation error: {type(exc).__name__}: {exc}\"}\n",
    "        design, controls, method = DESIGN[hid]\n",
    "        row = {\"hypothesis_id\": hid, \"research_question\": question, \"experimental_design\": design,\n",
    "               \"required_features\": design.split(\" \")[0], \"control_variables\": controls, \"statistical_method\": method,\n",
    "               \"validation_scheme\": VALIDATION.get(hid, \"student-disjoint CV (+ school-grouped where available)\"),\n",
    "               \"observed_effect\": \"\", \"uncertainty\": \"\", \"multiple_testing_adjustment\": \"Benjamini-Hochberg FDR where applicable\",\n",
    "               \"robustness\": \"\", \"support_status\": \"NOT_TESTED\", \"limitations\": \"required artifacts unavailable\",\n",
    "               \"recommended_next_step\": \"\"}\n",
    "        if res:\n",
    "            row.update(res)\n",
    "        row[\"recommended_next_step\"] = {\n",
    "            \"SUPPORTED\": \"carry into P02 feature engineering and confirm on new folds\",\n",
    "            \"PARTIALLY_SUPPORTED\": \"confirm with school-grouped/nested validation before relying on it\",\n",
    "            \"INCONCLUSIVE\": \"increase power (more features/better extraction) or refine the measurement\",\n",
    "            \"NOT_SUPPORTED\": \"deprioritise in P02\", \"NOT_TESTED\": \"enable the required stages/modalities\"}[row[\"support_status\"]]\n",
    "        rows.append(row)\n",
    "    reg = pd.DataFrame(rows)\n",
    "    ctx.save_df(reg, \"hypothesis_registry\", also_csv=True)\n",
    "    return {\"outputs\": [\"hypothesis_registry\"], \"summary\": reg[\"support_status\"].value_counts().to_dict()}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-023",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/io_utils.py\n",
    "\"\"\"Atomic file writes, JSON serialisation helpers and the artifact store.\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import datetime as _dt\n",
    "import json\n",
    "import os\n",
    "import tempfile\n",
    "from pathlib import Path\n",
    "from typing import Any\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def json_default(obj: Any) -> Any:\n",
    "    if isinstance(obj, (np.integer,)):\n",
    "        return int(obj)\n",
    "    if isinstance(obj, (np.floating,)):\n",
    "        value = float(obj)\n",
    "        return None if not np.isfinite(value) else value\n",
    "    if isinstance(obj, (np.bool_,)):\n",
    "        return bool(obj)\n",
    "    if isinstance(obj, np.ndarray):\n",
    "        return obj.tolist()\n",
    "    if isinstance(obj, (Path,)):\n",
    "        return str(obj)\n",
    "    if isinstance(obj, (_dt.datetime, _dt.date, pd.Timestamp)):\n",
    "        return obj.isoformat()\n",
    "    if isinstance(obj, set):\n",
    "        return sorted(obj)\n",
    "    if isinstance(obj, pd.Series):\n",
    "        return obj.to_dict()\n",
    "    if isinstance(obj, pd.DataFrame):\n",
    "        return obj.to_dict(orient=\"records\")\n",
    "    return str(obj)\n",
    "\n",
    "\n",
    "def _clean_json(obj: Any) -> Any:\n",
    "    if isinstance(obj, float) and not np.isfinite(obj):\n",
    "        return None\n",
    "    if isinstance(obj, dict):\n",
    "        return {str(k): _clean_json(v) for k, v in obj.items()}\n",
    "    if isinstance(obj, (list, tuple)):\n",
    "        return [_clean_json(v) for v in obj]\n",
    "    return obj\n",
    "\n",
    "\n",
    "def _tmp_path(path: Path) -> Path:\n",
    "    path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    fd, tmp = tempfile.mkstemp(prefix=f\".{path.name}.\", suffix=\".tmp\", dir=str(path.parent))\n",
    "    os.close(fd)\n",
    "    return Path(tmp)\n",
    "\n",
    "\n",
    "def atomic_write_bytes(path: str | Path, data: bytes) -> Path:\n",
    "    path = Path(path)\n",
    "    tmp = _tmp_path(path)\n",
    "    try:\n",
    "        with open(tmp, \"wb\") as fh:\n",
    "            fh.write(data)\n",
    "            fh.flush()\n",
    "            os.fsync(fh.fileno())\n",
    "        os.replace(tmp, path)\n",
    "    finally:\n",
    "        if tmp.exists():\n",
    "            tmp.unlink()\n",
    "    return path\n",
    "\n",
    "\n",
    "def atomic_write_text(path: str | Path, text: str) -> Path:\n",
    "    return atomic_write_bytes(path, text.encode(\"utf-8\"))\n",
    "\n",
    "\n",
    "def atomic_write_json(path: str | Path, obj: Any) -> Path:\n",
    "    text = json.dumps(_clean_json(json.loads(json.dumps(obj, default=json_default))), indent=2, sort_keys=False)\n",
    "    return atomic_write_text(path, text)\n",
    "\n",
    "\n",
    "def parquet_safe(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Convert mixed-type object columns to strings so Parquet writes never fail.\"\"\"\n",
    "    out = df.copy()\n",
    "    out.columns = [str(c) for c in out.columns]\n",
    "    for col in out.columns:\n",
    "        if out[col].dtype == object:\n",
    "            non_null = out[col].dropna()\n",
    "            kinds = {type(v) for v in non_null.head(1000)}\n",
    "            if len(kinds) > 1 or (kinds and not kinds <= {str}):\n",
    "                out[col] = out[col].map(lambda v: v if v is None or (isinstance(v, float) and np.isnan(v)) else str(v))\n",
    "    return out\n",
    "\n",
    "\n",
    "def atomic_write_parquet(df: pd.DataFrame, path: str | Path) -> Path:\n",
    "    path = Path(path)\n",
    "    tmp = _tmp_path(path)\n",
    "    try:\n",
    "        parquet_safe(df).to_parquet(tmp, index=False)\n",
    "        os.replace(tmp, path)\n",
    "    finally:\n",
    "        if tmp.exists():\n",
    "            tmp.unlink()\n",
    "    return path\n",
    "\n",
    "\n",
    "def atomic_write_csv(df: pd.DataFrame, path: str | Path, index: bool = False) -> Path:\n",
    "    path = Path(path)\n",
    "    tmp = _tmp_path(path)\n",
    "    try:\n",
    "        df.to_csv(tmp, index=index)\n",
    "        os.replace(tmp, path)\n",
    "    finally:\n",
    "        if tmp.exists():\n",
    "            tmp.unlink()\n",
    "    return path\n",
    "\n",
    "\n",
    "def read_json(path: str | Path, default: Any = None) -> Any:\n",
    "    path = Path(path)\n",
    "    if not path.exists():\n",
    "        return default\n",
    "    with open(path, \"r\", encoding=\"utf-8\") as fh:\n",
    "        return json.load(fh)\n",
    "\n",
    "\n",
    "def file_fingerprint(path: str | Path) -> dict:\n",
    "    path = Path(path)\n",
    "    st = path.stat()\n",
    "    return {\"path\": str(path), \"size\": int(st.st_size), \"mtime_ns\": int(st.st_mtime_ns)}\n",
    "\n",
    "\n",
    "class ArtifactMissing(FileNotFoundError):\n",
    "    \"\"\"Raised when a required artifact has not been produced yet.\"\"\"\n",
    "\n",
    "\n",
    "class ArtifactStore:\n",
    "    \"\"\"Registry of named artifacts (tables, JSON documents, figures).\n",
    "\n",
    "    Every artifact has a globally unique name. The index is persisted so that\n",
    "    later sessions (RESUME profile) can locate earlier outputs.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, index_path: Path):\n",
    "        self.index_path = Path(index_path)\n",
    "        self.index: dict = read_json(self.index_path, default={}) or {}\n",
    "        self._memory: dict = {}\n",
    "\n",
    "    def _persist(self) -> None:\n",
    "        atomic_write_json(self.index_path, self.index)\n",
    "\n",
    "    def register(self, name: str, path: Path, stage: str, kind: str, extra: dict | None = None) -> None:\n",
    "        self.index[name] = {\n",
    "            \"path\": str(path),\n",
    "            \"stage\": stage,\n",
    "            \"kind\": kind,\n",
    "            \"written_at\": _dt.datetime.now().isoformat(timespec=\"seconds\"),\n",
    "            **(extra or {}),\n",
    "        }\n",
    "        self._memory.pop(name, None)\n",
    "        self._persist()\n",
    "\n",
    "    def path(self, name: str) -> Path:\n",
    "        if name not in self.index:\n",
    "            raise ArtifactMissing(f\"artifact {name!r} has not been produced\")\n",
    "        return Path(self.index[name][\"path\"])\n",
    "\n",
    "    def has(self, name: str) -> bool:\n",
    "        return name in self.index and Path(self.index[name][\"path\"]).exists()\n",
    "\n",
    "    def stage_of(self, name: str) -> str | None:\n",
    "        return self.index.get(name, {}).get(\"stage\")\n",
    "\n",
    "    def save_df(self, df: pd.DataFrame, name: str, directory: Path, stage: str, fmt: str = \"parquet\") -> Path:\n",
    "        directory.mkdir(parents=True, exist_ok=True)\n",
    "        if fmt == \"parquet\":\n",
    "            path = atomic_write_parquet(df, directory / f\"{name}.parquet\")\n",
    "        elif fmt == \"csv\":\n",
    "            path = atomic_write_csv(df, directory / f\"{name}.csv\")\n",
    "        else:\n",
    "            raise ValueError(f\"unsupported table format {fmt}\")\n",
    "        self.register(name, path, stage, f\"table/{fmt}\", {\"rows\": int(len(df)), \"cols\": int(df.shape[1])})\n",
    "        return path\n",
    "\n",
    "    def load_df(self, name: str, use_memory: bool = True) -> pd.DataFrame:\n",
    "        if use_memory and name in self._memory:\n",
    "            return self._memory[name].copy()\n",
    "        path = self.path(name)\n",
    "        if not path.exists():\n",
    "            raise ArtifactMissing(f\"artifact {name!r} is registered but {path} is missing\")\n",
    "        df = pd.read_parquet(path) if path.suffix == \".parquet\" else pd.read_csv(path, low_memory=False)\n",
    "        if use_memory:\n",
    "            self._memory[name] = df\n",
    "        return df.copy()\n",
    "\n",
    "    def save_json(self, obj: Any, name: str, directory: Path, stage: str) -> Path:\n",
    "        path = atomic_write_json(directory / f\"{name}.json\", obj)\n",
    "        self.register(name, path, stage, \"json\")\n",
    "        return path\n",
    "\n",
    "    def load_json(self, name: str) -> Any:\n",
    "        path = self.path(name)\n",
    "        if not path.exists():\n",
    "            raise ArtifactMissing(f\"artifact {name!r} is registered but {path} is missing\")\n",
    "        return read_json(path)\n",
    "\n",
    "    def outputs_exist(self, names: list[str]) -> bool:\n",
    "        return all(self.has(n) for n in names)\n",
    "\n",
    "    def clear_memory(self) -> None:\n",
    "        self._memory.clear()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-024",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/irt.py\n",
    "\"\"\"Regularised item response theory (Rasch, 1PL, 2PL) by penalised maximum likelihood.\n",
    "\n",
    "Model: P(y=1) = sigmoid(a_i * (theta_s - b_i)) with Gaussian priors\n",
    "theta ~ N(0, s_theta^2), b ~ N(0, s_b^2), log a ~ N(0, s_a^2).\n",
    "\n",
    "* rasch: a_i = 1\n",
    "* 1pl:   a_i = a (one common discrimination)\n",
    "* 2pl:   item-specific a_i (only fitted when every item has enough responses)\n",
    "\n",
    "Only observed responses enter the likelihood: non-attempted items are never\n",
    "treated as incorrect, which accounts for adaptive exposure and sparsity.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "from dataclasses import dataclass\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.optimize import minimize\n",
    "from scipy.special import expit\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class IRTResult:\n",
    "    model: str\n",
    "    items: pd.DataFrame\n",
    "    students: pd.DataFrame\n",
    "    loglik: float\n",
    "    n_params: int\n",
    "    n_obs: int\n",
    "    converged: bool\n",
    "    message: str\n",
    "\n",
    "    @property\n",
    "    def aic(self) -> float:\n",
    "        return float(2 * self.n_params - 2 * self.loglik)\n",
    "\n",
    "    @property\n",
    "    def bic(self) -> float:\n",
    "        return float(np.log(max(self.n_obs, 1)) * self.n_params - 2 * self.loglik)\n",
    "\n",
    "\n",
    "def _encode(df: pd.DataFrame, student_col: str, item_col: str, resp_col: str):\n",
    "    d = df[[student_col, item_col, resp_col]].dropna()\n",
    "    d = d[d[resp_col].isin([0, 1, 0.0, 1.0])]\n",
    "    s_codes, s_index = pd.factorize(d[student_col])\n",
    "    i_codes, i_index = pd.factorize(d[item_col])\n",
    "    return s_codes, i_codes, d[resp_col].to_numpy(dtype=float), s_index, i_index\n",
    "\n",
    "\n",
    "def fit_irt(df: pd.DataFrame, student_col: str = \"student_id\", item_col: str = \"item_key\", resp_col: str = \"correct\",\n",
    "            model: str = \"rasch\", prior_theta_sd: float = 1.0, prior_b_sd: float = 2.0, prior_loga_sd: float = 0.5,\n",
    "            max_iter: int = 500, min_obs_per_item: int = 5) -> IRTResult:\n",
    "    counts = df.dropna(subset=[resp_col]).groupby(item_col)[resp_col].count()\n",
    "    keep = counts[counts >= min_obs_per_item].index\n",
    "    d = df[df[item_col].isin(keep)]\n",
    "    s, i, y, s_index, i_index = _encode(d, student_col, item_col, resp_col)\n",
    "    S, I, N = len(s_index), len(i_index), len(y)\n",
    "    if N == 0 or I == 0:\n",
    "        raise ValueError(\"no valid binary responses for IRT\")\n",
    "    n_a = {\"rasch\": 0, \"1pl\": 1, \"2pl\": I}[model]\n",
    "\n",
    "    def unpack(p):\n",
    "        theta, b = p[:S], p[S:S + I]\n",
    "        if model == \"rasch\":\n",
    "            loga = np.zeros(I)\n",
    "        elif model == \"1pl\":\n",
    "            loga = np.full(I, p[S + I])\n",
    "        else:\n",
    "            loga = p[S + I:]\n",
    "        return theta, b, loga\n",
    "\n",
    "    def objective(p):\n",
    "        theta, b, loga = unpack(p)\n",
    "        a = np.exp(loga)\n",
    "        diff = theta[s] - b[i]\n",
    "        eta = a[i] * diff\n",
    "        prob = expit(eta)\n",
    "        ll = np.sum(y * np.log(prob + 1e-12) + (1 - y) * np.log(1 - prob + 1e-12))\n",
    "        pen = (theta ** 2).sum() / (2 * prior_theta_sd ** 2) + (b ** 2).sum() / (2 * prior_b_sd ** 2)\n",
    "        r = prob - y\n",
    "        g_theta = np.bincount(s, weights=r * a[i], minlength=S) + theta / prior_theta_sd ** 2\n",
    "        g_b = np.bincount(i, weights=-r * a[i], minlength=I) + b / prior_b_sd ** 2\n",
    "        grads = [g_theta, g_b]\n",
    "        if model == \"1pl\":\n",
    "            pen += loga[0] ** 2 / (2 * prior_loga_sd ** 2)\n",
    "            grads.append(np.array([np.sum(r * a[i] * diff) + loga[0] / prior_loga_sd ** 2]))\n",
    "        elif model == \"2pl\":\n",
    "            pen += (loga ** 2).sum() / (2 * prior_loga_sd ** 2)\n",
    "            grads.append(np.bincount(i, weights=r * a[i] * diff, minlength=I) + loga / prior_loga_sd ** 2)\n",
    "        return -ll + pen, np.concatenate(grads)\n",
    "\n",
    "    item_p = pd.Series(y).groupby(i).mean().reindex(range(I)).fillna(0.5).clip(0.02, 0.98).to_numpy()\n",
    "    p0 = np.concatenate([np.zeros(S), -np.log(item_p / (1 - item_p)), np.zeros(n_a)])\n",
    "    res = minimize(objective, p0, jac=True, method=\"L-BFGS-B\", options={\"maxiter\": max_iter})\n",
    "    theta, b, loga = unpack(res.x)\n",
    "    a = np.exp(loga)\n",
    "    prob = expit(a[i] * (theta[s] - b[i]))\n",
    "    info_obs = a[i] ** 2 * prob * (1 - prob)\n",
    "    b_se = 1 / np.sqrt(np.bincount(i, weights=info_obs, minlength=I) + 1 / prior_b_sd ** 2)\n",
    "    t_se = 1 / np.sqrt(np.bincount(s, weights=info_obs, minlength=S) + 1 / prior_theta_sd ** 2)\n",
    "    diff = theta[s] - b[i]\n",
    "    a_info = np.bincount(i, weights=(a[i] * diff) ** 2 * prob * (1 - prob), minlength=I) + 1 / prior_loga_sd ** 2\n",
    "    loga_se = 1 / np.sqrt(a_info) if model == \"2pl\" else np.full(I, np.nan)\n",
    "    ll = float(np.sum(y * np.log(prob + 1e-12) + (1 - y) * np.log(1 - prob + 1e-12)))\n",
    "    items = pd.DataFrame({\"item_key\": i_index, \"b\": b, \"b_se\": b_se, \"a\": a, \"loga_se\": loga_se,\n",
    "                          \"n_obs\": np.bincount(i, minlength=I), \"p_correct\": pd.Series(y).groupby(i).mean().reindex(range(I)).to_numpy()})\n",
    "    students = pd.DataFrame({\"student_id\": s_index, \"theta\": theta, \"theta_se\": t_se, \"n_obs\": np.bincount(s, minlength=S)})\n",
    "    return IRTResult(model, items, students, ll, S + I + n_a, N, bool(res.success), str(res.message))\n",
    "\n",
    "\n",
    "def score_students(df: pd.DataFrame, items: pd.DataFrame, student_col: str = \"student_id\", item_col: str = \"item_key\",\n",
    "                   resp_col: str = \"correct\", prior_theta_sd: float = 1.0, n_iter: int = 40) -> pd.DataFrame:\n",
    "    \"\"\"MAP ability for each student given fixed item parameters (Newton iterations).\"\"\"\n",
    "    d = df[[student_col, item_col, resp_col]].dropna()\n",
    "    d = d.merge(items[[\"item_key\", \"a\", \"b\"]].rename(columns={\"item_key\": item_col}), on=item_col, how=\"inner\")\n",
    "    if d.empty:\n",
    "        return pd.DataFrame(columns=[student_col, \"theta\", \"theta_se\", \"n_obs\"])\n",
    "    s, s_index = pd.factorize(d[student_col])\n",
    "    a, b, y = d[\"a\"].to_numpy(), d[\"b\"].to_numpy(), d[resp_col].to_numpy(dtype=float)\n",
    "    S = len(s_index)\n",
    "    theta = np.zeros(S)\n",
    "    for _ in range(n_iter):\n",
    "        p = expit(a * (theta[s] - b))\n",
    "        g = np.bincount(s, weights=a * (p - y), minlength=S) + theta / prior_theta_sd ** 2\n",
    "        h = np.bincount(s, weights=a ** 2 * p * (1 - p), minlength=S) + 1 / prior_theta_sd ** 2\n",
    "        step = g / h\n",
    "        theta -= step\n",
    "        if np.max(np.abs(step)) < 1e-6:\n",
    "            break\n",
    "    p = expit(a * (theta[s] - b))\n",
    "    h = np.bincount(s, weights=a ** 2 * p * (1 - p), minlength=S) + 1 / prior_theta_sd ** 2\n",
    "    return pd.DataFrame({student_col: s_index, \"theta\": theta, \"theta_se\": 1 / np.sqrt(h), \"n_obs\": np.bincount(s, minlength=S)})\n",
    "\n",
    "\n",
    "def item_information(theta_grid: np.ndarray, a: float, b: float) -> np.ndarray:\n",
    "    p = expit(a * (theta_grid - b))\n",
    "    return a ** 2 * p * (1 - p)\n",
    "\n",
    "\n",
    "def difficulty_features(df: pd.DataFrame, items: pd.DataFrame, abilities: pd.DataFrame, prefix: str = \"irt_\",\n",
    "                        student_col: str = \"student_id\", item_col: str = \"item_key\", resp_col: str = \"correct\") -> pd.DataFrame:\n",
    "    \"\"\"Difficulty-aware student features from fixed item parameters and own responses.\"\"\"\n",
    "    d = df[[student_col, item_col, resp_col]].dropna()\n",
    "    d = d.merge(items[[\"item_key\", \"a\", \"b\"]].rename(columns={\"item_key\": item_col}), on=item_col, how=\"inner\")\n",
    "    d = d.merge(abilities[[student_col, \"theta\"]], on=student_col, how=\"left\")\n",
    "    if d.empty:\n",
    "        return pd.DataFrame(columns=[student_col])\n",
    "    b_lo, b_hi = items[\"b\"].quantile(1 / 3), items[\"b\"].quantile(2 / 3)\n",
    "    d[\"p_hat\"] = expit(d[\"a\"] * (d[\"theta\"] - d[\"b\"]))\n",
    "    d[\"w\"] = expit(d[\"b\"])\n",
    "    d[\"info\"] = d[\"a\"] ** 2 * d[\"p_hat\"] * (1 - d[\"p_hat\"])\n",
    "    d[\"resid\"] = d[resp_col] - d[\"p_hat\"]\n",
    "    d[\"easy_expected\"] = d[\"p_hat\"] >= 0.8\n",
    "    d[\"hard_expected\"] = d[\"p_hat\"] <= 0.2\n",
    "    g = d.groupby(student_col)\n",
    "\n",
    "    def ratio(num, den):\n",
    "        return num / den.where(den > 0)\n",
    "\n",
    "    out = pd.DataFrame({\n",
    "        f\"{prefix}difficulty_weighted_accuracy\": ratio(g.apply(lambda x: (x[resp_col] * x[\"w\"]).sum()), g[\"w\"].sum()),\n",
    "        f\"{prefix}mean_attempted_item_difficulty\": g[\"b\"].mean(),\n",
    "        f\"{prefix}max_attempted_item_difficulty\": g[\"b\"].max(),\n",
    "        f\"{prefix}hard_item_accuracy\": d[d[\"b\"] >= b_hi].groupby(student_col)[resp_col].mean(),\n",
    "        f\"{prefix}easy_item_accuracy\": d[d[\"b\"] <= b_lo].groupby(student_col)[resp_col].mean(),\n",
    "        f\"{prefix}unexpected_easy_item_error_rate\": d[d[\"easy_expected\"]].groupby(student_col)[resp_col].apply(lambda s: 1 - s.mean()),\n",
    "        f\"{prefix}unexpected_hard_item_success_rate\": d[d[\"hard_expected\"]].groupby(student_col)[resp_col].mean(),\n",
    "        f\"{prefix}response_residual_mean\": g[\"resid\"].mean(),\n",
    "        f\"{prefix}response_residual_std\": g[\"resid\"].std(),\n",
    "        f\"{prefix}item_information_weighted_score\": ratio(g.apply(lambda x: (x[resp_col] * x[\"info\"]).sum()), g[\"info\"].sum()),\n",
    "        f\"{prefix}theta\": abilities.set_index(student_col)[\"theta\"],\n",
    "        f\"{prefix}theta_se\": abilities.set_index(student_col)[\"theta_se\"],\n",
    "        f\"{prefix}n_scored\": g[resp_col].count(),\n",
    "    })\n",
    "    out.index.name = student_col\n",
    "    return out.reset_index()\n",
    "\n",
    "\n",
    "def fit_task_irt(clips: pd.DataFrame, cfg: dict, models: list | None = None) -> dict:\n",
    "    \"\"\"Fit IRT separately per task family; returns per-task results and selection.\"\"\"\n",
    "    results: dict = {}\n",
    "    for task, g in clips.dropna(subset=[\"correct\", \"item_key\"]).groupby(\"task_family\"):\n",
    "        if g[\"item_key\"].nunique() < 3 or g[\"student_id\"].nunique() < 10:\n",
    "            results[task] = {\"status\": \"INSUFFICIENT_DATA\"}\n",
    "            continue\n",
    "        fits = {}\n",
    "        counts = g.groupby(\"item_key\")[\"correct\"].count()\n",
    "        for m in models or cfg[\"irt_models\"]:\n",
    "            if m == \"2pl\" and counts[counts >= int(cfg[\"irt_min_obs_per_item\"])].min() < int(cfg[\"irt_2pl_min_obs_per_item\"]):\n",
    "                fits[m] = None\n",
    "                continue\n",
    "            fits[m] = fit_irt(g, model=m, prior_theta_sd=float(cfg[\"irt_prior_theta_sd\"]),\n",
    "                              prior_b_sd=float(cfg[\"irt_prior_b_sd\"]), prior_loga_sd=float(cfg[\"irt_prior_loga_sd\"]),\n",
    "                              max_iter=int(cfg[\"irt_max_iter\"]), min_obs_per_item=int(cfg[\"irt_min_obs_per_item\"]))\n",
    "        valid = {m: f for m, f in fits.items() if f is not None and f.converged}\n",
    "        if not valid:\n",
    "            valid = {m: f for m, f in fits.items() if f is not None}\n",
    "        selected = min(valid, key=lambda m: valid[m].bic) if valid else None\n",
    "        results[task] = {\"status\": \"OK\" if selected else \"FAILED\", \"fits\": fits, \"selected\": selected}\n",
    "    return results\n",
    "\n",
    "\n",
    "def fold_irt_features(clips: pd.DataFrame, train_students: set, cfg: dict, prefix: str = \"irt_\") -> pd.DataFrame:\n",
    "    \"\"\"Fit item parameters on training-fold students only, then score every student.\"\"\"\n",
    "    frames = []\n",
    "    train = clips[clips[\"student_id\"].isin(train_students)]\n",
    "    for task, g_train in train.dropna(subset=[\"correct\", \"item_key\"]).groupby(\"task_family\"):\n",
    "        if g_train[\"item_key\"].nunique() < 3 or g_train[\"student_id\"].nunique() < 10:\n",
    "            continue\n",
    "        fit = fit_irt(g_train, model=\"rasch\", prior_theta_sd=float(cfg[\"irt_prior_theta_sd\"]),\n",
    "                      prior_b_sd=float(cfg[\"irt_prior_b_sd\"]), max_iter=int(cfg[\"irt_max_iter\"]),\n",
    "                      min_obs_per_item=int(cfg[\"irt_min_obs_per_item\"]))\n",
    "        g_all = clips[clips[\"task_family\"] == task]\n",
    "        ab = score_students(g_all, fit.items, prior_theta_sd=float(cfg[\"irt_prior_theta_sd\"]))\n",
    "        feats = difficulty_features(g_all, fit.items, ab, prefix=f\"{prefix}{task}_\")\n",
    "        frames.append(feats.set_index(\"student_id\"))\n",
    "    if not frames:\n",
    "        return pd.DataFrame()\n",
    "    out = pd.concat(frames, axis=1)\n",
    "    for stat in (\"difficulty_weighted_accuracy\", \"response_residual_mean\", \"theta\", \"unexpected_easy_item_error_rate\"):\n",
    "        cols = [c for c in out.columns if c.endswith(stat) and c.startswith(prefix)]\n",
    "        if cols:\n",
    "            out[f\"{prefix}all_{stat}\"] = out[cols].mean(axis=1)\n",
    "    return out\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-025",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/item_intelligence.py\n",
    "\"\"\"Section 04 - item difficulty and response intelligence.\n",
    "\n",
    "Scientific question: are some literacy assessment items substantially more\n",
    "informative than others?\n",
    "\n",
    "All statistics use observed responses only (non-attempted items are never\n",
    "counted as incorrect). Item parameters here are fitted on all training\n",
    "students for exploratory purposes; predictive stages refit them per fold.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from . import irt\n",
    "from . import visualization as viz\n",
    "from .stats_utils import bh_fdr, partial_corr, safe_corr\n",
    "\n",
    "\n",
    "def item_registry(clips: pd.DataFrame, students: pd.DataFrame, cfg: dict) -> pd.DataFrame:\n",
    "    d = clips.dropna(subset=[\"item_key\"]).copy()\n",
    "    has_correct = \"correct\" in d.columns and d[\"correct\"].notna().any()\n",
    "    g = d.groupby(\"item_key\")\n",
    "    reg = pd.DataFrame({\"task_family\": g[\"task_family\"].first(), \"n_exposures\": g.size(), \"n_students\": g[\"student_id\"].nunique()})\n",
    "    for c in (\"item_id\", \"expected_text\"):\n",
    "        if c in d.columns:\n",
    "            reg[c] = g[c].first()\n",
    "    n_task_students = d.groupby(\"task_family\")[\"student_id\"].nunique()\n",
    "    reg[\"exposure_rate_within_task\"] = reg[\"n_students\"] / reg[\"task_family\"].map(n_task_students)\n",
    "    if not has_correct:\n",
    "        return reg.reset_index()\n",
    "    reg[\"n_scored\"] = g[\"correct\"].count()\n",
    "    reg[\"missing_correctness_rate\"] = 1 - reg[\"n_scored\"] / reg[\"n_exposures\"]\n",
    "    reg[\"p_correct\"] = g[\"correct\"].mean()\n",
    "    k = 2.0\n",
    "    task_p = d.groupby(\"task_family\")[\"correct\"].mean()\n",
    "    prior = reg[\"task_family\"].map(task_p)\n",
    "    reg[\"p_correct_smoothed\"] = (reg[\"p_correct\"] * reg[\"n_scored\"] + prior * k) / (reg[\"n_scored\"] + k)\n",
    "    reg[\"empirical_difficulty_logit\"] = -np.log(reg[\"p_correct_smoothed\"].clip(1e-3, 1 - 1e-3) / (1 - reg[\"p_correct_smoothed\"].clip(1e-3, 1 - 1e-3)))\n",
    "    reg[\"rare\"] = reg[\"n_scored\"] < int(cfg[\"item_rare_threshold\"])\n",
    "    d = d.merge(students[[\"student_id\", \"target\", \"school_id\"] + [c for c in students.columns if c.startswith(\"theta_\")]],\n",
    "                on=\"student_id\", how=\"left\")\n",
    "    task_sum = d.groupby([\"student_id\", \"task_family\"])[\"correct\"].agg([\"sum\", \"count\"]).rename(columns={\"sum\": \"ts\", \"count\": \"tc\"})\n",
    "    d = d.join(task_sum, on=[\"student_id\", \"task_family\"])\n",
    "    d[\"rest_score\"] = (d[\"ts\"] - d[\"correct\"]) / (d[\"tc\"] - 1).where(d[\"tc\"] > 1)\n",
    "    rows = []\n",
    "    for item, gi in d.groupby(\"item_key\"):\n",
    "        r = {\"item_key\": item}\n",
    "        r[\"point_biserial_rest\"], r[\"p_rest\"], _ = safe_corr(gi[\"correct\"], gi[\"rest_score\"], \"pearson\", 10)\n",
    "        r[\"point_biserial_target\"], r[\"p_target\"], r[\"n_target\"] = safe_corr(gi[\"correct\"], gi[\"target\"], \"pearson\", 10)\n",
    "        task_theta = f\"theta_{gi['task_family'].iloc[0]}\"\n",
    "        if task_theta in gi.columns:\n",
    "            r[\"partial_r_target_given_task_theta\"], r[\"p_partial\"], _ = partial_corr(gi[\"correct\"], gi[\"target\"], gi[[task_theta]], \"pearson\", 15)\n",
    "        if \"school_id\" in gi.columns:\n",
    "            sp = gi.groupby(\"school_id\")[\"correct\"].agg([\"mean\", \"count\"])\n",
    "            sp = sp[sp[\"count\"] >= 5]\n",
    "            r[\"difficulty_sd_across_schools\"] = float(sp[\"mean\"].std()) if len(sp) >= 2 else np.nan\n",
    "            r[\"n_schools_ge5\"] = int(len(sp))\n",
    "        if \"theta_mean\" in gi.columns or task_theta in gi.columns:\n",
    "            th = gi[task_theta] if task_theta in gi.columns else gi[\"theta_mean\"]\n",
    "            try:\n",
    "                grp = pd.qcut(th, 3, labels=[\"low\", \"mid\", \"high\"], duplicates=\"drop\")\n",
    "                ap = gi.groupby(grp, observed=True)[\"correct\"].agg([\"mean\", \"count\"])\n",
    "                ap = ap[ap[\"count\"] >= 5]\n",
    "                r[\"difficulty_sd_across_ability\"] = float(ap[\"mean\"].std()) if len(ap) >= 2 else np.nan\n",
    "                for lvl in ap.index:\n",
    "                    r[f\"p_correct_ability_{lvl}\"] = float(ap.loc[lvl, \"mean\"])\n",
    "            except ValueError:\n",
    "                pass\n",
    "        rows.append(r)\n",
    "    stats = pd.DataFrame(rows).set_index(\"item_key\")\n",
    "    reg = reg.join(stats)\n",
    "    for p in (\"p_rest\", \"p_target\", \"p_partial\"):\n",
    "        if p in reg.columns:\n",
    "            reg[p.replace(\"p_\", \"q_\", 1)] = bh_fdr(reg[p])\n",
    "    return reg.reset_index()\n",
    "\n",
    "\n",
    "def item_redundancy(clips: pd.DataFrame, cfg: dict, max_items: int = 400) -> pd.DataFrame:\n",
    "    d = clips.dropna(subset=[\"item_key\", \"correct\"])\n",
    "    top = d[\"item_key\"].value_counts().head(max_items).index\n",
    "    M = d[d[\"item_key\"].isin(top)].pivot_table(index=\"student_id\", columns=\"item_key\", values=\"correct\", aggfunc=\"mean\")\n",
    "    E = M.notna().astype(float)\n",
    "    co = E.T @ E\n",
    "    rows = []\n",
    "    min_co = int(cfg[\"item_redundancy_min_coexposure\"])\n",
    "    cols = list(M.columns)\n",
    "    for i, a in enumerate(cols):\n",
    "        for b in cols[i + 1:]:\n",
    "            n = co.loc[a, b]\n",
    "            if n < min_co:\n",
    "                continue\n",
    "            pair = M[[a, b]].dropna()\n",
    "            if pair[a].std() == 0 or pair[b].std() == 0:\n",
    "                continue\n",
    "            rows.append({\"item_a\": a, \"item_b\": b, \"n_coexposed\": int(n), \"phi\": float(pair[a].corr(pair[b]))})\n",
    "    return pd.DataFrame(rows), co\n",
    "\n",
    "\n",
    "def stage_item_intelligence(ctx) -> dict:\n",
    "    cfg = ctx.config\n",
    "    clips = da.clips(ctx, \"train\")\n",
    "    sm = da.students(ctx, \"train\")\n",
    "    scr = da.screening(ctx) if ctx.stage_available(\"03\") else None\n",
    "    if scr is not None and \"theta_mean\" in scr.columns:\n",
    "        sm = sm.merge(scr[[\"theta_mean\"]], left_on=\"student_id\", right_index=True, how=\"left\")\n",
    "    if clips[\"item_key\"].isna().all():\n",
    "        ctx.save_json({\"status\": \"NO_ITEM_IDENTIFIERS\"}, \"item_status\")\n",
    "        return {\"outputs\": [\"item_status\"], \"summary\": {\"status\": \"NO_ITEM_IDENTIFIERS\"}}\n",
    "    reg = item_registry(clips, sm, cfg)\n",
    "    outputs = []\n",
    "    has_correct = \"correct\" in clips.columns and clips[\"correct\"].notna().sum() > 0\n",
    "    params, studs, comparison, feats = [], [], [], []\n",
    "    if has_correct and cfg.get(\"enable_irt\"):\n",
    "        results = irt.fit_task_irt(clips, cfg)\n",
    "        for task, res in results.items():\n",
    "            if res.get(\"status\") != \"OK\":\n",
    "                comparison.append({\"task_family\": task, \"status\": res.get(\"status\")})\n",
    "                continue\n",
    "            for m, fit in res[\"fits\"].items():\n",
    "                if fit is None:\n",
    "                    comparison.append({\"task_family\": task, \"model\": m, \"status\": \"NOT_IDENTIFIABLE_SAMPLE_SIZE\"})\n",
    "                    continue\n",
    "                comparison.append({\"task_family\": task, \"model\": m, \"status\": \"OK\", \"loglik\": fit.loglik, \"aic\": fit.aic,\n",
    "                                   \"bic\": fit.bic, \"n_params\": fit.n_params, \"n_obs\": fit.n_obs, \"converged\": fit.converged,\n",
    "                                   \"selected\": m == res[\"selected\"]})\n",
    "                params.append(fit.items.assign(task_family=task, model=m, selected_model=res[\"selected\"]))\n",
    "                studs.append(fit.students.assign(task_family=task, model=m, selected_model=res[\"selected\"]))\n",
    "            sel = res[\"fits\"][res[\"selected\"]]\n",
    "            g = clips[clips[\"task_family\"] == task]\n",
    "            feats.append(irt.difficulty_features(g, sel.items, sel.students, prefix=f\"irt_{task}_\").set_index(\"student_id\"))\n",
    "        item_params = pd.concat(params, ignore_index=True) if params else pd.DataFrame(columns=[\"item_key\", \"b\", \"a\", \"model\", \"selected_model\"])\n",
    "        ctx.save_df(item_params, \"irt_item_params\", also_csv=True)\n",
    "        ctx.save_df(pd.concat(studs, ignore_index=True) if studs else pd.DataFrame(), \"irt_student_params\")\n",
    "        ctx.save_df(pd.DataFrame(comparison), \"irt_model_comparison\", fmt=\"csv\")\n",
    "        outputs += [\"irt_item_params\", \"irt_student_params\", \"irt_model_comparison\"]\n",
    "        if feats:\n",
    "            sf = pd.concat(feats, axis=1)\n",
    "            for stat in (\"difficulty_weighted_accuracy\", \"response_residual_mean\", \"theta\", \"unexpected_easy_item_error_rate\"):\n",
    "                cols = [c for c in sf.columns if c.endswith(stat)]\n",
    "                if cols:\n",
    "                    sf[f\"irt_all_{stat}\"] = sf[cols].mean(axis=1)\n",
    "            ctx.save_df(sf.reset_index(), \"irt_student_features\")\n",
    "            outputs.append(\"irt_student_features\")\n",
    "        sel_params = item_params[item_params[\"model\"] == item_params[\"selected_model\"]]\n",
    "        reg = reg.merge(sel_params[[\"item_key\", \"b\", \"b_se\", \"a\"]].rename(columns={\"b\": \"irt_b\", \"b_se\": \"irt_b_se\", \"a\": \"irt_a\"}),\n",
    "                        on=\"item_key\", how=\"left\")\n",
    "        _irt_figures(ctx, item_params, pd.concat(studs, ignore_index=True) if studs else pd.DataFrame())\n",
    "    ctx.save_df(reg, \"item_registry\", also_csv=True)\n",
    "    outputs.append(\"item_registry\")\n",
    "    if has_correct:\n",
    "        red, co = item_redundancy(clips, cfg)\n",
    "        ctx.save_df(red, \"item_redundancy\", fmt=\"csv\")\n",
    "        outputs.append(\"item_redundancy\")\n",
    "        _item_figures(ctx, reg, red, co, clips)\n",
    "    top = reg.sort_values(\"point_biserial_target\", ascending=False).head(10) if \"point_biserial_target\" in reg.columns else reg.head(0)\n",
    "    return {\"outputs\": outputs, \"summary\": {\"n_items\": int(len(reg)), \"n_rare\": int(reg.get(\"rare\", pd.Series(dtype=bool)).sum()),\n",
    "                                            \"top_target_items\": top[[\"item_key\", \"point_biserial_target\"]].to_dict(\"records\") if len(top) else []}}\n",
    "\n",
    "\n",
    "def _irt_figures(ctx, params: pd.DataFrame, studs: pd.DataFrame) -> None:\n",
    "    grid = np.linspace(-4, 4, 161)\n",
    "    sel = params[params[\"model\"] == params[\"selected_model\"]]\n",
    "    for task, g in sel.groupby(\"task_family\"):\n",
    "        fig, axes = viz.new_figure(1, 3, (5, 4))\n",
    "        show = g.iloc[np.linspace(0, len(g) - 1, min(12, len(g))).astype(int)] if len(g) else g\n",
    "        for _, r in show.iterrows():\n",
    "            p = 1 / (1 + np.exp(-r[\"a\"] * (grid - r[\"b\"])))\n",
    "            axes[0, 0].plot(grid, p, lw=0.8)\n",
    "            axes[0, 1].plot(grid, irt.item_information(grid, r[\"a\"], r[\"b\"]), lw=0.8)\n",
    "        viz.finalize_axis(axes[0, 0], f\"{task}: item characteristic curves (subset)\", \"theta\", \"P(correct)\", len(g))\n",
    "        viz.finalize_axis(axes[0, 1], f\"{task}: item information curves (subset)\", \"theta\", \"information\", len(g))\n",
    "        test_info = sum(irt.item_information(grid, r[\"a\"], r[\"b\"]) for _, r in g.iterrows())\n",
    "        axes[0, 2].plot(grid, test_info)\n",
    "        if not studs.empty:\n",
    "            st = studs[(studs[\"task_family\"] == task) & (studs[\"model\"] == studs[\"selected_model\"])]\n",
    "            ax2 = axes[0, 2].twinx()\n",
    "            ax2.hist(st[\"theta\"], bins=30, alpha=0.3, color=\"grey\")\n",
    "            ax2.set_ylabel(\"students\")\n",
    "        viz.finalize_axis(axes[0, 2], f\"{task}: total information and ability distribution\", \"theta\", \"information\", len(g))\n",
    "        ctx.figure(fig, f\"irt_curves_{task}\", f\"IRT curves for {task} ({g['selected_model'].iloc[0]})\",\n",
    "                   \"Where on the ability scale are items informative?\", \"irt_item_params\", len(g),\n",
    "                   f\"Selected by BIC; median b={g['b'].median():.2f}, median a={g['a'].median():.2f}.\")\n",
    "    fig, axes = viz.new_figure(1, 1)\n",
    "    ax = axes[0, 0]\n",
    "    for task, g in sel.groupby(\"task_family\"):\n",
    "        ax.errorbar(g[\"b\"], g[\"p_correct\"], xerr=1.96 * g[\"b_se\"], fmt=\"o\", ms=3, alpha=0.6, label=task)\n",
    "    ax.legend(fontsize=7)\n",
    "    viz.finalize_axis(ax, \"IRT difficulty (95% CI) vs observed proportion correct\", \"b\", \"p correct\", len(sel))\n",
    "    ctx.figure(fig, \"irt_difficulty_uncertainty\", \"Item difficulty with uncertainty\", \"How precisely are items calibrated?\",\n",
    "               \"irt_item_params\", len(sel), \"Error bars from the observed information at the MAP estimate.\")\n",
    "\n",
    "\n",
    "def _item_figures(ctx, reg: pd.DataFrame, red: pd.DataFrame, co: pd.DataFrame, clips: pd.DataFrame) -> None:\n",
    "    fig, axes = viz.new_figure(1, 3, (5, 4))\n",
    "    viz.hist_kde(axes[0, 0], reg[\"n_exposures\"], \"item exposure\", \"clips\")\n",
    "    viz.hist_kde(axes[0, 1], reg[\"p_correct\"], \"proportion correct\")\n",
    "    if \"point_biserial_target\" in reg.columns:\n",
    "        viz.scatter_fit(axes[0, 2], reg[\"empirical_difficulty_logit\"], reg[\"point_biserial_target\"],\n",
    "                        \"empirical difficulty (logit)\", \"point-biserial with outcome\", \"difficulty vs outcome association\")\n",
    "    ctx.figure(fig, \"item_exposure_difficulty\", \"Item exposure, difficulty and outcome association\",\n",
    "               \"Are some items more informative?\", \"item_registry\", int(len(reg)),\n",
    "               f\"{int(reg['rare'].sum())} rare items (< threshold scored responses).\")\n",
    "    if len(red):\n",
    "        fig, axes = viz.new_figure(1, 1)\n",
    "        viz.hist_kde(axes[0, 0], red[\"phi\"], \"phi between co-exposed items\")\n",
    "        ctx.figure(fig, \"item_redundancy\", \"Item redundancy (phi coefficients)\", \"Are items redundant?\", \"item_redundancy\",\n",
    "                   int(len(red)), f\"{int((red['phi'] > 0.7).sum())} pairs with phi > 0.7.\")\n",
    "    top = co.iloc[:40, :40]\n",
    "    if top.shape[0] > 1:\n",
    "        fig, axes = viz.new_figure(1, 1, (8, 7))\n",
    "        viz.heatmap(axes[0, 0], top, \"Item co-occurrence (students exposed to both)\", cmap=\"viridis\", cbar_label=\"students\")\n",
    "        ctx.figure(fig, \"item_cooccurrence\", \"Item co-occurrence matrix (40 most frequent items)\",\n",
    "                   \"Which items are administered together?\", \"clip_master\", int(clips[\"student_id\"].nunique()),\n",
    "                   \"Counts reflect adaptive exposure.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-026",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/linguistic_features.py\n",
    "\"\"\"Local grapheme-to-phoneme processing and expected-text complexity features.\n",
    "\n",
    "G2P backends (all local, tried in order for ``g2p_backend='auto'``):\n",
    "``g2p_en`` (neural G2P; needs its bundled model and NLTK tagger data available\n",
    "locally), ``pronouncing`` (CMU Pronouncing Dictionary lookup), and a\n",
    "deterministic rule-based grapheme approximation (flagged as approximate).\n",
    "No text is sent to remote services. Word-frequency and phonetic-neighbourhood\n",
    "features are only computed when a licensed local lexicon is supplied.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import re\n",
    "from functools import lru_cache\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "ARPABET_VOWELS = {\"AA\", \"AE\", \"AH\", \"AO\", \"AW\", \"AY\", \"EH\", \"ER\", \"EY\", \"IH\", \"IY\", \"OW\", \"OY\", \"UH\", \"UW\"}\n",
    "RULE_DIGRAPHS = {\"ch\": \"CH\", \"sh\": \"SH\", \"th\": \"TH\", \"ph\": \"F\", \"ng\": \"NG\", \"ck\": \"K\", \"wh\": \"W\", \"qu\": \"K W\",\n",
    "                 \"ee\": \"IY\", \"ea\": \"IY\", \"oo\": \"UW\", \"ai\": \"EY\", \"ay\": \"EY\", \"oa\": \"OW\", \"ou\": \"AW\", \"ow\": \"OW\",\n",
    "                 \"oi\": \"OY\", \"oy\": \"OY\", \"igh\": \"AY\"}\n",
    "RULE_LETTERS = {\"a\": \"AE\", \"b\": \"B\", \"c\": \"K\", \"d\": \"D\", \"e\": \"EH\", \"f\": \"F\", \"g\": \"G\", \"h\": \"HH\", \"i\": \"IH\",\n",
    "                \"j\": \"JH\", \"k\": \"K\", \"l\": \"L\", \"m\": \"M\", \"n\": \"N\", \"o\": \"AA\", \"p\": \"P\", \"q\": \"K\", \"r\": \"R\", \"s\": \"S\",\n",
    "                \"t\": \"T\", \"u\": \"AH\", \"v\": \"V\", \"w\": \"W\", \"x\": \"K S\", \"y\": \"Y\", \"z\": \"Z\"}\n",
    "\n",
    "\n",
    "def tokenize_words(text: str) -> list:\n",
    "    return re.findall(r\"[a-z']+\", str(text).lower())\n",
    "\n",
    "\n",
    "def strip_stress(ph: str) -> str:\n",
    "    return re.sub(r\"\\d\", \"\", ph)\n",
    "\n",
    "\n",
    "def rule_g2p(word: str) -> list:\n",
    "    word = word.lower().replace(\"'\", \"\")\n",
    "    out, i = [], 0\n",
    "    while i < len(word):\n",
    "        for size in (3, 2):\n",
    "            chunk = word[i:i + size]\n",
    "            if chunk in RULE_DIGRAPHS:\n",
    "                out.extend(RULE_DIGRAPHS[chunk].split())\n",
    "                i += size\n",
    "                break\n",
    "        else:\n",
    "            ch = word[i]\n",
    "            if ch in RULE_LETTERS and not (ch == \"e\" and i == len(word) - 1 and len(word) > 2):\n",
    "                out.extend(RULE_LETTERS[ch].split())\n",
    "            i += 1\n",
    "    return out\n",
    "\n",
    "\n",
    "class G2P:\n",
    "    def __init__(self, backend: str = \"auto\"):\n",
    "        self.backend = None\n",
    "        self._g2p = None\n",
    "        self._pron = None\n",
    "        order = [\"g2p_en\", \"pronouncing\", \"rules\"] if backend == \"auto\" else [backend]\n",
    "        for name in order:\n",
    "            try:\n",
    "                if name == \"g2p_en\":\n",
    "                    from g2p_en import G2p  # type: ignore\n",
    "\n",
    "                    self._g2p = G2p()\n",
    "                    self._g2p(\"test\")\n",
    "                elif name == \"pronouncing\":\n",
    "                    import pronouncing  # type: ignore\n",
    "\n",
    "                    pronouncing.phones_for_word(\"test\")\n",
    "                    self._pron = pronouncing\n",
    "                self.backend = name\n",
    "                break\n",
    "            except Exception:\n",
    "                continue\n",
    "        if self.backend is None:\n",
    "            self.backend = \"rules\"\n",
    "\n",
    "    @lru_cache(maxsize=200000)\n",
    "    def word(self, w: str) -> tuple:\n",
    "        if self.backend == \"g2p_en\":\n",
    "            return tuple(strip_stress(p) for p in self._g2p(w) if p.strip() and p not in {\" \", \"'\"})\n",
    "        if self.backend == \"pronouncing\":\n",
    "            phones = self._pron.phones_for_word(w)\n",
    "            if phones:\n",
    "                return tuple(strip_stress(p) for p in phones[0].split())\n",
    "        return tuple(rule_g2p(w))\n",
    "\n",
    "    def text(self, text: str) -> list:\n",
    "        return [list(self.word(w)) for w in tokenize_words(text)]\n",
    "\n",
    "    def oov_rate(self, text: str) -> float:\n",
    "        if self.backend != \"pronouncing\":\n",
    "            return np.nan\n",
    "        words = tokenize_words(text)\n",
    "        if not words:\n",
    "            return np.nan\n",
    "        return float(np.mean([not self._pron.phones_for_word(w) for w in words]))\n",
    "\n",
    "\n",
    "def lz_complexity(seq: list) -> float:\n",
    "    \"\"\"Lempel-Ziv (1976) phrase count normalised by n / log2(n).\"\"\"\n",
    "    n = len(seq)\n",
    "    if n < 2:\n",
    "        return np.nan\n",
    "    s = [str(x) for x in seq]\n",
    "    i, c = 0, 0\n",
    "    while i < n:\n",
    "        k = 1\n",
    "        while i + k <= n and _contains(s[:i + k - 1], s[i:i + k]):\n",
    "            k += 1\n",
    "        c += 1\n",
    "        i += k\n",
    "    return float(c / (n / np.log2(n)))\n",
    "\n",
    "\n",
    "def _contains(hay: list, needle: list) -> bool:\n",
    "    m = len(needle)\n",
    "    return any(hay[j:j + m] == needle for j in range(len(hay) - m + 1))\n",
    "\n",
    "\n",
    "def text_features(text: str, g2p: G2P) -> dict:\n",
    "    words = tokenize_words(text)\n",
    "    phon_words = g2p.text(text)\n",
    "    phones = [p for w in phon_words for p in w]\n",
    "    vowels = [p for p in phones if p in ARPABET_VOWELS]\n",
    "    cons_flags = [p not in ARPABET_VOWELS for p in phones]\n",
    "    clusters, run = [], 0\n",
    "    for w in phon_words:\n",
    "        for p in w:\n",
    "            if p not in ARPABET_VOWELS:\n",
    "                run += 1\n",
    "            else:\n",
    "                if run >= 2:\n",
    "                    clusters.append(run)\n",
    "                run = 0\n",
    "        if run >= 2:\n",
    "            clusters.append(run)\n",
    "        run = 0\n",
    "    bigrams = list(zip(phones[:-1], phones[1:]))\n",
    "    out = {\n",
    "        \"l_n_chars\": float(len(re.sub(r\"[^a-z]\", \"\", str(text).lower()))),\n",
    "        \"l_n_words\": float(len(words)),\n",
    "        \"l_n_phonemes\": float(len(phones)),\n",
    "        \"l_n_syllables\": float(max(len(vowels), 1)) if phones else np.nan,\n",
    "        \"l_mean_word_len\": float(np.mean([len(w) for w in words])) if words else np.nan,\n",
    "        \"l_max_word_len\": float(max((len(w) for w in words), default=np.nan)) if words else np.nan,\n",
    "        \"l_n_consonants\": float(sum(cons_flags)),\n",
    "        \"l_n_vowels\": float(len(vowels)),\n",
    "        \"l_n_consonant_clusters\": float(len(clusters)),\n",
    "        \"l_max_cluster_len\": float(max(clusters)) if clusters else 0.0,\n",
    "        \"l_phonetic_diversity\": float(len(set(phones)) / len(phones)) if phones else np.nan,\n",
    "        \"l_transition_complexity\": float(len(set(bigrams)) / len(bigrams)) if bigrams else np.nan,\n",
    "        \"l_repeated_bigrams\": float(len(bigrams) - len(set(bigrams))) if bigrams else 0.0,\n",
    "        \"l_sentence_len_words\": float(len(words)),\n",
    "        \"l_lz_complexity\": lz_complexity(phones),\n",
    "        \"l_g2p_oov_rate\": g2p.oov_rate(text),\n",
    "    }\n",
    "    return out\n",
    "\n",
    "\n",
    "def item_linguistic_table(items: pd.DataFrame, cfg: dict, lexicon: pd.DataFrame | None = None) -> tuple[pd.DataFrame, dict]:\n",
    "    g2p = G2P(cfg.get(\"g2p_backend\", \"auto\"))\n",
    "    rows = []\n",
    "    text_col = \"expected_text\" if \"expected_text\" in items.columns else None\n",
    "    if text_col is None:\n",
    "        return pd.DataFrame(columns=[\"item_key\"]), {\"status\": \"NO_EXPECTED_TEXT\", \"g2p_backend\": g2p.backend}\n",
    "    for _, r in items.iterrows():\n",
    "        feats = text_features(r[text_col], g2p) if pd.notna(r[text_col]) else {}\n",
    "        feats[\"item_key\"] = r[\"item_key\"]\n",
    "        feats[\"l_phonemes\"] = \" \".join(p for w in g2p.text(r[text_col]) for p in w) if pd.notna(r[text_col]) else \"\"\n",
    "        if lexicon is not None and pd.notna(r[text_col]):\n",
    "            freq = lexicon.set_index(\"word\")[\"log_frequency\"]\n",
    "            ws = tokenize_words(r[text_col])\n",
    "            vals = [freq.get(w, np.nan) for w in ws]\n",
    "            feats[\"l_mean_log_word_frequency\"] = float(np.nanmean(vals)) if np.isfinite(vals).any() else np.nan\n",
    "        rows.append(feats)\n",
    "    table = pd.DataFrame(rows)\n",
    "    return table, {\"status\": \"OK\", \"g2p_backend\": g2p.backend,\n",
    "                   \"approximate\": g2p.backend == \"rules\", \"n_items\": int(len(table))}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-027",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/literacy_indices.py\n",
    "\"\"\"Section 19 - experimental literacy index discovery.\n",
    "\n",
    "Each index is an interpretable composite of validated component features with\n",
    "pre-declared directions, robust train-fitted scaling, missing-component\n",
    "handling and an equal-weight versus regularised-weight comparison. These are\n",
    "EXPERIMENTAL research constructs, not established educational assessments,\n",
    "and an index is retained only if the evidence supports it.\n",
    "\n",
    "Index scaling is always refitted on training folds. Components derived from\n",
    "item statistics (irt_/ia_) use the all-training EDA versions in this stage;\n",
    "the fully fold-fitted evaluation of the indices is experiment A14 in Section 20.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import re\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from . import data_access as da\n",
    "from . import visualization as viz\n",
    "from .stats_utils import bootstrap_ci, safe_corr, spearman_stat\n",
    "\n",
    "# direction +1: higher component = more of the construct\n",
    "INDEX_SPECS = {\n",
    "    \"L01_PHONOLOGICAL_PRECISION\": {\"motivation\": \"Expected phoneme alignment confidence and sequence preservation.\",\n",
    "                                    \"components\": [(r\"^ph_.*_seq_confidence__mean$\", 1), (r\"^ph_.*_phone_order_preservation__mean$\", 1),\n",
    "                                                   (r\"^ph_.*_phone_er__mean$\", -1)]},\n",
    "    \"L02_PHONOLOGICAL_STABILITY\": {\"motivation\": \"Within-student consistency of phoneme confidence across comparable items.\",\n",
    "                                    \"components\": [(r\"^ph_.*_seq_confidence__std$\", -1), (r\"^ia_ph_.*_seq_confidence__std$\", -1)]},\n",
    "    \"L03_ARTICULATION_CONSISTENCY\": {\"motivation\": \"Item-conditioned acoustic transition consistency.\",\n",
    "                                      \"components\": [(r\"^ia_m_sp_transition_rate__std$\", -1), (r\"^ia_m_sp_cepstral_variability__std$\", -1),\n",
    "                                                     (r\"^m_sp_transition_rate__std$\", -1)]},\n",
    "    \"L04_FLUENCY_DISRUPTION\": {\"motivation\": \"Internal pauses, discontinuities and restarts.\",\n",
    "                                \"components\": [(r\"^t_n_pauses__mean$\", 1), (r\"^t_pause_speech_ratio__mean$\", 1), (r\"^t_internal_sil__mean$\", 1),\n",
    "                                               (r\"^t_n_long_pauses__mean$\", 1), (r\"^ph_.*_self_corrections__mean$\", 1)]},\n",
    "    \"L05_COMPLEXITY_SENSITIVITY\": {\"motivation\": \"Change of performance and acoustics with item complexity.\",\n",
    "                                    \"components\": [(r\"^cx_t_active_dur__vs_.*__all$\", 1), (r\"^cx_correct__vs_.*__all$\", -1),\n",
    "                                                   (r\"^cx_t_n_pauses__vs_.*__all$\", 1)]},\n",
    "    \"L06_EXPECTED_TEXT_DEVIATION\": {\"motivation\": \"Expected-versus-recognised speech differences.\",\n",
    "                                     \"components\": [(r\"^ph_.*_word_er__mean$\", 1), (r\"^ph_.*_char_er__mean$\", 1), (r\"^ph_.*_phone_er__mean$\", 1)]},\n",
    "    \"L07_VERBAL_SEQUENCING\": {\"motivation\": \"Sequence completeness and order preservation.\",\n",
    "                               \"components\": [(r\"^ph_.*_word_order_preservation__mean$\", 1), (r\"^ph_.*_word_completeness__mean$\", 1),\n",
    "                                              (r\"^ph_.*_phone_completeness__mean$\", 1)]},\n",
    "    \"L08_ACOUSTIC_REGULARITY\": {\"motivation\": \"Temporal and spectral consistency.\",\n",
    "                                 \"components\": [(r\"^t_rhythm_regularity__mean$\", 1), (r\"^s_sp_stationarity__mean$\", -1),\n",
    "                                                (r\"^s_sp_entropy_mean__std$\", -1), (r\"^t_npvi__mean$\", -1)]},\n",
    "    \"L09_RESPONSE_CONSISTENCY\": {\"motivation\": \"Variability across comparable responses.\",\n",
    "                                  \"components\": [(r\"^ia_t_active_dur__std$\", -1), (r\"^ia_item_adjusted_acoustic_variability$\", -1),\n",
    "                                                 (r\"^t_active_dur__cv$\", -1)]},\n",
    "    \"L10_UNEXPECTED_ERROR\": {\"motivation\": \"Failures on items expected to be easy given estimated ability.\",\n",
    "                              \"components\": [(r\"^irt_.*_unexpected_easy_item_error_rate$\", 1), (r\"^irt_.*_response_residual_mean$\", -1)]},\n",
    "    \"L11_CROSS_TASK_ASYMMETRY\": {\"motivation\": \"Differences between task-specific performance and speech behaviour.\",\n",
    "                                  \"components\": [(r\"^xt_skill_asymmetry_accuracy_range$\", 1), (r\"^xt_acoustic_asymmetry$\", 1),\n",
    "                                                 (r\"^xt_accuracy_between_task_std$\", 1)]},\n",
    "    \"L12_ERROR_RECOVERY\": {\"motivation\": \"Recovery from unsuccessful responses (valid order required).\",\n",
    "                            \"components\": [(r\"^traj_all_error_recovery_rate$\", 1), (r\"^traj_all_longest_error_streak$\", -1)]},\n",
    "    \"L13_SPECTROTEMPORAL_COMPLEXITY\": {\"motivation\": \"Complementary multiscale descriptors.\",\n",
    "                                        \"components\": [(r\"^s_sp_tf_entropy__mean$\", 1), (r\"^w_.*_entropy__mean$\", 1), (r\"^w_wp_entropy__mean$\", 1),\n",
    "                                                       (r\"^m_sp_cepstral_traj_length_per_s__mean$\", 1)]},\n",
    "    \"L14_RESPONSE_EFFICIENCY\": {\"motivation\": \"Performance relative to item-conditioned active speech duration.\",\n",
    "                                 \"components\": [(r\"^acc_all$\", 1), (r\"^ia_item_adjusted_duration$\", -1)]},\n",
    "    \"L15_LITERACY_PROFILE_IMBALANCE\": {\"motivation\": \"Imbalance among initial literacy skills.\",\n",
    "                                        \"components\": [(r\"^theta_skill_imbalance$\", 1), (r\"^theta_range$\", 1), (r\"^theta_std$\", 1)]},\n",
    "}\n",
    "\n",
    "\n",
    "def resolve_components(columns, spec: dict) -> list:\n",
    "    comps = []\n",
    "    for pattern, direction in spec[\"components\"]:\n",
    "        rx = re.compile(pattern)\n",
    "        matches = [c for c in columns if rx.search(c)]\n",
    "        comps += [(m, direction) for m in matches[:3]]\n",
    "    return comps\n",
    "\n",
    "\n",
    "def compute_indices(base: pd.DataFrame, fit_ids, cfg: dict, extra: pd.DataFrame | None = None) -> tuple[pd.DataFrame, dict]:\n",
    "    \"\"\"Equal-weight indices with robust scaling fitted on fit_ids only.\n",
    "\n",
    "    EDA-only fold-sensitive columns (irt_/ia_) in ``base`` are ignored; pass\n",
    "    fold-fitted versions through ``extra``.\n",
    "    \"\"\"\n",
    "    B = base[[c for c in base.columns if not c.startswith((\"irt_\", \"ia_\", \"idx_\", \"clu_\"))]]\n",
    "    if extra is not None and not extra.empty:\n",
    "        B = B.join(extra[[c for c in extra.columns if c not in B.columns]])\n",
    "    fit_ids = [i for i in fit_ids if i in B.index]\n",
    "    out = pd.DataFrame(index=B.index)\n",
    "    report = {}\n",
    "    min_c = int(cfg[\"index_min_components\"])\n",
    "    for name, spec in INDEX_SPECS.items():\n",
    "        comps = resolve_components(B.columns, spec)\n",
    "        if len(comps) < min_c and not (len(comps) == 1 and min_c <= 1):\n",
    "            report[name] = {\"status\": \"UNAVAILABLE\", \"n_components\": len(comps)}\n",
    "            continue\n",
    "        Z = []\n",
    "        for col, direction in comps:\n",
    "            x = B[col]\n",
    "            ref = x.loc[fit_ids]\n",
    "            med = ref.median()\n",
    "            iqr = ref.quantile(0.75) - ref.quantile(0.25)\n",
    "            if not np.isfinite(iqr) or iqr == 0:\n",
    "                continue\n",
    "            Z.append(direction * ((x - med) / iqr).clip(-5, 5))\n",
    "        if len(Z) < min_c:\n",
    "            report[name] = {\"status\": \"UNAVAILABLE\", \"n_components\": len(Z)}\n",
    "            continue\n",
    "        Zdf = pd.concat(Z, axis=1)\n",
    "        n_avail = Zdf.notna().sum(axis=1)\n",
    "        out[f\"idx_{name}\"] = Zdf.mean(axis=1).where(n_avail >= min_c)\n",
    "        out[f\"idx_{name}_n_components\"] = n_avail\n",
    "        report[name] = {\"status\": \"OK\", \"components\": [c for c, _ in comps], \"directions\": [d for _, d in comps]}\n",
    "    return out, report\n",
    "\n",
    "\n",
    "def cronbach_alpha(Z: pd.DataFrame) -> float:\n",
    "    Z = Z.dropna()\n",
    "    k = Z.shape[1]\n",
    "    if k < 2 or len(Z) < 10:\n",
    "        return np.nan\n",
    "    var_items = Z.var(ddof=1).sum()\n",
    "    var_total = Z.sum(axis=1).var(ddof=1)\n",
    "    return float(k / (k - 1) * (1 - var_items / var_total)) if var_total > 0 else np.nan\n",
    "\n",
    "\n",
    "def stage_literacy_indices(ctx) -> dict:\n",
    "    from .ablation import ColumnSetBuilder, cv_evaluate\n",
    "    from .validation import paired_bootstrap_delta, pooled_predictions\n",
    "\n",
    "    cfg = ctx.config\n",
    "    S = da.student_features(ctx, \"train\")\n",
    "    meta = da.student_meta(ctx, \"train\")\n",
    "    y = meta[\"target\"].dropna().astype(float)\n",
    "    S = S.reindex(y.index)\n",
    "    res = da.residuals(ctx).reindex(y.index)\n",
    "    assign = ctx.load_df(\"cv_assignments\")\n",
    "    numeric = S[[c for c in S.columns if pd.api.types.is_numeric_dtype(S[c])]]\n",
    "    eda_extra = numeric[[c for c in numeric.columns if c.startswith((\"irt_\", \"ia_\"))]]\n",
    "    idx_all, report = compute_indices(numeric, list(numeric.index), cfg, extra=eda_extra)\n",
    "    ctx.save_df(idx_all.reset_index().rename(columns={\"index\": \"student_id\"}), \"literacy_indices\")\n",
    "    screening = da.raw_theta_columns(numeric)\n",
    "    schools = meta[\"school_id\"].reindex(y.index)\n",
    "    groups = schools if schools.notna().any() else None\n",
    "    base_res = cv_evaluate(ColumnSetBuilder(numeric, screening), None, y, assign, \"CV_A_REPEATED_STUDENT_KFOLD\", cfg, repeats=[0])\n",
    "    p0 = pooled_predictions(base_res.oof)\n",
    "    rows = []\n",
    "    for name, info in report.items():\n",
    "        row = {\"index\": name, \"motivation\": INDEX_SPECS[name][\"motivation\"], \"status\": info[\"status\"]}\n",
    "        if info[\"status\"] != \"OK\":\n",
    "            rows.append(row)\n",
    "            continue\n",
    "        col = f\"idx_{name}\"\n",
    "        comps = info[\"components\"]\n",
    "        row[\"components\"] = \";\".join(comps)\n",
    "        row[\"directions\"] = \";\".join(map(str, info[\"directions\"]))\n",
    "        Z = pd.concat([d * numeric.get(c, eda_extra.get(c)) for c, d in zip(comps, info[\"directions\"])], axis=1)\n",
    "        row[\"cronbach_alpha\"] = cronbach_alpha(Z)\n",
    "        row[\"missing_rate\"] = float(idx_all[col].isna().mean())\n",
    "        row[\"target_rho\"], row[\"target_p\"], row[\"n\"] = safe_corr(idx_all[col], y, \"spearman\", 20)\n",
    "        row[\"residual_rho\"], row[\"residual_p\"], _ = safe_corr(idx_all[col], res, \"spearman\", 20)\n",
    "        comp_rhos = [abs(safe_corr(Z.iloc[:, j], res, \"spearman\", 20)[0]) for j in range(Z.shape[1])]\n",
    "        row[\"best_component_abs_residual_rho\"] = float(np.nanmax(comp_rhos)) if np.isfinite(comp_rhos).any() else np.nan\n",
    "        sub = pd.DataFrame({\"i\": idx_all[col], \"r\": res}).dropna()\n",
    "        ci = bootstrap_ci(spearman_stat, sub[\"i\"].to_numpy(), sub[\"r\"].to_numpy(), n_boot=int(cfg[\"bootstrap_iterations\"]),\n",
    "                          seed=int(cfg[\"seed\"]), groups=groups.reindex(sub.index).to_numpy() if groups is not None else None)\n",
    "        row[\"residual_rho_ci_lower\"], row[\"residual_rho_ci_upper\"] = ci[\"lower\"], ci[\"upper\"]\n",
    "        signs = []\n",
    "        for s, ids in schools.dropna().groupby(schools.dropna()).groups.items():\n",
    "            if len(ids) >= int(cfg[\"min_group_size\"]):\n",
    "                r = safe_corr(idx_all.loc[ids, col], res.reindex(ids), \"spearman\", int(cfg[\"min_group_size\"]))[0]\n",
    "                if np.isfinite(r) and np.isfinite(row[\"residual_rho\"]):\n",
    "                    signs.append(np.sign(r) == np.sign(row[\"residual_rho\"]))\n",
    "        row[\"cross_school_sign_consistency\"] = float(np.mean(signs)) if signs else np.nan\n",
    "        # incremental contribution: fold-fitted equal-weight index vs regularised components, both with screening\n",
    "        def eq_builder():\n",
    "            class _B:\n",
    "                columns = screening\n",
    "\n",
    "                def build(self, tr, va, families=None, key=None):\n",
    "                    idx, _ = compute_indices(numeric, tr, cfg, extra=eda_extra)\n",
    "                    X = numeric[screening].join(idx[[col]])\n",
    "                    return X.loc[list(tr)], X.loc[list(va)]\n",
    "            return _B()\n",
    "        r_eq = cv_evaluate(eq_builder(), None, y, assign, \"CV_A_REPEATED_STUDENT_KFOLD\", cfg, repeats=[0])\n",
    "        comp_cols = [c for c in comps if c in numeric.columns]\n",
    "        r_reg = cv_evaluate(ColumnSetBuilder(numeric, screening + comp_cols), None, y, assign, \"CV_A_REPEATED_STUDENT_KFOLD\",\n",
    "                            cfg, repeats=[0]) if comp_cols else None\n",
    "        pe = pooled_predictions(r_eq.oof)\n",
    "        d = paired_bootstrap_delta(pe[\"y\"], pe[\"pred\"], p0.reindex(pe.index)[\"pred\"], cfg, \"r2\")\n",
    "        row.update({\"delta_r2_equal_weight\": d[\"delta\"], \"delta_r2_equal_weight_ci_lower\": d[\"ci_lower\"],\n",
    "                    \"delta_r2_equal_weight_ci_upper\": d[\"ci_upper\"]})\n",
    "        if r_reg is not None:\n",
    "            pr = pooled_predictions(r_reg.oof)\n",
    "            d2 = paired_bootstrap_delta(pr[\"y\"], pr[\"pred\"], p0.reindex(pr.index)[\"pred\"], cfg, \"r2\")\n",
    "            row.update({\"delta_r2_regularised_components\": d2[\"delta\"], \"delta_r2_regularised_ci_lower\": d2[\"ci_lower\"]})\n",
    "        retain = (np.isfinite(row.get(\"delta_r2_equal_weight_ci_lower\", np.nan)) and row[\"delta_r2_equal_weight_ci_lower\"] > 0\n",
    "                  and (row[\"cross_school_sign_consistency\"] if np.isfinite(row[\"cross_school_sign_consistency\"]) else 0) >= 0.7)\n",
    "        row[\"retention\"] = \"RETAIN\" if retain else (\"INVESTIGATE\" if np.isfinite(row[\"residual_rho_ci_lower\"]) and\n",
    "                                                    (row[\"residual_rho_ci_lower\"] > 0 or row[\"residual_rho_ci_upper\"] < 0) else \"DO_NOT_RETAIN\")\n",
    "        rows.append(row)\n",
    "    rep = pd.DataFrame(rows)\n",
    "    ctx.save_df(rep, \"literacy_index_report\", also_csv=True)\n",
    "    ok = rep[rep[\"status\"] == \"OK\"] if \"status\" in rep else rep\n",
    "    if len(ok):\n",
    "        o = ok.sort_values(\"residual_rho\")\n",
    "        fig, axes = viz.new_figure(1, 1, (8, 0.35 * len(o) + 2))\n",
    "        viz.forest(axes[0, 0], o, \"index\", \"residual_rho\", \"residual_rho_ci_lower\", \"residual_rho_ci_upper\",\n",
    "                   \"Experimental literacy indices: association with OOF screening residual\", \"Spearman rho (cluster bootstrap 95% CI)\")\n",
    "        ctx.figure(fig, \"literacy_indices_forest\", \"Experimental literacy indices\", \"Which composite indices are worth retaining?\",\n",
    "                   \"literacy_index_report\", int(len(y)), \"Experimental constructs, not established assessments.\")\n",
    "    return {\"outputs\": [\"literacy_indices\", \"literacy_index_report\"],\n",
    "            \"summary\": rep[[\"index\", \"status\"] + [c for c in (\"retention\",) if c in rep]].to_dict(\"records\")}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-028",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/src/wildspeech/logging_utils.py\n",
    "\"\"\"Structured logging, timers, memory monitoring and progress bars.\"\"\"\n",
    "from __future__ import annotations\n",
    "\n",
    "import gc\n",
    "import logging\n",
    "import os\n",
    "import sys\n",
    "import time\n",
    "from contextlib import contextmanager\n",
    "from pathlib import Path\n",
    "from typing import Iterable, Iterator\n",
    "\n",
    "_LOGGERS: dict = {}\n",
    "\n",
    "\n",
    "def get_logger(name: str = \"wildspeech\", log_dir: Path | None = None, level: int = logging.INFO) -> logging.Logger:\n",
    "    key = (name, str(log_dir))\n",
    "    if key in _LOGGERS:\n",
    "        return _LOGGERS[key]\n",
    "    logger = logging.getLogger(name)\n",
    "    logger.setLevel(level)\n",
    "    logger.propagate = False\n",
    "    fmt = logging.Formatter(\"%(asctime)s | %(levelname)-8s | %(name)s | %(message)s\", \"%Y-%m-%d %H:%M:%S\")\n",
    "    if not any(isinstance(h, logging.StreamHandler) and getattr(h, \"_ws\", False) for h in logger.handlers):\n",
    "        sh = logging.StreamHandler(sys.stdout)\n",
    "        sh.setFormatter(fmt)\n",
    "        sh._ws = True  # type: ignore[attr-defined]\n",
    "        logger.addHandler(sh)\n",
    "    if log_dir is not None:\n",
    "        log_dir = Path(log_dir)\n",
    "        log_dir.mkdir(parents=True, exist_ok=True)\n",
    "        fh = logging.FileHandler(log_dir / f\"{name}.log\", encoding=\"utf-8\")\n",
    "        fh.setFormatter(fmt)\n",
    "        logger.addHandler(fh)\n",
    "    _LOGGERS[key] = logger\n",
    "    return logger\n",
    "\n",
    "\n",
    "def memory_usage_mb() -> float:\n",
    "    \"\"\"Resident set size of the current process in MB (NaN if unavailable).\"\"\"\n",
    "    try:\n",
    "        import psutil  # type: ignore\n",
    "\n",
    "        return psutil.Process(os.getpid()).memory_info().rss / 1e6\n",
    "    except Exception:\n",
    "        try:\n",
    "            import resource\n",
    "\n",
    "            usage = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n",
    "            return usage / 1e3 if sys.platform != \"darwin\" else usage / 1e6\n",
    "        except Exception:\n",
    "            return float(\"nan\")\n",
    "\n",
    "\n",
    "def available_memory_mb() -> float:\n",
    "    try:\n",
    "        import psutil  # type: ignore\n",
    "\n",
    "        return psutil.virtual_memory().available / 1e6\n",
    "    except Exception:\n",
    "        return float(\"nan\")\n",
    "\n",
    "\n",
    "class StageTimer:\n",
    "    \"\"\"Context manager recording elapsed time and memory deltas.\"\"\"\n",
    "\n",
    "    def __init__(self, label: str, logger: logging.Logger | None = None):\n",
    "        self.label = label\n",
    "        self.logger = logger\n",
    "        self.elapsed = float(\"nan\")\n",
    "        self.mem_start = float(\"nan\")\n",
    "        self.mem_end = float(\"nan\")\n",
    "\n",
    "    def __enter__(self) -> \"StageTimer\":\n",
    "        self.t0 = time.perf_counter()\n",
    "        self.mem_start = memory_usage_mb()\n",
    "        if self.logger:\n",
    "            self.logger.info(\"START %s (rss=%.0f MB)\", self.label, self.mem_start)\n",
    "        return self\n",
    "\n",
    "    def __exit__(self, exc_type, exc, tb) -> None:\n",
    "        self.elapsed = time.perf_counter() - self.t0\n",
    "        gc.collect()\n",
    "        self.mem_end = memory_usage_mb()\n",
    "        if self.logger:\n",
    "            state = \"FAILED\" if exc_type else \"END\"\n",
    "            self.logger.info(\"%s %s in %.1fs (rss=%.0f MB, delta=%.0f MB)\", state, self.label,\n",
    "                             self.elapsed, self.mem_end, self.mem_end - self.mem_start)\n",
    "\n",
    "    def as_dict(self) -> dict:\n",
    "        return {\"elapsed_s\": self.elapsed, \"rss_start_mb\": self.mem_start, \"rss_end_mb\": self.mem_end}\n",
    "\n",
    "\n",
    "@contextmanager\n",
    "def timed(label: str, logger: logging.Logger | None = None) -> Iterator[StageTimer]:\n",
    "    timer = StageTimer(label, logger)\n",
    "    with timer:\n",
    "        yield timer\n",
    "\n",
    "\n",
    "def progress(iterable: Iterable, total: int | None = None, desc: str = \"\", disable: bool = False):\n",
    "    try:\n",
    "        from tqdm.auto import tqdm  # type: ignore\n",
    "\n",
    "        return tqdm(iterable, total=total, desc=desc, disable=disable, leave=False)\n",
    "    except Exception:\n",
    "        return iterable\n",
    "\n",
    "\n",
    "def release_memory() -> None:\n",
    "    gc.collect()\n",
    "    try:\n",
    "        import torch  # type: ignore\n",
    "\n",
    "        if torch.cuda.is_available():\n",
    "            torch.cuda.empty_cache()\n",
    "    except Exception:\n",
    "        pass\n"
   ]
  },
