   "source": [
    "## D. Execution controls and context\n",
    "\n",
    "`INITIALIZE_CONTEXT` mounts Drive (Colab, authorised only) and creates the project tree. `RUN_SECTIONS` controls each section below; dependencies are resolved automatically."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-067",
   "metadata": {},
   "outputs": [],
   "source": [
    "INITIALIZE_CONTEXT = False\n",
    "INCLUDE_DEPENDENCIES = True\n",
    "RUN_SECTIONS = {f\"{i:02d}\": False for i in range(29)}\n",
    "\n",
    "ctx = pipe = None\n",
    "if INITIALIZE_CONTEXT:\n",
    "    from wildspeech.pipeline import Pipeline, STAGE_REGISTRY, build_context\n",
    "    ctx = build_context(CONFIG, profile=PROFILE, yaml_path=CODE_ROOT / \"configs\" / \"p01_config.yaml\")\n",
    "    pipe = Pipeline(ctx)\n",
    "    display(pipe.status_table())\n",
    "\n",
    "\n",
    "def run_section(stage_id):\n",
    "    if not RUN_SECTIONS.get(stage_id):\n",
    "        print(f\"Section {stage_id}: not requested (set RUN_SECTIONS['{stage_id}'] = True)\")\n",
    "        return None\n",
    "    if pipe is None:\n",
    "        raise RuntimeError(\"Set INITIALIZE_CONTEXT = True and run the context cell first\")\n",
    "    report = pipe.run([stage_id], include_dependencies=INCLUDE_DEPENDENCIES)\n",
    "    display(report)\n",
    "    return report\n"
   ]
  },
