   "source": [
    "%%writefile {CODE_ROOT}/tests/test_student_disjoint_validation.py\n",
    "import numpy as np\n",
    "\n",
    "from wildspeech.validation import assert_student_disjoint, iter_folds, make_cv_assignments\n",
    "\n",
    "\n",
    "def test_every_scheme_partitions_students(synthetic_students, cfg):\n",
    "    assign, status = make_cv_assignments(synthetic_students, cfg)\n",
    "    assert_student_disjoint(assign)\n",
    "    for scheme, st in status.items():\n",
    "        if st[\"status\"] != \"OK\":\n",
    "            continue\n",
    "        for rep, fold, tr, va in iter_folds(assign, scheme):\n",
    "            assert len(np.intersect1d(tr, va)) == 0\n",
    "        sub = assign[assign[\"scheme\"] == scheme]\n",
    "        for rep, g in sub.groupby(\"repeat\"):\n",
    "            assert g[\"student_id\"].is_unique\n",
    "            assert set(g[\"student_id\"]) == set(synthetic_students.index)\n",
    "\n",
    "\n",
    "def test_school_grouped_folds_keep_schools_together(synthetic_students, cfg):\n",
    "    assign, status = make_cv_assignments(synthetic_students, cfg)\n",
    "    assert status[\"CV_B_SCHOOL_GROUP_KFOLD\"][\"status\"] == \"OK\"\n",
    "    sub = assign[assign[\"scheme\"] == \"CV_B_SCHOOL_GROUP_KFOLD\"].set_index(\"student_id\")\n",
    "    schools = synthetic_students[\"school_id\"]\n",
    "    folds_per_school = sub.join(schools).groupby(\"school_id\")[\"fold\"].nunique()\n",
    "    assert (folds_per_school == 1).all()\n",
    "\n",
    "\n",
    "def test_missing_metadata_reports_fallback(synthetic_students, cfg):\n",
    "    meta = synthetic_students.copy()\n",
    "    meta[\"school_id\"] = np.nan\n",
    "    assign, status = make_cv_assignments(meta, cfg)\n",
    "    assert status[\"CV_B_SCHOOL_GROUP_KFOLD\"][\"status\"].startswith(\"UNAVAILABLE\")\n",
    "    assert \"CV_B_SCHOOL_GROUP_KFOLD\" not in set(assign[\"scheme\"])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-061",
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile {CODE_ROOT}/tests/test_submission_validation.py\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from wildspeech.submission import validate_submission\n",
    "\n",
    "\n",
    "def _fmt():\n",
    "    return pd.DataFrame({\"student_id\": [\"a\", \"b\", \"c\"], \"score\": [0.0, 0.0, 0.0]})\n",
    "\n",
    "\n",
    "def test_valid_submission_passes():\n",
    "    sub = _fmt().assign(score=[1.0, 2.0, 3.0])\n",
    "    assert validate_submission(sub, _fmt(), \"student_id\", \"score\")[\"valid\"]\n",
    "\n",
    "\n",
    "def test_detects_missing_nonfinite_duplicates_and_order():\n",
    "    fmt = _fmt()\n",
    "    assert not validate_submission(fmt.assign(score=[1.0, np.nan, 2.0]), fmt, \"student_id\", \"score\")[\"no_missing_predictions\"]\n",
    "    assert not validate_submission(fmt.assign(score=[1.0, np.inf, 2.0]), fmt, \"student_id\", \"score\")[\"all_finite\"]\n",
    "    dup = fmt.assign(student_id=[\"a\", \"a\", \"c\"], score=1.0)\n",
    "    chk = validate_submission(dup, fmt, \"student_id\", \"score\")\n",
    "    assert not chk[\"no_duplicate_ids\"] and not chk[\"exact_id_coverage\"]\n",
    "    reordered = fmt.iloc[[2, 1, 0]].assign(score=1.0).reset_index(drop=True)\n",
    "    assert not validate_submission(reordered, fmt, \"student_id\", \"score\")[\"order_preserved\"]\n",
    "    renamed = fmt.rename(columns={\"score\": \"prediction\"}).assign(prediction=1.0)\n",
    "    assert not validate_submission(renamed.rename(columns={\"prediction\": \"score\"}).iloc[:2], fmt, \"student_id\", \"score\")[\"row_count_matches\"]\n"
   ]
  },
